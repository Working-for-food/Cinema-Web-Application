@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using Infrastructure.Entities

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor

@{
    string? username = User.Identity?.Name ?? "Гість";
    bool isActualAdmin = User.IsInRole("admin");
    string adminMode = Context.Session?.GetString("AdminMode") ?? "";
    bool isAdminInUserMode = isActualAdmin && adminMode == "user";
    bool showAdminPanel = isActualAdmin && !isAdminInUserMode;
    string? selectedCinemaName = Context.Session?.GetString("SelectedCinemaName") ?? "Оберіть кінотеатр";
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CinemaApp</title>
    <script type="importmap"></script>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_red.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
  
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-theme.min.css" />
    <link rel="stylesheet" href="~/css/modules/cite.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-clapperboard text-primary"></i> CINEMAAPP
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Afisha" asp-action="Index">Афіша</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Головна</a>
                        </li>

                        @if (showAdminPanel)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-danger" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                    Адміністрування
                                </a>
                                <ul class="dropdown-menu animate slideIn">
                                    <li><h6 class="dropdown-header">Контент</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Movies" asp-action="Index"><i class="fa-solid fa-film me-2 opacity-50"></i> Фільми</a></li>
                                    <li><a class="dropdown-item" asp-controller="Genres" asp-action="Index"><i class="fa-solid fa-tags me-2 opacity-50"></i> Жанри</a></li>
                                    <li><a class="dropdown-item" asp-controller="People" asp-action="Index"><i class="fa-solid fa-user-group me-2 opacity-50"></i> Люди</a></li>
                                    <li><a class="dropdown-item" asp-controller="Sessions" asp-action="Index"><i class="fa-solid fa-calendar-days me-2 opacity-50"></i> Сеанси</a></li>

                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">Шаблони</h6></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="PricingTemplates" asp-action="Index"><i class="fa-solid fa-receipt me-2 opacity-50"></i> Шаблони цін </a></li

                                    <li><hr class="dropdown-divider"></li>

                                    <li><h6 class="dropdown-header">Локації</h6></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Cinemas" asp-action="Index"><i class="fa-solid fa-building-user me-2 opacity-50"></i> Кінотеатри</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Halls" asp-action="Index"><i class="fa-solid fa-door-open me-2 opacity-50"></i> Зали</a></li>

                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">Система</h6></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Roles" asp-action="UserList"><i class="fa-solid fa-users-gear me-2 opacity-50"></i> Користувачі</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (!showAdminPanel)
                        {
                            <div class="dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="cinemaSelectionToggle" role="button" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i> @selectedCinemaName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" id="cinemaSelectionDropdown">
                                    <li><span class="dropdown-item-text opacity-50">Завантаження...</span></li>
                                </ul>
                            </div>
                        }

                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown ms-2">
                                <a class="nav-link dropdown-toggle d-flex align-items-center fw-bold text-dark" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-circle-user fs-4 me-2 opacity-75"></i> @username.ToUpper()
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fa-solid fa-address-card me-2"></i> Мій Профіль</a></li>
                                    
                                    @if (isActualAdmin)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="ToggleAdminMode" method="post">
                                                <button type="submit" class="dropdown-item">
                                                    <i class="fa-solid @(isAdminInUserMode ? "fa-toggle-on text-success" : "fa-toggle-off") me-2"></i>
                                                    @(isAdminInUserMode ? "Режим Адміна" : "Режим Юзера")
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger fw-bold">
                                                <i class="fa-solid fa-power-off me-2"></i> Вийти
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-link text-decoration-none fw-bold text-dark small" asp-controller="Account" asp-action="Login">ВХІД</a>
                            <a class="btn btn-maroon px-4 rounded-pill shadow-sm fw-bold small" asp-controller="Account" asp-action="Register">РЕЄСТРАЦІЯ</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/uk.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const cinemaToggle = document.getElementById("cinemaSelectionToggle");
            const cinemaDropdown = document.getElementById("cinemaSelectionDropdown");

            if (cinemaToggle && cinemaDropdown) {
                cinemaToggle.addEventListener("click", function () {
                    if (cinemaDropdown.children.length <= 1) {
                        fetch("/api/cinemas")
                            .then(res => res.ok ? res.json() : [])
                            .then(data => {
                                cinemaDropdown.innerHTML = "";
                                cinemaDropdown.innerHTML += `<li><a class="dropdown-item cinema-opt" href="#" data-id="0">Усі кінотеатри</a></li>`;
                                data.forEach(c => {
                                    cinemaDropdown.innerHTML += `<li><a class="dropdown-item cinema-opt" href="#" data-id="${c.id}">${c.name} <small class='text-muted'>(${c.address})</small></a></li>`;
                                });
                            })
                            .catch(err => console.error("Cinema load failed", err));
                    }
                });

                cinemaDropdown.addEventListener("click", function(e) {
                    const target = e.target.closest(".cinema-opt");
                    if(target) {
                        e.preventDefault();
                        const id = target.getAttribute("data-id");
                        const name = target.textContent;
                        fetch(`/Home/SetCinemaFilter?cinemaId=${id}&cinemaName=${encodeURIComponent(name)}`, { method: "POST" })
                            .then(res => { if(res.ok) window.location.reload(); });
                    }
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>