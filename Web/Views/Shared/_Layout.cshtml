@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using Infrastructure.Entities

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor

@{
    string? username = User.Identity?.Name ?? "Гість";
    bool isActualAdmin = User.IsInRole("admin");
    string adminMode = Context.Session?.GetString("AdminMode") ?? "";
    bool isAdminInUserMode = isActualAdmin && adminMode == "user";
    bool showAdminPanel = isActualAdmin && !isAdminInUserMode;
    string? selectedCinemaName = Context.Session?.GetString("SelectedCinemaName") ?? "Оберіть кінотеатр";
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CinemaApp</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_red.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
  
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-theme.min.css" />
    <link rel="stylesheet" href="~/css/modules/cite.css" asp-append-version="true" />


    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />
  


</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-film"></i> CinemaApp
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Головна</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Sessions" asp-action="Index">Сеанси</a>
                        </li>

                        @if (showAdminPanel)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-danger fw-bold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Адміністрування
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><h6 class="dropdown-header">Контент</h6></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Movies" asp-action="Index">Фільми</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Genres" asp-action="Index">Жанри</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="People" asp-action="Index">Люди</a></li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li><h6 class="dropdown-header">Локації</h6></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Cinemas" asp-action="Index">Кінотеатри</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Halls" asp-action="Index">Зали</a></li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li><h6 class="dropdown-header">Користувачі</h6></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Roles" asp-action="UserList">Список користувачів</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Roles" asp-action="Index">Керування ролями</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        @if (!showAdminPanel)
                        {
                            <div class="dropdown me-3">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="cinemaSelectionToggle" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-map-marker-alt text-danger"></i> @selectedCinemaName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" id="cinemaSelectionDropdown">
                                    <li><span class="dropdown-item-text">Завантаження...</span></li>
                                </ul>
                            </div>
                        }
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle"></i> @username
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">
                                            <i class="fas fa-id-card"></i> Мій Профіль
                                        </a>
                                    </li>

                                    @if (isActualAdmin)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="ToggleAdminMode" method="post">
                                                <button type="submit" class="dropdown-item">
                                                    <i class="fas @(isAdminInUserMode ? "fa-user-shield" : "fa-user")"></i>
                                                    @(isAdminInUserMode ? "Перейти в Адмін" : "Перегляд як користувач")
                                                </button>
                                            </form>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-sign-out-alt"></i> Вийти
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary me-2" asp-controller="Account" asp-action="Login">Вхід</a>
                            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Реєстрація</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto py-3">
        <div class="container text-center">
            &copy; 2026 - CinemaApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Конфіденційність</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/uk.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const cinemaToggle = document.getElementById("cinemaSelectionToggle");
            const cinemaDropdown = document.getElementById("cinemaSelectionDropdown");

            if (cinemaToggle && cinemaDropdown) {
                cinemaToggle.addEventListener("click", function () {
                    if (cinemaDropdown.children.length <= 1) {
                        fetch("/api/cinemas")
                            .then(res => res.ok ? res.json() : [])
                            .then(data => {
                                cinemaDropdown.innerHTML = "";
                                cinemaDropdown.innerHTML += `<li><a class="dropdown-item cinema-opt" href="#" data-id="0">Усі кінотеатри</a></li>`;
                                data.forEach(c => {
                                    cinemaDropdown.innerHTML += `<li><a class="dropdown-item cinema-opt" href="#" data-id="${c.id}">${c.name} <small class='text-muted'>(${c.address})</small></a></li>`;
                                });
                            })
                            .catch(err => console.error("Cinema load failed", err));
                    }
                });

                cinemaDropdown.addEventListener("click", function(e) {
                    const target = e.target.closest(".cinema-opt");
                    if(target) {
                        e.preventDefault();
                        const id = target.getAttribute("data-id");
                        const name = target.textContent;
                        fetch(`/Home/SetCinemaFilter?cinemaId=${id}&cinemaName=${encodeURIComponent(name)}`, { method: "POST" })
                            .then(res => { if(res.ok) window.location.reload(); });
                    }
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>