@model Web.ViewModels.BookingSuccessVm
@{
    ViewData["Title"] = "Success";
}

<h2>Booked</h2>

<p><b>Booking:</b> #@Model.BookingId</p>
<p><b>Total:</b> @Model.TotalAmount</p>
<p><b>Date:</b> @Model.BookedAt</p>

<p><b>Seats:</b> @string.Join(", ", Model.Seats)</p>

<a asp-action="My">My bookings</a>
