@model Web.ViewModels.BookingSuccessVm

@{
    ViewData["Title"] = "Booking successful";
    var dateText = Model.BookedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm");

    // Форматує значення місця у вигляді: "Ряд X, місце Y"
    // Працює як для "2-8" / "2:8" / "2 8" / "Ряд 2 Місце 8", так і для інших рядків (fallback).
    string FormatSeat(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return raw;

        var t = raw.Trim();

        // Спроба витягнути перші 2 числа з будь-якого формату рядка
        var nums = System.Text.RegularExpressions.Regex.Matches(t, @"\d+")
            .Cast<System.Text.RegularExpressions.Match>()
            .Select(m => m.Value)
            .ToList();

        if (nums.Count >= 2)
            return $"Ряд {nums[0]}, місце {nums[1]}";

        // Якщо не вдалося — повертаємо як є
        return t;
    }
}

<section class="py-5 gray-bg">
    <div class="container">
        <div class="text-center mb-4">
            <div class="icon-badge bg-success text-white shadow-sm mx-auto mb-3" style="width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <i class="fa-solid fa-check fa-2xl"></i>
            </div>

            <h1 class="section-title display-5 fw-bold text-dark text-uppercase">Бронювання підтверджено</h1>
            <p class="text-muted small text-uppercase fw-bold opacity-75 letter-spacing-1">Ваші місця було успішно зарезервовано</p>
        </div>

        <div class="card shadow-sm border-0 col-lg-6 mx-auto br-12 overflow-hidden bg-white">
            <div class="card-body p-4 p-lg-5">

                <div class="info-list">

                    <!-- Прибрано вивід номера бронювання -->

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fa-solid fa-calendar-day me-2 opacity-50"></i>Дата та час</span>
                        <span class="fw-bold text-dark">@dateText</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fa-solid fa-coins me-2 opacity-50"></i>Сума до сплати</span>
                        <span class="fw-bold text-primary fs-5">@Model.TotalAmount.ToString("F2") грн</span>
                    </div>

                    <div class="py-3">
                        <span class="text-muted small text-uppercase fw-bold d-block mb-3"><i class="fa-solid fa-chair me-2 opacity-50"></i>Обрані місця</span>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var s in Model.Seats)
                            {
                                <span class="badge bg-light text-dark border px-3 py-2 br-8 fw-bold">
                                    @FormatSeat(s)
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 mt-4 pt-4 border-top">
                    <a asp-action="My" class="btn btn-maroon flex-grow-1 py-3 fw-bold text-uppercase shadow-sm">
                        <i class="fa-solid fa-ticket me-2"></i> Мої квитки
                    </a>
                    <a asp-controller="Afisha" asp-action="Index" class="btn btn-secondary flex-grow-1 py-3 fw-bold text-uppercase">
                        <i class="fa-solid fa-house me-2"></i> Назад до афіші
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
