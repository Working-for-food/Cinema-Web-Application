@using Infrastructure.Entities
@model Web.ViewModels.BookingCreateVm

@{
    ViewData["Title"] = "Бронювання місць";
    var seats = Model.Seats ?? new List<Web.ViewModels.BookingCreateVm.SeatVm>();
    var grouped = seats.GroupBy(x => x.RowNumber).OrderBy(g => g.Key).ToList();
    var maxSeats = grouped.Count == 0 ? 0 : grouped.Max(g => g.Max(s => s.SeatNumber));

    string SeatUiClass(int c) => c switch
    {
        1 => "seat-bg-vip",
        2 => "seat-bg-acc",
        _ => "seat-bg-std"
    };

    string PosterOrFallback() => string.IsNullOrWhiteSpace(Model.MoviePosterUrl)
        ? "https://via.placeholder.com/300x450?text=Poster"
        : Model.MoviePosterUrl!;

    string DayUa(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Понеділок",
        DayOfWeek.Tuesday => "Вівторок",
        DayOfWeek.Wednesday => "Середа",
        DayOfWeek.Thursday => "Четвер",
        DayOfWeek.Friday => "Пʼятниця",
        DayOfWeek.Saturday => "Субота",
        DayOfWeek.Sunday => "Неділя",
        _ => d.ToString()
    };
}

<section class="py-5 gray-bg seats-page-v2">
    <div class="container">

        <div class="card-modern overflow-hidden mb-5">
            <div class="booking-header-v2">
                <div class="header-backdrop" style="background-image: url('@PosterOrFallback()')"></div>

                <div class="header-content p-4 p-lg-5">
                    <div class="row align-items-center g-4">
                        <div class="col-md-auto text-center">
                            <div class="booking-poster-v2 shadow-lg">
                                <img src="@PosterOrFallback()" alt="Постер" />
                                @if (!string.IsNullOrWhiteSpace(Model.AgeLabel))
                                {
                                    <span class="age-badge">@Model.AgeLabel</span>
                                }
                            </div>
                        </div>
                        <div class="col-md">
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @if (!string.IsNullOrWhiteSpace(Model.FormatLabel))
                                {
                                    <span class="pill pill-blur">@Model.FormatLabel</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.LanguageLabel))
                                {
                                    <span class="pill pill-blur">@Model.LanguageLabel</span>
                                }
                            </div>
                            <h1 class="movie-title-v2 text-white mb-4">@Model.MovieTitle</h1>

                            <div class="booking-meta-v2">
                                <div class="meta-item-v2">
                                    <div class="meta-icon"><i class="fa-solid fa-location-dot"></i></div>
                                    <div class="meta-info">
                                        <label>Кінотеатр</label>
                                        <span>@Model.CinemaName (@Model.HallName)</span>
                                    </div>
                                </div>
                                <div class="meta-item-v2">
                                    <div class="meta-icon"><i class="fa-solid fa-calendar-day"></i></div>
                                    <div class="meta-info">
                                        <label>Дата</label>
                                        <span>@Model.StartTime?.ToString("dd.MM.yyyy"), @(Model.StartTime.HasValue? DayUa(Model.StartTime.Value.DayOfWeek) : "")</span>
                                    </div>
                                </div>
                                <div class="meta-item-v2">
                                    <div class="meta-icon"><i class="fa-solid fa-clock"></i></div>
                                    <div class="meta-info">
                                        <label>Час</label>
                                        <span>@Model.StartTime?.ToString("HH:mm") — @Model.EndTime?.ToString("HH:mm")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 br-16 bg-white p-4 p-lg-5">
            <div class="text-center mb-5">
                <h2 class="section-title mb-4">ОБЕРІТЬ МІСЦЯ</h2>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <span class="legend-item"><span class="dot seat-bg-std"></span>Звичайні</span>
                    <span class="legend-item"><span class="dot seat-bg-vip"></span>VIP</span>
                    <span class="legend-item"><span class="dot seat-bg-acc"></span>Інклюзивні</span>
                    <span class="legend-item"><span class="dot dot-booked"></span>Зайняті</span>
                </div>
            </div>

            <form method="post" class="booking-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SessionId" value="@Model.SessionId" />
                <div asp-validation-summary="All" class="text-danger mb-4 fw-bold text-center"></div>

                <div class="cinema-map-wrap mb-5">
                    <div class="cinema-map">
                        <div class="cinema-screen">
                            <div class="cinema-screen-arc"></div>
                            <div class="cinema-screen-title text-uppercase fw-black opacity-25" style="letter-spacing: 12px;">Екран</div>
                        </div>

                        @if (grouped.Count == 0)
                        {
                            <div class="text-center py-5 opacity-50">
                                <i class="fa-solid fa-ticket fa-3x mb-3"></i>
                                <h5>Схема залу порожня</h5>
                            </div>
                        }
                        else
                        {
                            <div class="cinema-grid" style="--cols:@maxSeats;">
                                @foreach (var row in grouped)
                                {
                                    <div class="row-label">@row.Key</div>
                                    @for (int s = 1; s <= maxSeats; s++)
                                    {
                                        var seat = row.FirstOrDefault(x => x.SeatNumber == s);
                                        if (seat == null)
                                        {
                                            <div class="seat seat-empty"></div>
                                        }
                                        else
                                        {
                                            var css = SeatUiClass(seat.Category);
                                            var isBooked = seat.IsBooked;
                                            <label class="seat @css js-seat @(isBooked ? "seat-booked" : "")" title="Ряд @row.Key, місце @s">
                                                <input class="seat-input" type="checkbox" name="SelectedSeatIds" value="@seat.SeatId" data-price="@seat.Price" @(isBooked ? "disabled" : null) />
                                                <div class="seat-text">
                                                    <div class="seat-no">@s</div>
                                                    <div class="seat-price">@seat.Price.ToString("0")</div>
                                                </div>
                                            </label>
                                        }
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="footer-checkout card-modern p-4">
                    <div class="row align-items-center justify-content-between g-4">
                        <div class="col-md-auto">
                            <div class="total-summary">
                                <span class="text-muted text-uppercase fw-bold small d-block mb-1">До сплати:</span>
                                <div class="total-amount">
                                    <span id="total">0.00</span> <small>₴</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-auto">
                            <div class="d-flex gap-3">
                                <a asp-controller="Afisha" asp-action="Index" class="btn btn-secondary px-4 fa-solid fa-arrow-left me-1">НАЗАД</a>
                                <button type="submit" class="btn btn-maroon btn-lg px-5 shadow-sm">
                                    <i class="fa-solid fa-check-circle me-2"></i> ЗАБРОНЮВАТИ
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const checkboxes = document.querySelectorAll('.seat-input[data-price]');
        const totalEl = document.getElementById('total');

        const map = document.querySelector('.cinema-map')
                 || document.querySelector('.cinema-grid')
                 || document.querySelector('.cinema-map-wrap');

        function updateTotal() {
            let sum = 0;
            let anySelected = false;

            checkboxes.forEach(cb => {
                if (cb.checked) {
                    anySelected = true;
                    sum += parseFloat(cb.dataset.price);
                }
            });

            totalEl.textContent = sum.toLocaleString('uk-UA', { minimumFractionDigits: 2 });
        }

        checkboxes.forEach(cb => cb.addEventListener('change', updateTotal));
        updateTotal();
    });
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/booking-create.css" asp-append-version="true" />
}

