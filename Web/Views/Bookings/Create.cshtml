@model Web.ViewModels.BookingCreateVm

@{
    ViewData["Title"] = "Booking";
    var grouped = Model.Seats
        .GroupBy(x => x.RowNumber)
        .OrderBy(g => g.Key)
        .ToList();
}

<h2>Choose seats</h2>

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="SessionId" value="@Model.SessionId" />

    <div asp-validation-summary="All" class="text-danger"></div>

    @foreach (var row in grouped)
    {
        <div style="margin-bottom: 12px;">
            <div><b>Row @row.Key</b></div>

            @foreach (var s in row.OrderBy(x => x.SeatNumber))
            {
                var disabled = s.IsBooked ? "disabled" : "";
                <label style="display:inline-block; margin-right:10px; opacity:@(s.IsBooked ? "0.45" : "1")">
                    <input type="checkbox" name="SelectedSeatIds" value="@s.SeatId" @disabled />
                    @s.SeatNumber (@s.Price)
                </label>
            }
        </div>
    }

    <button type="submit">Book</button>
</form>
