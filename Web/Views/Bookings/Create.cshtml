@model Web.ViewModels.BookingCreateVm

@{
    ViewData["Title"] = "Бронювання місць";

    var grouped = Model.Seats
        .GroupBy(x => x.RowNumber)
        .OrderBy(g => g.Key)
        .ToList();

    string CategoryClass(int c) => c switch
    {
        1 => "seat-vip",
        2 => "seat-accessible",
        _ => "seat-standard"
    };

    string PosterOrFallback()
    {
        return string.IsNullOrWhiteSpace(Model.MoviePosterUrl)
            ? "https://via.placeholder.com/300x450?text=Poster"
            : Model.MoviePosterUrl!;
    }

    string DayUa(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Понеділок",
        DayOfWeek.Tuesday => "Вівторок",
        DayOfWeek.Wednesday => "Середа",
        DayOfWeek.Thursday => "Четвер",
        DayOfWeek.Friday => "Пʼятниця",
        DayOfWeek.Saturday => "Субота",
        DayOfWeek.Sunday => "Неділя",
        _ => d.ToString()
    };
}

<link rel="stylesheet" href="~/css/booking-create.css" />

<div class="booking-page">
    <div class="booking-wrap">

        <!-- Header -->
        <div class="booking-header">
            <div class="booking-poster">
                <img src="@PosterOrFallback()" alt="Постер" />
            </div>

            <div class="booking-info">
                <div class="booking-title-row">
                    @if (!string.IsNullOrWhiteSpace(Model.AgeLabel))
                    {
                        <span class="booking-age">@Model.AgeLabel</span>
                    }
                    <h1 class="booking-title">@Model.MovieTitle</h1>
                </div>

                <div class="booking-chips">
                    @if (!string.IsNullOrWhiteSpace(Model.FormatLabel))
                    {
                        <span class="booking-chip">@Model.FormatLabel</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.LanguageLabel))
                    {
                        <span class="booking-chip">@Model.LanguageLabel</span>
                    }
                </div>

                <div class="booking-meta">
                    <div class="meta-card">
                        <div class="meta-ico">📍</div>
                        <div class="meta-text">
                            <div class="meta-top">Місце</div>
                            <div class="meta-main">
                                @Model.HallName
                                @if (!string.IsNullOrWhiteSpace(Model.City) || !string.IsNullOrWhiteSpace(Model.CinemaName))
                                {
                                    <span>, @Model.City @Model.CinemaName</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="meta-card">
                        <div class="meta-ico">📅</div>
                        <div class="meta-text">
                            <div class="meta-top">Дата</div>
                            <div class="meta-main">
                                @if (Model.StartTime.HasValue)
                                {
                                    <div>@Model.StartTime.Value.ToString("dd.MM.yyyy")</div>
                                    <div>@DayUa(Model.StartTime.Value.DayOfWeek)</div>
                                }
                                else
                                {
                                    <div>—</div>
                                }
                            </div>
                        </div>
                    </div>


                    <div class="meta-card">
                        <div class="meta-ico">🕒</div>
                        <div class="meta-text">
                            <div class="meta-top">Час</div>
                            <div class="meta-main">
                                @if (Model.StartTime.HasValue && Model.EndTime.HasValue)
                                {
                                    <span>@Model.StartTime.Value.ToString("HH:mm") - @Model.EndTime.Value.ToString("HH:mm")</span>
                                }
                                else if (Model.StartTime.HasValue)
                                {
                                    <span>@Model.StartTime.Value.ToString("HH:mm")</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Seats -->
        <div class="seats-title">ОБЕРІТЬ МІСЦЯ</div>

        <div class="legend">
            <span class="lg"><i class="lg-dot dot-standard"></i>Звичайні</span>
            <span class="lg"><i class="lg-dot dot-vip"></i>VIP</span>
            <span class="lg"><i class="lg-dot dot-accessible"></i>Інклюзивні</span>
            <span class="lg"><i class="lg-dot dot-booked"></i>Зайняті</span>
        </div>

        <div class="hall-wrap">
            <div class="hall">
                <div class="screen">ЕКРАН</div>
            </div>
        </div>


        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SessionId" value="@Model.SessionId" />

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="hall-wrap">
                <div class="hall">
                    @foreach (var row in grouped)
                    {
                        <div class="row-line">
                            <div class="row-label">Ряд @row.Key</div>

                            @foreach (var s in row.OrderBy(x => x.SeatNumber))
                            {
                                var css = CategoryClass(s.Category);
                                var bookedClass = s.IsBooked ? "booked" : "";

                                <label class="seat @css @bookedClass">
                                    <input type="checkbox"
                                           name="SelectedSeatIds"
                                           value="@s.SeatId"
                                           data-price="@s.Price"
                                    @(s.IsBooked ? "disabled" : null) />
                                    <span>
                                        @s.SeatNumber
                                        <small>@s.Price.ToString("0.00")</small>
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="total-box">
                Разом: <span id="total">0.00</span> ₴
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-success mt-2">
                    Забронювати вибрані місця
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const checkboxes = document.querySelectorAll('input[type="checkbox"][data-price]');
    const totalEl = document.getElementById('total');

    function updateTotal() {
        let sum = 0;
        checkboxes.forEach(cb => {
            if (cb.checked) sum += parseFloat(cb.dataset.price);
        });
        totalEl.textContent = sum.toFixed(2);
    }

    checkboxes.forEach(cb => cb.addEventListener('change', updateTotal));
</script>
