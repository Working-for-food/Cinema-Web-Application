<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Квиток</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body>

    <div class="modal fade" id="qrTicketModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="box-shadow: none">
            <div class="modal-content border-0 p-0" style="border-radius: 20px; overflow: hidden;">

                <div class="modal-header" style="background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%); border-bottom: 1px solid rgba(99, 102, 241, 0.1);">
                    <div style="width: 100%;">
                        <h5 class="modal-title fw-bold text-dark" id="qrModalTitle" style="letter-spacing: 0.02em;">Квиток</h5>
                        <small id="qrModalMovieName" class="d-block text-muted fw-bold" style="font-size: 13px; text-transform: uppercase;">Назва фільму</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-0" style="background-color: #f8fafc;">

                    <div id="carouselTickets" class="carousel slide" data-bs-interval="false" data-bs-wrap="false">
                        <div class="carousel-inner" id="qrTicketsContainer">
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselTickets" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Попередній</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselTickets" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Наступний</span>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <style>
        .ticket-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 24px;
            width: 280px;
            position: relative;
            box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.15), 0 4px 6px -2px rgba(99, 102, 241, 0.1);
            border: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin: 30px auto;
        }

        .ticket-divider {
            width: 100%;
            height: 1px;
            border-bottom: 2px dashed #e2e8f0;
            margin: 16px 0;
            position: relative;
        }

            .ticket-divider::before, .ticket-divider::after {
                content: '';
                position: absolute;
                width: 20px;
                height: 20px;
                background-color: #f8fafc;
                border-radius: 50%;
                top: -10px;
                border: 1px solid #e2e8f0;
            }

            .ticket-divider::before {
                left: -35px;
                border-right-color: transparent;
            }

            .ticket-divider::after {
                right: -35px;
                border-left-color: transparent;
            }

        .seat-info {
            font-size: 22px;
            font-weight: 800;
            color: #6366f1;
            margin-bottom: 4px;
        }

        .row-info {
            font-size: 14px;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
        }

        .qr-placeholder {
            padding: 5px;
            background: white;
            border-radius: 8px;
        }

            .qr-placeholder img {
                display: block;
                margin: 0 auto;
            }

        .carousel-control-prev-icon,
        .carousel-control-next-icon {
            filter: invert(0.3) sepia(1) saturate(3) hue-rotate(210deg);
            width: 2rem;
            height: 2rem;
        }

        .carousel-control-prev, .carousel-control-next {
            width: 15%;
            opacity: 0.5;
            transition: opacity 0.3s;
        }

            .carousel-control-prev:hover, .carousel-control-next:hover {
                opacity: 1;
            }

            /* ЦЕЙ КОД ПРИХОВУЄ СТРІЛКУ, ЯКЩО ГОРТАТИ НІКУДИ */
            .carousel-control-prev.disabled,
            .carousel-control-next.disabled {
                opacity: 0;
                pointer-events: none;
            }
    </style>

    <script>
        var qrModalInstance = null;

        function openQrModal(tickets, movieTitle) {
            document.getElementById('qrModalMovieName').textContent = movieTitle;

            const container = document.getElementById('qrTicketsContainer');
            container.innerHTML = '';

            tickets.forEach((ticket, index) => {
                const slide = document.createElement('div');

                if (index === 0) {
                    slide.className = 'carousel-item active';
                } else {
                    slide.className = 'carousel-item';
                }

                slide.innerHTML = `
                    <div class="d-flex justify-content-center align-items-center" style="min-height: 420px;">
                        <div class="ticket-card">
                            <div class="row-info">Ряд ${ticket.Row}</div>
                            <div class="seat-info">Місце ${ticket.Seat}</div>

                            <div class="ticket-divider"></div>

                            <div class="qr-placeholder" id="qrcode-${index}"></div>

                            <div style="margin-top: 12px; font-size: 10px; color: #94a3b8; font-family: monospace; font-weight: bold; letter-spacing: 0.05em;">
                                СКАНУЙ ТУТ
                            </div>
                        </div>
                    </div>
                `;

                container.appendChild(slide);

                setTimeout(() => {
                    const qrContainer = document.getElementById(`qrcode-${index}`);
                    if (qrContainer) {
                        qrContainer.innerHTML = "";
                        new QRCode(qrContainer, {
                            text: ticket.QrContent,
                            width: 160,
                            height: 160,
                            colorDark : "#1e293b",
                            colorLight : "#ffffff",
                            correctLevel : QRCode.CorrectLevel.H
                        });
                    }
                }, 50);
            });

            const modalEl = document.getElementById('qrTicketModal');
            if (!qrModalInstance) {
                qrModalInstance = new bootstrap.Modal(modalEl);
            }
            qrModalInstance.show();
        }
    </script>

</body>
</html>