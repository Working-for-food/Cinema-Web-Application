<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tickets Modal Flat</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body>
    <div class="modal fade" id="qrTicketModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="box-shadow: none">
            <div class="modal-content border-0 p-0" style="border-radius: 20px; overflow: hidden;">
                <div class="modal-header text-white" style="background: linear-gradient(135deg, #222, #444); border:none;">
                    <div style="width: 100%;">
                        <h5 class="modal-title fw-bold" id="qrModalTitle">Квитки</h5>
                        <small id="qrModalMovieName" class="d-block text-white-50" style="font-size: 13px;">Назва фільму</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-0" style="background-color: #f4f6f9;">

                    <div id="carouselTickets" class="carousel slide" data-bs-interval="false">
                        <div class="carousel-inner" id="qrTicketsContainer">
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselTickets" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Попередній</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselTickets" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Наступний</span>
                        </button>
                    </div>

                </div>

                <div class="modal-footer justify-content-center" style="border-top: 1px solid #e0e0e0; background:#fff;">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Закрити</button>
                </div>
            </div>
        </div>
    </div>

    <style>
        .ticket-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 24px;
            width: 280px;
            position: relative;
            box-shadow: none;
            border: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin: 20px auto;
        }

        .ticket-divider {
            width: 100%;
            height: 1px;
            border-bottom: 2px dashed #eee;
            margin: 16px 0;
            position: relative;
        }

            .ticket-divider::before, .ticket-divider::after {
                content: '';
                position: absolute;
                width: 20px;
                height: 20px;
                background-color: #f4f6f9;
                border-radius: 50%;
                top: -10px;
            }

            .ticket-divider::before {
                left: -34px;
            }

            .ticket-divider::after {
                right: -34px;
            }

        .seat-info {
            font-size: 22px;
            font-weight: 800;
            color: #800000;
            margin-bottom: 4px;
        }

        .row-info {
            font-size: 14px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .qr-placeholder {
            padding: 5px;
            background: white;
            border-radius: 8px;
        }

            .qr-placeholder img {
                display: block;
                margin: 0 auto;
            }

        .carousel-control-prev-icon,
        .carousel-control-next-icon {
            filter: invert(1) grayscale(100);
            width: 2rem;
            height: 2rem;
        }

        .carousel-control-prev, .carousel-control-next {
            width: 15%;
            opacity: 0.5;
        }

            .carousel-control-prev:hover, .carousel-control-next:hover {
                opacity: 1;
            }
    </style>


    <script>
        var qrModalInstance = null;

        function openQrModal(tickets, movieTitle) {
            document.getElementById('qrModalMovieName').textContent = movieTitle;

            const container = document.getElementById('qrTicketsContainer');
            container.innerHTML = '';

            tickets.forEach((ticket, index) => {
                const slide = document.createElement('div');

                if (index === 0) {
                    slide.className = 'carousel-item active';
                } else {
                    slide.className = 'carousel-item';
                }

                slide.innerHTML = `
                    <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
                        <div class="ticket-card">
                            <div class="row-info">Ряд ${ticket.Row}</div>
                            <div class="seat-info">Місце ${ticket.Seat}</div>

                            <div class="ticket-divider"></div>

                            <div class="qr-placeholder" id="qrcode-${index}"></div>

                            <div style="margin-top: 12px; font-size: 10px; color: #999; font-family: monospace;">
                                SCAN TO ENTER
                            </div>
                        </div>
                    </div>
                `;

                container.appendChild(slide);

                setTimeout(() => {
                    const qrContainer = document.getElementById(`qrcode-${index}`);
                    if (qrContainer) {
                        qrContainer.innerHTML = "";
                        new QRCode(qrContainer, {
                            text: ticket.QrContent,
                            width: 160,
                            height: 160,
                            colorDark : "#000000",
                            colorLight : "#ffffff",
                            correctLevel : QRCode.CorrectLevel.H
                        });
                    }
                }, 50);
            });

            const modalEl = document.getElementById('qrTicketModal');
            if (!qrModalInstance) {
                qrModalInstance = new bootstrap.Modal(modalEl);
            }
            qrModalInstance.show();
        }
    </script>

</body>
</html>