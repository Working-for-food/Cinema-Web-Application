<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Квиток</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <link rel="stylesheet" href="/css/qr-code.css">
</head>
<body>

    <div class="modal fade" id="qrTicketModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="box-shadow: none">
            <div class="modal-content border-0 p-0" style="border-radius: 20px; overflow: hidden;">

                <div class="modal-header" style="background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%); border-bottom: 1px solid rgba(99, 102, 241, 0.1);">
                    <div style="width: 100%;">
                        <h5 class="modal-title fw-bold text-dark" id="qrModalTitle" style="letter-spacing: 0.02em;">Квиток</h5>
                        <small id="qrModalMovieName" class="d-block text-muted fw-bold" style="font-size: 13px; text-transform: uppercase;">Назва фільму</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-0" style="background-color: #f8fafc;">

                    <div id="carouselTickets" class="carousel slide" data-bs-interval="false" data-bs-wrap="false">
                        <div class="carousel-inner" id="qrTicketsContainer">
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselTickets" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Попередній</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselTickets" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Наступний</span>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>


    <script>
        var qrModalInstance = null;

        function openQrModal(tickets, movieTitle) {
            document.getElementById('qrModalMovieName').textContent = movieTitle;

            const container = document.getElementById('qrTicketsContainer');
            container.innerHTML = '';

            tickets.forEach((ticket, index) => {
                const slide = document.createElement('div');

                if (index === 0) {
                    slide.className = 'carousel-item active';
                } else {
                    slide.className = 'carousel-item';
                }

                slide.innerHTML = `
                    <div class="d-flex justify-content-center align-items-center" style="min-height: 420px;">
                        <div class="ticket-card">
                            <div class="row-info">Ряд ${ticket.Row}</div>
                            <div class="seat-info">Місце ${ticket.Seat}</div>

                            <div class="ticket-divider"></div>

                            <div class="qr-placeholder" id="qrcode-${index}"></div>

                            <div style="margin-top: 12px; font-size: 10px; color: #94a3b8; font-family: monospace; font-weight: bold; letter-spacing: 0.05em;">
                                СКАНУЙ ТУТ
                            </div>
                        </div>
                    </div>
                `;

                container.appendChild(slide);

                setTimeout(() => {
                    const qrContainer = document.getElementById(`qrcode-${index}`);
                    if (qrContainer) {
                        qrContainer.innerHTML = "";
                        new QRCode(qrContainer, {
                            text: ticket.QrContent,
                            width: 160,
                            height: 160,
                            colorDark : "#1e293b",
                            colorLight : "#ffffff",
                            correctLevel : QRCode.CorrectLevel.H
                        });
                    }
                }, 50);
            });

            const modalEl = document.getElementById('qrTicketModal');
            if (!qrModalInstance) {
                qrModalInstance = new bootstrap.Modal(modalEl);
            }
            qrModalInstance.show();
        }
    </script>

</body>
</html>