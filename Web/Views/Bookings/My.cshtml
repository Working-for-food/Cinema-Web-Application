@model IReadOnlyList<Application.DTOs.BookingResultDto>

@{
    ViewData["Title"] = "Мої бронювання";
    var totalSpent = Model?.Sum(x => x.TotalAmount) ?? 0m;
    var tmdbPosterBase = "https://image.tmdb.org/t/p/w342";
}

<section class="py-5 gray-bg">
    <div class="container">

        <div class="d-flex justify-content-between align-items-end mb-5 flex-wrap gap-4">
            <div>
                <h1 class="section-title fw-bold text-dark text-uppercase">Мої бронювання</h1>
            </div>

            <div class="card shadow-sm border-0 br-12 bg-white px-4 py-3">
                <div class="d-flex gap-4 align-items-center">
                    <div class="text-center">
                        <div class="small text-muted text-uppercase fw-bold">Кількість</div>
                        <div class="fw-bold fs-5">@(Model?.Count ?? 0)</div>
                    </div>
                    <div class="vr opacity-10"></div>
                    <div class="text-center">
                        <div class="small text-muted text-uppercase fw-bold">Сума усіх бронювань</div>
                        <div class="fw-bold fs-5 text-primary">@totalSpent.ToString("F2") грн</div>
                    </div>
                </div>
            </div>
        </div>

        @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 br-12">@ok</div>
        }
        @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-12">@err</div>
        }

        @if (Model == null || Model.Count == 0)
        {
            <div class="card shadow-sm border-0 br-12 p-5 text-center bg-white">
                <div class="icon-badge bg-light text-muted mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <i class="fa-solid fa-ticket fa-xl opacity-25"></i>
                </div>
                <h4 class="fw-bold">У вас поки немає бронювань</h4>
                <p class="text-muted mb-4">Оберіть фільм та зручні місця, щоб почати історію ваших переглядів.</p>
                <a asp-controller="Afisha" asp-action="Index" class="btn btn-maroon px-4 py-2 fw-bold text-uppercase">Переглянути афішу</a>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var b in Model)
                {
                    var seats = b.Seats;
                    var dateText = b.BookedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm");
                    var posterUrl = !string.IsNullOrWhiteSpace(b.MoviePosterPath) ? (tmdbPosterBase + b.MoviePosterPath) : null;

                    <div class="card shadow-sm border-0 br-12 overflow-hidden bg-white p-3 p-md-4">
                        <div class="row align-items-center g-4">

                            <div class="col-md-5 col-lg-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="flex-shrink-0">
                                        @if (!string.IsNullOrWhiteSpace(posterUrl))
                                        {
                                            <img src="@posterUrl" class="rounded shadow-sm" style="width: 70px; height: 100px; object-fit: cover;" alt="@b.MovieTitle" />
                                        }
                                        else
                                        {
                                            <div class="rounded bg-light d-flex align-items-center justify-content-center border" style="width: 70px; height: 100px;">
                                                <i class="fa-solid fa-image text-muted opacity-25"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="min-width-0">
                                        <h5 class="fw-bold text-dark mb-1 text-truncate">@b.MovieTitle</h5>
                                        <div class="badge bg-light text-primary border px-2 py-1 br-8 small fw-bold">Сеанс #@b.SessionId</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4 col-lg-5">
                                <div class="row g-3">
                                    <div class="col-6 col-md-12 col-lg-6">
                                        <div class="text-muted x-small text-uppercase fw-bold mb-1"><i class="fa-solid fa-calendar me-1 opacity-50"></i> Дата</div>
                                        <div class="fw-bold small">@dateText</div>
                                    </div>
                                    <div class="col-6 col-md-12 col-lg-6">
                                        <div class="text-muted x-small text-uppercase fw-bold mb-1"><i class="fa-solid fa-coins me-1 opacity-50"></i> Сума</div>
                                        <div class="fw-bold small text-primary">@b.TotalAmount.ToString("F2") грн</div>
                                    </div>
                                    <div class="col-12">
                                        <div class="text-muted x-small text-uppercase fw-bold mb-2"><i class="fa-solid fa-chair me-1 opacity-50"></i> Місця</div>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var s in seats.OrderBy(x => x.RowNumber).ThenBy(x => x.SeatNumber))
                                            {
                                                <span class="badge bg-light text-dark border px-2 py-1 br-6 x-small">Ряд @s.RowNumber, М @s.SeatNumber</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 col-lg-3 text-md-end">
                                <form asp-controller="Booking" asp-action="Cancel" asp-route-id="@b.BookingId" method="post" onsubmit="return confirm('Скасувати бронювання №@b.BookingId?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger w-100">
                                        <i class="fa-solid fa-xmark me-1"></i> Скасувати
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>