@model IReadOnlyList<Application.DTOs.BookingResultDto>
@{
    ViewData["Title"] = "My bookings";
}

<h2>My bookings</h2>

@if (Model.Count == 0)
{
    <p>No bookings yet.</p>
}
else
{
    @foreach (var b in Model)
    {
        <div style="border:1px solid #ddd; padding:12px; margin-bottom:12px;">
            <div><b>#@b.BookingId</b> | session @b.SessionId</div>
            <div>Total: @b.TotalAmount</div>
            <div>Date: @b.BookedAt</div>
            <div>
                Seats:
                @string.Join(", ", b.Seats.Select(s => $"{s.RowNumber}-{s.SeatNumber}"))
            </div>
        </div>
    }
}
