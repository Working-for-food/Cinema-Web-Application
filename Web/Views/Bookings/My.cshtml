@using System.Globalization
@using System.Text.Json
@model IReadOnlyList<Application.DTOs.BookingResultDto>

@{
    ViewData["Title"] = "Мої бронювання";
    var tmdbPosterBase = "https://image.tmdb.org/t/p/w342";
    var ukCulture = new CultureInfo("uk-UA");

    var groupedBookings = Model?
        .GroupBy(x => x.SessionId)
        .Select(g => new
        {
            SessionId = g.Key,
            MovieTitle = g.First().MovieTitle,
            MoviePosterPath = g.First().MoviePosterPath,
            TotalGroupAmount = g.Sum(x => x.TotalAmount),
            LastPurchaseDate = g.Max(x => x.BookedAt),
            TicketsData = g.SelectMany(x => x.Seats).Select(s => new
            {
                Row = s.RowNumber,
                Seat = s.SeatNumber,
                QrContent = $"TICKET|Session:{g.Key}|Row:{s.RowNumber}|Seat:{s.SeatNumber}|User:{User.Identity.Name}"
            }).OrderBy(t => t.Row).ThenBy(t => t.Seat).ToList(),
            AllSeats = g.SelectMany(x => x.Seats)
                        .OrderBy(s => s.RowNumber)
                        .ThenBy(s => s.SeatNumber)
                        .ToList(),
            Transactions = g.OrderByDescending(x => x.BookedAt).ToList()
        })
        .OrderByDescending(g => g.LastPurchaseDate)
        .ToList();

    var totalSpent = Model?.Sum(x => x.TotalAmount) ?? 0m;
}

<div class="container py-5">

    @* Заголовок сторінки *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-5 fw-bold text-dark mb-2">Мої бронювання</h1>
            <p class="text-muted mb-0">Історія відвідувань та активні квитки</p>
        </div>
        <div class="d-none d-md-block">
            <div class="icon-badge shadow-sm" style="width: 60px; height: 60px; background: var(--surface); color: var(--accent);">
                <i class="fa-solid fa-ticket fs-3"></i>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        @* Статистика (Панелі) *@
        <div class="row g-4 mb-5">
            <div class="col-md-6 col-lg-4">
                <div class="panel d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small fw-bold text-muted text-uppercase letter-spacing-1 mb-1">Фільмів</div>
                        <div class="fs-4 fw-bold text-dark">@groupedBookings.Count</div>
                    </div>
                    <div class="icon-badge">
                        <i class="fa-solid fa-film"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="panel d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small fw-bold text-muted text-uppercase letter-spacing-1 mb-1">Всього витрачено</div>
                        <div class="fs-4 fw-bold text-accent">@totalSpent.ToString("N0", ukCulture) ₴</div>
                    </div>
                    <div class="icon-badge" style="background-color: var(--accent-soft); color: var(--accent);">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success border-0 shadow-sm br-12 mb-4 p-3 d-flex align-items-center">
            <i class="fa-solid fa-circle-check me-2 fs-5"></i>
            <span class="fw-bold">@ok</span>
        </div>
    }

    @if (groupedBookings == null || groupedBookings.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fa-solid fa-ticket-simple"></i>
            </div>
            <h4 class="empty-title">Квитків немає</h4>
            <p class="empty-sub">Ви ще не придбали жодного квитка.</p>
            <a href="/" class="btn btn-maroon mt-3 px-4">
                <i class="fa-solid fa-plus me-1"></i> ОБРАТИ ФІЛЬМ
            </a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var group in groupedBookings)
            {
                var posterUrl = !string.IsNullOrWhiteSpace(group.MoviePosterPath) ? (tmdbPosterBase + group.MoviePosterPath) : null;
                var ticketsJson = JsonSerializer.Serialize(group.TicketsData);

                <div class="card-modern transition-all border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="row g-4">
                            @* Постер фільму *@
                            <div class="col-12 col-sm-auto text-center text-sm-start">
                                <div class="rounded-3 shadow-sm overflow-hidden border" style="width: 110px; height: 165px; margin: 0 auto;">
                                    @if (!string.IsNullOrWhiteSpace(posterUrl))
                                    {
                                        <img src="@posterUrl" class="w-100 h-100" style="object-fit: cover;" alt="@group.MovieTitle" />
                                    }
                                    else
                                    {
                                        <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center text-muted">
                                            <i class="fa-solid fa-film fa-2x opacity-25"></i>
                                        </div>
                                    }
                                </div>
                            </div>

                            @* Інформація про фільм та місця *@
                            <div class="col-12 col-sm">
                                <div class="d-flex flex-column h-100 justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <div class="small fw-bold text-muted text-uppercase letter-spacing-1">Фільм</div>
                                                <h3 class="header-title mb-0">@group.MovieTitle</h3>
                                            </div>
                                            <span class="badge bg-light text-dark border py-2 px-3 br-16 fw-bold">
                                                @group.TotalGroupAmount.ToString("N0") ₴
                                            </span>
                                        </div>

                                        <div class="mt-3">
                                            <div class="small fw-bold text-muted text-uppercase letter-spacing-1 mb-2">
                                                <i class="fa-solid fa-couch me-1 text-accent"></i> Ваші місця (@group.AllSeats.Count)
                                            </div>
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var seat in group.AllSeats)
                                                {
                                                    <span class="badge-modern bg-light-soft text-dark border" title="Ціна: @seat.Price ₴">
                                                        <span class="text-muted fw-normal">Ряд</span> @seat.RowNumber
                                                        <span class="text-muted fw-normal mx-1">|</span>
                                                        <span class="text-muted fw-normal">Місце</span> @seat.SeatNumber
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-4 pt-2 d-flex justify-content-end">
                                        <button class="btn btn-maroon w-100 w-sm-auto px-4 fw-bold shadow-sm"
                                                onclick='openQrModal(@Html.Raw(ticketsJson), "@group.MovieTitle")'>
                                            <i class="fa-solid fa-qrcode me-2"></i> ПОКАЗАТИ КВИТКИ
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Акордеон з історією транзакцій *@
                    <div class="bg-light-soft border-top p-0">
                        <div class="accordion accordion-flush" id="accordion-@group.SessionId">
                            <div class="accordion-item bg-transparent">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed bg-transparent shadow-none py-3 small fw-bold text-uppercase text-muted letter-spacing-1"
                                            type="button" data-bs-toggle="collapse" data-bs-target="#flush-@group.SessionId">
                                        <i class="fa-solid fa-clock-rotate-left me-2"></i> Історія транзакцій
                                    </button>
                                </h2>
                                <div id="flush-@group.SessionId" class="accordion-collapse collapse" data-bs-parent="#accordion-@group.SessionId">
                                    <div class="accordion-body pt-0 pb-3">
                                        @foreach (var trans in group.Transactions)
                                        {
                                            <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="icon-badge" style="width:32px; height:32px; font-size: 0.8rem;">
                                                        <i class="fa-regular fa-calendar-check text-success"></i>
                                                    </div>
                                                    <div>
                                                        <div class="small fw-bold text-dark">@trans.BookedAt.ToLocalTime().ToString("d MMMM yyyy", ukCulture)</div>
                                                        <div class="x-small text-muted">@trans.BookedAt.ToLocalTime().ToString("HH:mm", ukCulture)</div>
                                                    </div>
                                                </div>

                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="fw-bold text-dark">@trans.TotalAmount.ToString("N0") ₴</div>
                                                    <form asp-controller="Booking" asp-action="Cancel" asp-route-id="@trans.BookingId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger-second btn-sm fw-bold px-3 py-1"
                                                                onclick="return confirm('Скасувати ці квитки? Кошти будуть повернуті.');">
                                                            <i class="fa-solid fa-arrow-rotate-left me-1"></i> Повернути
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<partial name="~/Views/Bookings/_QrModal.cshtml" />