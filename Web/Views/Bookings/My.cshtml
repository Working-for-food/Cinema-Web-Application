@model Web.ViewModels.Bookings.MyBookingsVm

@{
    ViewData["Title"] = "Мої бронювання";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Мої бронювання</h1>
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">На головну</a>
</div>

@if (Model.Items == null || Model.Items.Count == 0)
{
    <div class="alert alert-info">
        Поки що у вас немає бронювань.
    </div>
}
else
{
    <div class="list-group">
        @foreach (var b in Model.Items.OrderByDescending(x => x.BookingId))
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">@b.MovieTitle</div>
                    <div class="text-muted small">@b.StartTime.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                <div class="text-end">
                    <div class="fw-semibold">@b.TotalAmount.ToString("0.00")</div>
                    @if (b.IsCancelled)
                    {
                        <span class="badge bg-secondary">Скасовано</span>
                    }
                </div>
            </div>
        }
    </div>
}
