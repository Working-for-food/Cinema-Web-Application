@model Web.ViewModels.Account.ProfileVm
@{
    ViewData["Title"] = "Кабінет Адміністратора";
}

<div class="auth-container d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="container" style="max-width: 1140px;">

        <div class="text-center mb-5">
            <div class="d-flex justify-content-center align-items-center mb-3 gap-3">
                <div class="icon-3d-box">
                    <i class="fas fa-user-shield"></i>
                </div>

                <div class="admin-badge-container">
                    <div class="admin-badge-glow"></div>
                    <span class="admin-badge-content">
                        <i class="fas fa-crown text-warning me-2"></i> ADMINISTRATOR
                    </span>
                </div>
            </div>
            <h1 class="page-heading mb-1">Кабінет Адміністратора</h1>
            <p class="text-muted fw-medium x-small">Панель керування та персональні налаштування</p>
            <div class="heading-underline mx-auto"></div>
        </div>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-success d-flex align-items-center shadow-sm border-0 mb-4 mx-auto" role="alert"
                 style="background: rgba(220, 252, 231, 0.9); color: #166534; border-radius: 12px; max-width: 800px;">
                <i class="fas fa-check-circle me-3 fa-lg"></i>
                <div class="flex-grow-1 fw-medium">
                    @Model.StatusMessage
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-4">

            <div class="col-lg-7">
                <div class="auth-card p-4 h-100">
                    <h5 class="fw-bold mb-4 text-brand">
                        <i class="fas fa-id-card me-2"></i> Персональні дані
                    </h5>

                    <form asp-action="UpdateProfile" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 pill pill-warning w-100 justify-content-center text-center fw-bold x-small"></div>

                        <div class="mb-3">
                            <label class="form-label ms-1">Логін</label>
                            <div class="input-group input-group-modern" style="background-color: rgba(241, 245, 249, 0.5);">
                                <span class="input-group-text icon-box">
                                    <i class="fas fa-user"></i>
                                </span>
                                <input class="form-control text-muted" value="@Model.Username" disabled readonly />
                                <span class="input-group-text icon-box text-muted">
                                    <i class="fas fa-lock small"></i>
                                </span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label ms-1">Email</label>
                            <div class="input-group input-group-modern" style="background-color: rgba(241, 245, 249, 0.5);">
                                <span class="input-group-text icon-box">
                                    <i class="fas fa-envelope"></i>
                                </span>
                                <input asp-for="Email" class="form-control text-muted" disabled readonly />
                                @if (Model.IsEmailConfirmed)
                                {
                                    <span class="input-group-text icon-box text-success" title="Підтверджено">
                                        <i class="fas fa-check-circle"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="input-group-text icon-box text-warning" title="Не підтверджено">
                                        <i class="fas fa-exclamation-triangle"></i>
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="PhoneNumber" class="form-label ms-1">Телефон</label>
                                <div class="input-group input-group-modern">
                                    <span class="input-group-text icon-box">
                                        <i class="fas fa-phone"></i>
                                    </span>
                                    <input asp-for="PhoneNumber"
                                           class="form-control"
                                           placeholder="+380..."
                                           type="tel"
                                           id="PhoneNumber"
                                           maxlength="13" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger x-small mt-1 ms-1 d-block fw-bold"></span>
                                <div id="phone-warn" class="x-small ms-1 mt-1 fw-bold text-warning" style="min-height: 18px;"></div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label ms-1">Дата народження</label>
                                <div class="input-group input-group-modern">
                                    <span class="input-group-text icon-box">
                                        <i class="fas fa-calendar-alt"></i>
                                    </span>
                                    <input asp-for="DateOfBirth" type="text" class="form-control js-flatpickr" id="DateOfBirth" placeholder="Оберіть дату" />
                                </div>
                                <span asp-validation-for="DateOfBirth" class="custom-warning x-small mt-1 ms-1 d-block fw-bold" data-valmsg-for="DateOfBirth"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-2">
                            <button type="submit" class="btn btn-qr-prominent flex-grow-1 fw-bold shadow-sm">
                                <i class="fas fa-save me-2"></i> ЗБЕРЕГТИ
                            </button>
                            <a asp-action="ChangePassword" class="btn btn-glass px-4" title="Змінити пароль">
                                <i class="fas fa-key"></i>
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="auth-card p-4 h-100 d-flex flex-column">
                    <h5 class="fw-bold mb-4 text-brand">
                        <i class="fas fa-cogs me-2"></i> Панель керування
                    </h5>

                    <div class="d-flex flex-column gap-3 flex-grow-1">
                        <a asp-area="Admin" asp-controller="Movies" asp-action="Index" class="btn-admin-nav">
                            <div class="icon-wrapper"><i class="fas fa-film"></i></div>
                            <div class="text-wrapper">
                                <span class="title">Фільми</span>
                                <span class="subtitle">Керування контентом</span>
                            </div>
                            <i class="fas fa-chevron-right arrow"></i>
                        </a>

                        <a asp-area="Admin" asp-controller="Cinemas" asp-action="Index" class="btn-admin-nav">
                            <div class="icon-wrapper"><i class="fas fa-building"></i></div>
                            <div class="text-wrapper">
                                <span class="title">Кінотеатри</span>
                                <span class="subtitle">Локації та зали</span>
                            </div>
                            <i class="fas fa-chevron-right arrow"></i>
                        </a>

                        <div class="my-1 border-top border-light opacity-50"></div>

                        <a asp-area="Admin" asp-controller="Roles" asp-action="UserList" class="btn-admin-nav">
                            <div class="icon-wrapper"><i class="fas fa-users"></i></div>
                            <div class="text-wrapper">
                                <span class="title">Користувачі</span>
                                <span class="subtitle">Права доступу</span>
                            </div>
                            <i class="fas fa-chevron-right arrow"></i>
                        </a>

                        <a asp-area="Admin" asp-controller="Roles" asp-action="Index" class="btn-admin-nav">
                            <div class="icon-wrapper"><i class="fas fa-user-tag"></i></div>
                            <div class="text-wrapper">
                                <span class="title">Ролі</span>
                                <span class="subtitle">Налаштування груп</span>
                            </div>
                            <i class="fas fa-chevron-right arrow"></i>
                        </a>
                    </div>

                    <div class="mt-4 pt-3 border-top border-light">
                        <form asp-controller="Account" asp-action="ToggleAdminMode" method="post">
                            <button type="submit" class="btn btn-glass w-100 justify-content-center text-muted fw-bold small">
                                <i class="fas fa-glasses me-2"></i> Вигляд Користувача
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="\css\auth.css">

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $(".js-flatpickr").flatpickr({
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d.m.Y",
                monthSelectorType: "dropdown",
                disableMobile: "true",
                locale: { firstDayOfWeek: 1 },

                onReady: function(selectedDates, dateStr, instance) {
                    const yearInput = instance.currentYearElement;
                    if (yearInput) {
                        yearInput.setAttribute("type", "number");
                        yearInput.addEventListener("click", function() { this.select(); });
                    }
                },
                onChange: function(selectedDates, dateStr, instance) {
                    validateAge();
                }
            });

            const dobInput = $('#DateOfBirth');
            const dobErrorSpan = $('span[data-valmsg-for="DateOfBirth"]');

            function validateAge() {
                const dobValue = dobInput.val();
                if (!dobValue) {
                    dobErrorSpan.text("");
                    return;
                }

                const birthDate = new Date(dobValue);
                const today = new Date();

                if (birthDate > today) {
                    dobErrorSpan.text("Дата не може бути в майбутньому.");
                    dobErrorSpan.removeClass("text-danger field-validation-error").addClass("custom-warning");
                    return;
                }

                let age = today.getFullYear() - birthDate.getFullYear();
                const m = today.getMonth() - birthDate.getMonth();
                if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }

                if (age < 12) {
                    dobErrorSpan.text("Користувач має бути старше 12 років.");
                    dobErrorSpan.removeClass("text-danger field-validation-error").addClass("custom-warning");
                } else if (age > 100) {
                    dobErrorSpan.text("Введіть коректну дату (до 100 років).");
                    dobErrorSpan.removeClass("text-danger field-validation-error").addClass("custom-warning");
                } else {
                    dobErrorSpan.text("");
                    dobErrorSpan.removeClass("custom-warning").addClass("field-validation-valid");
                }
            }

            dobInput.on('change blur input', validateAge);

            const phoneInput = $('#PhoneNumber');
            const phoneWarn = $('#phone-warn');

            phoneInput.on('focus click', function () {
                if ($(this).val().length === 0) $(this).val('+380');
            });

            phoneInput.on('input', function (e) {
                let val = $(this).val();
                let cleanVal = val.replace(/[^\d+]/g, '');

                if (!cleanVal.startsWith('+380')) {
                    cleanVal = '+380' + cleanVal.replace(/^\+?3?8?0?/, '');
                }
                if (cleanVal.length > 13) cleanVal = cleanVal.substring(0, 13);

                if (val !== cleanVal && val.length > cleanVal.length) {
                     phoneWarn.html('<i class="fas fa-exclamation-triangle me-1"></i> Тільки цифри!');
                } else {
                     phoneWarn.empty();
                }
                $(this).val(cleanVal);
            });

            phoneInput.on('blur', function () {
                if ($(this).val() === '+380') {
                    $(this).val('');
                    phoneWarn.empty();
                }
            });
        });
    </script>
}