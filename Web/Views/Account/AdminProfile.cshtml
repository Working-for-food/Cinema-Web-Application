@model Web.ViewModels.Account.ProfileVm
@{
    ViewData["Title"] = "Кабінет Адміністратора";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2" style="color: #800000;">
                <i class="fas fa-user-shield"></i> Кабінет Адміністратора
            </h1>
            <p class="text-muted">Панель керування та персональні налаштування</p>
        </div>
        <div>
            <span class="badge p-2 fs-6 shadow-sm" style="background-color: #800000;">Права адміністратора</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-7 mb-4">
            <div class="card shadow-lg border-0 h-100 rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0" style="color: #800000;"><i class="fas fa-id-card"></i> Мої дані</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="UpdateProfile" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label text-muted">Логін</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-user"></i></span>
                                <input class="form-control" value="@Model.Username" disabled readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control" disabled />
                                @if (Model.IsEmailConfirmed)
                                {
                                    <span class="input-group-text text-success" title="Підтверджено"><i class="fas fa-check-circle"></i></span>
                                }
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label text-muted">Телефон</label>
                                <input asp-for="PhoneNumber" class="form-control auth-input" placeholder="+380..." />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted">Дата народження</label>
                                <input type="date" class="form-control auth-input" asp-for="DateOfBirth"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <button type="submit" class="btn px-4 py-2" style="background-color: #800000; color: white;">
                                <i class="fas fa-save"></i> Зберегти
                            </button>

                            <a asp-action="ChangePassword" class="btn btn-outline-dark">
                                <i class="fas fa-key"></i> Пароль
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5 mb-4">
            <div class="card shadow-lg border-0 h-100 rounded-3">
                <div class="card-header py-3 text-white" style="background-color: #800000;">
                    <h5 class="mb-0"><i class="fas fa-cogs"></i> Панель керування</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-4">Оберіть розділ для адміністрування:</p>

                    <div class="d-grid gap-3">
                        <a asp-area="Admin" asp-controller="Movies" asp-action="Index" class="btn btn-outline-dark text-start p-3 shadow-sm position-relative admin-btn">
                            <i class="fas fa-film fa-lg me-3" style="color: #800000;"></i>
                            <strong>Фільми</strong>
                            <i class="fas fa-chevron-right position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
                        </a>

                        <a asp-area="Admin" asp-controller="Cinemas" asp-action="Index" class="btn btn-outline-dark text-start p-3 shadow-sm position-relative admin-btn">
                            <i class="fas fa-building fa-lg me-3" style="color: #800000;"></i>
                            <strong>Кінотеатри</strong>
                            <i class="fas fa-chevron-right position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
                        </a>

                        <hr class="text-muted my-2">

                        <a asp-area="Admin" asp-controller="Roles" asp-action="UserList" class="btn btn-outline-dark text-start p-3 shadow-sm position-relative admin-btn">
                            <i class="fas fa-users fa-lg me-3" style="color: #800000;"></i>
                            <strong>Користувачі</strong>
                            <small class="d-block text-muted ms-5">Список та права доступу</small>
                            <i class="fas fa-chevron-right position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
                        </a>

                        <a asp-area="Admin" asp-controller="Roles" asp-action="Index" class="btn btn-outline-dark text-start p-3 shadow-sm position-relative admin-btn">
                            <i class="fas fa-user-tag fa-lg me-3" style="color: #800000;"></i>
                            <strong>Ролі</strong>
                            <small class="d-block text-muted ms-5">Створення та видалення груп</small>
                            <i class="fas fa-chevron-right position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
                        </a>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <div class="bg-light p-3 rounded border">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="text-muted mb-0"><i class="fas fa-glasses"></i> Режим перегляду</h6>
                            </div>
                            <form asp-controller="Account" asp-action="ToggleAdminMode" method="post">
                                <button type="submit" class="btn btn-sm w-100 btn-secondary">
                                    Переключитись на вигляд Користувача
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}