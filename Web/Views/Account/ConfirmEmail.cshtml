@{
    ViewData["Title"] = "Пошту підтверджено";
}

<div class="container mt-5 text-center">
    <div class="card p-5 shadow-sm border-success" style="border-width: 2px;">
        <div class="mb-4">
            <i class="fas fa-check-circle fa-4x text-success"></i>
        </div>
        <h2 class="text-success">Успіх!</h2>
        <p class="lead">
            Вашу електронну пошту успішно підтверджено.
        </p>
        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5">Увійти</a>
        </div>
    </div>
</div>