@model Web.ViewModels.Account.ProfileVm
@{
    ViewData["Title"] = "Мій Профіль";
}

<div class="auth-container d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="auth-card p-5 shadow-lg rounded">

            <div class="text-center mb-4">
                <h1 class="section-title"><i class="fas fa-id-card"></i> Мій Профіль</h1>
                <p class="text-muted">Керування обліковим записом</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Model.StatusMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="UpdateProfile" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Логін</label>
                        <input class="form-control" value="@Model.Username" disabled readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Ваші Ролі</label>
                        <div class="d-flex gap-1 flex-wrap">
                            @foreach (var role in Model.Roles)
                            {
                                <span class="badge bg-secondary">@role</span>
                            }
                            @if (!Model.Roles.Any())
                            {
                                <span class="text-muted small">Немає ролей</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted">Електронна пошта</label>
                    <div class="input-group">
                        <input asp-for="Email" class="form-control auth-input" disabled />
                        @if (Model.IsEmailConfirmed)
                        {
                            <span class="input-group-text text-success" title="Email Confirmed"><i class="fas fa-check-circle"></i></span>
                        }
                        else
                        {
                            <span class="input-group-text text-warning" title="Unconfirmed"><i class="fas fa-exclamation-triangle"></i></span>
                        }
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted">Номер телефону</label>
                    <input asp-for="PhoneNumber" class="form-control auth-input" placeholder="Введіть номер телефону" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted">Дата народження</label>
                    <input type="date" class="form-control auth-input" asp-for="DateOfBirth"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-maroon" style="background-color: #800000; color: white;">
                        <i class="fas fa-save"></i> Зберегти зміни
                    </button>
                </div>
            </form>

            <hr class="my-4" />

            <h5 class="text-muted mb-3"><i class="fas fa-shield-alt"></i> Безпека</h5>

            <div class="d-flex justify-content-between align-items-center mb-3 border p-3 rounded">
                <div>
                    <strong>Двоетапна перевірка (2FA)</strong>
                    <div class="small text-muted">
                        @if (Model.TwoFactorEnabled)
                        {
                            <span class="text-success">Увімкнено</span>
                        }
                        else
                        {
                            <span class="text-secondary">Вимкнено</span>
                        }
                    </div>
                </div>
                <form asp-action="Toggle2FA" method="post" class="m-0">
                    @if (Model.TwoFactorEnabled)
                    {
                        <button type="submit" class="btn btn-outline-danger btn-sm">Вимкнути</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-outline-success btn-sm">Увімкнути</button>
                    }
                </form>
            </div>

            <div class="text-center">
                <a href="#" class="text-muted small text-decoration-underline">Змінити пароль</a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}