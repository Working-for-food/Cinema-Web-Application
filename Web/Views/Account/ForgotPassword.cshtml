@model Web.ViewModels.Account.ForgotPasswordVm

<div class="auth-container d-flex align-items-center justify-content-center min-vh-100">
    <div class="col-12 col-md-6 col-lg-4 px-3">
        <div class="auth-card p-4 shadow-lg">
            <div class="text-center mb-4">
                <div class="icon-3d-box mx-auto mb-3">
                    <i class="fas fa-user-lock"></i>
                </div>
                <h1 class="page-heading mb-1">Відновлення</h1>
                <p class="text-muted fw-medium x-small">Введіть ваш логін для отримання посилання</p>
                <div class="heading-underline mx-auto"></div>
            </div>

            <div class="validation-summary-container">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            </div>

            <form asp-action="ForgotPassword" method="post">
                <div class="mb-4">
                    <label asp-for="Username" class="form-label ms-1">Логін (Username)</label>
                    <div class="input-group input-group-modern">
                        <span class="input-group-text icon-box">
                            <i class="fas fa-user"></i>
                        </span>
                        <input asp-for="Username" class="form-control" placeholder="Введіть ваш логін" id="Username" autocomplete="off" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger x-small mt-1 ms-1 d-block fw-bold"></span>

                    <div id="username-warn" class="x-small ms-1 mt-1 fw-bold text-warning" style="min-height: 18px;"></div>
                </div>

                <button type="submit" class="btn btn-qr-prominent w-100 justify-content-center fw-bold shadow-sm mb-3">
                    ВІДПРАВИТИ ІНСТРУКЦІЇ
                </button>

                <div class="text-center">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-action="Profile" class="text-brand fw-bold text-decoration-none x-small transition-hover">
                            <i class="fas fa-arrow-left me-1"></i> Повернутися до профілю
                        </a>
                    }
                    else
                    {
                        <a asp-action="Login" class="text-brand fw-bold text-decoration-none x-small transition-hover">
                            <i class="fas fa-arrow-left me-1"></i> Назад до входу
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('#Username').on('keyup input', function () {
                const val = $(this).val();
                const warnSelector = $('#username-warn');

                if (/[^\x00-\x7F]/.test(val)) {
                    warnSelector.html('<i class="fas fa-exclamation-triangle me-1"></i> Змініть розкладку на англійську!');
                } else {
                    warnSelector.empty();
                }
            });

            $('#Username').on('input', function() {
                if ($('.validation-summary-errors').is(':visible')) {
                    $('.validation-summary-errors').fadeOut(200);
                }
            });
        });
    </script>
}