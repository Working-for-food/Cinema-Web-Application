@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('.toggle-password').on('click', function (e) {
                e.preventDefault();
                const container = $(this).closest('.input-group-modern');
                const input = container.find('input');
                const icon = $(this).find('i');

                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            function checkLanguage(inputSelector, warnSelector) {
                $(inputSelector).on('keyup input', function () {
                    const val = $(this).val();

                    if (/[^\x00-\x7F]/.test(val)) {
                        $(warnSelector).html('<i class="fas fa-exclamation-triangle me-1"></i> Змініть розкладку на англійську!');
                    } else {
                        $(warnSelector).empty();
                    }
                });
            }

            checkLanguage('#Username', '#username-warn');
            checkLanguage('#Password', '#password-warn');
        });
    </script>
}