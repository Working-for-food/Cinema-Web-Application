@model Web.ViewModels.Account.LoginVm
@{
    ViewData["Title"] = "Вхід";
}

<div class="auth-container d-flex align-items-center justify-content-center min-vh-100">
    <div class="col-12 col-md-6 col-lg-4">
        <div class="auth-card p-5 shadow-lg rounded">
            <h1 class="section-title text-center mb-4">
                <i class="fas fa-right-to-bracket"></i> Вхід
            </h1>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-action="Login" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]">

                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-4">
                    <label class="form-label text-muted">Ім'я користувача</label>
                    <input asp-for="Username" class="form-control auth-input" placeholder="Введіть логін" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted">Пароль</label>
                    <div class="input-group">
                        <input asp-for="Password" class="form-control auth-input" placeholder="Введіть пароль" type="password" />
                        <button class="btn btn-outline-secondary toggle-password" type="button">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-4 form-check">
                    <input class="form-check-input" asp-for="RememberMe" />
                    <label class="form-check-label text-muted" asp-for="RememberMe">
                        Запам'ятати мене
                    </label>
                </div>

                <div class="mb-4 text-center">
                    <button type="submit" class="btn btn-maroon w-100" style="background-color: #800000; color: white;">
                        Увійти
                    </button>
                </div>
            </form>

            <p class="text-center text-muted mt-3">
                Ще не маєте акаунту? <a asp-action="Register" class="text-maroon">Зареєструватися</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('.toggle-password').on('click', function () {
                const input = $(this).closest('.input-group').find('input');
                const icon = $(this).find('i');

                if (input.attr('type') === 'password') {
                    input.attr('type', 'text'); 
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    input.attr('type', 'password'); 
                    icon.removeClass('fa-eye-slash').addClass('fa-eye'); 
                }
            });
        });
    </script>
}