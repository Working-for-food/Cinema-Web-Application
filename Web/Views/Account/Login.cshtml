@model Web.ViewModels.Account.LoginVm
@{
    ViewData["Title"] = "Вхід";
}

<link rel="stylesheet" href="\css\auth.css">

<div class="auth-container d-flex align-items-center justify-content-center min-vh-100">
    <div class="col-12 col-md-6 col-lg-4 px-3">
        <div class="auth-card p-4">

            <div class="text-center mb-4">
                <div class="d-flex justify-content-center mb-3">
                    <div class="icon-3d-box">
                        <i class="fas fa-right-to-bracket"></i>
                    </div>
                </div>
                <h1 class="page-heading mb-1">Вхід</h1>
                <p class="text-muted fw-medium x-small">Ласкаво просимо до нашого кінотеатру!</p>
                <div class="heading-underline mx-auto"></div>
            </div>

            <div class="validation-summary-container">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            </div>

            <form asp-action="Login" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]">
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="Username" class="form-label ms-1">Ім'я користувача</label>
                    <div class="input-group input-group-modern">
                        <span class="input-group-text icon-box">
                            <i class="fas fa-user"></i>
                        </span>
                        <input asp-for="Username" class="form-control" placeholder="Введіть логін" id="Username" autocomplete="off" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger x-small mt-1 ms-1 d-block fw-bold"></span>
                    <div id="username-warn" class="x-small ms-1 mt-1 fw-bold text-warning" style="min-height: 18px;"></div>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label ms-1">Пароль</label>
                    <div class="input-group input-group-modern">
                        <span class="input-group-text icon-box">
                            <i class="fas fa-key"></i>
                        </span>
                        <input asp-for="Password" class="form-control" placeholder="Введіть пароль" type="password" id="Password" />
                        <button class="btn btn-icon-end toggle-password" type="button" tabindex="-1">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger x-small mt-1 ms-1 d-block fw-bold" id="password-validation-msg"></span>
                    <div id="password-warn" class="x-small ms-1 mt-1 fw-bold text-warning" style="min-height: 18px;"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                    <div class="form-check">
                        <input class="form-check-input cursor-pointer" type="checkbox" asp-for="RememberMe">
                        <label class="form-check-label text-muted cursor-pointer x-small fw-bold" asp-for="RememberMe" style="padding-top: 2px;">
                            Запам'ятати
                        </label>
                    </div>
                    <a href="ForgotPassword" class="x-small text-brand fw-bold text-decoration-none">Забули пароль?</a>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-qr-prominent w-100 justify-content-center fw-bold shadow-sm">
                        УВІЙТИ
                    </button>
                </div>
            </form>

