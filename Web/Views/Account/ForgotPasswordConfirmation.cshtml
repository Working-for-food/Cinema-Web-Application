@model string
@{
    ViewData["Title"] = "Лист надіслано";
}

<div class="auth-container d-flex align-items-center justify-content-center min-vh-100">
    <div class="auth-card p-5 text-center" style="max-width: 480px;">
        <div class="icon-3d-box mx-auto mb-4">
            <i class="fas fa-envelope-open-text"></i>
        </div>
        <h2 class="page-heading">Лист надіслано!</h2>
        <div class="heading-underline mx-auto mb-4"></div>

        <div class="alert alert-info py-3 border-0 shadow-sm" style="background: rgba(239, 246, 255, 0.8); border-radius: 15px;">
            <p class="text-muted small mb-1">Ми надіслали інструкції на адресу:</p>
            <strong class="text-brand" style="letter-spacing: 1px;">@Model</strong>
        </div>

        <p class="text-muted x-small mt-3">
            Якщо ви не отримали лист протягом 5 хвилин, перевірте папку <b>Спам</b>.
        </p>

        <a asp-action="Login" class="btn btn-qr-prominent w-100 justify-content-center mt-4">ПОВЕРНУТИСЬ</a>
    </div>
</div>