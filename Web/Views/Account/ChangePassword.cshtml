@model Web.ViewModels.Account.ChangePasswordVm
@{
    ViewData["Title"] = "Зміна пароля";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white text-center py-3">
                    <h4 class="mb-0"><i class="fas fa-key text-warning"></i> Зміна пароля</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label text-muted"></label>
                            <div class="input-group">
                                <input asp-for="CurrentPassword" class="form-control" placeholder="Введіть старий пароль" />
                                <button class="btn btn-outline-secondary toggle-password" type="button">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label text-muted"></label>
                            <div class="input-group">
                                <input asp-for="NewPassword" class="form-control" placeholder="Введіть новий пароль" />
                                <button class="btn btn-outline-secondary toggle-password" type="button">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label text-muted"></label>
                            <div class="input-group">
                                <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Повторіть новий пароль" />
                                <button class="btn btn-outline-secondary toggle-password" type="button">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Змінити пароль</button>
                            <a asp-action="Profile" class="btn btn-outline-secondary">Скасувати</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('.toggle-password').on('click', function () {
                const input = $(this).closest('.input-group').find('input');
                const icon = $(this).find('i');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            const currentPassInput = $('#CurrentPassword');
            const newPassInput = $('#NewPassword');
            const errorSpan = $('span[data-valmsg-for="NewPassword"]'); 
            const submitButton = $('button[type="submit"]');

            function checkPasswords() {
                const currentVal = currentPassInput.val();
                const newVal = newPassInput.val();

                if (currentVal && newVal && currentVal === newVal) {
                    errorSpan.text("Новий пароль не може бути таким самим, як старий.");
                    errorSpan.addClass("field-validation-error").removeClass("field-validation-valid");
                    newPassInput.addClass("input-validation-error");

                    submitButton.prop('disabled', true);
                } else {
                    if (errorSpan.text() === "Новий пароль не може бути таким самим, як старий.") {
                        errorSpan.text("");
                        errorSpan.removeClass("field-validation-error").addClass("field-validation-valid");
                        newPassInput.removeClass("input-validation-error");
                    }
                    submitButton.prop('disabled', false);
                }
            }

            newPassInput.on('keyup blur', checkPasswords);
            currentPassInput.on('keyup blur', checkPasswords);
        });
    </script>
}