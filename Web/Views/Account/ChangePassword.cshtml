@model Web.ViewModels.Account.ChangePasswordVm
@{
    ViewData["Title"] = "Зміна пароля";
}

<div class="auth-container d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="auth-card p-5">

            <div class="text-center mb-5">
                <div class="d-flex justify-content-center mb-3">
                    <div class="icon-3d-box">
                        <i class="fas fa-key"></i>
                    </div>
                </div>
                <h1 class="page-heading mb-1">Зміна пароля</h1>
                <p class="text-muted fw-medium x-small">Оновіть свої дані для входу</p>
                <div class="heading-underline mx-auto"></div>
            </div>

            <form asp-action="ChangePassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 pill pill-warning w-100 justify-content-center text-center fw-bold x-small"></div>

                <div class="mb-3 position-relative">
                    <label asp-for="CurrentPassword" class="form-label ms-1">Поточний пароль</label>
                    <div class="input-group input-group-modern">
                        <span class="input-group-text icon-box">
                            <i class="fas fa-shield-alt"></i>
                        </span>
                        <input asp-for="CurrentPassword" class="form-control" type="password" placeholder="Введіть старий пароль" id="CurrentPassword" />
                        <button class="btn btn-icon-end toggle-password" type="button" tabindex="-1">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="CurrentPassword" class="text-danger x-small mt-1 ms-1 d-block fw-bold" id="current-pass-error"></span>

                    <div class="mt-1 text-end">
                        <a asp-action="ForgotPassword" class="x-small fw-bold text-brand text-decoration-none">
                            Не пам'ятаєте пароль?
                        </a>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label ms-1">Новий пароль</label>
                    <div class="input-group input-group-modern">
                        <span class="input-group-text icon-box">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input asp-for="NewPassword" class="form-control" type="password" placeholder="Введіть новий пароль" id="NewPassword" />
                        <button class="btn btn-icon-end toggle-password" type="button" tabindex="-1">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger x-small mt-1 ms-1 d-block fw-bold" data-valmsg-for="NewPassword"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label ms-1">Підтвердження</label>
                    <div class="input-group input-group-modern">
                        <span class="input-group-text icon-box">
                            <i class="fas fa-check-double"></i>
                        </span>
                        <input asp-for="ConfirmNewPassword" class="form-control" type="password" placeholder="Повторіть новий пароль" />
                        <button class="btn btn-icon-end toggle-password" type="button" tabindex="-1">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger x-small mt-1 ms-1 d-block fw-bold"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" id="submitBtn" class="btn btn-qr-prominent w-100 justify-content-center fw-bold shadow-sm p-3">
                        ЗМІНИТИ ПАРОЛЬ
                    </button>
                </div>

                <div class="text-center">
                    <a asp-action="Profile" class="text-muted fw-bold text-decoration-none x-small transition-hover">
                        <i class="fas fa-arrow-left me-1"></i> Повернутися до профілю
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="\css\auth.css">

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('.toggle-password').on('click', function () {
                const input = $(this).siblings('input');
                const icon = $(this).find('i');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                    icon.addClass('text-brand');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                    icon.removeClass('text-brand');
                }
            });

            const currentPassInput = $('#CurrentPassword');
            const currentPassError = $('#current-pass-error');
            const newPassInput = $('#NewPassword');
            const newPassError = $('span[data-valmsg-for="NewPassword"]');
            const submitBtn = $('#submitBtn');

            currentPassInput.on('blur', function () {
                const password = $(this).val();

                if (password.length === 0) return;

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("CheckCurrentPassword", "Account")',
                    data: { password: password },
                    success: function (isCorrect) {
                        if (isCorrect === false) {
                            currentPassError.text("Старий пароль введено невірно.");
                            currentPassInput.addClass("is-invalid").removeClass("is-valid");

                            submitBtn.prop('disabled', true).addClass('opacity-50');
                        } else {
                            currentPassError.text("");
                            currentPassInput.removeClass("is-invalid").addClass("is-valid");

                            submitBtn.prop('disabled', false).removeClass('opacity-50');
                            checkNewSameAsOld();
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Помилка AJAX: " + error);
                    }
                });
            });


            function checkNewSameAsOld() {
                const currentVal = currentPassInput.val();
                const newVal = newPassInput.val();

                if (currentVal && newVal && currentVal === newVal) {
                    newPassError.text("Новий пароль не може бути таким самим, як старий.");
                    newPassError.removeClass("field-validation-valid").addClass("field-validation-error");
                    submitBtn.prop('disabled', true).addClass('opacity-50');
                } else {
                    if (newPassError.text() === "Новий пароль не може бути таким самим, як старий.") {
                        newPassError.text("");
                        newPassError.removeClass("field-validation-error").addClass("field-validation-valid");
                        submitBtn.prop('disabled', false).removeClass('opacity-50');
                    }
                }
            }

            newPassInput.on('keyup blur', checkNewSameAsOld);

            currentPassInput.on('input', function() {
                currentPassError.text("");
                $(this).removeClass("is-invalid is-valid");
                submitBtn.prop('disabled', false).removeClass('opacity-50');
            });
        });
    </script>
}