@model Web.ViewModels.Account.ResetPasswordVm
@{
    ViewData["Title"] = "Новий пароль";
}

<link rel="stylesheet" href="\css\auth.css">


<div class="auth-container d-flex align-items-center justify-content-center min-vh-100">
    <div class="col-12 col-md-6 col-lg-5 px-3">
        <div class="auth-card p-4">

            <div class="text-center mb-4">
                <div class="d-flex justify-content-center mb-3">
                    <div class="icon-3d-box">
                        <i class="fas fa-user-shield"></i>
                    </div>
                </div>
                <h1 class="page-heading mb-1">Новий пароль</h1>
                <p class="text-muted fw-medium x-small">Встановіть надійний пароль</p>
                <div class="heading-underline mx-auto"></div>
            </div>

            <div class="validation-summary-container">
                <div asp-validation-summary="ModelOnly" id="global-validation-summary" class="validation-summary-errors"></div>
            </div>

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Code" />

                <div class="mb-3">
                    <label class="form-label ms-1">Новий пароль</label>
                    <div class="input-group input-group-modern">
                        <span class="input-group-text icon-box"><i class="fas fa-key"></i></span>
                        <input asp-for="Password" class="form-control auth-trigger" placeholder="Введіть новий пароль" type="password" id="Password" />
                        <button class="btn btn-icon-end toggle-password" type="button" tabindex="-1"><i class="fas fa-eye"></i></button>
                    </div>
                    <span asp-validation-for="Password" class="custom-warning x-small mt-1 ms-1 d-block fw-bold"></span>
                    <div class="text-muted x-small ms-1 mt-1 lh-sm">
                        <i class="fas fa-info-circle me-1"></i> Вимоги: 8+ символів, 1 велика, 1 цифра.
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label ms-1">Підтвердження пароля</label>
                    <div class="input-group input-group-modern">
                        <span class="input-group-text icon-box"><i class="fas fa-lock"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Повторіть пароль" type="password" />
                        <button class="btn btn-icon-end toggle-password" type="button" tabindex="-1"><i class="fas fa-eye"></i></button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="custom-warning x-small mt-1 ms-1 d-block fw-bold"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-qr-prominent w-100 justify-content-center fw-bold shadow-sm">
                        СИНХРОНІЗУВАТИ ПАРОЛЬ
                    </button>
                </div>
            </form>

            <div class="text-center mt-3">
                <a asp-action="Login" class="text-brand fw-bold text-decoration-none x-small">
                    <i class="fas fa-arrow-left me-1"></i> Повернутися до входу
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('.toggle-password').on('click', function (e) {
                e.preventDefault();
                const container = $(this).closest('.input-group-modern');
                const input = container.find('input');
                const icon = $(this).find('i');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            $('.auth-trigger, #ConfirmPassword').on('input', function() { 
                const summary = $('#global-validation-summary');
                if (summary.is(':visible')) {
                    summary.fadeOut(200);
                }
            });

            const passwordInput = $('#Password');
            const passwordErrorSpan = $('span[data-valmsg-for="Password"]');

            function validatePassword() {
                const password = passwordInput.val();
                let errors = [];
                if (!password) return;

                if (/[^\x00-\x7F]/.test(password)) errors.push("тільки англійські літери");
                if (password.length < 8) errors.push("мінімум 8 символів");
                if (!/[A-Z]/.test(password)) errors.push("1 велику літеру");
                if (!/[0-9]/.test(password)) errors.push("1 цифру");

                if (errors.length > 0) {
                    passwordErrorSpan.text("Вимоги: " + errors.join(", ") + ".");
                    passwordErrorSpan.removeClass("text-danger field-validation-error").addClass("custom-warning");
                } else {
                    passwordErrorSpan.text("");
                    passwordErrorSpan.removeClass("custom-warning").addClass("field-validation-valid");
                }
            }
            passwordInput.on('blur keyup', function () { if($(this).val().length > 0) validatePassword(); });
        });
    </script>
}