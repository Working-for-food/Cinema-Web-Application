@using Application.DTOs
@model Web.ViewModels.Admin.Sessions.SessionsIndexVm

@{
    ViewData["Title"] = "Сеанси (адмін)";
    string FormatDate(DateTime? dt) => dt?.ToString("yyyy-MM-dd") ?? "";

    var now = DateTime.Now;
    var today = DateTime.Today;

    var weekStart = today.AddDays(-((int)today.DayOfWeek == 0 ? 6 : (int)today.DayOfWeek - 1));
    var weekEnd = weekStart.AddDays(6);

    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    string PosterUrl(string? posterPath)
    {
        if (string.IsNullOrWhiteSpace(posterPath)) return "";
        if (posterPath.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return posterPath;
        return $"https://image.tmdb.org/t/p/w92{posterPath}";
    }

    IDictionary<string, string> RouteWithDates(DateTime from, DateTime to)
    {
        var dict = new Dictionary<string, string>
        {
            ["From"] = from.ToString("yyyy-MM-dd"),
            ["To"] = to.ToString("yyyy-MM-dd"),
            ["IncludeCancelled"] = Model.IncludeCancelled.ToString().ToLowerInvariant(),
            ["IncludeFinished"] = Model.IncludeFinished.ToString().ToLowerInvariant(),
            ["Page"] = "1"
        };

        if (Model.CinemaId.HasValue)
            dict["CinemaId"] = Model.CinemaId.Value.ToString();

        if (Model.HallId.HasValue)
            dict["HallId"] = Model.HallId.Value.ToString();

        if (Model.MovieId.HasValue)
            dict["MovieId"] = Model.MovieId.Value.ToString();

        if (!string.IsNullOrWhiteSpace(Model.MovieTitle))
            dict["MovieTitle"] = Model.MovieTitle!;

        if (!string.IsNullOrWhiteSpace(Model.Sort))
            dict["Sort"] = Model.Sort!;

        return dict;
    }

    IDictionary<string, string> RouteForPage(int page)
    {
        var dict = new Dictionary<string, string>
        {
            ["Page"] = page.ToString(),
            ["IncludeCancelled"] = Model.IncludeCancelled.ToString().ToLowerInvariant(),
            ["IncludeFinished"] = Model.IncludeFinished.ToString().ToLowerInvariant()
        };

        if (Model.From.HasValue)
            dict["From"] = Model.From.Value.ToString("yyyy-MM-dd");

        if (Model.To.HasValue)
            dict["To"] = Model.To.Value.ToString("yyyy-MM-dd");

        if (Model.CinemaId.HasValue)
            dict["CinemaId"] = Model.CinemaId.Value.ToString();

        if (Model.HallId.HasValue)
            dict["HallId"] = Model.HallId.Value.ToString();

        if (Model.MovieId.HasValue)
            dict["MovieId"] = Model.MovieId.Value.ToString();

        if (!string.IsNullOrWhiteSpace(Model.MovieTitle))
            dict["MovieTitle"] = Model.MovieTitle!;

        if (!string.IsNullOrWhiteSpace(Model.Sort))
            dict["Sort"] = Model.Sort!;

        return dict;
    }
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="mb-0">Сеанси</h1>
    <a class="btn btn-primary" asp-action="Create">Створити новий сеанс</a>
</div>

@if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger">@err</div>
}

<form method="get" class="mb-3" id="filtersForm">
    <input type="hidden" name="Page" value="1" />

    @{
        var isHallDisabled = !Model.CinemaId.HasValue;
        var hallPlaceholder = Model.CinemaId.HasValue ? "— Усі —" : "— Спершу оберіть кінотеатр —";
    }

    <div class="card shadow-sm">
        <div class="card-body py-2">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div class="fw-semibold">Фільтри</div>
                <div class="text-muted small">Кінотеатр → оновлює зали</div>
            </div>

            <div class="row g-2">

                <div class="col-lg-6">
                    <label class="form-label fw-semibold text-uppercase small mb-1">Кінотеатр</label>
                    <select class="form-select form-select-sm" asp-for="CinemaId" asp-items="Model.Cinemas" id="cinemaSelect">
                        <option value="">— Усі —</option>
                    </select>
                </div>

                <div class="col-lg-6">
                    <label class="form-label fw-semibold text-uppercase small mb-1">Зал</label>
                    <select class="form-select form-select-sm"
                            asp-for="HallId"
                            asp-items="Model.Halls"
                            id="hallSelect"
                            disabled="@isHallDisabled"
                            aria-disabled="@isHallDisabled">
                        <option value="">@hallPlaceholder</option>
                    </select>
                </div>

                <div class="col-lg-8">
                    <label class="form-label fw-semibold text-uppercase small mb-1">Фільм</label>

                    <input class="form-control form-control-sm"
                           list="movieList"
                           id="movieTitleInput"
                           asp-for="MovieTitle"
                           placeholder="Почніть вводити назву..." />

                    <datalist id="movieList">
                        @foreach (var m in Model.Movies)
                        {
                            <option value="@m.Text" data-id="@m.Value"></option>
                        }
                    </datalist>

                    <input type="hidden" asp-for="MovieId" id="movieIdHidden" />
                </div>

                <div class="col-lg-4">
                    <label class="form-label fw-semibold text-uppercase small mb-1">Сортування</label>
                    <select class="form-select form-select-sm" asp-for="Sort" asp-items="Model.SortOptions"></select>
                </div>

                <div class="col-12">
                    <div class="p-2 rounded border bg-light">
                        <div class="row g-2 align-items-end">

                            <div class="col-lg-3">
                                <label class="form-label fw-semibold text-uppercase small mb-1">З</label>
                                <input class="form-control form-control-sm" type="date" asp-for="From" value="@FormatDate(Model.From)" />
                            </div>

                            <div class="col-lg-3">
                                <label class="form-label fw-semibold text-uppercase small mb-1">До</label>
                                <input class="form-control form-control-sm" type="date" asp-for="To" value="@FormatDate(Model.To)" />
                            </div>

                            <div class="col-lg-6">
                                <div class="fw-semibold text-uppercase small mb-1">Швидко</div>
                                <div class="btn-group w-100" role="group" aria-label="Швидкі фільтри за датою">
                                    <a class="btn btn-outline-secondary btn-sm"
                                       asp-action="Index"
                                       asp-all-route-data="RouteWithDates(today, today)">
                                        Сьогодні
                                    </a>

                                    <a class="btn btn-outline-secondary btn-sm"
                                       asp-action="Index"
                                       asp-all-route-data="RouteWithDates(today.AddDays(1), today.AddDays(1))">
                                        Завтра
                                    </a>

                                    <a class="btn btn-outline-secondary btn-sm"
                                       asp-action="Index"
                                       asp-all-route-data="RouteWithDates(weekStart, weekEnd)">
                                        Цей тиждень
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2">

                        <div class="d-flex flex-wrap gap-3">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="IncludeCancelled" />
                                <label class="form-check-label" asp-for="IncludeCancelled">Скасовані</label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" asp-for="IncludeFinished" />
                                <label class="form-check-label" asp-for="IncludeFinished">Завершені</label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-secondary btn-sm" type="submit">Застосувати</button>
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Очистити</a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</form>

@if (Model.TotalCount > 0)
{
    <div class="text-muted mb-2">
        Знайдено: @Model.TotalCount
    </div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th style="width:72px;">Постер</th>
            <th>Фільм</th>
            <th>Зал</th>
            <th>Початок</th>
            <th>Кінець</th>
            <th>Тип</th>
            <th>Статус</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Sessions == null || Model.Sessions.Count == 0)
        {
            <tr>
                <td colspan="8">Сеансів не знайдено.</td>
            </tr>
        }
        else
        {
            @foreach (var s in Model.Sessions)
            {
                var isOver = s.EndTime <= now;
                var isFinished = !s.IsCancelled && isOver;

                var posterUrl = PosterUrl(s.PosterPath);

                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(posterUrl))
                        {
                            <img src="@posterUrl"
                                 alt="Poster"
                                 style="width:56px;height:auto;border-radius:6px;object-fit:cover;"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="text-muted small">—</div>
                        }
                    </td>

                    <td>@(string.IsNullOrWhiteSpace(s.MovieTitle) ? $"#{s.MovieId}" : s.MovieTitle)</td>

                    <td>
                        @if (!string.IsNullOrWhiteSpace(s.CinemaName))
                        {
                            @($"{s.CinemaName} — {s.HallName}")
                        }
                        else
                        {
                            @(string.IsNullOrWhiteSpace(s.HallName) ? $"#{s.HallId}" : s.HallName)
                        }
                    </td>

                    <td>@s.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@s.EndTime.ToString("dd.MM.yyyy HH:mm")</td>

                    <td>
                        <span class="badge text-bg-secondary">@s.PresentationType</span>
                    </td>

                    <td>
                        @if (s.IsCancelled)
                        {
                            <span class="badge text-bg-danger">Скасовано</span>
                        }
                        else if (isFinished)
                        {
                            <span class="badge text-bg-dark">Завершено</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">Активний</span>
                        }
                    </td>

                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Details"
                           asp-route-id="@s.Id">
                            Деталі
                        </a>

                        @if (s.IsCancelled || isOver)
                        {
                            <span title="Не можна змінювати ціни для скасованого або завершеного сеансу">
                                <button class="btn btn-sm btn-outline-primary" type="button" disabled>
                                    Ціни
                                </button>
                            </span>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="Pricing"
                               asp-route-id="@s.Id">
                                Ціни
                            </a>
                        }

                        @if (s.IsCancelled || isOver)
                        {
                            <span title="Не можна редагувати скасований або завершений сеанс">
                                <button class="btn btn-sm btn-outline-secondary" type="button" disabled>
                                    Редагувати
                                </button>
                            </span>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-action="Edit"
                               asp-route-id="@s.Id">
                                Редагувати
                            </a>
                        }

                        @if (!s.IsCancelled)
                        {
                            if (isOver)
                            {
                                <span title="Не можна скасувати завершений сеанс">
                                    <button class="btn btn-sm btn-outline-danger" type="button" disabled>
                                        Скасувати
                                    </button>
                                </span>
                            }
                            else
                            {
                                <form asp-action="Cancel"
                                      asp-route-id="@s.Id"
                                      method="post"
                                      class="d-inline js-cancel-form"
                                      data-session-id="@s.Id"
                                      data-movie="@(s.MovieTitle ?? "")"
                                      data-start="@s.StartTime.ToString("dd.MM.yyyy HH:mm")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                                    <button class="btn btn-sm btn-outline-danger" type="submit">
                                        Скасувати
                                    </button>
                                </form>
                            }
                        }
                        else
                        {
                            if (isOver)
                            {
                                <span title="Не можна відновити завершений сеанс">
                                    <button class="btn btn-sm btn-outline-success" type="button" disabled>
                                        Відновити
                                    </button>
                                </span>
                            }
                            else
                            {
                                <form asp-action="Restore"
                                      asp-route-id="@s.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                                    <button class="btn btn-sm btn-outline-success" type="submit">
                                        Відновити
                                    </button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }

        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Пагінація сеансів" class="mt-3">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-all-route-data="RouteForPage(Model.Page - 1)">
                    Назад
                </a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">
                    Сторінка @Model.Page з @Model.TotalPages
                </span>
            </li>

            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-all-route-data="RouteForPage(Model.Page + 1)">
                    Вперед
                </a>
            </li>

        </ul>
    </nav>
}

@section Scripts {
    <script>
        (function () {
          const form = document.getElementById('filtersForm');
          const cinema = document.getElementById('cinemaSelect');
          const hall = document.getElementById('hallSelect');

          if (cinema && form) {
            cinema.addEventListener('change', () => {
              if (hall) hall.value = '';
              form.submit();
            });
          }

          const input = document.getElementById('movieTitleInput');
          const hidden = document.getElementById('movieIdHidden');
          const list = document.getElementById('movieList');

          function syncHidden() {
            const value = (input.value || "").trim();
            const option = Array.from(list.options).find(o => o.value === value);
            hidden.value = option ? option.dataset.id : '';
          }

          if (input && hidden && list) {
            input.addEventListener('input', syncHidden);
            syncHidden();
          }

          document.querySelectorAll('form.js-cancel-form').forEach(formEl => {
            formEl.addEventListener('submit', (e) => {
              if (formEl.querySelector('button[disabled]')) return;

              const id = formEl.dataset.sessionId || '';
              const movie = (formEl.dataset.movie || '').trim();
              const start = (formEl.dataset.start || '').trim();

              const msg =
                `Скасувати сеанс №${id}` +
                (movie ? `\nФільм: ${movie}` : '') +
                (start ? `\nПочаток: ${start}` : '') +
                `\n\nПідтвердити дію?`;

              if (!confirm(msg)) e.preventDefault();
            });
          });
        })();
    </script>
}
