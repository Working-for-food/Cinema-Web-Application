@using Application.DTOs
@model Web.ViewModels.Admin.Sessions.SessionsIndexVm

@{
    ViewData["Title"] = "Сеанси";

    string PtLabel(PresentationType pt) => pt switch
    {
        PresentationType.TwoD => "2D",
        PresentationType.ThreeD => "3D",
        _ => pt.ToString()
    };

    string FormatDate(DateTime? dt) => dt?.ToString("yyyy-MM-dd") ?? "";

    var now = DateTime.Now;
    var today = DateTime.Today;
    var weekStart = today.AddDays(-((int)today.DayOfWeek == 0 ? 6 : (int)today.DayOfWeek - 1));
    var weekEnd = weekStart.AddDays(6);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    string PosterUrl(string? posterPath)
    {
        if (string.IsNullOrWhiteSpace(posterPath)) return "";
        if (posterPath.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return posterPath;
        return $"https://image.tmdb.org/t/p/w154{(posterPath.StartsWith("/") ? posterPath : "/" + posterPath)}";
    }

    IDictionary<string, string> RouteWithDates(DateTime from, DateTime to)
    {
        var dict = new Dictionary<string, string>
        {
            ["From"] = from.ToString("yyyy-MM-dd"),
            ["To"] = to.ToString("yyyy-MM-dd"),
            ["IncludeCancelled"] = Model.IncludeCancelled.ToString().ToLowerInvariant(),
            ["IncludeFinished"] = Model.IncludeFinished.ToString().ToLowerInvariant(),
            ["Page"] = "1"
        };
        if (Model.CinemaId.HasValue) dict["CinemaId"] = Model.CinemaId.Value.ToString();
        if (Model.HallId.HasValue) dict["HallId"] = Model.HallId.Value.ToString();
        if (Model.MovieId.HasValue) dict["MovieId"] = Model.MovieId.Value.ToString();
        if (!string.IsNullOrWhiteSpace(Model.MovieTitle)) dict["MovieTitle"] = Model.MovieTitle!;
        if (!string.IsNullOrWhiteSpace(Model.Sort)) dict["Sort"] = Model.Sort!;
        return dict;
    }

    IDictionary<string, string> RouteForPage(int page)
    {
        var dict = new Dictionary<string, string>
        {
            ["Page"] = page.ToString(),
            ["IncludeCancelled"] = Model.IncludeCancelled.ToString().ToLowerInvariant(),
            ["IncludeFinished"] = Model.IncludeFinished.ToString().ToLowerInvariant()
        };
        if (Model.From.HasValue) dict["From"] = Model.From.Value.ToString("yyyy-MM-dd");
        if (Model.To.HasValue) dict["To"] = Model.To.Value.ToString("yyyy-MM-dd");
        if (Model.CinemaId.HasValue) dict["CinemaId"] = Model.CinemaId.Value.ToString();
        if (Model.HallId.HasValue) dict["HallId"] = Model.HallId.Value.ToString();
        if (Model.MovieId.HasValue) dict["MovieId"] = Model.MovieId.Value.ToString();
        if (!string.IsNullOrWhiteSpace(Model.MovieTitle)) dict["MovieTitle"] = Model.MovieTitle!;
        if (!string.IsNullOrWhiteSpace(Model.Sort)) dict["Sort"] = Model.Sort!;
        return dict;
    }

    var isHallDisabled = !Model.CinemaId.HasValue;
    var hallPlaceholder = Model.CinemaId.HasValue ? "— Усі —" : "— Спершу оберіть кінотеатр —";
}

<section class="py-5 gray-bg">
    <div class="container-fluid px-lg-5">

        <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
            <h1 class="section-title mb-0">Сеанси</h1>
            <a asp-action="Create" class="btn btn-maroon px-4 shadow-sm">
                <i class="fa-solid fa-plus me-2"></i>СТВОРИТИ НОВИЙ
            </a>
        </div>

        @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 br-12">@ok</div>
        }
        @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-12">@err</div>
        }

        <div class="card shadow-sm border-0 mb-4 br-12">
            <div class="card-body p-4">
                <form method="get" asp-action="Index" class="row g-3 align-items-end" id="filtersForm">
                    <input type="hidden" name="Page" value="1" />

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Кінотеатр</label>
                        <select class="form-select border-2 br-8 shadow-none" asp-for="CinemaId" asp-items="Model.Cinemas" id="cinemaSelect">
                            <option value="">Усі кінотеатри</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Зал</label>
                        <select class="form-select border-2 br-8 shadow-none" asp-for="HallId" asp-items="Model.Halls" id="hallSelect" disabled="@isHallDisabled">
                            <option value="">@hallPlaceholder</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Фільм</label>
                        <input class="form-control border-2 br-8 shadow-none" list="movieList" id="movieTitleInput" asp-for="MovieTitle" placeholder="Пошук фільму..." />
                        <datalist id="movieList">
                            @foreach (var m in Model.Movies) { <option value="@m.Text" data-id="@m.Value"></option> }
                        </datalist>
                        <input type="hidden" asp-for="MovieId" id="movieIdHidden" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Сортування</label>
                        <select class="form-select border-2 br-8 shadow-none" asp-for="Sort" asp-items="Model.SortOptions"></select>
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label small fw-bold text-muted text-uppercase">Період</label>
                        <div class="input-group">
                            <input class="form-control border-2 br-left-8 shadow-none" type="date" asp-for="From" value="@FormatDate(Model.From)" />
                            <span class="input-group-text bg-light border-2 border-start-0 border-end-0 text-muted small">до</span>
                            <input class="form-control border-2 br-right-8 shadow-none" type="date" asp-for="To" value="@FormatDate(Model.To)" />
                        </div>
                    </div>

                    <div class="col-12 col-lg-4 d-flex align-items-center gap-4 py-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IncludeCancelled">
                            <label class="form-check-label small fw-bold text-muted text-uppercase" asp-for="IncludeCancelled">Скасовані</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IncludeFinished">
                            <label class="form-check-label small fw-bold text-muted text-uppercase" asp-for="IncludeFinished">Завершені</label>
                        </div>
                    </div>

                    <div class="col-12 col-lg-4 text-lg-end">
                        <div class="btn-group shadow-sm br-8 overflow-hidden me-2">
                            <a class="btn btn-light btn-sm border fw-bold text-muted px-3" asp-action="Index" asp-all-route-data="RouteWithDates(today, today)">СЬОГОДНІ</a>
                            <a class="btn btn-light btn-sm border fw-bold text-muted px-3" asp-action="Index" asp-all-route-data="RouteWithDates(today.AddDays(1), today.AddDays(1))">ЗАВТРА</a>
                        </div>
                        <button type="submit" class="btn btn-dark px-4 br-8">ЗАСТОСУВАТИ</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="mb-3">
            <div class="text-muted small fw-bold text-uppercase">Знайдено: <span class="text-dark">@Model.TotalCount</span></div>
        </div>

        @if (Model.Sessions == null || Model.Sessions.Count == 0)
        {
            <div class="empty-state mx-auto" style="max-width: 600px;">
                <div class="empty-icon"><i class="fa-solid fa-calendar-xmark"></i></div>
                <h5 class="empty-title">Сеансів не знайдено</h5>
                <p class="empty-sub">Спробуйте змінити фільтри або створіть новий сеанс.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var s in Model.Sessions)
                {
                    var isOver = s.EndTime <= now;
                    var isFinished = !s.IsCancelled && isOver;
                    var posterUrl = PosterUrl(s.PosterPath);

                    <div class="col-12 col-xl-6">
                        <div class="card shadow-sm border-0 br-12 overflow-hidden h-100 session-card">
                            <div class="row g-0 h-100">
                                <div class="col-auto">
                                    <div class="session-poster-wrap">
                                        @if (!string.IsNullOrWhiteSpace(posterUrl))
                                        {
                                            <img src="@posterUrl" alt="Постер" class="h-100 w-100 object-fit-cover" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="h-100 w-100 d-flex align-items-center justify-content-center text-muted small">No poster</div>
                                        }
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card-body p-4 d-flex flex-column h-100">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="fw-bold mb-0 text-dark">@(string.IsNullOrWhiteSpace(s.MovieTitle) ? $"#{s.MovieId}" : s.MovieTitle)</h5>
                                            <span class="badge @(s.IsCancelled ? "text-bg-danger" : isFinished ? "text-bg-secondary" : "badge-active") br-4 px-2 py-1">
                                                @(s.IsCancelled ? "СКАСОВАНО" : isFinished ? "ЗАВЕРШЕНО" : "АКТИВНИЙ")
                                            </span>
                                        </div>

                                        <div class="small text-muted mb-3">
                                            <span class="me-3"><i class="fa-solid fa-location-dot me-1 text-primary"></i>@s.CinemaName — @s.HallName</span>
                                            <span class="badge bg-light text-dark border fw-normal">@PtLabel(s.PresentationType)</span>
                                        </div>

                                        <div class="mt-auto pt-3 border-top">
                                            <div class="row align-items-center">
                                                <div class="col">
                                                    <div class="small text-muted text-uppercase fw-bold x-small">Час</div>
                                                    <div class="fw-bold text-dark">
                                                        <span class="text-primary">@s.StartTime.ToString("HH:mm")</span> 
                                                        <span class="text-muted mx-1">—</span> 
                                                        @s.EndTime.ToString("HH:mm")
                                                        <span class="ms-2 small fw-normal text-muted">(@s.StartTime.ToString("dd.MM"))</span>
                                                    </div>
                                                </div>
                                                <div class="col-auto d-flex gap-1">
                                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn-icon-sm" title="Деталі"><i class="fa-solid fa-eye"></i></a>
                                                    
                                                    @{ var disabledBtn = s.IsCancelled || isOver; }
                                                    
                                                    <a asp-action="Pricing" asp-route-id="@s.Id" class="btn-icon-sm @(disabledBtn ? "disabled bg-light opacity-50" : "text-primary")" title="Ціни"><i class="fa-solid fa-tags"></i></a>
                                                    
                                                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn-icon-sm @(disabledBtn ? "disabled bg-light opacity-50" : "")" title="Редагувати"><i class="fa-solid fa-pen-to-square"></i></a>

                                                    @if (!s.IsCancelled)
                                                    {
                                                        <form asp-action="Cancel" asp-route-id="@s.Id" method="post" class="d-inline js-cancel-form" data-session-id="@s.Id" data-movie="@s.MovieTitle" data-start="@s.StartTime.ToString("dd.MM HH:mm")">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                            <button class="btn-icon-sm text-danger border @(isOver ? "disabled opacity-50" : "")" type="submit" title="Скасувати"><i class="fa-solid fa-ban"></i></button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form asp-action="Restore" asp-route-id="@s.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                            <button class="btn-icon-sm text-success border @(isOver ? "disabled opacity-50" : "")" type="submit" title="Відновити"><i class="fa-solid fa-rotate-left"></i></button>
                                                        </form>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination pagination-sm justify-content-center border-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link border-0 shadow-sm mx-1 rounded-2" asp-action="Index" asp-all-route-data="RouteForPage(Model.Page - 1)">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link border-0 bg-transparent text-dark fw-bold">@Model.Page / @Model.TotalPages</span>
                    </li>
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link border-0 shadow-sm mx-1 rounded-2" asp-action="Index" asp-all-route-data="RouteForPage(Model.Page + 1)">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</section>

@section Scripts {
    <script>
        (function () {
          const form = document.getElementById('filtersForm');
          const cinema = document.getElementById('cinemaSelect');
          const hall = document.getElementById('hallSelect');

          if (cinema && form) {
            cinema.addEventListener('change', () => {
              if (hall) hall.value = '';
              form.submit();
            });
          }

          const input = document.getElementById('movieTitleInput');
          const hidden = document.getElementById('movieIdHidden');
          const list = document.getElementById('movieList');

          function syncHidden() {
            const value = (input.value || "").trim();
            const option = Array.from(list.options).find(o => o.value === value);
            hidden.value = option ? option.dataset.id : '';
          }

          if (input && hidden && list) {
            input.addEventListener('input', syncHidden);
            syncHidden();
          }

          document.querySelectorAll('form.js-cancel-form').forEach(formEl => {
            formEl.addEventListener('submit', (e) => {
              const id = formEl.dataset.sessionId || '';
              const movie = (formEl.dataset.movie || '').trim();
              const start = (formEl.dataset.start || '').trim();

              const msg = `Скасувати сеанс №${id}${movie ? '\nФільм: ' + movie : ''}${start ? '\nПочаток: ' + start : ''}\n\nВи впевнені?`;
              if (!confirm(msg)) e.preventDefault();
            });
          });
        })();
    </script>
}