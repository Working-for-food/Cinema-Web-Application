@using Infrastructure.Entities
@using Web.ViewModels.Admin.Sessions
@using System.Globalization
@model SessionPricingPageVm

@{
    ViewData["Title"] = "Ціни сеансу";

    string CatLabel(SeatCategory c) => c switch {
        SeatCategory.Standard => "Звичайні",
        SeatCategory.Vip => "VIP",
        SeatCategory.Accessible => "Інклюзивні",
        _ => c.ToString()
    };

    string BadgeClass(SeatCategory c) => c switch {
        SeatCategory.Standard => "badge-modern bg-light text-dark border",
        SeatCategory.Vip => "badge-modern bg-warning text-dark",
        SeatCategory.Accessible => "badge-modern bg-info text-dark",
        _ => "badge-modern bg-secondary"
    };

    string SeatUiClass(SeatCategory c) => c switch {
        SeatCategory.Vip => "seat-bg-vip",
        SeatCategory.Accessible => "seat-bg-acc",
        _ => "seat-bg-std"
    };

    var groupedSeats = (Model.Seats ?? new List<SessionPricingPageVm.SeatPriceVm>())
        .GroupBy(s => s.Row).OrderBy(g => g.Key).ToList();

    var maxSeats = groupedSeats.Count == 0 ? 0 : groupedSeats.Max(g => g.Max(s => s.Number));
}

<section class="py-5 gray-bg">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <h1 class="display-5 fw-bold text-dark text-uppercase mb-0">Управління цінами</h1>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary px-4 py-2 fw-bold text-uppercase">
                    <i class="fa-solid fa-arrow-left me-2"></i>НАЗАД
                </a>
                <a asp-action="Details" asp-route-id="@Model.SessionId" class="btn btn-maroon px-4 py-2 fw-bold text-uppercase shadow-sm">
                    <i class="fa-solid fa-circle-info me-2"></i>ДЕТАЛІ
                </a>
            </div>
        </div>

        <div class="text-muted small text-uppercase fw-bold opacity-75 mb-4 ms-1 letter-spacing-1">
            <i class="fa-solid fa-film me-1"></i> @Model.MovieTitle 
            <span class="mx-2">|</span>
            <i class="fa-solid fa-location-dot me-1"></i> @Model.CinemaName (@Model.HallName)
        </div>

        @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 br-12">@ok</div>
        }

        <form asp-action="Pricing" asp-route-id="@Model.SessionId" method="post" id="pricingForm">
            @Html.AntiForgeryToken()

            <div class="row g-4 mb-4">
                <div class="col-lg-12">
                    <div class="card shadow-sm border-0 br-12 overflow-hidden bg-white">
                        <div class="card-body p-4 p-lg-5">
                            <div class="panel p-3 mb-5 border-0 br-8" style="background: #f1f5f9;">
                                <div class="d-flex align-items-center gap-2 text-dark small fw-bold text-uppercase opacity-75">
                                    <i class="fa-solid fa-calculator text-primary"></i>
                                    Алгоритм розрахунку: Базова ціна ряду × Коефіцієнт категорії
                                </div>
                            </div>

                            <div class="row g-5">
                                <div class="col-md-6">
                                    <h5 class="fw-bold text-muted text-uppercase small mb-4 letter-spacing-1">
                                        <i class="fa-solid fa-layer-group me-2"></i> Базова ціна за ряд (грн)
                                    </h5>
                                    <div class="table-responsive br-8 border">
                                        <table class="table admin-table mb-0 align-middle table-sm">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="ps-3">Ряд</th>
                                                    <th style="width: 150px;">Ціна</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < Model.RowPrices.Count; i++)
                                                {
                                                    <tr>
                                                        <td class="ps-3 fw-bold">Ряд @Model.RowPrices[i].RowNumber</td>
                                                        <td class="p-2">
                                                            <input type="hidden" name="RowPrices[@i].RowNumber" value="@Model.RowPrices[i].RowNumber" />
                                                            <input class="form-control form-control-sm border-2 shadow-none price-input" 
                                                                   name="RowPrices[@i].BasePrice" 
                                                                   value="@Model.RowPrices[i].BasePrice.ToString("0.##", CultureInfo.InvariantCulture)" 
                                                                   type="number" step="1" min="0" required />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <h5 class="fw-bold text-muted text-uppercase small mb-4 letter-spacing-1">
                                        <i class="fa-solid fa-tags me-2"></i> Коефіцієнти категорій
                                    </h5>
                                    <div class="table-responsive br-8 border">
                                        <table class="table admin-table mb-0 align-middle table-sm">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="ps-3">Категорія</th>
                                                    <th style="width: 150px;">Множник (x)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < Model.CategoryMultipliers.Count; i++)
                                                {
                                                    var catEnum = (SeatCategory)Model.CategoryMultipliers[i].Category;
                                                    <tr>
                                                        <td class="ps-3">
                                                            <span class="@BadgeClass(catEnum) px-2 py-1">@CatLabel(catEnum)</span>
                                                        </td>
                                                        <td class="p-2">
                                                            <input type="hidden" name="CategoryMultipliers[@i].Category" value="@Model.CategoryMultipliers[i].Category" />
                                                            <input type="hidden" name="CategoryMultipliers[@i].Title" value="@Model.CategoryMultipliers[i].Title" />
                                                            <input class="form-control form-control-sm border-2 shadow-none multiplier-input" 
                                                                   name="CategoryMultipliers[@i].Multiplier" 
                                                                   value="@Model.CategoryMultipliers[i].Multiplier.ToString("0.##", CultureInfo.InvariantCulture)" 
                                                                   type="number" step="0.1" min="0.1" required />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="text-end mt-4">
                                        <button class="btn btn-maroon px-5 py-2 fw-bold shadow-sm br-8" type="submit">
                                            <i class="fa-solid fa-floppy-disk me-2"></i> ЗБЕРЕГТИ ТАРИФИ
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-12">
                    <div class="card shadow-sm border-0 br-12 overflow-hidden bg-white">
                        <div class="card-body p-4 p-lg-5">
                            <div class="text-center mb-5">
                                <h5 class="fw-bold text-dark text-uppercase mb-1">Попередній перегляд залу</h5>
                                <p class="text-muted small">Фінальна вартість квитків за налаштованими коефіцієнтами</p>
                            </div>

                            @if (groupedSeats.Count == 0)
                            {
                                <div class="alert alert-warning border-0 br-12 text-center">Схема залу порожня.</div>
                            }
                            else
                            {
                                <div class="cinema-map-wrap p-4 br-16 shadow-inner" style="background: #f8fafc;">
                                    <div class="cinema-map mx-auto">
                                        <div class="cinema-screen mb-5">
                                            <div class="cinema-screen-arc"></div>
                                            <div class="cinema-screen-title opacity-50 fw-bold">ЕКРАН</div>
                                        </div>

                                        <div class="cinema-grid mx-auto" style="--cols:@maxSeats;">
                                            @foreach (var row in groupedSeats)
                                            {
                                                <div class="row-label opacity-50 fw-bold">@row.Key</div>
                                                @for (int s = 1; s <= maxSeats; s++)
                                                {
                                                    var seat = row.FirstOrDefault(x => x.Number == s);
                                                    if (seat == null) { <div class="seat seat-empty"></div> }
                                                    else
                                                    {
                                                        var cat = (SeatCategory)seat.Category;
                                                        <div class="seat @SeatUiClass(cat) d-flex flex-column align-items-center justify-content-center" 
                                                             title="Ряд @seat.Row, місце @s (@CatLabel(cat))">
                                                            <span class="x-small fw-bold" style="font-size: 0.6rem; line-height: 1; opacity: 0.7;">@s</span>
                                                            <span class="fw-bold" style="font-size: 0.75rem;">@seat.Price.ToString("0")</span>
                                                        </div>
                                                    }
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rowInputs = document.querySelectorAll('input[data-type="row-base"]');
            const multInputs = document.querySelectorAll('input[data-type="cat-mult"]');
            const priceDisplays = document.querySelectorAll('.seat-price-display');

            const rowPrices = new Map();
            const catMults = new Map();

            function updateData() {
                rowInputs.forEach(input => {
                    const rowId = parseInt(input.dataset.rowId);
                    const val = parseFloat(input.value);
                    rowPrices.set(rowId, isNaN(val) ? 0 : val);
                });

                multInputs.forEach(input => {
                    const catId = parseInt(input.dataset.catId);
                    const val = parseFloat(input.value);
                    catMults.set(catId, isNaN(val) ? 1 : val);
                });

                recalcAll();
            }

            function recalcAll() {
                priceDisplays.forEach(display => {
                    const r = parseInt(display.dataset.row);
                    const c = parseInt(display.dataset.cat);

                    const base = rowPrices.get(r) || 0;
                    const mult = catMults.get(c) || 1;

                    const finalPrice = base * mult;

                    const newText = finalPrice.toFixed(0);
                    if (display.innerText !== newText) {
                        display.style.opacity = '0.5';
                        display.innerText = newText;
                        setTimeout(() => display.style.opacity = '1', 150);
                    }
                });
            }

            rowInputs.forEach(i => i.addEventListener('input', updateData));
            multInputs.forEach(i => i.addEventListener('input', updateData));

            updateData();
        });
    </script>
}