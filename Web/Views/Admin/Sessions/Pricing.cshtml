@using Infrastructure.Entities
@using Web.ViewModels.Admin.Sessions
@using System.Globalization
@model SessionPricingPageVm

@{
    ViewData["Title"] = "Ціни сеансу";

    string CatLabel(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "Звичайне",
        SeatCategory.Vip => "VIP",
        SeatCategory.Accessible => "Інклюзивне",
        _ => c.ToString()
    };

    string BadgeClass(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "badge text-bg-light border text-dark",
        SeatCategory.Vip => "badge text-bg-warning text-dark",
        SeatCategory.Accessible => "badge text-bg-info text-dark",
        _ => "badge text-bg-secondary"
    };

    string SeatBgClass(SeatCategory c) => c switch
    {
        SeatCategory.Vip => "seat-bg-vip",
        SeatCategory.Accessible => "seat-bg-acc",
        _ => "seat-bg-std"
    };

    var groupedSeats = (Model.Seats ?? new List<SessionPricingPageVm.SeatPriceVm>())
        .GroupBy(s => s.Row)
        .OrderBy(g => g.Key)
        .ToList();

    var maxSeats = groupedSeats.Count == 0 ? 0 : groupedSeats.Max(g => g.Max(s => s.Number));
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">ЦІНИ СЕАНСУ</h1>

        @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success mb-3">@ok</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-maroon text-white">
                <h5 class="mb-0">
                    <i class="fa-solid fa-coins me-2"></i>
                    Управління цінами
                </h5>
            </div>

            <div class="card-body p-3 p-md-4" style="background-color:#fff9e6;">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">

                    <div>
                        <div class="small text-muted mb-1">
                            <i class="fa-solid fa-location-dot me-1"></i>
                            @Model.CinemaName / @Model.HallName
                            <span class="mx-2">|</span>
                            <i class="fa-solid fa-film me-1"></i>
                            <strong>@Model.MovieTitle</strong>
                        </div>

                        <div class="text-muted">
                            Тут можна змінити базові тарифи та перевірити фінальні ціни на схемі залу нижче.
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap justify-content-lg-end">

                        <a asp-controller="Sessions"
                           asp-action="Index"
                           class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            НАЗАД
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@Model.SessionId"
                           class="btn btn-maroon">
                            <i class="fa-solid fa-pen-to-square me-1"></i>
                            РЕДАГУВАТИ
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@Model.SessionId"
                           class="btn btn-maroon">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            ДЕТАЛІ
                        </a>

                    </div>

                </div>
            </div>
        </div>

        <form asp-action="Pricing" asp-route-id="@Model.SessionId" method="post" id="pricingForm">
            @Html.AntiForgeryToken()

            <div class="card shadow-sm mb-4" style="background-color:#fff9e6;">
                <div class="card-header bg-maroon text-white">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-receipt me-2"></i>
                        1) Базові тарифи
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4">

                        <div class="col-12 col-lg-6">
                            <label class="form-label text-muted">
                                <i class="fa-solid fa-layer-group me-1"></i>
                                Базова ціна за ряд
                            </label>

                            <div class="table-responsive border rounded bg-white">
                                <table class="table table-sm table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Ряд</th>
                                            <th style="width:140px;">Ціна (грн)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.RowPrices.Count; i++)
                                        {
                                            <tr>
                                                <td class="ps-3 fw-semibold">Ряд @Model.RowPrices[i].RowNumber</td>
                                                <td class="p-2">
                                                    <input type="hidden"
                                                           name="RowPrices[@i].RowNumber"
                                                           value="@Model.RowPrices[i].RowNumber" />

                                                    <input class="form-control form-control-sm price-input"
                                                           name="RowPrices[@i].BasePrice"
                                                           value="@Model.RowPrices[i].BasePrice.ToString("0.##", CultureInfo.InvariantCulture)"
                                                           type="number" step="1" min="0"
                                                           data-type="row-base"
                                                           data-row-id="@Model.RowPrices[i].RowNumber"
                                                           required />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <label class="form-label text-muted">
                                <i class="fa-solid fa-tags me-1"></i>
                                Коефіцієнти категорій
                            </label>

                            <div class="table-responsive border rounded bg-white">
                                <table class="table table-sm table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Категорія</th>
                                            <th style="width:120px;">X</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.CategoryMultipliers.Count; i++)
                                        {
                                            var catEnum = (SeatCategory)Model.CategoryMultipliers[i].Category;
                                            <tr>
                                                <td class="ps-3">
                                                    <span class="@BadgeClass(catEnum) me-2">●</span>
                                                    <span class="fw-semibold">@CatLabel(catEnum)</span>
                                                </td>
                                                <td class="p-2">
                                                    <input type="hidden"
                                                           name="CategoryMultipliers[@i].Category"
                                                           value="@Model.CategoryMultipliers[i].Category" />
                                                    <input type="hidden"
                                                           name="CategoryMultipliers[@i].Title"
                                                           value="@Model.CategoryMultipliers[i].Title" />

                                                    <input class="form-control form-control-sm multiplier-input"
                                                           name="CategoryMultipliers[@i].Multiplier"
                                                           value="@Model.CategoryMultipliers[i].Multiplier.ToString("0.##", CultureInfo.InvariantCulture)"
                                                           type="number" step="0.1" min="0.1"
                                                           data-type="cat-mult"
                                                           data-cat-id="@Model.CategoryMultipliers[i].Category"
                                                           required />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="form-text small mt-2">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                Фінальна ціна = Ціна ряду × Коефіцієнт
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card-footer bg-transparent border-top-0">
                    <button class="btn btn-maroon w-100" type="submit">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        ЗБЕРЕГТИ ЦІНИ
                    </button>
                </div>
            </div>

            <div class="card shadow-sm" style="background-color:#fff9e6;">
                <div class="card-header bg-maroon text-white">
                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                        <h5 class="mb-0">
                            <i class="fa-solid fa-chair me-2"></i>
                            2) Попередній перегляд залу
                        </h5>

                        <div class="d-flex flex-wrap gap-3 small align-items-center">
                            @foreach (var cat in Enum.GetValues<SeatCategory>())
                            {
                                <span class="d-flex align-items-center">
                                    <span class="@BadgeClass(cat) me-2"
                                          style="width:12px; height:12px; display:inline-block; padding:0; border-radius:50%;"></span>
                                    <span class="text-white-50">@CatLabel(cat)</span>
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 bg-light overflow-auto">

                    @if (groupedSeats.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">
                            Схема залу порожня. Спочатку налаштуйте місця в залі.
                        </div>
                    }
                    else
                    {
                        <div class="mb-4 mx-auto text-center" style="max-width:520px;">
                            <div class="border-top border-4 border-secondary opacity-25 mb-2"></div>
                            <small class="text-uppercase text-muted fw-semibold">Екран</small>
                        </div>

                        <!-- без justify-content-center, щоб sticky не перекривав першу колонку -->
                        <div class="seat-preview-wrap">
                            <table class="table table-borderless w-auto text-center seat-preview-table"
                                   style="border-spacing:4px; border-collapse:separate;">
                                <thead>
                                    <tr>
                                        <th class="text-muted fw-normal small seat-sticky-col">Ряд</th>
                                        @for (int i = 1; i <= maxSeats; i++)
                                        {
                                            <th class="text-muted fw-normal small" style="width:50px;">@i</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in groupedSeats)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-secondary align-middle seat-sticky-col">@row.Key</td>

                                            @for (int s = 1; s <= maxSeats; s++)
                                            {
                                                var seat = row.FirstOrDefault(x => x.Number == s);

                                                <td>
                                                    @if (seat != null)
                                                    {
                                                        var currentPrice = seat.Price;
                                                        var cat = (SeatCategory)seat.Category;

                                                        <div class="card shadow-sm border-0 seat-card @SeatBgClass(cat)"
                                                             style="width:50px; cursor:default;">
                                                            <div class="p-1">
                                                                <div class="fw-bold small seat-num">@s</div>

                                                                <div class="small fw-bold seat-price-display"
                                                                     data-row="@seat.Row"
                                                                     data-cat="@seat.Category">
                                                                    @currentPrice.ToString("F0")
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div style="width:50px; height:40px;"></div>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>

        </form>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rowInputs = document.querySelectorAll('input[data-type="row-base"]');
            const multInputs = document.querySelectorAll('input[data-type="cat-mult"]');
            const priceDisplays = document.querySelectorAll('.seat-price-display');

            const rowPrices = new Map();
            const catMults = new Map();

            function updateData() {
                rowInputs.forEach(input => {
                    const rowId = parseInt(input.dataset.rowId);
                    const val = parseFloat(input.value);
                    rowPrices.set(rowId, isNaN(val) ? 0 : val);
                });

                multInputs.forEach(input => {
                    const catId = parseInt(input.dataset.catId);
                    const val = parseFloat(input.value);
                    catMults.set(catId, isNaN(val) ? 1 : val);
                });

                recalcAll();
            }

            function recalcAll() {
                priceDisplays.forEach(display => {
                    const r = parseInt(display.dataset.row);
                    const c = parseInt(display.dataset.cat);

                    const base = rowPrices.get(r) || 0;
                    const mult = catMults.get(c) || 1;

                    const finalPrice = base * mult;

                    const newText = finalPrice.toFixed(0);
                    if (display.innerText !== newText) {
                        display.style.opacity = '0.5';
                        display.innerText = newText;
                        setTimeout(() => display.style.opacity = '1', 150);
                    }
                });
            }

            rowInputs.forEach(i => i.addEventListener('input', updateData));
            multInputs.forEach(i => i.addEventListener('input', updateData));

            updateData();
        });
    </script>
}