@using Infrastructure.Entities
@using Web.ViewModels.Admin.Sessions
@using System.Globalization
@model SessionPricingPageVm

@{
    ViewData["Title"] = "Ціни сеансу";

    string CatLabel(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "Звичайне",
        SeatCategory.Vip => "VIP",
        SeatCategory.Accessible => "Інклюзивне",
        _ => c.ToString()
    };

    string BadgeClass(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "badge text-bg-light border text-dark",
        SeatCategory.Vip => "badge text-bg-warning text-dark",
        SeatCategory.Accessible => "badge text-bg-info text-dark",
        _ => "badge text-bg-secondary"
    };

    string CardBgClass(SeatCategory c) => c switch
    {
        SeatCategory.Vip => "bg-warning-subtle",
        SeatCategory.Accessible => "bg-info-subtle",
        _ => "bg-white"
    };

    var groupedSeats = (Model.Seats ?? new List<SessionPricingPageVm.SeatPriceVm>())
        .GroupBy(s => s.Row)
        .OrderBy(g => g.Key)
        .ToList();

    var maxSeats = groupedSeats.Count == 0 ? 0 : groupedSeats.Max(g => g.Max(s => s.Number));
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Управління цінами</h1>
        <div class="text-muted">
            <i class="bi bi-geo-alt"></i> @Model.CinemaName / @Model.HallName
            <span class="mx-2">|</span>
            <i class="bi bi-film"></i> <strong>@Model.MovieTitle</strong>
        </div>
    </div>
    <div class="btn-group">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.SessionId">Налаштування сеансу</a>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.SessionId">Деталі</a>
    </div>
</div>

@if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success mb-3" role="alert">@ok</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger mb-3" role="alert"></div>
}

<form asp-action="Pricing" asp-route-id="@Model.SessionId" method="post" id="pricingForm">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-body-tertiary">
                    <h5 class="card-title mb-0">1. Базові тарифи</h5>
                </div>
                <div class="card-body">

                    <div class="mb-4">
                        <label class="form-label fw-bold text-primary">Базова ціна за ряд</label>
                        <div class="table-responsive border rounded">
                            <table class="table table-sm table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Ряд</th>
                                        <th style="width: 120px;">Ціна (грн)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.RowPrices.Count; i++)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-medium">Ряд @Model.RowPrices[i].RowNumber</td>
                                            <td class="p-1">
                                                <input type="hidden" name="RowPrices[@i].RowNumber" value="@Model.RowPrices[i].RowNumber" />

                                                <input class="form-control form-control-sm price-input"
                                                       name="RowPrices[@i].BasePrice"
                                                       value="@Model.RowPrices[i].BasePrice.ToString("0.##", CultureInfo.InvariantCulture)"
                                                       type="number" step="1" min="0"
                                                       data-type="row-base"
                                                       data-row-id="@Model.RowPrices[i].RowNumber"
                                                       required />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div>
                        <label class="form-label fw-bold text-primary">Коефіцієнти категорій</label>
                        <div class="table-responsive border rounded">
                            <table class="table table-sm table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Категорія</th>
                                        <th style="width: 100px;">X</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.CategoryMultipliers.Count; i++)
                                    {
                                        var catEnum = (SeatCategory)Model.CategoryMultipliers[i].Category;
                                        <tr>
                                            <td class="ps-3">
                                                <span class="@BadgeClass(catEnum) me-1">●</span>
                                                @CatLabel(catEnum)
                                            </td>
                                            <td class="p-1">
                                                <input type="hidden" name="CategoryMultipliers[@i].Category" value="@Model.CategoryMultipliers[i].Category" />
                                                <input type="hidden" name="CategoryMultipliers[@i].Title" value="@Model.CategoryMultipliers[i].Title" />

                                                <input class="form-control form-control-sm multiplier-input"
                                                       name="CategoryMultipliers[@i].Multiplier"
                                                       value="@Model.CategoryMultipliers[i].Multiplier.ToString("0.##", CultureInfo.InvariantCulture)"
                                                       type="number" step="0.1" min="0.1"
                                                       data-type="cat-mult"
                                                       data-cat-id="@Model.CategoryMultipliers[i].Category"
                                                       required />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="form-text small mt-2">
                            <i class="bi bi-info-circle"></i> Фінальна ціна = Ціна ряду × Коефіцієнт
                        </div>
                    </div>

                </div>
                <div class="card-footer bg-white border-top-0 pt-0 pb-3">
                    <button class="btn btn-primary w-100" type="submit">
                        <i class="bi bi-save me-1"></i> Зберегти ціни
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">2. Попередній перегляд залу</h5>

                    <div class="d-flex gap-3 small">
                        @foreach (var cat in Enum.GetValues<SeatCategory>())
                        {
                            <div class="d-flex align-items-center">
                                <span class="@BadgeClass(cat) me-1" style="width: 12px; height: 12px; display:inline-block; padding:0; border-radius:50%;"></span>
                                <span>@CatLabel(cat)</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-body overflow-auto bg-light">

                    @if (groupedSeats.Count == 0)
                    {
                        <div class="alert alert-warning">Схема залу порожня. Спочатку налаштуйте місця в залі.</div>
                    }
                    else
                    {
                        <div class="mb-4 mx-auto w-75 text-center">
                            <div class="border-top border-4 border-secondary opacity-25 mb-2"></div>
                            <small class="text-uppercase text-muted fw-bold spacing-2">Екран</small>
                        </div>

                        <div class="d-flex justify-content-center">
                            <table class="table table-borderless w-auto text-center border-separate" style="border-spacing: 4px;">
                                <thead>
                                    <tr>
                                        <th class="text-muted fw-normal small">Ряд</th>
                                        @for (int i = 1; i <= maxSeats; i++)
                                        {
                                            <th class="text-muted fw-normal small" style="width: 50px;">@i</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in groupedSeats)
                                    {
                                        <tr>
                                            <td class="fw-bold text-secondary align-middle">@row.Key</td>

                                            @for (int s = 1; s <= maxSeats; s++)
                                            {
                                                var seat = row.FirstOrDefault(x => x.Number == s);
                                                <td>
                                                    @if (seat != null)
                                                    {
                                                        var currentPrice = seat.Price;
                                                        var cat = (SeatCategory)seat.Category;

                                                        <div class="position-relative d-inline-block">
                                                            <div class="card shadow-sm border-0 seat-card @CardBgClass(cat)"
                                                                 style="width: 50px; cursor: default;">

                                                                <div class="@BadgeClass(cat) w-100 rounded-top-1" style="height: 6px; padding:0;"></div>

                                                                <div class="p-1">
                                                                    <div class="fw-bold small text-dark">@s</div>
                                                                    <div class="small text-primary fw-bold seat-price-display"
                                                                         data-row="@seat.Row"
                                                                         data-cat="@seat.Category">
                                                                        @currentPrice.ToString("F0")
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div style="width: 50px; height: 40px;"></div>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rowInputs = document.querySelectorAll('input[data-type="row-base"]');
            const multInputs = document.querySelectorAll('input[data-type="cat-mult"]');
            const priceDisplays = document.querySelectorAll('.seat-price-display');

            const rowPrices = new Map();
            const catMults = new Map();

            function updateData() {
                rowInputs.forEach(input => {
                    const rowId = parseInt(input.dataset.rowId);
                    const val = parseFloat(input.value);
                    rowPrices.set(rowId, isNaN(val) ? 0 : val);
                });

                multInputs.forEach(input => {
                    const catId = parseInt(input.dataset.catId);
                    const val = parseFloat(input.value);
                    catMults.set(catId, isNaN(val) ? 1 : val);
                });

                recalcAll();
            }

            function recalcAll() {
                priceDisplays.forEach(display => {
                    const r = parseInt(display.dataset.row);
                    const c = parseInt(display.dataset.cat);

                    const base = rowPrices.get(r) || 0;
                    const mult = catMults.get(c) || 1;

                    const finalPrice = base * mult;

                    const newText = finalPrice.toFixed(0);
                    if (display.innerText !== newText) {
                        display.style.opacity = '0.5';
                        display.innerText = newText;
                        setTimeout(() => display.style.opacity = '1', 150);
                    }
                });
            }

            rowInputs.forEach(i => i.addEventListener('input', updateData));
            multInputs.forEach(i => i.addEventListener('input', updateData));

            updateData();
        });
    </script>
}