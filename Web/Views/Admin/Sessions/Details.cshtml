@using Infrastructure.Entities
@using System.Globalization
@model Web.ViewModels.Admin.Sessions.SessionDetailsVm

@{
    ViewData["Title"] = "Деталі сеансу";

    string PtText(PresentationType pt) => pt switch
    {
        PresentationType.TwoD => "2D",
        PresentationType.ThreeD => "3D",
        _ => pt.ToString()
    };

    string CatLabel(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "Звичайні",
        SeatCategory.Vip => "VIP",
        SeatCategory.Accessible => "Інклюзивні",
        _ => c.ToString()
    };

    string BadgeClass(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "badge text-bg-light border text-dark",
        SeatCategory.Vip => "badge text-bg-warning text-dark",
        SeatCategory.Accessible => "badge text-bg-info text-dark",
        _ => "badge text-bg-secondary"
    };

    string SeatUiClass(SeatCategory c) => c switch
    {
        SeatCategory.Vip => "seat-bg-vip",
        SeatCategory.Accessible => "seat-bg-acc",
        _ => "seat-bg-std"
    };

    var groupedSeats = (Model.Seats ?? new List<Web.ViewModels.Admin.Sessions.SessionDetailsVm.SeatVm>())
        .GroupBy(s => s.Row)
        .OrderBy(g => g.Key)
        .ToList();

    var maxSeats = groupedSeats.Count == 0 ? 0 : groupedSeats.Max(g => g.Max(s => s.Number));

    var ua = CultureInfo.GetCultureInfo("uk-UA");

    var now = DateTime.Now;
    var isOver = Model.EndTime <= now;
    var isFinished = !Model.IsCancelled && isOver;
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">Деталі сеансу</h1>

        @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success mb-3">@ok</div>
        }
        @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="alert alert-danger mb-3">@err</div>
        }

        <div class="card shadow-sm col-lg-8 mx-auto">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Інформація про сеанс №@Model.Id
                </h5>
            </div>

            <div class="card-body p-4">
                <div class="mb-4">

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-clapperboard me-1"></i>
                            Фільм
                        </label>
                        <div class="fw-semibold fs-5">
                            @(!string.IsNullOrWhiteSpace(Model.MovieTitle) ? Model.MovieTitle : "—")
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-film me-1"></i>
                            Кінотеатр
                        </label>
                        <div class="fw-semibold fs-5">
                            @(!string.IsNullOrWhiteSpace(Model.CinemaName) ? Model.CinemaName : "—")
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-chair me-1"></i>
                            Зал
                        </label>
                        <div class="fw-semibold fs-5">
                            @(!string.IsNullOrWhiteSpace(Model.HallName) ? Model.HallName : "—")
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-clock me-1"></i>
                            Початок
                        </label>
                        <div class="fw-semibold fs-5">
                            @Model.StartTime.ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-clock-rotate-left me-1"></i>
                            Кінець
                        </label>
                        <div class="fw-semibold fs-5">
                            @Model.EndTime.ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-tv me-1"></i>
                            Тип показу
                        </label>
                        <div class="fw-semibold fs-5">
                            @PtText(Model.PresentationType)
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-signal me-1"></i>
                            Стан
                        </label>
                        <div class="fw-semibold">
                            @if (Model.IsCancelled)
                            {
                                <span class="badge bg-danger">Скасовано</span>
                            }
                            else if (isFinished)
                            {
                                <span class="badge bg-dark">Завершено</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Активний</span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-calendar-plus me-1"></i>
                            Створено
                        </label>
                        <div class="fw-semibold fs-5">
                            @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-calendar-check me-1"></i>
                            Оновлено
                        </label>
                        <div class="fw-semibold fs-5">
                            @((Model.UpdatedAt.HasValue) ? Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm") : "—")
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Назад
                    </a>

                    <a asp-action="Pricing" asp-route-id="@Model.Id" class="btn btn-maroon">
                        <i class="fa-solid fa-coins me-1"></i>
                        Ціни
                    </a>

                    @if (isFinished)
                    {
                        <button class="btn btn-secondary" type="button" disabled title="Не можна редагувати завершений сеанс.">
                            <i class="fa-solid fa-pen-to-square me-1"></i>
                            Редагувати
                        </button>

                        <button class="btn btn-maroon" type="button" disabled title="Не можна скасувати завершений сеанс.">
                            <i class="fa-solid fa-ban me-1"></i>
                            Скасувати
                        </button>
                    }
                    else if (!Model.IsCancelled)
                    {
                        <a class="btn btn-maroon" asp-action="Edit" asp-route-id="@Model.Id">
                            <i class="fa-solid fa-pen-to-square me-1"></i>
                            Редагувати
                        </a>

                        <form asp-action="Cancel"
                              asp-route-id="@Model.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Скасувати цей сеанс?');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-maroon" type="submit">
                                <i class="fa-solid fa-ban me-1"></i>
                                Скасувати
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary" type="button" disabled title="Не можна редагувати скасований сеанс. Спочатку відновіть його.">
                            <i class="fa-solid fa-pen-to-square me-1"></i>
                            Редагувати
                        </button>

                        @if (isOver)
                        {
                            <button class="btn btn-maroon" type="button" disabled title="Не можна відновити завершений сеанс.">
                                <i class="fa-solid fa-rotate-left me-1"></i>
                                Відновити
                            </button>
                        }
                        else
                        {
                            <form asp-action="Restore"
                                  asp-route-id="@Model.Id"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-maroon" type="submit">
                                    <i class="fa-solid fa-rotate-left me-1"></i>
                                    Відновити
                                </button>
                            </form>
                        }
                    }

                </div>

            </div>
        </div>

        <style>
            /* Виділення заброньованих місць на схемі */
            .seat-booked { position: relative; opacity: .55; filter: saturate(.85); }
            .seat-booked::after {
                content: "";
                position: absolute;
                inset: 0;
                border-radius: 8px;
                background: repeating-linear-gradient(45deg, rgba(0,0,0,.28) 0, rgba(0,0,0,.28) 6px, rgba(0,0,0,0) 6px, rgba(0,0,0,0) 12px);
                pointer-events: none;
            }
            .seat-booked .seat-text { position: relative; z-index: 2; }
            .seat-lock { position: absolute; top: 4px; right: 6px; z-index: 3; font-size: 12px; color: rgba(0,0,0,.85); }
            .seat-legend-booked {
                width: 12px; height: 12px; border-radius: 50%;
                display: inline-block;
                background: repeating-linear-gradient(45deg, rgba(255,255,255,.65) 0, rgba(255,255,255,.65) 4px, rgba(255,255,255,0) 4px, rgba(255,255,255,0) 8px);
                border: 1px solid rgba(255,255,255,.65);
            }
            .stat-kpi { background: #fff; border: 1px solid rgba(0,0,0,.08); border-radius: 12px; }
        </style>

        <div class="card shadow-sm col-xl-10 mx-auto mt-4">
            <div class="card-header bg-maroon text-white">
                <h5 class="mb-0">
                    <i class="fa-solid fa-chart-column me-2"></i>
                    Статистика бронювань
                </h5>
            </div>

            <div class="card-body p-3 p-md-4" style="background-color:#fff9e6;">
                @if (Model.TotalSeats == 0)
                {
                    <div class="alert alert-warning mb-0">
                        У цьому залі ще не налаштовані місця, або для сеансу не створені SessionSeats.
                    </div>
                }
                else
                {
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="stat-kpi p-3 h-100">
                                <div class="small text-muted">Заповненість</div>
                                <div class="fs-3 fw-bold">@Model.OccupancyPercent.ToString("0.##", ua)%</div>
                                <div class="progress mt-2" style="height:8px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width:@(Model.OccupancyPercent.ToString("0.##", CultureInfo.InvariantCulture))%;"></div>
                                </div>
                                <div class="mt-2 small text-muted">
                                    Заброньовано: <strong>@Model.BookedSeats</strong> із <strong>@Model.TotalSeats</strong>
                                    <span class="text-muted">(вільно: @Model.FreeSeats)</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="stat-kpi p-3 h-100">
                                <div class="small text-muted">Бронювань</div>
                                <div class="fs-3 fw-bold">@Model.BookingsCount</div>
                                <div class="small text-muted">Середній чек: <strong>@Model.AverageBookingAmount.ToString("N0", ua)</strong> грн</div>
                                <div class="small text-muted">Середній квиток: <strong>@Model.AverageTicketPrice.ToString("N0", ua)</strong> грн</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="stat-kpi p-3 h-100">
                                <div class="small text-muted">Дохід з бронювань</div>
                                <div class="fs-3 fw-bold">@Model.TotalRevenue.ToString("N0", ua) грн</div>
                                <div class="small text-muted">Потенціал залу: @Model.PotentialRevenue.ToString("N0", ua) грн</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="stat-kpi p-3 h-100">
                                <div class="small text-muted">Ще можна продати</div>
                                <div class="fs-3 fw-bold">@Model.RemainingPotentialRevenue.ToString("N0", ua) грн</div>
                                <div class="small text-muted">Вільних місць: <strong>@Model.FreeSeats</strong></div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-12 col-lg-6">
                            <div class="fw-semibold mb-2">
                                <i class="fa-solid fa-layer-group me-1"></i>
                                Категорії місць
                            </div>
                            <div class="table-responsive border rounded bg-white">
                                <table class="table table-sm table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Категорія</th>
                                            <th class="text-end">Всього</th>
                                            <th class="text-end">Заброньовано</th>
                                            <th class="text-end">Вільно</th>
                                            <th class="text-end pe-3">Дохід</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in Model.CategoryStats)
                                        {
                                            <tr>
                                                <td class="ps-3">
                                                    <span class="@BadgeClass(c.Category) me-2">●</span>
                                                    <span class="fw-semibold">@CatLabel(c.Category)</span>
                                                </td>
                                                <td class="text-end">@c.Total</td>
                                                <td class="text-end fw-semibold">@c.Booked</td>
                                                <td class="text-end">@c.Free</td>
                                                <td class="text-end pe-3">@c.Revenue.ToString("N0", ua) грн</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="fw-semibold mb-2">
                                <i class="fa-solid fa-bars-staggered me-1"></i>
                                Ряди
                            </div>
                            <div class="table-responsive border rounded bg-white" style="max-height: 320px; overflow:auto;">
                                <table class="table table-sm table-hover mb-0 align-middle">
                                    <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                                        <tr>
                                            <th class="ps-3">Ряд</th>
                                            <th class="text-end">Забр./Всього</th>
                                            <th class="text-end">%</th>
                                            <th class="text-end pe-3">Дохід</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model.RowStats)
                                        {
                                            <tr>
                                                <td class="ps-3 fw-semibold">@r.Row</td>
                                                <td class="text-end">@r.Booked/@r.Total</td>
                                                <td class="text-end">@r.OccupancyPercent.ToString("0.##", ua)</td>
                                                <td class="text-end pe-3">@r.Revenue.ToString("N0", ua) грн</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm mt-4" style="background-color:#fff9e6;">
            <div class="card-header bg-maroon text-white">
                <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-chair me-2"></i>
                        Схема залу (ціни + бронювання)
                    </h5>

                    <div class="d-flex flex-wrap gap-3 small align-items-center">
                        @foreach (var cat in Enum.GetValues<SeatCategory>())
                        {
                            <span class="d-flex align-items-center">
                                <span class="@BadgeClass(cat) me-2"
                                      style="width:12px; height:12px; display:inline-block; padding:0; border-radius:50%;"></span>
                                <span class="text-white-50">@CatLabel(cat)</span>
                            </span>
                        }
                        <span class="d-flex align-items-center">
                            <span class="seat-legend-booked me-2"></span>
                            <span class="text-white-50">Заброньовано</span>
                        </span>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                @if (groupedSeats.Count == 0)
                {
                    <div class="alert alert-warning mb-0">
                        Схема залу порожня. Спочатку налаштуйте місця в залі.
                    </div>
                }
                else
                {
                    <div class="cinema-map-wrap">
                        <div class="cinema-map">

                            <div class="cinema-screen">
                                <div class="cinema-screen-arc"></div>
                                <div class="cinema-screen-title">ЕКРАН</div>
                            </div>

                            <div class="cinema-grid" style="--cols:@maxSeats;">
                                @foreach (var row in groupedSeats)
                                {
                                    var seatsInRow = row.OrderBy(x => x.Number).ToList();

                                    <div class="row-label">@row.Key</div>

                                    @for (int s = 1; s <= maxSeats; s++)
                                    {
                                        var seat = seatsInRow.FirstOrDefault(x => x.Number == s);

                                        if (seat == null)
                                        {
                                            <div class="seat seat-empty"></div>
                                        }
                                        else
                                        {
                                            var isBooked = seat.IsBooked;
                                            var priceText = seat.Price.ToString("N0", ua);

                                            var title = isBooked
                                            ? $"Ряд {seat.Row}, місце {s} — {priceText} грн | Заброньовано (бронь №{seat.BookingId})"
                                            : $"Ряд {seat.Row}, місце {s} — {priceText} грн | Вільно";

                            <div class="seat @SeatUiClass(seat.Category) @(isBooked ? "seat-booked" : "")" title="@title">
                                <div class="seat-text">
                                    <div class="seat-no">@s</div>
                                    <div class="seat-price">@seat.Price.ToString("0")</div>
                                </div>
                                @if (isBooked)
                                                {
                                                    <i class="fa-solid fa-lock seat-lock"></i>
                                                }
                                            </div>
                                        }
                                    }
                                }
                            </div>

                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</section>
