@using Infrastructure.Entities
@model Web.ViewModels.Admin.Sessions.SessionDetailsVm

@{
    ViewData["Title"] = "Деталі сеансу";

    string PtText(PresentationType pt) => pt switch
    {
        PresentationType.TwoD => "2D",
        PresentationType.ThreeD => "3D",
        _ => pt.ToString()
    };

    var now = DateTime.Now;
    var isOver = Model.EndTime <= now;
    var isFinished = !Model.IsCancelled && isOver;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Сеанс №@Model.Id</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">До списку</a>
</div>

@if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success mb-3">@ok</div>
}
@if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger mb-3">@err</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Фільм</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.MovieTitle) ? Model.MovieTitle : "—")</dd>

            <dt class="col-sm-3">Кінотеатр</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.CinemaName) ? Model.CinemaName : "—")</dd>

            <dt class="col-sm-3">Зал</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.HallName) ? Model.HallName : "—")</dd>

            <dt class="col-sm-3">Початок</dt>
            <dd class="col-sm-9">@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Кінець</dt>
            <dd class="col-sm-9">@Model.EndTime.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Тип показу</dt>
            <dd class="col-sm-9">@PtText(Model.PresentationType)</dd>

            <dt class="col-sm-3">Стан</dt>
            <dd class="col-sm-9">
                @if (Model.IsCancelled)
                {
                    <span class="badge bg-danger">Скасовано</span>
                }
                else if (isFinished)
                {
                    <span class="badge bg-dark">Завершено</span>
                }
                else
                {
                    <span class="badge bg-success">Активний</span>
                }
            </dd>

            <dt class="col-sm-3">Створено</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Оновлено</dt>
            <dd class="col-sm-9">@((Model.UpdatedAt.HasValue) ? Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm") : "—")</dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2 mt-3">
    @if (isFinished)
    {
        <span title="Не можна редагувати завершений сеанс.">
            <button class="btn btn-outline-secondary" type="button" disabled>
                Редагувати
            </button>
        </span>

        <span title="Не можна скасувати завершений сеанс.">
            <button class="btn btn-outline-danger" type="button" disabled>
                Скасувати
            </button>
        </span>
    }
    else if (!Model.IsCancelled)
    {
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Редагувати</a>

        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline"
              onsubmit="return confirm('Скасувати цей сеанс?');">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger" type="submit">Скасувати</button>
        </form>
    }
    else
    {
        <span title="Не можна редагувати скасований сеанс. Спочатку відновіть його.">
            <button class="btn btn-outline-secondary" type="button" disabled>
                Редагувати
            </button>
        </span>

        @if (isOver)
        {
            <span title="Не можна відновити завершений сеанс.">
                <button class="btn btn-outline-success" type="button" disabled>
                    Відновити
                </button>
            </span>
        }
        else
        {
            <form asp-action="Restore" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-success" type="submit">Відновити</button>
            </form>
        }
    }
</div>

