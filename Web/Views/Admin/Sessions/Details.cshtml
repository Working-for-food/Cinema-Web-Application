@using Infrastructure.Entities
@model Web.ViewModels.Admin.Sessions.SessionDetailsVm

@{
    ViewData["Title"] = "Деталі сеансу";

    string PtText(PresentationType pt) => pt switch
    {
        PresentationType.TwoD => "2D",
        PresentationType.ThreeD => "3D",
        _ => pt.ToString()
    };

    var now = DateTime.Now;
    var isOver = Model.EndTime <= now;
    var isFinished = !Model.IsCancelled && isOver;
}

<section class="py-5 gray-bg">
    <div class="container">

        <div class="card shadow-sm border-0 col-lg-8 mx-auto br-12 overflow-hidden">

            <div class="card-body p-4 p-lg-5">

                <div class="text-center mb-5">
                    <div class="icon-badge bg-white shadow-sm text-primary mb-4" style="width: 64px; height: 64px; border-radius: 50%;">
                        <i class="fa-solid fa-calendar-check fa-2x"></i>
                    </div>
                    <div class="header-subtitle text-uppercase fw-bold mb-1">Деталі сеансу</div>
                    <h2 class="header-title display-6">@(!string.IsNullOrWhiteSpace(Model.MovieTitle) ? Model.MovieTitle : "—")</h2>

                    <div class="mt-3">
                        @if (Model.IsCancelled)
                        {
                            <span class="badge bg-danger px-3 py-2">СКАСОВАНО</span>
                        }
                        else if (isFinished)
                        {
                            <span class="badge bg-dark px-3 py-2">ЗАВЕРШЕНО</span>
                        }
                        else
                        {
                            <span class="badge bg-success px-3 py-2">АКТИВНИЙ</span>
                        }
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="info-item">
                            <span class="info-item-label"><i class="fa-solid fa-film me-2"></i>Кінотеатр</span>
                            <span class="info-item-value">@Model.CinemaName</span>
                        </div>
                        <div class="info-item">
                            <span class="info-item-label"><i class="fa-solid fa-chair me-2"></i>Зал</span>
                            <span class="info-item-value">@Model.HallName</span>
                        </div>
                        <div class="info-item">
                            <span class="info-item-label"><i class="fa-solid fa-tv me-2"></i>Тип показу</span>
                            <span class="info-item-value">@PtText(Model.PresentationType)</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-item">
                            <span class="info-item-label"><i class="fa-solid fa-clock me-2"></i>Початок</span>
                            <span class="info-item-value">@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-item-label"><i class="fa-solid fa-clock-rotate-left me-2"></i>Кінець</span>
                            <span class="info-item-value">@Model.EndTime.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-item-label"><i class="fa-solid fa-calendar-plus me-2"></i>Створено</span>
                            <span class="info-item-value">@Model.CreatedAt.ToString("dd.MM.yyyy")</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center flex-wrap gap-3 mt-5 pt-4 border-top">
                    <a asp-action="Index" class="btn btn-secondary px-5 py-2 fw-bold text-uppercase">
                        <i class="fa-solid fa-arrow-left me-2"></i> Назад
                    </a>

                    @if (isFinished)
                    {
                        <button class="btn btn-secondary px-4 py-2" type="button" disabled>
                            <i class="fa-solid fa-pen-to-square me-2"></i> РЕДАГУВАТИ
                        </button>
                    }
                    else if (!Model.IsCancelled)
                    {
                        <a class="btn btn-maroon px-4 py-2 fw-bold shadow-sm" asp-action="Edit" asp-route-id="@Model.Id">
                            <i class="fa-solid fa-pen-to-square me-2"></i> РЕДАГУВАТИ
                        </a>

                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Скасувати цей сеанс?');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-danger-second px-4 py-2 fw-bold" type="submit">
                                <i class="fa-solid fa-ban me-2"></i> СКАСУВАТИ
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary px-4 py-2" type="button" disabled>
                            <i class="fa-solid fa-pen-to-square me-2"></i> РЕДАГУВАТИ
                        </button>

                        @if (!isOver)
                        {
                            <form asp-action="Restore" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-maroon px-4 py-2 fw-bold shadow-sm" type="submit">
                                    <i class="fa-solid fa-rotate-left me-2"></i> ВІДНОВИТИ
                                </button>
                            </form>
                        }
                    }
                </div>

            </div>
        </div>

    </div>
</section>