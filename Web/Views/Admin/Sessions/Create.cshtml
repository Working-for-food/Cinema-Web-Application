@using Infrastructure.Entities
@using System.Globalization
@model Web.ViewModels.Admin.Sessions.SessionEditVm

@{
    ViewData["Title"] = "Створити сеанс";

    var movieTitleFromPost = Context.Request.HasFormContentType && Context.Request.Form.ContainsKey("movieTitle")
        ? Context.Request.Form["movieTitle"].ToString()
        : "";

    var movieTitleFromQuery = Context.Request.Query["movieTitle"].ToString();

    var movieTitleValue = !string.IsNullOrWhiteSpace(movieTitleFromPost)
        ? movieTitleFromPost
        : movieTitleFromQuery;

    var isHallDisabled = Model.CinemaId <= 0;
    var hallPlaceholder = Model.CinemaId > 0 ? "— Оберіть зал —" : "— Спершу оберіть кінотеатр —";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <!-- HEADER як на "ІМПОРТ З TMDB" -->
        <h1 class="section-title text-center mb-4">НОВИЙ СЕАНС</h1>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div></div>

            <a class="btn btn-secondary" asp-action="Index">
                <i class="fa-solid fa-arrow-left me-1"></i>
                НАЗАД
            </a>
        </div>

        @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success mb-3" role="alert">@ok</div>
        }
        @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="alert alert-danger mb-3" role="alert">@err</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger mb-3" role="alert"></div>
        }

        <form asp-action="Create" method="post" novalidate id="createForm" asp-antiforgery="true">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <!-- LEFT -->
                <div class="col-12 col-lg-8">

                    <!-- Локація та час -->
                    <div class="card shadow-sm rounded-4 modern-card mb-3">
                        <div class="card-header bg-maroon text-white rounded-top-4">
                            <h5 class="mb-0">
                                <i class="fa-solid fa-location-dot me-2"></i>Локація та час
                            </h5>
                        </div>
                        <div class="card-body p-4 p-md-5">

                            <div class="row g-3 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label text-muted">
                                        <i class="fa-solid fa-film me-1"></i>Кінотеатр
                                    </label>

                                    <select class="form-select"
                                            asp-for="CinemaId"
                                            asp-items="Model.Cinemas"
                                            id="cinemaSelect">
                                        <option value="0">— Оберіть кінотеатр —</option>
                                    </select>

                                    <span class="text-danger" asp-validation-for="CinemaId"></span>
                                    <div class="form-text">Після вибору кінотеатру список залів оновиться.</div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label text-muted">
                                        <i class="fa-solid fa-chair me-1"></i>Зал
                                    </label>

                                    <select class="form-select"
                                            asp-for="HallId"
                                            asp-items="Model.Halls"
                                            id="hallSelect"
                                            disabled="@isHallDisabled"
                                            aria-disabled="@isHallDisabled">
                                        <option value="0">@hallPlaceholder</option>
                                    </select>

                                    <span class="text-danger" asp-validation-for="HallId"></span>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-muted">
                                        <i class="fa-solid fa-clock me-1"></i>Початок
                                    </label>

                                    <input class="form-control"
                                           asp-for="StartTime"
                                           id="StartTime"
                                           type="datetime-local"
                                           step="60" />

                                    <span class="text-danger" asp-validation-for="StartTime"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label text-muted">
                                        <i class="fa-solid fa-hourglass-end me-1"></i>Кінець
                                    </label>

                                    <input class="form-control"
                                           asp-for="EndTime"
                                           id="EndTime"
                                           type="datetime-local"
                                           step="60" />

                                    <div class="d-flex justify-content-between mt-2">
                                        <span class="form-text" id="movieDurationText">Тривалість: —</span>
                                        <span class="text-danger d-none fw-semibold" id="shortDurationWarn"></span>
                                    </div>

                                    <span class="text-danger" asp-validation-for="EndTime"></span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Фільм -->
                    <div class="card shadow-sm rounded-4 modern-card">
                        <div class="card-header bg-maroon text-white rounded-top-4">
                            <h5 class="mb-0">
                                <i class="fa-solid fa-clapperboard me-2"></i>Фільм
                            </h5>
                        </div>

                        <div class="card-body p-4 p-md-5">
                            <div class="row g-4 align-items-start">

                                <div class="col-auto">
                                    <div class="card overflow-hidden shadow-sm" style="width:150px;">
                                        <div class="bg-light d-flex align-items-center justify-content-center" style="width:150px;height:224px;">
                                            <img id="posterImg"
                                                 class="d-none w-100 h-100"
                                                 style="object-fit:cover;"
                                                 src=""
                                                 alt="Постер"
                                                 loading="lazy" />

                                            <div id="posterPlaceholder" class="text-muted text-center px-2">
                                                <i class="fa-regular fa-image fs-3 d-block mb-1"></i>
                                                Постер
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="mb-3">
                                        <label class="form-label text-muted">
                                            <i class="fa-solid fa-magnifying-glass me-1"></i>Назва фільму
                                        </label>

                                        <input class="form-control"
                                               list="movieList"
                                               id="movieTitleInput"
                                               name="movieTitle"
                                               placeholder="Почніть вводити назву..."
                                               autocomplete="off"
                                               value="@movieTitleValue" />

                                        <datalist id="movieList">
                                            @foreach (var m in Model.Movies)
                                            {
                                                <option value="@m.Text" data-id="@m.Value"></option>
                                            }
                                        </datalist>

                                        <input type="hidden" asp-for="MovieId" id="movieIdHidden" />
                                        <span class="text-danger" asp-validation-for="MovieId"></span>

                                        <div class="form-text">Пошук фільму по базі.</div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label class="form-label text-muted">
                                            <i class="fa-solid fa-ticket me-1"></i>Формат
                                        </label>
                                        <select class="form-select"
                                                asp-for="PresentationType"
                                                asp-items="Model.PresentationTypes"></select>
                                        <span class="text-danger" asp-validation-for="PresentationType"></span>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>

                <!-- RIGHT -->
                <div class="col-12 col-lg-4">

                    <div class="card shadow-sm rounded-4 modern-card h-100">
                        <div class="card-header bg-maroon text-white rounded-top-4">
                            <h5 class="mb-0">
                                <i class="fa-solid fa-tags me-2"></i>Ціноутворення
                            </h5>
                        </div>

                        <div class="card-body p-4 p-md-5">
                            <div class="alert alert-warning py-2 px-3 small mb-3">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                Формула: <strong>ціна ряду</strong> × <strong>множник категорії</strong>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">База по рядах (грн)</label>
                                <div id="rowPricesWrap" class="bg-white border rounded overflow-hidden">
                                    <div class="text-muted small text-center py-3">Оберіть зал</div>
                                </div>
                                <span class="text-danger" asp-validation-for="RowPrices"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Множники категорій</label>
                                <div id="catMultipliersWrap" class="bg-white border rounded overflow-hidden">
                                    <div class="text-muted small text-center py-3">Оберіть зал</div>
                                </div>
                                <span class="text-danger" asp-validation-for="CategoryMultipliers"></span>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top-0 p-4 p-md-5 pt-0">
                            <button class="btn btn-maroon w-100" type="submit">
                                <i class="fa-solid fa-check me-2"></i>Створити
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </form>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            // --- CONFIG ---
            const pricingMetaUrl = '@Url.Action("PricingMeta", "Sessions")';
            const hallsUrl = '@Url.Action("HallsByCinema", "Sessions")';

            // Server Data
            const movieDurations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, int>)(ViewBag.MovieDurations ?? new Dictionary<int, int>())));
            const moviePosters = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, string>)(ViewBag.MoviePosters ?? new Dictionary<int, string>())));

            // Initial Data
            const initialRowPrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RowPrices ?? new List<Web.ViewModels.Admin.Sessions.SessionEditVm.RowPriceVm>()));
            const initialCategoryMultipliers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryMultipliers ?? new List<Web.ViewModels.Admin.Sessions.SessionEditVm.CategoryMultiplierVm>()));

            // DOM Elements
            const els = {
                cinemaSelect: document.getElementById('cinemaSelect'),
                hallSelect: document.getElementById('hallSelect'),
                titleInput: document.getElementById('movieTitleInput'),
                movieIdHidden: document.getElementById('movieIdHidden'),
                movieList: document.getElementById('movieList'),
                startInput: document.getElementById('StartTime'),
                endInput: document.getElementById('EndTime'),
                durationText: document.getElementById('movieDurationText'),
                warn: document.getElementById('shortDurationWarn'),
                posterImg: document.getElementById('posterImg'),
                posterPlaceholder: document.getElementById('posterPlaceholder'),
                rowWrap: document.getElementById('rowPricesWrap'),
                catWrap: document.getElementById('catMultipliersWrap')
            };

            if (!els.cinemaSelect || !els.hallSelect) return;

            // --- HELPERS ---
            function buildMap(arr, keyProp, valProp) {
                const map = new Map();
                if (Array.isArray(arr)) {
                    for (const x of arr) {
                        const key = Number(x[keyProp] ?? x[keyProp.charAt(0).toUpperCase() + keyProp.slice(1)] ?? 0);
                        const val = x[valProp] ?? x[valProp.charAt(0).toUpperCase() + valProp.slice(1)];
                        if (key > 0 && val != null) map.set(key, val);
                    }
                }
                return map;
            }

            const initRowMap = buildMap(initialRowPrices, 'rowNumber', 'basePrice');
            const initCatMap = buildMap(initialCategoryMultipliers, 'category', 'multiplier');

            // --- RENDERERS ---
            function renderRowPrices(rows) {
                if (!els.rowWrap) return;

                if (!Array.isArray(rows) || rows.length === 0) {
                    els.rowWrap.innerHTML = `<div class="text-muted small text-center py-3">Пусто</div>`;
                    return;
                }

                els.rowWrap.innerHTML = `
                <table class="table table-sm table-borderless align-middle mb-0">
                  <thead class="table-light border-bottom">
                    <tr><th class="ps-3 text-secondary small">Ряд</th><th class="text-end pe-3 text-secondary small">Ціна</th></tr>
                  </thead>
                  <tbody>
                    ${rows.map((rowNumber, i) => {
                        const rn = Number(rowNumber);
                        const val = initRowMap.get(rn) ?? '100';
                        return `
                        <tr>
                          <td class="ps-3 small fw-bold text-muted">Ряд ${rn}</td>
                          <td class="text-end pe-2 py-1">
                            <input type="hidden" name="RowPrices[${i}].RowNumber" value="${rn}" />
                            <input class="form-control form-control-sm text-end"
                                   style="max-width: 90px; display: inline-block;"
                                   type="number" step="1" min="0"
                                   name="RowPrices[${i}].BasePrice"
                                   value="${val}" required />
                          </td>
                        </tr>`;
                    }).join('')}
                  </tbody>
                </table>`;
            }

            function renderCategoryMultipliers(categories) {
                if (!els.catWrap) return;

                if (!Array.isArray(categories) || categories.length === 0) {
                    els.catWrap.innerHTML = `<div class="text-muted small text-center py-3">Пусто</div>`;
                    return;
                }

                els.catWrap.innerHTML = `
                <table class="table table-sm table-borderless align-middle mb-0">
                  <thead class="table-light border-bottom">
                    <tr><th class="ps-3 text-secondary small">Категорія</th><th class="text-end pe-3 text-secondary small">Множ.</th></tr>
                  </thead>
                  <tbody>
                    ${categories.map((c, i) => {
                        const id = Number(c.id);
                        const title = String(c.title ?? id);
                        const val = initCatMap.get(id) ?? '1';
                        return `
                        <tr>
                          <td class="ps-3 small fw-bold text-muted text-truncate" style="max-width: 160px;" title="${title}">${title}</td>
                          <td class="text-end pe-2 py-1">
                            <input type="hidden" name="CategoryMultipliers[${i}].Category" value="${id}" />
                            <input class="form-control form-control-sm text-end"
                                   style="max-width: 90px; display: inline-block;"
                                   type="number" step="0.1" min="0.1"
                                   name="CategoryMultipliers[${i}].Multiplier"
                                   value="${val}" required />
                          </td>
                        </tr>`;
                    }).join('')}
                  </tbody>
                </table>`;
            }

            // --- FETCHERS ---
            async function loadHalls(cinemaId) {
                if (cinemaId <= 0) {
                    els.hallSelect.innerHTML = '<option value="0">— Спершу кінотеатр —</option>';
                    els.hallSelect.disabled = true;
                    clearPricing();
                    return;
                }
                try {
                    const res = await fetch(hallsUrl + '?cinemaId=' + cinemaId);
                    if (!res.ok) throw new Error();
                    const halls = await res.json();

                    els.hallSelect.innerHTML = '<option value="0">— Оберіть зал —</option>';
                    halls.forEach(h => {
                        const opt = document.createElement('option');
                        opt.value = h.id;
                        opt.textContent = h.title;
                        els.hallSelect.appendChild(opt);
                    });
                    els.hallSelect.disabled = false;
                } catch { }
            }

            function clearPricing() {
                els.rowWrap.innerHTML = '<div class="text-muted small text-center py-3">Оберіть зал</div>';
                els.catWrap.innerHTML = '<div class="text-muted small text-center py-3">Оберіть зал</div>';
            }

            async function loadPricingMeta(hallId) {
                const hid = Number(hallId || 0);
                if (hid < 1) { clearPricing(); return; }

                try {
                    const res = await fetch(pricingMetaUrl + '?hallId=' + encodeURIComponent(hid));
                    if (!res.ok) throw new Error();
                    const meta = await res.json();
                    renderRowPrices(meta.rows);
                    renderCategoryMultipliers(meta.categories);
                } catch {
                    els.rowWrap.innerHTML = '<div class="text-danger small text-center py-2">Помилка</div>';
                    els.catWrap.innerHTML = '<div class="text-danger small text-center py-2">Помилка</div>';
                }
            }

            // --- MOVIE & DATE LOGIC ---
            function posterUrl(path) {
                if (!path) return '';
                if (path.startsWith('http')) return path;
                return `https://image.tmdb.org/t/p/w154${path.startsWith('/') ? path : '/' + path}`;
            }

            function findSelectedMovieIdByTitle() {
                const val = (els.titleInput.value || '').trim();
                if (!els.movieList) return "0";
                const opt = Array.from(els.movieList.options).find(o => o.value === val);
                return opt ? (opt.dataset.id || "0") : "0";
            }

            function updateUIForMovie() {
                const newId = findSelectedMovieIdByTitle();
                els.movieIdHidden.value = newId;
                const id = Number(newId || 0);

                const path = moviePosters[id];
                const url = posterUrl(path);
                if (url) {
                    els.posterImg.src = url;
                    els.posterImg.classList.remove('d-none');
                    els.posterPlaceholder.classList.add('d-none');
                } else {
                    els.posterImg.classList.add('d-none');
                    els.posterPlaceholder.classList.remove('d-none');
                }

                const dur = movieDurations[id];
                els.durationText.textContent = (dur > 0) ? `Тривалість: ${dur} хв` : "Тривалість: —";

                const startVal = els.startInput.value;
                if (dur > 0 && startVal) {
                    const start = new Date(startVal);
                    if (!isNaN(start)) {
                        const end = new Date(start.getTime() + dur * 60000);
                        const pad = n => String(n).padStart(2, '0');
                        els.endInput.value = `${end.getFullYear()}-${pad(end.getMonth() + 1)}-${pad(end.getDate())}T${pad(end.getHours())}:${pad(end.getMinutes())}`;
                    }
                }

                const start = new Date(els.startInput.value);
                const end = new Date(els.endInput.value);
                if (dur > 0 && !isNaN(start) && !isNaN(end)) {
                    const diffMins = (end - start) / 60000;
                    if (diffMins < dur) {
                        els.warn.classList.remove('d-none');
                        els.warn.textContent = `Час (${Math.round(diffMins)} хв) менший за фільм (${dur} хв)`;
                    } else {
                        els.warn.classList.add('d-none');
                    }
                } else {
                    els.warn.classList.add('d-none');
                }
            }

            // --- EVENTS ---
            els.cinemaSelect.addEventListener('change', () => loadHalls(els.cinemaSelect.value));
            els.hallSelect.addEventListener('change', () => loadPricingMeta(els.hallSelect.value));

            els.titleInput.addEventListener('input', updateUIForMovie);
            els.startInput.addEventListener('change', updateUIForMovie);
            els.endInput.addEventListener('change', updateUIForMovie);

            // Init
            if (Number(els.hallSelect.value || 0) > 0) loadPricingMeta(els.hallSelect.value);
            updateUIForMovie();

        })();
    </script>
}

