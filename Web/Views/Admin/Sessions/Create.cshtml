@using Infrastructure.Entities
@model Web.ViewModels.Admin.Sessions.SessionEditVm

@{
    ViewData["Title"] = "Створення сеансу";

    var movieTitleFromPost = Context.Request.HasFormContentType && Context.Request.Form.ContainsKey("movieTitle")
        ? Context.Request.Form["movieTitle"].ToString()
        : "";

    var movieTitleFromQuery = Context.Request.Query["movieTitle"].ToString();

    var movieTitleValue = !string.IsNullOrWhiteSpace(movieTitleFromPost)
        ? movieTitleFromPost
        : movieTitleFromQuery;

    var isHallDisabled = Model.CinemaId <= 0;
    var hallPlaceholder = Model.CinemaId > 0 ? "— Оберіть зал —" : "— Спершу оберіть кінотеатр —";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="section-title mb-1">Новий сеанс</h1>

            <a class="btn btn-secondary shadow-sm br-8 px-3" asp-action="Index">
                <i class="fa-solid fa-arrow-left me-2"></i>НАЗАД ДО СЕАНСІВ
            </a>
        </div>

        @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 br-12">@ok</div>
        }
        @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-12">@err</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger border-0 small br-8 shadow-none mb-4"></div>
        }

        <form asp-action="Create" method="post" novalidate id="createForm" asp-antiforgery="true">
            @Html.AntiForgeryToken()

            <div class="row g-4 align-items-stretch">

                <div class="col-12 col-lg-7 d-flex">
                    <div class="card shadow-sm border-0 br-12 overflow-hidden flex-grow-1">
                        <div class="card-body p-4">

                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                <h5 class="fw-bold text-muted text-uppercase small mb-0 letter-spacing-1">
                                    <i class="fa-solid fa-location-dot me-2 text-primary"></i> Локація та час
                                </h5>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Кінотеатр</label>
                                    <select class="form-select border-2 br-8 shadow-none"
                                            asp-for="CinemaId"
                                            asp-items="Model.Cinemas"
                                            id="cinemaSelect">
                                        <option value="0">— Оберіть кінотеатр —</option>
                                    </select>
                                    <span class="text-danger small" asp-validation-for="CinemaId"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Зал</label>
                                    <select class="form-select border-2 br-8 shadow-none"
                                            asp-for="HallId"
                                            asp-items="Model.Halls"
                                            id="hallSelect"
                                            disabled="@isHallDisabled"
                                            aria-disabled="@isHallDisabled">
                                        <option value="0">@hallPlaceholder</option>
                                    </select>
                                    <span class="text-danger small" asp-validation-for="HallId"></span>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Початок</label>
                                    <input class="form-control border-2 br-8 shadow-none"
                                           asp-for="StartTime"
                                           id="StartTime"
                                           type="datetime-local"
                                           step="60" />
                                    <span class="text-danger small" asp-validation-for="StartTime"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Кінець</label>
                                    <input class="form-control border-2 br-8 shadow-none"
                                           asp-for="EndTime"
                                           id="EndTime"
                                           type="datetime-local"
                                           step="60" />

                                    <div class="d-flex justify-content-between mt-2">
                                        <span class="form-text x-small fw-bold text-primary" id="movieDurationText">ТРИВАЛІСТЬ: —</span>
                                        <span class="text-danger d-none fw-semibold x-small" id="shortDurationWarn"></span>
                                    </div>

                                    <span class="text-danger small" asp-validation-for="EndTime"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-5 d-flex">
                    <div class="card shadow-sm border-0 br-12 overflow-hidden flex-grow-1">
                        <div class="card-body p-4 d-flex flex-column">

                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                <h5 class="fw-bold text-muted text-uppercase small mb-0 letter-spacing-1">
                                    <i class="fa-solid fa-clapperboard me-2 text-primary"></i> Вибір фільму
                                </h5>
                            </div>

                            <div class="d-flex gap-3 align-items-stretch flex-grow-1">

                                <div class="flex-shrink-0 d-none d-md-block">
                                    <div class="h-100 shadow-sm border br-8 overflow-hidden bg-light" style="width:140px;">
                                        <img id="posterImg"
                                             class="d-none w-100 h-100"
                                             style="object-fit:cover;"
                                             src=""
                                             alt="Постер"
                                             loading="lazy" />
                                        <div id="posterPlaceholder"
                                             class="h-100 w-100 d-flex flex-column align-items-center justify-content-center text-muted opacity-50 small text-center px-2">
                                            <i class="fa-solid fa-image fa-2x mb-2"></i>
                                            Постер
                                        </div>
                                    </div>
                                </div>

                                <div class="flex-grow-1 d-flex flex-column" style="min-width:0;">
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted text-uppercase">Назва фільму</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white border-2 border-end-0 br-left-8 text-muted">
                                                <i class="fa-solid fa-magnifying-glass"></i>
                                            </span>
                                            <input class="form-control border-2 border-start-0 br-right-8 shadow-none"
                                                   list="movieList"
                                                   id="movieTitleInput"
                                                   name="movieTitle"
                                                   placeholder="Почніть вводити назву..."
                                                   autocomplete="off"
                                                   value="@movieTitleValue" />
                                        </div>

                                        <datalist id="movieList">
                                            @foreach (var m in Model.Movies)
                                            {
                                                <option value="@m.Text" data-id="@m.Value"></option>
                                            }
                                        </datalist>

                                        <input type="hidden" asp-for="MovieId" id="movieIdHidden" />
                                        <span class="text-danger small" asp-validation-for="MovieId"></span>

                                        <div id="movieInfoPanel" class="d-none mt-2">
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 fw-normal">
                                                <i class="fa-regular fa-calendar me-1"></i>
                                                Прем'єра: <strong id="movieReleaseDateDisplay">...</strong>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="mt-auto">
                                        <label class="form-label small fw-bold text-muted text-uppercase">Формат показу</label>
                                        <select class="form-select border-2 br-8 shadow-none"
                                                asp-for="PresentationType"
                                                asp-items="Model.PresentationTypes"></select>
                                        <span class="text-danger small" asp-validation-for="PresentationType"></span>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>

            <div class="row g-4 mt-4">

                <div class="col-12 col-lg-4">
                    <div class="card border-0 br-12 shadow-sm overflow-hidden h-100">
                        <div class="card-body p-4 d-flex flex-column h-100">

                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                <h5 class="fw-bold text-muted text-uppercase small mb-0 letter-spacing-1">
                                    <i class="fa-solid fa-coins me-2 text-primary"></i> Ціноутворення
                                </h5>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase mb-2">Шаблон цін</label>

                                <div class="input-group input-group-sm br-8 overflow-hidden border border-2">
                                    <select class="form-select border-0 shadow-none" id="templateSelect" disabled>
                                        <option value="0">Спочатку оберіть зал</option>
                                    </select>

                                    <button class="btn btn-outline-secondary border-0 border-start border-2 px-3"
                                            type="button"
                                            id="applyTemplateBtn"
                                            disabled>
                                        <i class="fa-solid fa-arrow-down me-2"></i><span class="fw-semibold">Заст.</span>
                                    </button>
                                </div>

                                <div class="form-text small visually-hidden" id="templateHelp">Автозаповнення цін за шаблоном.</div>
                            </div>

                            <div class="p-3 br-12 border bg-light mt-4 mb-3">
                                <div class="d-flex gap-3 align-items-start">
                                    <div class="d-inline-flex align-items-center justify-content-center br-10 bg-white border shadow-sm"
                                         style="width:38px; height:38px;">
                                        <i class="fa-solid fa-circle-info text-primary"></i>
                                    </div>

                                    <div class="small text-dark lh-sm">
                                        <div class="text-muted text-uppercase fw-bold" style="font-size:.72rem; letter-spacing:.06em;">
                                            Пояснення
                                        </div>

                                        <ul class="mb-0 ps-3">
                                            <li><strong>Ціна ряду</strong> × <strong>Множник категорії</strong></li>
                                            <li>На вкладці <strong>Ряди</strong> задайте базову ціну та винятки.</li>
                                            <li>На вкладці <strong>Категорії</strong> виставте множники (x).</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="btn-group w-100"
                                     role="tablist"
                                     aria-label="Розділи ціноутворення"
                                     style="--bs-btn-active-bg: rgba(13,110,253,.12);
                --bs-btn-active-border-color: rgba(13,110,253,.35);
                --bs-btn-active-color: var(--bs-primary);
                --bs-btn-hover-border-color: rgba(13,110,253,.35);">
                                    <button class="btn btn-sm fw-semibold btn-outline-secondary border-2 br-left-8 active"
                                            id="tab-rows"
                                            data-bs-toggle="pill"
                                            data-bs-target="#pane-rows"
                                            type="button"
                                            role="tab"
                                            aria-controls="pane-rows"
                                            aria-selected="true">
                                        <i class="fa-solid fa-layer-group me-2"></i>Ряди
                                    </button>

                                    <button class="btn btn-sm fw-semibold btn-outline-secondary border-2 br-right-8"
                                            id="tab-cats"
                                            data-bs-toggle="pill"
                                            data-bs-target="#pane-cats"
                                            type="button"
                                            role="tab"
                                            aria-controls="pane-cats"
                                            aria-selected="false">
                                        <i class="fa-solid fa-tags me-2"></i>Категорії
                                    </button>
                                </div>
                            </div>


                            <div class="tab-content flex-grow-1" style="min-height:0;">
                                <div class="tab-pane fade show active h-100" id="pane-rows" role="tabpanel" aria-labelledby="tab-rows" tabindex="0">
                                    <div id="rowPricesUi"
                                         class="bg-white border-2 br-10 overflow-auto p-3"
                                         style="max-height: 360px; min-height: 180px;">
                                        <div class="text-muted small text-center py-4">Оберіть зал</div>
                                    </div>

                                    <div id="hiddenRowPrices"></div>
                                    <span class="text-danger small" asp-validation-for="RowPrices"></span>
                                </div>

                                <div class="tab-pane fade h-100" id="pane-cats" role="tabpanel" aria-labelledby="tab-cats" tabindex="0">
                                    <div id="catMultipliersWrap"
                                         class="bg-white border-2 br-10 overflow-auto p-3"
                                         style="max-height: 360px; min-height: 180px;">
                                        <div class="text-muted small text-center py-4">Оберіть зал</div>
                                    </div>

                                    <span class="text-danger small" asp-validation-for="CategoryMultipliers"></span>
                                </div>
                            </div>

                            <div class="mt-auto pt-3 border-top">
                                <button class="btn btn-maroon w-100 py-3 fw-bold shadow-sm" type="submit">
                                    <i class="fa-solid fa-plus me-2"></i> СТВОРИТИ СЕАНС
                                </button>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-8">
                    <div class="card border-0 br-12 shadow-sm overflow-hidden h-100">
                        <div class="card-body p-0 d-flex flex-column h-100">

                            <div class="p-4 border-bottom bg-white">
                                <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                                    <div>
                                        <div class="fw-bold text-muted text-uppercase small mb-0 letter-spacing-1">
                                            Попередній перегляд цін
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <span class="d-inline-flex align-items-center gap-2 px-2 py-1 br-8 border bg-light">
                                            <span class="d-inline-block br-4 seat-bg-std" style="width:12px;height:12px;"></span>
                                            <span class="small text-muted fw-semibold">Звичайні</span>
                                        </span>
                                        <span class="d-inline-flex align-items-center gap-2 px-2 py-1 br-8 border bg-light">
                                            <span class="d-inline-block br-4 seat-bg-vip" style="width:12px;height:12px;"></span>
                                            <span class="small text-muted fw-semibold">VIP</span>
                                        </span>
                                        <span class="d-inline-flex align-items-center gap-2 px-2 py-1 br-8 border bg-light">
                                            <span class="d-inline-block br-4 seat-bg-acc" style="width:12px;height:12px;"></span>
                                            <span class="small text-muted fw-semibold">Інклюзивні</span>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="p-4 flex-grow-1" style="min-height:0;">
                                <div id="seatPreviewWrap"
                                     class="bg-white border-2 br-12 p-3 h-100"
                                     style="min-height: 360px;">
                                    <div class="text-muted small text-center py-4">
                                        <i class="fa-solid fa-chair me-2"></i>Оберіть зал, щоб побачити мапу
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </form>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const urls = {
                pricingMeta: '@Url.Action("PricingMeta", "Sessions", new { Area = "Admin" })',
                hallsByCinema: '@Url.Action("HallsByCinema", "Sessions", new { Area = "Admin" })',
                templatesByHall: '@Url.Action("GetTemplatesByHall", "Sessions", new { Area = "Admin" })',
                loadTemplate: '@Url.Action("LoadTemplateData", "Sessions", new { Area = "Admin" })'
            };

            const movieDurations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, int>)(ViewBag.MovieDurations ?? new Dictionary<int, int>())));
            const moviePosters = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, string>)(ViewBag.MoviePosters ?? new Dictionary<int, string>())));
            const movieReleaseDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, string>)(ViewBag.MovieReleaseDates ?? new Dictionary<int, string>())));

            const initialRowPrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RowPrices ?? new List<Web.ViewModels.Admin.Sessions.SessionEditVm.RowPriceVm>()));
            const initialCategoryMultipliers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryMultipliers ?? new List<Web.ViewModels.Admin.Sessions.SessionEditVm.CategoryMultiplierVm>()));

            const CAT = {
                Standard: @((int)SeatCategory.Standard),
                Vip: @((int)SeatCategory.Vip),
                Accessible: @((int)SeatCategory.Accessible)
            };

            const $ = (id) => document.getElementById(id);
            const pad2 = (n) => String(n).padStart(2, '0');
            const toInputDt = (d) => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}T${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
            const parseDt = (v) => {
                const d = new Date(v || '');
                return isNaN(d) ? null : d;
            };

            const els = {
                form: $('createForm'),
                cinema: $('cinemaSelect'),
                hall: $('hallSelect'),

                title: $('movieTitleInput'),
                movieId: $('movieIdHidden'),
                movieList: $('movieList'),

                start: $('StartTime'),
                end: $('EndTime'),
                durationText: $('movieDurationText'),
                warn: $('shortDurationWarn'),

                poster: $('posterImg'),
                posterPh: $('posterPlaceholder'),
                release: $('movieReleaseDateDisplay'),
                infoPanel: $('movieInfoPanel'),

                rowUi: $('rowPricesUi'),
                hiddenRows: $('hiddenRowPrices'),
                catWrap: $('catMultipliersWrap'),

                templateSelect: $('templateSelect'),
                applyTemplate: $('applyTemplateBtn'),
                templateHelp: $('templateHelp'),

                seatWrap: $('seatPreviewWrap')
            };

            if (!els.form || !els.cinema || !els.hall) return;

            const nowMin = () => {
                const n = new Date();
                return new Date(n.getFullYear(), n.getMonth(), n.getDate(), n.getHours(), n.getMinutes(), 0, 0);
            };

            const applyMinAndGray = () => {
                if (!els.start || !els.end) return;

                const now = nowMin();

                const existingMin = parseDt(els.start.min);
                const effectiveMin = (!existingMin || existingMin < now) ? now : existingMin;

                els.start.min = toInputDt(effectiveMin);

                const startVal = parseDt(els.start.value);
                const endMin = (startVal && startVal > effectiveMin) ? startVal : effectiveMin;
                els.end.min = toInputDt(endMin);

                const mark = (input) => {
                    const v = parseDt(input.value);
                    const m = parseDt(input.min);
                    input.classList.toggle('dt-past', !!(v && m && v < m));
                };

                mark(els.start);
                mark(els.end);
            };


            applyMinAndGray();

            els.start?.addEventListener('change', applyMinAndGray);
            els.end?.addEventListener('change', applyMinAndGray);

            els.form?.addEventListener('submit', applyMinAndGray);

            const state = {
                rows: [],
                basePrice: 100,
                rowPrices: new Map(),
                catMult: new Map(),
                hallMeta: null,
                lastMinEnd: null
            };

            if (Array.isArray(initialCategoryMultipliers)) {
                for (const x of initialCategoryMultipliers) {
                    const cat = x.Category ?? x.category;
                    const mult = x.Multiplier ?? x.multiplier;
                    if (cat != null && mult != null) state.catMult.set(Number(cat), Number(mult));
                }
            }

            const fetchJson = async (url, params) => {
                const qs = params ? ('?' + new URLSearchParams(params).toString()) : '';
                const res = await fetch(url + qs);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                return await res.json();
            };

            const seatClass = (catId) => (catId === CAT.Vip ? 'seat-bg-vip' : (catId === CAT.Accessible ? 'seat-bg-acc' : 'seat-bg-std'));
            const finalPrice = (row, catId) => {
                const base = state.rowPrices.has(row) ? Number(state.rowPrices.get(row)) : Number(state.basePrice);
                const mult = state.catMult.has(catId) ? Number(state.catMult.get(catId)) : 1;
                return Math.round(base * mult);
            };

            const posterUrl = (path) => {
                if (!path) return '';
                const p = String(path);
                if (p.startsWith('http')) return p;
                return `https://image.tmdb.org/t/p/w154${p.startsWith('/') ? p : '/' + p}`;
            };

            const getSelectedMovieId = () => {
                const val = (els.title?.value || '').trim();
                const opt = Array.from(els.movieList?.options || []).find(o => o.value === val);
                return Number(opt?.dataset?.id || 0);
            };

            const setWarn = (html, cls) => {
                if (!els.warn) return;
                els.warn.className = 'fw-semibold x-small ms-2';
                if (cls) els.warn.classList.add(cls);
                els.warn.innerHTML = html || '';
                els.warn.classList.toggle('d-none', !html);
            };

            const validateDurationLabel = (dur) => {
                const start = parseDt(els.start?.value);
                const end = parseDt(els.end?.value);
                if (!dur || !start || !end) return setWarn('', '');

                const diff = (end - start) / 60000;
                if (diff < dur - 1) return setWarn(`<i class="fa-solid fa-triangle-exclamation me-1"></i>Коротший за фільм (${Math.round(diff)} < ${dur} хв)`, 'text-danger');

                const extra = Math.round(diff - dur);
                if (extra > 0) return setWarn(`<i class="fa-solid fa-check me-1"></i>+${extra} хв`, 'text-success');

                setWarn('', '');
            };

            const minEndFor = (start, dur) => new Date(start.getTime() + dur * 60000);

            const normalizeEnd = (dur, preserveExtra) => {
                const start = parseDt(els.start?.value);
                if (!dur || dur <= 0 || !start) return;

                const end = parseDt(els.end?.value);
                const minEnd = minEndFor(start, dur);

                let extraMs = 0;
                if (preserveExtra && end && state.lastMinEnd) extraMs = Math.max(0, end - state.lastMinEnd);

                const target = new Date(minEnd.getTime() + extraMs);

                if (!end || end < minEnd || (preserveExtra && (extraMs > 0 || (end && state.lastMinEnd && end.getTime() === state.lastMinEnd.getTime())))) {
                    els.end.value = toInputDt(target);

                    if (end && end < minEnd) {
                        els.end.style.transition = 'background-color .25s';
                        els.end.style.backgroundColor = '#fff3cd';
                        setTimeout(() => els.end && (els.end.style.backgroundColor = ''), 600);
                    }
                }

                state.lastMinEnd = minEnd;
            };

            const updateMovieUi = (isInit) => {
                const id = isInit ? Number(els.movieId?.value || 0) : getSelectedMovieId();
                if (!isInit && els.movieId) els.movieId.value = String(id);

                const dur = Number(movieDurations[id] || 0);
                if (els.durationText) els.durationText.textContent = dur > 0 ? `ТРИВАЛІСТЬ ФІЛЬМУ: ${dur} хв` : 'ТРИВАЛІСТЬ: —';

                const posterPath = moviePosters[id];
                if (posterPath && els.poster && els.posterPh) {
                    els.poster.src = posterUrl(posterPath);
                    els.poster.classList.remove('d-none');
                    els.posterPh.classList.add('d-none');
                } else if (els.poster && els.posterPh) {
                    els.poster.classList.add('d-none');
                    els.posterPh.classList.remove('d-none');
                }

                const iso = movieReleaseDates[id];
                if (iso && els.infoPanel && els.release && els.start) {
                    const d = new Date(iso.includes('T') ? iso : (iso + 'T00:00'));
                    els.release.textContent = d.toLocaleDateString('uk-UA');
                    els.infoPanel.classList.remove('d-none');

                    const minDt = (iso.includes('T') ? iso.slice(0, 10) : iso) + 'T00:00';
                    els.start.min = minDt;
                } else {
                    els.infoPanel?.classList.add('d-none');
                    if (els.start) els.start.min = toInputDt(nowMin());
                }

                normalizeEnd(dur, true);
                validateDurationLabel(dur);
                applyMinAndGray();
            };

            const renderSeatPreview = (meta) => {
                const wrap = els.seatWrap;
                if (!wrap) return;

                const seats = Array.isArray(meta?.seats) ? meta.seats : [];
                const maxSeats = Number(meta?.maxSeats || 0);

                if (!seats.length || maxSeats <= 0) {
                    wrap.innerHTML = '<div class="text-muted small text-center py-3">Немає місць у залі</div>';
                    return;
                }

                const byRow = new Map();
                for (const s of seats) {
                    const r = Number(s.row);
                    const n = Number(s.number);
                    const c = Number(s.category);
                    if (!byRow.has(r)) byRow.set(r, new Map());
                    byRow.get(r).set(n, { row: r, number: n, category: c });
                }

                const rows = Array.isArray(meta?.rows) && meta.rows.length
                    ? meta.rows.map(Number)
                    : Array.from(byRow.keys()).sort((a, b) => a - b);

                let html = '';
                for (const row of rows) {
                    const rowMap = byRow.get(row) || new Map();
                    html += `<div class="row-label">${row}</div>`;
                    for (let s = 1; s <= maxSeats; s++) {
                        const seat = rowMap.get(s);
                        if (!seat) {
                            html += `<div class="seat seat-empty"></div>`;
                            continue;
                        }
                        const catId = Number(seat.category);
                        const price = finalPrice(row, catId);
                        html += `
                            <div class="seat ${seatClass(catId)} js-seat"
                                 data-row="${row}" data-cat="${catId}" data-seat="${s}"
                                 title="Ряд ${row}, місце ${s} — ${price} грн">
                                <div class="seat-text">
                                    <div class="seat-no">${s}</div>
                                    <div class="seat-price js-seat-price">${price}</div>
                                </div>
                            </div>
                        `;
                    }
                }

                wrap.innerHTML = `
                    <div class="cinema-map-wrap">
                        <div class="cinema-map">
                            <div class="cinema-screen">
                                <div class="cinema-screen-arc"></div>
                                <div class="cinema-screen-title">ЕКРАН</div>
                            </div>
                            <div class="cinema-grid" style="--cols:${maxSeats};">${html}</div>
                        </div>
                    </div>
                `;
            };

            const recalcSeatPreview = () => {
                const wrap = els.seatWrap;
                if (!wrap) return;

                wrap.querySelectorAll('.js-seat').forEach(el => {
                    const row = Number(el.dataset.row);
                    const cat = Number(el.dataset.cat);
                    const seatNo = el.dataset.seat || '';
                    const price = finalPrice(row, cat);

                    const priceEl = el.querySelector('.js-seat-price');
                    if (priceEl && priceEl.textContent !== String(price)) {
                        priceEl.style.opacity = '0.5';
                        priceEl.textContent = String(price);
                        setTimeout(() => priceEl && (priceEl.style.opacity = '1'), 150);
                    }
                    el.title = `Ряд ${row}, місце ${seatNo} — ${price} грн`;
                });
            };

            const parseRowPricesToState = (flat) => {
                const list = (flat || [])
                    .map(p => ({
                        row: Number(p.RowNumber ?? p.row ?? p.Row ?? 0),
                        price: Number(p.BasePrice ?? p.basePrice ?? 0)
                    }))
                    .filter(x => x.row > 0);

                if (!list.length) return;

                const counts = {};
                for (const x of list) counts[String(x.price)] = (counts[String(x.price)] || 0) + 1;

                const mode = Number(Object.keys(counts).sort((a, b) => counts[b] - counts[a])[0] ?? 100);
                state.basePrice = Number.isFinite(mode) ? mode : 100;

                state.rowPrices.clear();
                for (const x of list) {
                    if (state.rows.includes(x.row) && x.price !== state.basePrice) state.rowPrices.set(x.row, x.price);
                }
            };

            const syncHiddenRowInputs = () => {
                if (!els.hiddenRows) return;

                els.hiddenRows.innerHTML = '';
                state.rows.forEach((r, i) => {
                    const price = state.rowPrices.has(r) ? Number(state.rowPrices.get(r)) : Number(state.basePrice);

                    const a = document.createElement('input');
                    a.type = 'hidden';
                    a.name = `RowPrices[${i}].RowNumber`;
                    a.value = String(r);

                    const b = document.createElement('input');
                    b.type = 'hidden';
                    b.name = `RowPrices[${i}].BasePrice`;
                    b.value = String(price);

                    els.hiddenRows.append(a, b);
                });

                recalcSeatPreview();
            };

            const renderRowsUi = () => {
                if (!els.rowUi) return;

                const exRows = Array.from(state.rowPrices.keys()).sort((a, b) => a - b);
                const exHtml = exRows.length
                    ? exRows.map(r => {
                        const v = Number(state.rowPrices.get(r));
                        return `
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-secondary fw-normal" style="min-width:56px;">Ряд ${r}</span>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white border-2 border-end-0 br-left-8">₴</span>
                                    <input type="number" class="form-control border-2 border-start-0 shadow-none text-end js-ex-price" data-row="${r}" value="${v}" min="0" />
                                    <button type="button" class="btn btn-sm btn-outline-danger border-2 br-right-8 js-ex-del" data-row="${r}" title="Видалити">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                        `;
                    }).join('')
                    : `<div class="text-muted small fst-italic ms-1" id="noExMsg">Немає (всі ряди по ${state.basePrice} грн)</div>`;

                const addOpts = state.rows
                    .filter(r => !state.rowPrices.has(r))
                    .map(r => `<option value="${r}">Ряд ${r}</option>`)
                    .join('');

                els.rowUi.innerHTML = `
                    <div class="mb-3">
                        <label class="form-label x-small fw-bold text-muted text-uppercase" for="basePriceInput">Базова ціна (грн)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-2 border-end-0 br-left-8">₴</span>
                            <input type="number" id="basePriceInput" class="form-control border-2 border-start-0 br-right-8 shadow-none fw-bold" value="${state.basePrice}" min="0" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label x-small fw-bold text-muted text-uppercase mb-1">Винятки</label>
                        <div class="d-flex flex-column gap-2 mb-2">${exHtml}</div>
                    </div>

                    <div class="bg-light-soft p-2 br-8">
                        <div class="d-flex gap-2">
                            <select id="exRow" class="form-select form-select-sm border-2 br-8 shadow-none">
                                <option value="">+ Ряд</option>
                                ${addOpts}
                            </select>
                            <button type="button" id="exAdd" class="btn btn-sm btn-secondary text-nowrap br-8 px-3 shadow-sm">Додати</button>
                        </div>
                        <div class="form-text small mt-1">Виняток перевизначає базову ціну для конкретного ряду.</div>
                    </div>
                `;

                syncHiddenRowInputs();

                $('basePriceInput')?.addEventListener('input', (e) => {
                    const v = Number(e.target.value);
                    if (!Number.isFinite(v) || v < 0) return;
                    state.basePrice = v;
                    syncHiddenRowInputs();
                    const msg = $('noExMsg');
                    if (msg) msg.textContent = `Немає (всі ряди по ${state.basePrice} грн)`;
                });

                $('exAdd')?.addEventListener('click', () => {
                    const row = Number($('exRow')?.value || 0);
                    if (!row) return;
                    state.rowPrices.set(row, state.basePrice);
                    renderRowsUi();
                });

                els.rowUi.querySelectorAll('.js-ex-del').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const row = Number(btn.dataset.row || 0);
                        if (!row) return;
                        state.rowPrices.delete(row);
                        renderRowsUi();
                    });
                });

                els.rowUi.querySelectorAll('.js-ex-price').forEach(inp => {
                    inp.addEventListener('input', () => {
                        const row = Number(inp.dataset.row || 0);
                        const v = Number(inp.value);
                        if (!row || !Number.isFinite(v) || v < 0) return;
                        state.rowPrices.set(row, v);
                        syncHiddenRowInputs();
                    });
                });
            };

            const renderCatsUi = (cats) => {
                if (!els.catWrap) return;

                if (!Array.isArray(cats) || !cats.length) {
                    els.catWrap.innerHTML = `<div class="text-muted small text-center py-3">Немає категорій</div>`;
                    return;
                }

                els.catWrap.innerHTML = `
                    <table class="table table-sm table-borderless align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="ps-3 small text-secondary">Категорія</th>
                                <th class="text-end pe-3 small text-secondary">x</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${cats.map((c, i) => {
                                const id = Number(c.id);
                                const title = String(c.title ?? id);
                                const val = state.catMult.has(id) ? Number(state.catMult.get(id)) : 1;
                                if (!state.catMult.has(id)) state.catMult.set(id, val);

                                return `
                                    <tr>
                                        <td class="ps-3 small fw-bold text-muted text-truncate" style="max-width:180px;" title="${title}">${title}</td>
                                        <td class="text-end pe-2 py-1">
                                            <input type="hidden" name="CategoryMultipliers[${i}].Category" value="${id}" />
                                            <input class="form-control form-control-sm text-end js-cat border-2 br-8 shadow-none"
                                                   style="width:90px; display:inline;"
                                                   type="number" step="0.1" min="0.1"
                                                   data-cat="${id}"
                                                   name="CategoryMultipliers[${i}].Multiplier"
                                                   value="${val}" />
                                        </td>
                                    </tr>
                                `;
                            }).join('')}
                        </tbody>
                    </table>
                `;
            };

            els.catWrap?.addEventListener('input', (e) => {
                const t = e.target;
                if (!(t instanceof HTMLInputElement)) return;
                if (!t.classList.contains('js-cat')) return;

                const cid = Number(t.dataset.cat || 0);
                const v = Number(t.value);
                if (!cid || !Number.isFinite(v)) return;

                state.catMult.set(cid, v);
                recalcSeatPreview();
            });

            const resetTemplates = () => {
                if (!els.templateSelect || !els.applyTemplate) return;
                els.templateSelect.innerHTML = '<option value="0">Спочатку оберіть зал</option>';
                els.templateSelect.disabled = true;
                els.applyTemplate.disabled = true;
            };

            const loadTemplates = async (hallId) => {
                if (!els.templateSelect || !els.applyTemplate) return;

                const hid = Number(hallId || 0);
                if (!hid) return resetTemplates();

                els.templateSelect.innerHTML = '<option value="0">Завантаження...</option>';
                els.templateSelect.disabled = true;
                els.applyTemplate.disabled = true;

                try {
                    const list = await fetchJson(urls.templatesByHall, { hallId: hid });
                    if (!Array.isArray(list) || !list.length) {
                        els.templateSelect.innerHTML = '<option value="0">Шаблони відсутні</option>';
                        els.templateSelect.disabled = true;
                        els.applyTemplate.disabled = true;
                        return;
                    }

                    els.templateSelect.innerHTML = '<option value="0">— Оберіть шаблон —</option>';
                    for (const t of list) {
                        const opt = document.createElement('option');
                        opt.value = String(t.id);
                        opt.textContent = t.title;
                        els.templateSelect.appendChild(opt);
                    }
                    els.templateSelect.disabled = false;
                } catch {
                    els.templateSelect.innerHTML = '<option value="0">Помилка</option>';
                    els.templateSelect.disabled = true;
                    els.applyTemplate.disabled = true;
                }
            };

            const applyTemplate = async () => {
                const tid = Number(els.templateSelect?.value || 0);
                if (!tid) return;

                const old = els.applyTemplate.innerHTML;
                els.applyTemplate.disabled = true;
                els.applyTemplate.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

                try {
                    const data = await fetchJson(urls.loadTemplate, { templateId: tid });

                    state.catMult.clear();
                    if (Array.isArray(data.categoryMultipliers)) {
                        for (const x of data.categoryMultipliers) {
                            const cat = Number(x.category ?? x.Category);
                            const mult = Number(x.multiplier ?? x.Multiplier);
                            if (Number.isFinite(cat) && Number.isFinite(mult)) state.catMult.set(cat, mult);
                        }
                    }

                    if (Array.isArray(data.rowPrices)) parseRowPricesToState(data.rowPrices);

                    if (state.hallMeta) {
                        renderRowsUi();
                        renderCatsUi(state.hallMeta.categories);
                        renderSeatPreview(state.hallMeta);
                        recalcSeatPreview();
                    }

                    if (els.templateHelp) {
                        els.templateHelp.textContent = 'Успішно застосовано!';
                        els.templateHelp.classList.add('text-success');
                        setTimeout(() => {
                            els.templateHelp.textContent = 'Автозаповнення цін за шаблоном.';
                            els.templateHelp.classList.remove('text-success');
                        }, 2000);
                    }
                } catch {
                    alert('Помилка застосування шаблону');
                } finally {
                    els.applyTemplate.innerHTML = old;
                    els.applyTemplate.disabled = false;
                }
            };

            const clearPricingUi = () => {
                els.rowUi && (els.rowUi.innerHTML = '<div class="text-muted small text-center py-3">Оберіть зал</div>');
                els.catWrap && (els.catWrap.innerHTML = '<div class="text-muted small text-center py-3">Оберіть зал</div>');
                els.seatWrap && (els.seatWrap.innerHTML = '<div class="text-muted small text-center py-3">Оберіть зал</div>');
                els.hiddenRows && (els.hiddenRows.innerHTML = '');

                state.rows = [];
                state.basePrice = 100;
                state.rowPrices.clear();
                state.hallMeta = null;
            };

            const loadPricingMeta = async (hallId) => {
                const hid = Number(hallId || 0);
                if (!hid) return clearPricingUi();

                try {
                    const meta = await fetchJson(urls.pricingMeta, { hallId: hid });
                    state.hallMeta = meta;
                    state.rows = Array.isArray(meta.rows) ? meta.rows.map(Number) : [];

                    if (Array.isArray(initialRowPrices) && initialRowPrices.length) {
                        parseRowPricesToState(initialRowPrices);
                        initialRowPrices.length = 0;
                    }

                    renderRowsUi();
                    renderCatsUi(meta.categories);
                    renderSeatPreview(meta);
                    recalcSeatPreview();
                } catch {
                    els.rowUi && (els.rowUi.innerHTML = '<div class="text-danger small text-center py-2">Помилка</div>');
                }
            };

            const loadHalls = async (cinemaId) => {
                const cid = Number(cinemaId || 0);
                if (!cid) {
                    els.hall.innerHTML = '<option value="0">— Спершу кінотеатр —</option>';
                    els.hall.disabled = true;
                    resetTemplates();
                    clearPricingUi();
                    return;
                }

                try {
                    const halls = await fetchJson(urls.hallsByCinema, { cinemaId: cid });
                    els.hall.innerHTML = '<option value="0">— Оберіть зал —</option>';
                    for (const h of (halls || [])) {
                        const opt = document.createElement('option');
                        opt.value = String(h.id);
                        opt.textContent = h.title;
                        els.hall.appendChild(opt);
                    }
                    els.hall.disabled = false;
                    resetTemplates();
                    clearPricingUi();
                } catch {
                    resetTemplates();
                    clearPricingUi();
                }
            };

            els.form.addEventListener('submit', () => {
                const id = Number(els.movieId?.value || 0);
                const dur = Number(movieDurations[id] || 0);
                normalizeEnd(dur, false);
            });

            els.title?.addEventListener('input', () => updateMovieUi(false));

            els.start?.addEventListener('change', () => {
                const id = Number(els.movieId?.value || 0);
                const dur = Number(movieDurations[id] || 0);
                normalizeEnd(dur, true);
                validateDurationLabel(dur);
            });

            els.end?.addEventListener('change', () => {
                const id = Number(els.movieId?.value || 0);
                const dur = Number(movieDurations[id] || 0);
                normalizeEnd(dur, false);
                validateDurationLabel(dur);
            });

            els.cinema.addEventListener('change', () => loadHalls(els.cinema.value));

            els.hall.addEventListener('change', async () => {
                const hid = els.hall.value;
                await loadPricingMeta(hid);
                await loadTemplates(hid);
            });

            els.templateSelect?.addEventListener('change', () => {
                if (!els.applyTemplate) return;
                els.applyTemplate.disabled = Number(els.templateSelect.value || 0) < 1;
            });

            els.applyTemplate?.addEventListener('click', applyTemplate);

            const initHall = Number(els.hall.value || 0);
            if (initHall > 0) {
                loadPricingMeta(initHall);
                loadTemplates(initHall);
            } else {
                clearPricingUi();
                resetTemplates();
            }

            updateMovieUi(true);
        })();
    </script>
}

