@using Infrastructure.Entities
@model Web.ViewModels.Admin.Sessions.SessionEditVm

@{
    ViewData["Title"] = "Створення сеансу";

    var movieTitleFromPost = Context.Request.HasFormContentType && Context.Request.Form.ContainsKey("movieTitle")
        ? Context.Request.Form["movieTitle"].ToString()
        : "";

    var movieTitleFromQuery = Context.Request.Query["movieTitle"].ToString();

    var movieTitleValue = !string.IsNullOrWhiteSpace(movieTitleFromPost)
        ? movieTitleFromPost
        : movieTitleFromQuery;

    var isHallDisabled = Model.CinemaId <= 0;
    var hallPlaceholder = Model.CinemaId > 0 ? "— Оберіть зал —" : "— Спершу оберіть кінотеатр —";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="section-title mb-1">Новий сеанс</h1>

            <a class="btn btn-secondary shadow-sm br-8 px-3" asp-action="Index">
                <i class="fa-solid fa-arrow-left me-2"></i>НАЗАД ДО СЕАНСІВ
            </a>
        </div>

        @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 br-12">@ok</div>
        }
        @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-12">@err</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger border-0 small br-8 shadow-none mb-4"></div>
        }

        <form asp-action="Create" method="post" novalidate id="createForm" asp-antiforgery="true">
            @Html.AntiForgeryToken()

            <div class="row g-4 align-items-stretch">

                <div class="col-12 col-lg-7 d-flex">
                    <div class="card shadow-sm border-0 br-12 overflow-hidden flex-grow-1">
                        <div class="card-body p-4">

                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                <h5 class="fw-bold text-muted text-uppercase small mb-0 letter-spacing-1">
                                    <i class="fa-solid fa-location-dot me-2 text-primary"></i> Локація та час
                                </h5>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Кінотеатр</label>
                                    <select class="form-select border-2 br-8 shadow-none"
                                            asp-for="CinemaId"
                                            asp-items="Model.Cinemas"
                                            id="cinemaSelect">
                                        <option value="0">— Оберіть кінотеатр —</option>
                                    </select>
                                    <span class="text-danger small" asp-validation-for="CinemaId"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Зал</label>
                                    <select class="form-select border-2 br-8 shadow-none"
                                            asp-for="HallId"
                                            asp-items="Model.Halls"
                                            id="hallSelect"
                                            disabled="@isHallDisabled"
                                            aria-disabled="@isHallDisabled">
                                        <option value="0">@hallPlaceholder</option>
                                    </select>
                                    <span class="text-danger small" asp-validation-for="HallId"></span>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Початок</label>
                                    <input class="form-control border-2 br-8 shadow-none"
                                           asp-for="StartTime"
                                           id="StartTime"
                                           type="datetime-local"
                                           step="60" />
                                    <span class="text-danger small" asp-validation-for="StartTime"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Кінець</label>
                                    <input class="form-control border-2 br-8 shadow-none"
                                           asp-for="EndTime"
                                           id="EndTime"
                                           type="datetime-local"
                                           step="60" />

                                    <div class="d-flex justify-content-between mt-2">
                                        <span class="form-text x-small fw-bold text-primary" id="movieDurationText">ТРИВАЛІСТЬ: —</span>
                                        <span class="text-danger d-none fw-semibold x-small" id="shortDurationWarn"></span>
                                    </div>

                                    <span class="text-danger small" asp-validation-for="EndTime"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-5 d-flex">
                    <div class="card shadow-sm border-0 br-12 overflow-hidden flex-grow-1">
                        <div class="card-body p-4 d-flex flex-column">

                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                <h5 class="fw-bold text-muted text-uppercase small mb-0 letter-spacing-1">
                                    <i class="fa-solid fa-clapperboard me-2 text-primary"></i> Вибір фільму
                                </h5>
                            </div>

                            <div class="d-flex gap-3 align-items-stretch flex-grow-1">

                                <div class="flex-shrink-0 d-none d-md-block">
                                    <div class="h-100 shadow-sm border br-8 overflow-hidden bg-light" style="width:140px;">
                                        <img id="posterImg"
                                             class="d-none w-100 h-100"
                                             style="object-fit:cover;"
                                             src=""
                                             alt="Постер"
                                             loading="lazy" />
                                        <div id="posterPlaceholder"
                                             class="h-100 w-100 d-flex flex-column align-items-center justify-content-center text-muted opacity-50 small text-center px-2">
                                            <i class="fa-solid fa-image fa-2x mb-2"></i>
                                            Постер
                                        </div>
                                    </div>
                                </div>

                                <div class="flex-grow-1 d-flex flex-column" style="min-width:0;">
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted text-uppercase">Назва фільму</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white border-2 border-end-0 br-left-8 text-muted">
                                                <i class="fa-solid fa-magnifying-glass"></i>
                                            </span>
                                            <input class="form-control border-2 border-start-0 br-right-8 shadow-none"
                                                   list="movieList"
                                                   id="movieTitleInput"
                                                   name="movieTitle"
                                                   placeholder="Почніть вводити назву..."
                                                   autocomplete="off"
                                                   value="@movieTitleValue" />
                                        </div>

                                        <datalist id="movieList">
                                            @foreach (var m in Model.Movies)
                                            {
                                                <option value="@m.Text" data-id="@m.Value"></option>
                                            }
                                        </datalist>

                                        <input type="hidden" asp-for="MovieId" id="movieIdHidden" />
                                        <span class="text-danger small" asp-validation-for="MovieId"></span>
                                    </div>

                                    <div class="mt-auto">
                                        <label class="form-label small fw-bold text-muted text-uppercase">Формат показу</label>
                                        <select class="form-select border-2 br-8 shadow-none"
                                                asp-for="PresentationType"
                                                asp-items="Model.PresentationTypes"></select>
                                        <span class="text-danger small" asp-validation-for="PresentationType"></span>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>

            <div class="row g-4 mt-4">

                <div class="col-12 col-lg-4">
                    <div class="card border-0 br-12 shadow-sm overflow-hidden h-100">
                        <div class="card-body p-4 d-flex flex-column h-100">

                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                <h5 class="fw-bold text-muted text-uppercase small mb-0 letter-spacing-1">
                                    <i class="fa-solid fa-coins me-2 text-primary"></i> Ціноутворення
                                </h5>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase mb-2">Шаблон цін</label>

                                <div class="input-group input-group-sm br-8 overflow-hidden border border-2">
                                    <select class="form-select border-0 shadow-none" id="templateSelect" disabled>
                                        <option value="0">Спочатку оберіть зал</option>
                                    </select>

                                    <button class="btn btn-outline-secondary border-0 border-start border-2 px-3"
                                            type="button"
                                            id="applyTemplateBtn"
                                            disabled>
                                        <i class="fa-solid fa-arrow-down me-2"></i><span class="fw-semibold">Заст.</span>
                                    </button>
                                </div>

                                <div class="form-text small visually-hidden" id="templateHelp">Автозаповнення цін за шаблоном.</div>
                            </div>

                            <div class="p-3 br-12 border bg-light mt-4 mb-3">
                                <div class="d-flex gap-3 align-items-start">
                                    <div class="d-inline-flex align-items-center justify-content-center br-10 bg-white border shadow-sm"
                                         style="width:38px; height:38px;">
                                        <i class="fa-solid fa-circle-info text-primary"></i>
                                    </div>

                                    <div class="small text-dark lh-sm">
                                        <div class="text-muted text-uppercase fw-bold" style="font-size:.72rem; letter-spacing:.06em;">
                                            Пояснення
                                        </div>

                                        <ul class="mb-0 ps-3">
                                            <li><strong>Ціна ряду</strong> × <strong>Множник категорії</strong></li>
                                            <li>На вкладці <strong>Ряди</strong> задайте базову ціну та винятки.</li>
                                            <li>На вкладці <strong>Категорії</strong> виставте множники (x).</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="btn-group w-100"
                                     role="tablist"
                                     aria-label="Розділи ціноутворення"
                                     style="--bs-btn-active-bg: rgba(13,110,253,.12);
                --bs-btn-active-border-color: rgba(13,110,253,.35);
                --bs-btn-active-color: var(--bs-primary);
                --bs-btn-hover-border-color: rgba(13,110,253,.35);">
                                    <button class="btn btn-sm fw-semibold btn-outline-secondary border-2 br-left-8 active"
                                            id="tab-rows"
                                            data-bs-toggle="pill"
                                            data-bs-target="#pane-rows"
                                            type="button"
                                            role="tab"
                                            aria-controls="pane-rows"
                                            aria-selected="true">
                                        <i class="fa-solid fa-layer-group me-2"></i>Ряди
                                    </button>

                                    <button class="btn btn-sm fw-semibold btn-outline-secondary border-2 br-right-8"
                                            id="tab-cats"
                                            data-bs-toggle="pill"
                                            data-bs-target="#pane-cats"
                                            type="button"
                                            role="tab"
                                            aria-controls="pane-cats"
                                            aria-selected="false">
                                        <i class="fa-solid fa-tags me-2"></i>Категорії
                                    </button>
                                </div>
                            </div>


                            <div class="tab-content flex-grow-1" style="min-height:0;">
                                <div class="tab-pane fade show active h-100" id="pane-rows" role="tabpanel" aria-labelledby="tab-rows" tabindex="0">
                                    <div id="rowPricesUi"
                                         class="bg-white border-2 br-10 overflow-auto p-3"
                                         style="max-height: 360px; min-height: 180px;">
                                        <div class="text-muted small text-center py-4">Оберіть зал</div>
                                    </div>

                                    <div id="hiddenRowPrices"></div>
                                    <span class="text-danger small" asp-validation-for="RowPrices"></span>
                                </div>

                                <div class="tab-pane fade h-100" id="pane-cats" role="tabpanel" aria-labelledby="tab-cats" tabindex="0">
                                    <div id="catMultipliersWrap"
                                         class="bg-white border-2 br-10 overflow-auto p-3"
                                         style="max-height: 360px; min-height: 180px;">
                                        <div class="text-muted small text-center py-4">Оберіть зал</div>
                                    </div>

                                    <span class="text-danger small" asp-validation-for="CategoryMultipliers"></span>
                                </div>
                            </div>

                            <div class="mt-auto pt-3 border-top">
                                <button class="btn btn-maroon w-100 py-3 fw-bold shadow-sm" type="submit">
                                    <i class="fa-solid fa-plus me-2"></i> СТВОРИТИ СЕАНС
                                </button>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-8">
                    <div class="card border-0 br-12 shadow-sm overflow-hidden h-100">
                        <div class="card-body p-0 d-flex flex-column h-100">

                            <div class="p-4 border-bottom bg-white">
                                <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                                    <div>
                                        <div class="fw-bold text-muted text-uppercase small mb-0 letter-spacing-1">
                                            Попередній перегляд цін
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <span class="d-inline-flex align-items-center gap-2 px-2 py-1 br-8 border bg-light">
                                            <span class="d-inline-block br-4 seat-bg-std" style="width:12px;height:12px;"></span>
                                            <span class="small text-muted fw-semibold">Звичайні</span>
                                        </span>
                                        <span class="d-inline-flex align-items-center gap-2 px-2 py-1 br-8 border bg-light">
                                            <span class="d-inline-block br-4 seat-bg-vip" style="width:12px;height:12px;"></span>
                                            <span class="small text-muted fw-semibold">VIP</span>
                                        </span>
                                        <span class="d-inline-flex align-items-center gap-2 px-2 py-1 br-8 border bg-light">
                                            <span class="d-inline-block br-4 seat-bg-acc" style="width:12px;height:12px;"></span>
                                            <span class="small text-muted fw-semibold">Інклюзивні</span>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="p-4 flex-grow-1" style="min-height:0;">
                                <div id="seatPreviewWrap"
                                     class="bg-white border-2 br-12 p-3 h-100"
                                     style="min-height: 360px;">
                                    <div class="text-muted small text-center py-4">
                                        <i class="fa-solid fa-chair me-2"></i>Оберіть зал, щоб побачити мапу
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </form>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const pricingMetaUrl = '@Url.Action("PricingMeta", "Sessions", new { Area = "Admin" })';
            const hallsUrl = '@Url.Action("HallsByCinema", "Sessions", new { Area = "Admin" })';
            const templatesUrl = '@Url.Action("GetTemplatesByHall", "Sessions", new { Area = "Admin" })';
            const loadTemplateUrl = '@Url.Action("LoadTemplateData", "Sessions", new { Area = "Admin" })';

            const movieDurations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, int>)(ViewBag.MovieDurations ?? new Dictionary<int, int>())));
            const moviePosters = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, string>)(ViewBag.MoviePosters ?? new Dictionary<int, string>())));

            const initialRowPrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RowPrices ?? new List<Web.ViewModels.Admin.Sessions.SessionEditVm.RowPriceVm>()));
            const initialCategoryMultipliers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryMultipliers ?? new List<Web.ViewModels.Admin.Sessions.SessionEditVm.CategoryMultiplierVm>()));

            const CAT = {
                Standard: @((int)SeatCategory.Standard),
                Vip: @((int)SeatCategory.Vip),
                Accessible: @((int)SeatCategory.Accessible)
            };

            const els = {
                cinemaSelect: document.getElementById('cinemaSelect'),
                hallSelect: document.getElementById('hallSelect'),

                titleInput: document.getElementById('movieTitleInput'),
                movieIdHidden: document.getElementById('movieIdHidden'),
                movieList: document.getElementById('movieList'),
                startInput: document.getElementById('StartTime'),
                endInput: document.getElementById('EndTime'),
                durationText: document.getElementById('movieDurationText'),
                warn: document.getElementById('shortDurationWarn'),
                posterImg: document.getElementById('posterImg'),
                posterPlaceholder: document.getElementById('posterPlaceholder'),

                rowUi: document.getElementById('rowPricesUi'),
                hiddenContainer: document.getElementById('hiddenRowPrices'),
                catWrap: document.getElementById('catMultipliersWrap'),

                templateSelect: document.getElementById('templateSelect'),
                applyTemplateBtn: document.getElementById('applyTemplateBtn'),
                templateHelp: document.getElementById('templateHelp'),

                seatPreviewWrap: document.getElementById('seatPreviewWrap')
            };

            if (!els.cinemaSelect || !els.hallSelect) return;

            let allRows = [];
            const pricesMap = new Map();
            let currentBasePrice = 100;

            const catMap = new Map();
            if (Array.isArray(initialCategoryMultipliers) && initialCategoryMultipliers.length > 0) {
                initialCategoryMultipliers.forEach(x => {
                    const catId = x.Category ?? x.category;
                    const mult = x.Multiplier ?? x.multiplier;
                    if (catId !== undefined && mult !== undefined) {
                        catMap.set(Number(catId), Number(mult));
                    }
                });
            }

            let hallMeta = null;

            function posterUrl(path) {
                if (!path) return '';
                const p = String(path);
                if (p.startsWith('http')) return p;
                return `https://image.tmdb.org/t/p/w154${p.startsWith('/') ? p : '/' + p}`;
            }

            function seatUiClass(catId) {
                if (catId === CAT.Vip) return 'seat-bg-vip';
                if (catId === CAT.Accessible) return 'seat-bg-acc';
                return 'seat-bg-std';
            }

            function calcFinal(row, catId) {
                const base = pricesMap.has(row) ? Number(pricesMap.get(row)) : Number(currentBasePrice);
                const mult = catMap.has(catId) ? Number(catMap.get(catId)) : 1;
                return Math.round(base * mult);
            }

            function updateUIForMovie() {
                const val = (els.titleInput?.value || '').trim();
                let id = 0;

                if (els.movieList) {
                    const opt = Array.from(els.movieList.options).find(o => o.value === val);
                    id = Number(opt ? opt.dataset.id : 0);
                }

                if (els.movieIdHidden) els.movieIdHidden.value = String(id);

                const path = moviePosters[id];
                if (path && els.posterImg && els.posterPlaceholder) {
                    els.posterImg.src = posterUrl(path);
                    els.posterImg.classList.remove('d-none');
                    els.posterPlaceholder.classList.add('d-none');
                } else if (els.posterImg && els.posterPlaceholder) {
                    els.posterImg.classList.add('d-none');
                    els.posterPlaceholder.classList.remove('d-none');
                }

                const dur = Number(movieDurations[id] || 0);
                if (els.durationText) els.durationText.textContent = dur > 0 ? `ТРИВАЛІСТЬ: ${dur} хв` : 'ТРИВАЛІСТЬ: —';

                const startVal = els.startInput?.value;
                if (dur > 0 && startVal && els.endInput) {
                    const start = new Date(startVal);
                    if (!isNaN(start)) {
                        const end = new Date(start.getTime() + dur * 60000);
                        const pad = n => String(n).padStart(2, '0');
                        els.endInput.value = `${end.getFullYear()}-${pad(end.getMonth() + 1)}-${pad(end.getDate())}T${pad(end.getHours())}:${pad(end.getMinutes())}`;
                    }
                }

                const start = new Date(els.startInput?.value || '');
                const end = new Date(els.endInput?.value || '');
                if (dur > 0 && !isNaN(start) && !isNaN(end)) {
                    const diffMins = (end - start) / 60000;
                    if (diffMins < dur) {
                        els.warn?.classList.remove('d-none');
                        if (els.warn) els.warn.textContent = `Час (${Math.round(diffMins)} хв) менший за фільм (${dur} хв)`;
                    } else {
                        els.warn?.classList.add('d-none');
                    }
                } else {
                    els.warn?.classList.add('d-none');
                }
            }

            function parsePricesToState(flatPrices) {
                if (!flatPrices || flatPrices.length === 0) return;

                const counts = {};
                const normalized = flatPrices
                    .map(p => ({
                        row: Number(p.RowNumber ?? p.row ?? p.Row ?? 0),
                        price: Number(p.BasePrice ?? p.basePrice ?? 0)
                    }))
                    .filter(p => p.row > 0);

                if (normalized.length === 0) return;

                normalized.forEach(p => {
                    const k = String(p.price);
                    counts[k] = (counts[k] || 0) + 1;
                });

                const sorted = Object.keys(counts).sort((a, b) => counts[b] - counts[a]);
                const modePrice = Number(sorted[0] ?? 100);
                currentBasePrice = Number.isFinite(modePrice) ? modePrice : 100;

                pricesMap.clear();
                normalized.forEach(p => {
                    if (allRows.includes(p.row) && p.price !== currentBasePrice) {
                        pricesMap.set(p.row, p.price);
                    }
                });
            }

            function generateHiddenInputs() {
                if (!els.hiddenContainer) return;

                els.hiddenContainer.innerHTML = '';
                allRows.forEach((r, index) => {
                    const price = pricesMap.has(r) ? Number(pricesMap.get(r)) : Number(currentBasePrice);

                    const inputRow = document.createElement('input');
                    inputRow.type = 'hidden';
                    inputRow.name = `RowPrices[${index}].RowNumber`;
                    inputRow.value = String(r);

                    const inputPrice = document.createElement('input');
                    inputPrice.type = 'hidden';
                    inputPrice.name = `RowPrices[${index}].BasePrice`;
                    inputPrice.value = String(price);

                    els.hiddenContainer.appendChild(inputRow);
                    els.hiddenContainer.appendChild(inputPrice);
                });

                recalcVisualMap();
            }

            function renderRowUi() {
                if (!els.rowUi) return;

                let html = `
                    <div class="mb-3">
                        <label class="form-label x-small fw-bold text-muted text-uppercase" for="basePriceInput">Базова ціна (грн)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-2 border-end-0 br-left-8">₴</span>
                            <input type="number" id="basePriceInput" class="form-control border-2 border-start-0 br-right-8 shadow-none fw-bold" value="${currentBasePrice}" min="0" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label x-small fw-bold text-muted text-uppercase mb-1">Винятки</label>
                        <div id="exceptionsContainer" class="d-flex flex-column gap-2 mb-2">
                `;

                if (pricesMap.size === 0) {
                    html += `<div class="text-muted small fst-italic ms-1" id="noExMsg">Немає (всі ряди по ${currentBasePrice} грн)</div>`;
                } else {
                    const sortedRows = Array.from(pricesMap.keys()).sort((a, b) => a - b);
                    sortedRows.forEach(row => {
                        const price = Number(pricesMap.get(row));
                        html += `
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-secondary fw-normal" style="min-width: 56px;">Ряд ${row}</span>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white border-2 border-end-0 br-left-8">₴</span>
                                    <input type="number" class="form-control border-2 border-start-0 shadow-none text-end js-ex-price" data-row="${row}" value="${price}" min="0" />
                                    <button type="button" class="btn btn-sm btn-outline-danger border-2 br-right-8 js-remove-ex" data-row="${row}" title="Видалити">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                        `;
                    });
                }

                html += `
                        </div>
                    </div>

                    <div class="bg-light-soft p-2 br-8">
                        <div class="d-flex gap-2">
                            <select id="exceptionRowSelect" class="form-select form-select-sm border-2 br-8 shadow-none">
                                <option value="">+ Ряд</option>
                `;

                allRows.forEach(r => {
                    if (!pricesMap.has(r)) html += `<option value="${r}">Ряд ${r}</option>`;
                });

                html += `
                            </select>
                            <button type="button" id="addExceptionBtn" class="btn btn-sm btn-secondary text-nowrap br-8 px-3 shadow-sm">Додати</button>
                        </div>
                        <div class="form-text small mt-1">Виняток перевизначає базову ціну для конкретного ряду.</div>
                    </div>
                `;

                els.rowUi.innerHTML = html;

                generateHiddenInputs();
                attachRowEvents();
            }

            function attachRowEvents() {
                document.getElementById('basePriceInput')?.addEventListener('input', function () {
                    const val = Number(this.value);
                    if (Number.isFinite(val) && val >= 0) {
                        currentBasePrice = val;
                        generateHiddenInputs();

                        const msg = document.getElementById('noExMsg');
                        if (msg) msg.textContent = `Немає (всі ряди по ${currentBasePrice} грн)`;
                    }
                });

                document.getElementById('addExceptionBtn')?.addEventListener('click', function () {
                    const select = document.getElementById('exceptionRowSelect');
                    const row = Number(select?.value || 0);
                    if (row > 0) {
                        pricesMap.set(row, currentBasePrice);
                        renderRowUi();
                    }
                });

                document.querySelectorAll('.js-remove-ex').forEach(btn => {
                    btn.addEventListener('click', function () {
                        const row = Number(this.dataset.row || 0);
                        if (row > 0) {
                            pricesMap.delete(row);
                            renderRowUi();
                        }
                    });
                });

                document.querySelectorAll('.js-ex-price').forEach(input => {
                    input.addEventListener('input', function () {
                        const row = Number(this.dataset.row || 0);
                        const val = Number(this.value);
                        if (row > 0 && Number.isFinite(val) && val >= 0) {
                            pricesMap.set(row, val);
                            generateHiddenInputs();
                        }
                    });
                });
            }

            function renderCats(apiCategories) {
                if (!els.catWrap) return;

                if (!Array.isArray(apiCategories) || apiCategories.length === 0) {
                    els.catWrap.innerHTML = `<div class="text-muted small text-center py-3">Немає категорій</div>`;
                    return;
                }

                els.catWrap.innerHTML = `
                    <table class="table table-sm table-borderless align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="ps-3 small text-secondary">Категорія</th>
                                <th class="text-end pe-3 small text-secondary">x</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${apiCategories.map((c, i) => {
                                const id = Number(c.id);
                                const title = String(c.title ?? id);
                                const val = catMap.has(id) ? Number(catMap.get(id)) : 1;

                                if (!catMap.has(id)) catMap.set(id, val);

                                return `
                                    <tr>
                                        <td class="ps-3 small fw-bold text-muted text-truncate" style="max-width: 180px;" title="${title}">${title}</td>
                                        <td class="text-end pe-2 py-1">
                                            <input type="hidden" name="CategoryMultipliers[${i}].Category" value="${id}" />
                                            <input class="form-control form-control-sm text-end js-cat-mult border-2 br-8 shadow-none"
                                                   style="width:90px; display:inline;"
                                                   type="number" step="0.1" min="0.1"
                                                   data-cat="${id}"
                                                   name="CategoryMultipliers[${i}].Multiplier"
                                                   value="${val}" />
                                        </td>
                                    </tr>
                                `;
                            }).join('')}
                        </tbody>
                    </table>
                `;
            }

            els.catWrap?.addEventListener('input', (e) => {
                const t = e.target;
                if (!(t instanceof HTMLInputElement)) return;
                if (!t.classList.contains('js-cat-mult')) return;

                const cid = Number(t.dataset.cat);
                const mult = Number(t.value);

                if (Number.isFinite(cid) && Number.isFinite(mult)) {
                    catMap.set(cid, mult);
                    recalcVisualMap();
                }
            });

            function renderSeatPreviewFromMeta(meta) {
                const wrap = els.seatPreviewWrap;
                if (!wrap) return;

                const seats = Array.isArray(meta?.seats) ? meta.seats : [];
                const maxSeats = Number(meta?.maxSeats || 0);

                if (!seats.length || maxSeats <= 0) {
                    wrap.innerHTML = '<div class="text-muted small text-center py-3">Немає місць у залі</div>';
                    return;
                }

                const byRow = new Map();
                seats.forEach(s => {
                    const r = Number(s.row);
                    const n = Number(s.number);
                    const c = Number(s.category);
                    if (!byRow.has(r)) byRow.set(r, new Map());
                    byRow.get(r).set(n, { row: r, number: n, category: c });
                });

                const rows = Array.isArray(meta?.rows) && meta.rows.length
                    ? meta.rows.map(Number)
                    : Array.from(byRow.keys()).sort((a, b) => a - b);

                let gridHtml = '';
                rows.forEach(row => {
                    const seatsInRow = byRow.get(row) || new Map();

                    gridHtml += `<div class="row-label">${row}</div>`;

                    for (let s = 1; s <= maxSeats; s++) {
                        const seat = seatsInRow.get(s);
                        if (!seat) {
                            gridHtml += `<div class="seat seat-empty"></div>`;
                            continue;
                        }

                        const catId = Number(seat.category);
                        const price = calcFinal(row, catId);

                        gridHtml += `
                            <div class="seat ${seatUiClass(catId)} js-seat-item"
                                 data-row="${row}"
                                 data-cat="${catId}"
                                 data-seat="${s}"
                                 title="Ряд ${row}, місце ${s} — ${price} грн">
                                <div class="seat-text">
                                    <div class="seat-no">${s}</div>
                                    <div class="seat-price js-seat-price">${price}</div>
                                </div>
                            </div>
                        `;
                    }
                });

                wrap.innerHTML = `
                    <div class="cinema-map-wrap">
                        <div class="cinema-map">
                            <div class="cinema-screen">
                                <div class="cinema-screen-arc"></div>
                                <div class="cinema-screen-title">ЕКРАН</div>
                            </div>

                            <div class="cinema-grid" style="--cols:${maxSeats};">
                                ${gridHtml}
                            </div>
                        </div>
                    </div>
                `;
            }

            function recalcVisualMap() {
                const wrap = els.seatPreviewWrap;
                if (!wrap) return;

                wrap.querySelectorAll('.js-seat-item').forEach(el => {
                    const row = Number(el.dataset.row);
                    const cat = Number(el.dataset.cat);
                    const seatNo = el.dataset.seat || '';

                    const final = calcFinal(row, cat);

                    const priceEl = el.querySelector('.js-seat-price');
                    if (priceEl && priceEl.textContent !== String(final)) {
                        priceEl.style.opacity = '0.5';
                        priceEl.textContent = String(final);
                        setTimeout(() => priceEl.style.opacity = '1', 150);
                    }

                    el.title = `Ряд ${row}, місце ${seatNo} — ${final} грн`;
                });
            }

            async function loadPricingMeta(hallId) {
                const hid = Number(hallId || 0);
                if (hid < 1) {
                    clearPricingUI();
                    return;
                }

                try {
                    const res = await fetch(pricingMetaUrl + '?hallId=' + encodeURIComponent(hid));
                    if (!res.ok) throw new Error();

                    const meta = await res.json();
                    hallMeta = meta;

                    allRows = Array.isArray(meta.rows) ? meta.rows.map(Number) : [];

                    if (Array.isArray(initialRowPrices) && initialRowPrices.length > 0) {
                        parsePricesToState(initialRowPrices);
                        initialRowPrices.length = 0;
                    } else if (pricesMap.size === 0 && (!Number.isFinite(currentBasePrice) || currentBasePrice == null)) {
                        currentBasePrice = 100;
                    }

                    renderRowUi();
                    renderCats(meta.categories);
                    renderSeatPreviewFromMeta(meta);
                    recalcVisualMap();
                } catch (e) {
                    console.error(e);
                    if (els.rowUi) els.rowUi.innerHTML = '<div class="text-danger small text-center py-2">Помилка</div>';
                    if (els.catWrap) els.catWrap.innerHTML = '<div class="text-danger small text-center py-2">Помилка</div>';
                    if (els.seatPreviewWrap) els.seatPreviewWrap.innerHTML = '<div class="text-danger small text-center py-2">Помилка</div>';
                }
            }

            async function loadHalls(cinemaId) {
                const cid = Number(cinemaId || 0);

                if (cid <= 0) {
                    els.hallSelect.innerHTML = '<option value="0">— Спершу кінотеатр —</option>';
                    els.hallSelect.disabled = true;
                    resetTemplatesUI();
                    clearPricingUI();
                    return;
                }

                try {
                    const res = await fetch(hallsUrl + '?cinemaId=' + encodeURIComponent(cid));
                    if (!res.ok) throw new Error();

                    const halls = await res.json();

                    els.hallSelect.innerHTML = '<option value="0">— Оберіть зал —</option>';
                    halls.forEach(h => {
                        const opt = document.createElement('option');
                        opt.value = String(h.id);
                        opt.textContent = h.title;
                        els.hallSelect.appendChild(opt);
                    });

                    els.hallSelect.disabled = false;

                    resetTemplatesUI();
                    clearPricingUI();
                } catch (e) {
                    console.error(e);
                }
            }

            async function loadTemplates(hallId) {
                if (!els.templateSelect || !els.applyTemplateBtn) return;

                const hid = Number(hallId || 0);
                if (hid < 1) { resetTemplatesUI(); return; }

                els.templateSelect.innerHTML = '<option value="0">Завантаження...</option>';
                els.templateSelect.disabled = true;
                els.applyTemplateBtn.disabled = true;

                try {
                    const res = await fetch(templatesUrl + '?hallId=' + encodeURIComponent(hid));
                    if (!res.ok) throw new Error();

                    const list = await res.json();
                    if (!Array.isArray(list) || list.length === 0) {
                        els.templateSelect.innerHTML = '<option value="0">Шаблони відсутні</option>';
                        els.templateSelect.disabled = true;
                        els.applyTemplateBtn.disabled = true;
                    } else {
                        els.templateSelect.innerHTML = '<option value="0">— Оберіть шаблон —</option>';
                        list.forEach(t => {
                            const opt = document.createElement('option');
                            opt.value = String(t.id);
                            opt.textContent = t.title;
                            els.templateSelect.appendChild(opt);
                        });
                        els.templateSelect.disabled = false;
                    }
                } catch (e) {
                    console.error(e);
                    els.templateSelect.innerHTML = '<option value="0">Помилка</option>';
                    els.templateSelect.disabled = true;
                    els.applyTemplateBtn.disabled = true;
                }
            }

            async function applySelectedTemplate() {
                const tid = Number(els.templateSelect?.value || 0);
                if (tid < 1) return;

                const oldHtml = els.applyTemplateBtn.innerHTML;
                els.applyTemplateBtn.disabled = true;
                els.applyTemplateBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

                try {
                    const res = await fetch(loadTemplateUrl + '?templateId=' + encodeURIComponent(tid));
                    if (!res.ok) throw new Error();

                    const data = await res.json();

                    catMap.clear();
                    if (Array.isArray(data.categoryMultipliers)) {
                        data.categoryMultipliers.forEach(x => {
                            const cat = Number(x.category ?? x.Category);
                            const mult = Number(x.multiplier ?? x.Multiplier);
                            if (Number.isFinite(cat) && Number.isFinite(mult)) catMap.set(cat, mult);
                        });
                    }

                    if (Array.isArray(data.rowPrices)) {
                        parsePricesToState(data.rowPrices);
                    }

                    if (hallMeta) {
                        renderRowUi();
                        renderCats(hallMeta.categories);
                        renderSeatPreviewFromMeta(hallMeta);
                        recalcVisualMap();
                    } else {
                        await loadPricingMeta(els.hallSelect.value);
                    }

                    if (els.templateHelp) {
                        els.templateHelp.textContent = "Успішно застосовано!";
                        els.templateHelp.classList.add('text-success');
                        setTimeout(() => {
                            els.templateHelp.textContent = "Автозаповнення цін за шаблоном.";
                            els.templateHelp.classList.remove('text-success');
                        }, 2000);
                    }
                } catch (e) {
                    console.error(e);
                    alert("Помилка застосування шаблону");
                } finally {
                    els.applyTemplateBtn.innerHTML = oldHtml;
                    els.applyTemplateBtn.disabled = false;
                }
            }

            function resetTemplatesUI() {
                els.templateSelect.innerHTML = '<option value="0">Спочатку оберіть зал</option>';
                els.templateSelect.disabled = true;
                els.applyTemplateBtn.disabled = true;
            }

            function clearPricingUI() {
                if (els.rowUi) els.rowUi.innerHTML = '<div class="text-muted small text-center py-3">Оберіть зал</div>';
                if (els.catWrap) els.catWrap.innerHTML = '<div class="text-muted small text-center py-3">Оберіть зал</div>';
                if (els.seatPreviewWrap) els.seatPreviewWrap.innerHTML = '<div class="text-muted small text-center py-3">Оберіть зал</div>';
                if (els.hiddenContainer) els.hiddenContainer.innerHTML = '';

                allRows = [];
                pricesMap.clear();
                currentBasePrice = 100;
                hallMeta = null;
            }

            els.cinemaSelect.addEventListener('change', async () => {
                await loadHalls(els.cinemaSelect.value);
            });

            els.hallSelect.addEventListener('change', async () => {
                const hid = els.hallSelect.value;
                await loadPricingMeta(hid);
                await loadTemplates(hid);
            });

            els.titleInput?.addEventListener('input', updateUIForMovie);
            els.startInput?.addEventListener('change', updateUIForMovie);
            els.endInput?.addEventListener('change', updateUIForMovie);

            els.templateSelect?.addEventListener('change', () => {
                els.applyTemplateBtn.disabled = Number(els.templateSelect.value || 0) < 1;
            });
            els.applyTemplateBtn?.addEventListener('click', applySelectedTemplate);

            const initialHall = Number(els.hallSelect.value || 0);
            if (initialHall > 0) {
                loadPricingMeta(initialHall);
                loadTemplates(initialHall);
            } else {
                clearPricingUI();
                resetTemplatesUI();
            }

            updateUIForMovie();
        })();
    </script>
}
