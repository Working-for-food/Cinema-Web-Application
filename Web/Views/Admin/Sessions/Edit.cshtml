@using Infrastructure.Entities
@model Web.ViewModels.Admin.Sessions.SessionEditVm

@{
    ViewData["Title"] = "Редагувати сеанс";

    string FormatDt(DateTime? dt) => dt.HasValue ? dt.Value.ToString("yyyy-MM-ddTHH:mm") : "";

    var selectedMovieText = Model.Movies.FirstOrDefault(x => x.Value == Model.MovieId.ToString())?.Text ?? "";
    var movieTitleFromPost = Context.Request.HasFormContentType ? Context.Request.Form["movieTitle"].ToString() : "";
    var movieTitleFromQuery = Context.Request.Query["movieTitle"].ToString();

    var movieTitleValue = !string.IsNullOrWhiteSpace(movieTitleFromPost)
        ? movieTitleFromPost
        : (!string.IsNullOrWhiteSpace(movieTitleFromQuery) ? movieTitleFromQuery : selectedMovieText);
}

<section class="py-5 gray-bg">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="section-title h2 fw-bold text-dark text-uppercase">Редагувати сеанс</h1>
            <p class="text-muted small text-uppercase fw-semibold">Налаштування часу, фільму та вартості квитків</p>
        </div>

        @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 br-12">@ok</div>
        }
        @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-12">@err</div>
        }

        <div class="card shadow-sm border-0 col-lg-10 mx-auto br-12 overflow-hidden">
            <div class="card-body p-4 p-lg-5">
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger border-0 small br-8 mb-4 shadow-none"></div>
                }

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate id="editForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="MovieId" id="movieIdHidden" />
                    <input type="hidden" asp-for="CinemaId" />
                    <input type="hidden" asp-for="HallId" />

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted text-uppercase">Кінотеатр</label>
                            <select class="form-select border-2 br-8 shadow-none bg-light" asp-items="Model.Cinemas" disabled>
                                <option value="0">— Оберіть кінотеатр —</option>
                            </select>
                            <div class="form-text x-small text-muted"><i class="fa-solid fa-lock me-1"></i>Зміна кінотеатру для існуючого сеансу неможлива</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted text-uppercase">Зал</label>
                            <select class="form-select border-2 br-8 shadow-none bg-light" asp-items="Model.Halls" disabled>
                                <option value="0">— Оберіть зал —</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted text-uppercase">Вибір фільму</label>
                        <div class="d-flex gap-3 align-items-start">
                            <div class="flex-grow-1">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-2 border-end-0 br-left-8 text-muted">
                                        <i class="fa-solid fa-clapperboard"></i>
                                    </span>
                                    <input class="form-control border-2 border-start-0 br-right-8 shadow-none" 
                                           list="movieList" id="movieTitleInput" name="movieTitle" 
                                           placeholder="Почніть вводити назву фільму..." value="@movieTitleValue" />
                                </div>
                                <datalist id="movieList">
                                    @foreach (var m in Model.Movies) { <option value="@m.Text" data-id="@m.Value"></option> }
                                </datalist>
                                <span class="text-danger small" asp-validation-for="MovieId"></span>
                            </div>

                            <div class="shadow-sm border br-8 overflow-hidden bg-white" style="width:90px; height:130px;">
                                <img id="posterImg" class="d-none w-100 h-100 object-fit-cover" src="" alt="Постер" />
                                <div id="posterPlaceholder" class="h-100 w-100 d-flex align-items-center justify-content-center text-muted opacity-50 small">
                                    <i class="fa-solid fa-image fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-5 opacity-10">

                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Тип показу</label>
                            <select class="form-select border-2 br-8 shadow-none" asp-for="PresentationType" asp-items="Model.PresentationTypes"></select>
                            <span class="text-danger small" asp-validation-for="PresentationType"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Початок сеансу</label>
                            <input class="form-control border-2 br-8 shadow-none" asp-for="StartTime" id="StartTime" 
                                   type="datetime-local" step="60" value="@FormatDt(Model.StartTime)" />
                            <span class="text-danger small" asp-validation-for="StartTime"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Кінець сеансу</label>
                            <input class="form-control border-2 br-8 shadow-none" asp-for="EndTime" id="EndTime" 
                                   type="datetime-local" step="60" value="@FormatDt(Model.EndTime)" />
                            <div class="form-text x-small fw-bold text-primary mt-1" id="movieDurationText">ТРИВАЛІСТЬ: —</div>
                        </div>
                    </div>
                    
                    <div class="alert alert-warning border-0 shadow-sm br-8 d-none" id="shortDurationWarn"></div>

                    <hr class="my-5 opacity-10">

                    <div class="panel p-4 bg-light-soft border">
                        <div class="panel-head mb-4">
                            <div>
                                <h5 class="panel-title mb-1 text-uppercase fs-6">Ціноутворення</h5>
                                <p class="panel-hint mb-0">Базова вартість розраховується за формулою: <strong>ціна ряду × множник категорії</strong></p>
                            </div>
                            <div class="icon-badge bg-white shadow-sm text-primary">
                                <i class="fa-solid fa-coins"></i>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-lg-6">
                                <label class="form-label small fw-bold text-muted text-uppercase mb-3">Базові ціни по рядах (грн)</label>
                                <div id="rowPricesWrap" class="p-3 bg-white border br-12 shadow-none min-vh-10">
                                    <div class="text-center py-4 text-muted">
                                        <div class="spinner-border text-primary spinner-border-sm me-2"></div> Завантаження конфігурації залу...
                                    </div>
                                </div>
                                <span class="text-danger small" asp-validation-for="RowPrices"></span>
                            </div>

                            <div class="col-lg-6">
                                <label class="form-label small fw-bold text-muted text-uppercase mb-3">Множники категорій (VIP / ACC)</label>
                                <div id="catMultipliersWrap" class="p-3 bg-white border br-12 shadow-none min-vh-10">
                                    <div class="text-center py-4 text-muted">
                                        <div class="spinner-border text-primary spinner-border-sm me-2"></div> Аналіз категорій місць...
                                    </div>
                                </div>
                                <span class="text-danger small" asp-validation-for="CategoryMultipliers"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                        <a class="btn btn-link text-muted text-decoration-none fw-bold small p-0" asp-action="Index">
                            <i class="fa-solid fa-arrow-left me-1"></i> НАЗАД ДО СПИСКУ
                        </a>

                        <button class="btn btn-maroon px-5 py-2 fw-bold shadow-sm" type="submit">
                            <i class="fa-solid fa-floppy-disk me-2"></i> ЗБЕРЕГТИ ЗМІНИ
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const movieDurations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, int>)(ViewBag.MovieDurations ?? new Dictionary<int, int>())));
            const moviePosters = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, string>)(ViewBag.MoviePosters ?? new Dictionary<int, string>())));

            const initialRowPrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RowPrices ?? new List<Web.ViewModels.Admin.Sessions.SessionEditVm.RowPriceVm>()));
            const initialCategoryMultipliers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryMultipliers ?? new List<Web.ViewModels.Admin.Sessions.SessionEditVm.CategoryMultiplierVm>()));

            const pricingMetaUrl = '@Url.Action("PricingMeta", "Sessions")';

            const rowWrap = document.getElementById('rowPricesWrap');
            const catWrap = document.getElementById('catMultipliersWrap');
            const hallSelect = document.getElementById('hallSelect');
            const hiddenHallIdInput = document.querySelector('input[name="HallId"]');

            const currentHallId = hiddenHallIdInput ? hiddenHallIdInput.value : (hallSelect ? hallSelect.value : 0);

            const titleInput = document.getElementById('movieTitleInput');
            const movieIdHidden = document.getElementById('movieIdHidden');
            const list = document.getElementById('movieList');
            const startInput = document.getElementById('StartTime');
            const endInput = document.getElementById('EndTime');
            const durationText = document.getElementById('movieDurationText');
            const warn = document.getElementById('shortDurationWarn');
            const posterImg = document.getElementById('posterImg');
            const posterPlaceholder = document.getElementById('posterPlaceholder');

            function buildMap(arr, keyProp, valProp) {
                const map = new Map();
                if (Array.isArray(arr)) {
                    for (const x of arr) {
                        const key = Number(x[keyProp] ?? x[keyProp.charAt(0).toUpperCase() + keyProp.slice(1)] ?? 0);
                        const val = x[valProp] ?? x[valProp.charAt(0).toUpperCase() + valProp.slice(1)];
                        if (key > 0 && val != null) map.set(key, val);
                    }
                }
                return map;
            }

            const initRowMap = buildMap(initialRowPrices, 'rowNumber', 'basePrice');
            const initCatMap = buildMap(initialCategoryMultipliers, 'category', 'multiplier');

            function renderRowPrices(rows) {
                if (!rowWrap) return;
                if (!Array.isArray(rows) || rows.length === 0) {
                    rowWrap.innerHTML = `<div class="text-muted small">Немає рядів.</div>`;
                    return;
                }

                rowWrap.innerHTML = `
                <table class="table table-sm align-middle mb-0">
                  <thead><tr><th style="width:40%;">Ряд</th><th>Базова ціна</th></tr></thead>
                  <tbody>
                    ${rows.map((rowNumber, i) => {
                        const rn = Number(rowNumber);
                        const val = initRowMap.get(rn) ?? '100';
                        return `
                        <tr>
                          <td class="text-muted">Ряд ${rn}</td>
                          <td>
                            <input type="hidden" name="RowPrices[${i}].RowNumber" value="${rn}" />
                            <input class="form-control form-control-sm"
                                   type="number" step="1" min="0"
                                   name="RowPrices[${i}].BasePrice"
                                   value="${val}" required />
                          </td>
                        </tr>`;
                    }).join('')}
                  </tbody>
                </table>`;
            }

            function renderCategoryMultipliers(categories) {
                if (!catWrap) return;
                if (!Array.isArray(categories) || categories.length === 0) {
                    catWrap.innerHTML = `<div class="text-muted small">Немає категорій.</div>`;
                    return;
                }

                catWrap.innerHTML = `
                <table class="table table-sm align-middle mb-0">
                  <thead><tr><th style="width:55%;">Категорія</th><th>Множник</th></tr></thead>
                  <tbody>
                    ${categories.map((c, i) => {
                        const id = Number(c.id);
                        const title = String(c.title ?? id);
                        const val = initCatMap.get(id) ?? '1';
                        return `
                        <tr>
                          <td class="text-muted">${title}</td>
                          <td>
                            <input type="hidden" name="CategoryMultipliers[${i}].Category" value="${id}" />
                            <input class="form-control form-control-sm"
                                   type="number" step="0.1" min="0.1"
                                   name="CategoryMultipliers[${i}].Multiplier"
                                   value="${val}" required />
                          </td>
                        </tr>`;
                    }).join('')}
                  </tbody>
                </table>`;
            }

            async function loadPricingMetaAndRender(hallId) {
                const hid = Number(hallId || 0);
                if (hid < 1) {
                    rowWrap.innerHTML = `<div class="text-muted small">—</div>`;
                    catWrap.innerHTML = `<div class="text-muted small">—</div>`;
                    return;
                }

                try {
                    const res = await fetch(pricingMetaUrl + '?hallId=' + encodeURIComponent(hid));
                    if (!res.ok) throw new Error('Network response was not ok');
                    const meta = await res.json();

                    renderRowPrices(meta.rows);
                    renderCategoryMultipliers(meta.categories);
                } catch (e) {
                    console.error(e);
                    rowWrap.innerHTML = `<div class="text-danger small">Помилка.</div>`;
                    catWrap.innerHTML = `<div class="text-danger small">Помилка.</div>`;
                }
            }

            function posterUrl(path) {
                if (!path) return '';
                if (path.startsWith('http')) return path;
                return `https://image.tmdb.org/t/p/w154${path.startsWith('/') ? path : '/' + path}`;
            }

            function setPoster(movieId) {
                const path = moviePosters[Number(movieId || 0)];
                const url = posterUrl(path);
                if (!url) {
                    posterImg.classList.add('d-none');
                    posterPlaceholder.classList.remove('d-none');
                } else {
                    posterImg.src = url;
                    posterImg.classList.remove('d-none');
                    posterPlaceholder.classList.add('d-none');
                }
            }

            function findSelectedMovieIdByTitle() {
                const val = (titleInput.value || '').trim();
                const opt = Array.from(list.options).find(o => o.value === val);
                return opt ? (opt.dataset.id || "0") : "0";
            }

            function updateUIForMovie(movieId) {
                const id = Number(movieId || 0);
                const dur = movieDurations[id];
                durationText.textContent = (dur > 0) ? `Тривалість: ${dur} хв` : "Тривалість: —";
                setPoster(id);

                const start = new Date(startInput.value);
                const end = new Date(endInput.value);
                if (dur > 0 && !isNaN(start) && !isNaN(end)) {
                    const diffMins = (end - start) / 60000;
                    if (diffMins < dur) {
                        warn.classList.remove('d-none');
                        warn.textContent = `Увага: час сеансу (${Math.round(diffMins)} хв) менший за фільм (${dur} хв).`;
                    } else {
                        warn.classList.add('d-none');
                    }
                } else {
                    warn.classList.add('d-none');
                }
            }

            titleInput.addEventListener('input', () => {
                const newId = findSelectedMovieIdByTitle();
                movieIdHidden.value = newId;
                updateUIForMovie(newId);
            });

            startInput.addEventListener('change', () => updateUIForMovie(movieIdHidden.value));
            endInput.addEventListener('change', () => updateUIForMovie(movieIdHidden.value));

            // Init
            updateUIForMovie(movieIdHidden.value);
            loadPricingMetaAndRender(currentHallId);

        })();
    </script>
}

