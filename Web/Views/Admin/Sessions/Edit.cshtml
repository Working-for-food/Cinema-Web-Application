@using Infrastructure.Entities
@model Web.ViewModels.Admin.Sessions.SessionEditVm

@{
    ViewData["Title"] = "Редагувати сеанс";

    string FormatDt(DateTime? dt) => dt.HasValue
        ? dt.Value.ToString("yyyy-MM-ddTHH:mm")
        : "";

    var selectedMovieText = Model.Movies
        .FirstOrDefault(x => x.Value == Model.MovieId.ToString())?.Text ?? "";

    var movieTitleFromPost = Context.Request.HasFormContentType
        ? Context.Request.Form["movieTitle"].ToString()
        : "";

    var movieTitleFromQuery = Context.Request.Query["movieTitle"].ToString();

    var movieTitleValue = !string.IsNullOrWhiteSpace(movieTitleFromPost)
        ? movieTitleFromPost
        : (!string.IsNullOrWhiteSpace(movieTitleFromQuery)
            ? movieTitleFromQuery
            : selectedMovieText);

    var lockHall = true;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Редагувати сеанс</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">До списку</a>
</div>

@if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success mb-3" role="alert">@ok</div>
}
@if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger mb-3" role="alert">@err</div>
}

<div class="card shadow-sm">
    <div class="card-body">

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger mb-3" role="alert"></div>
        }

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate id="editForm">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="MovieId" id="movieIdHidden" />

            <input type="hidden" asp-for="CinemaId" />
            <input type="hidden" asp-for="HallId" />

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Кінотеатр</label>
                    <select class="form-select"
                            asp-items="Model.Cinemas"
                            id="cinemaSelect"
                            disabled>
                        <option value="0">— Оберіть кінотеатр —</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Зал</label>
                    <select class="form-select"
                            asp-items="Model.Halls"
                            id="hallSelect"
                            disabled>
                        <option value="0">— Оберіть зал —</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Фільм</label>
                    <div class="d-flex gap-2 align-items-start">
                        <div class="flex-grow-1">
                            <input class="form-control"
                                   list="movieList"
                                   id="movieTitleInput"
                                   name="movieTitle"
                                   placeholder="Почніть вводити назву..."
                                   autocomplete="off"
                                   value="@movieTitleValue" />

                            <datalist id="movieList">
                                @foreach (var m in Model.Movies)
                                {
                                    <option value="@m.Text" data-id="@m.Value"></option>
                                }
                            </datalist>

                            <div class="form-text">Пошук фільму по базі.</div>
                            <span class="text-danger" asp-validation-for="MovieId"></span>
                        </div>

                        <div style="width:86px;">
                            [Image of movie poster placeholder icon]
                            <img id="posterImg" class="d-none" src="" alt="Постер"
                                 style="width:86px;height:auto;border-radius:8px;object-fit:cover;" loading="lazy" />
                            <div id="posterPlaceholder" class="text-muted small border rounded d-flex align-items-center justify-content-center" style="width:86px; height:120px;">—</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Тип показу</label>
                    <select class="form-select" asp-for="PresentationType" asp-items="Model.PresentationTypes"></select>
                    <span class="text-danger" asp-validation-for="PresentationType"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Початок</label>
                    <input class="form-control" asp-for="StartTime" id="StartTime" type="datetime-local" step="60" value="@FormatDt(Model.StartTime)" />
                    <span class="text-danger" asp-validation-for="StartTime"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Кінець</label>
                    <input class="form-control" asp-for="EndTime" id="EndTime" type="datetime-local" step="60" value="@FormatDt(Model.EndTime)" />
                    <div class="form-text" id="movieDurationText">Тривалість: —</div>
                    <div class="alert alert-warning mt-2 py-2 d-none" id="shortDurationWarn" role="alert"></div>
                    <span class="text-danger" asp-validation-for="EndTime"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="card border-0 bg-light mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">Ціноутворення</h5>
                        <span class="text-muted small">Формула: ціна ряду × множник категорії</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-6">
                            <label class="form-label fw-semibold">Базові ціни по рядах (грн)</label>
                            <div id="rowPricesWrap" class="border rounded p-2 bg-white">
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary spinner-border-sm" role="status"></div> Завантаження...
                                </div>
                            </div>
                            <span class="text-danger" asp-validation-for="RowPrices"></span>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label fw-semibold">Множники категорій</label>
                            <div id="catMultipliersWrap" class="border rounded p-2 bg-white">
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary spinner-border-sm" role="status"></div> Завантаження...
                                </div>
                            </div>
                            <span class="text-danger" asp-validation-for="CategoryMultipliers"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-primary" type="submit">Зберегти зміни</button>
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Скасувати</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const movieDurations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, int>)(ViewBag.MovieDurations ?? new Dictionary<int, int>())));
            const moviePosters = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, string>)(ViewBag.MoviePosters ?? new Dictionary<int, string>())));

            const initialRowPrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RowPrices ?? new List<Web.ViewModels.Admin.Sessions.SessionEditVm.RowPriceVm>()));
            const initialCategoryMultipliers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryMultipliers ?? new List<Web.ViewModels.Admin.Sessions.SessionEditVm.CategoryMultiplierVm>()));

            const pricingMetaUrl = '@Url.Action("PricingMeta", "Sessions")';

            const rowWrap = document.getElementById('rowPricesWrap');
            const catWrap = document.getElementById('catMultipliersWrap');
            const hallSelect = document.getElementById('hallSelect');
            const hiddenHallIdInput = document.querySelector('input[name="HallId"]');

            const currentHallId = hiddenHallIdInput ? hiddenHallIdInput.value : (hallSelect ? hallSelect.value : 0);

            const titleInput = document.getElementById('movieTitleInput');
            const movieIdHidden = document.getElementById('movieIdHidden');
            const list = document.getElementById('movieList');
            const startInput = document.getElementById('StartTime');
            const endInput = document.getElementById('EndTime');
            const durationText = document.getElementById('movieDurationText');
            const warn = document.getElementById('shortDurationWarn');
            const posterImg = document.getElementById('posterImg');
            const posterPlaceholder = document.getElementById('posterPlaceholder');

            function buildMap(arr, keyProp, valProp) {
                const map = new Map();
                if (Array.isArray(arr)) {
                    for (const x of arr) {
                        const key = Number(x[keyProp] ?? x[keyProp.charAt(0).toUpperCase() + keyProp.slice(1)] ?? 0);
                        const val = x[valProp] ?? x[valProp.charAt(0).toUpperCase() + valProp.slice(1)];
                        if (key > 0 && val != null) map.set(key, val);
                    }
                }
                return map;
            }

            const initRowMap = buildMap(initialRowPrices, 'rowNumber', 'basePrice');
            const initCatMap = buildMap(initialCategoryMultipliers, 'category', 'multiplier');

            function renderRowPrices(rows) {
                if (!rowWrap) return;
                if (!Array.isArray(rows) || rows.length === 0) {
                    rowWrap.innerHTML = `<div class="text-muted small">Немає рядів.</div>`;
                    return;
                }

                rowWrap.innerHTML = `
                <table class="table table-sm align-middle mb-0">
                  <thead><tr><th style="width:40%;">Ряд</th><th>Базова ціна</th></tr></thead>
                  <tbody>
                    ${rows.map((rowNumber, i) => {
                        const rn = Number(rowNumber);
                        const val = initRowMap.get(rn) ?? '100';
                        return `
                        <tr>
                          <td class="text-muted">Ряд ${rn}</td>
                          <td>
                            <input type="hidden" name="RowPrices[${i}].RowNumber" value="${rn}" />
                            <input class="form-control form-control-sm"
                                   type="number" step="1" min="0"
                                   name="RowPrices[${i}].BasePrice"
                                   value="${val}" required />
                          </td>
                        </tr>`;
                    }).join('')}
                  </tbody>
                </table>`;
            }

            function renderCategoryMultipliers(categories) {
                if (!catWrap) return;
                if (!Array.isArray(categories) || categories.length === 0) {
                    catWrap.innerHTML = `<div class="text-muted small">Немає категорій.</div>`;
                    return;
                }

                catWrap.innerHTML = `
                <table class="table table-sm align-middle mb-0">
                  <thead><tr><th style="width:55%;">Категорія</th><th>Множник</th></tr></thead>
                  <tbody>
                    ${categories.map((c, i) => {
                        const id = Number(c.id);
                        const title = String(c.title ?? id);
                        const val = initCatMap.get(id) ?? '1';
                        return `
                        <tr>
                          <td class="text-muted">${title}</td>
                          <td>
                            <input type="hidden" name="CategoryMultipliers[${i}].Category" value="${id}" />
                            <input class="form-control form-control-sm"
                                   type="number" step="0.1" min="0.1"
                                   name="CategoryMultipliers[${i}].Multiplier"
                                   value="${val}" required />
                          </td>
                        </tr>`;
                    }).join('')}
                  </tbody>
                </table>`;
            }

            async function loadPricingMetaAndRender(hallId) {
                const hid = Number(hallId || 0);
                if (hid < 1) {
                    rowWrap.innerHTML = `<div class="text-muted small">—</div>`;
                    catWrap.innerHTML = `<div class="text-muted small">—</div>`;
                    return;
                }

                try {
                    const res = await fetch(pricingMetaUrl + '?hallId=' + encodeURIComponent(hid));
                    if (!res.ok) throw new Error('Network response was not ok');
                    const meta = await res.json();

                    renderRowPrices(meta.rows);
                    renderCategoryMultipliers(meta.categories);
                } catch (e) {
                    console.error(e);
                    rowWrap.innerHTML = `<div class="text-danger small">Помилка.</div>`;
                    catWrap.innerHTML = `<div class="text-danger small">Помилка.</div>`;
                }
            }

            function posterUrl(path) {
                if (!path) return '';
                if (path.startsWith('http')) return path;
                return `https://image.tmdb.org/t/p/w154${path.startsWith('/') ? path : '/' + path}`;
            }

            function setPoster(movieId) {
                const path = moviePosters[Number(movieId || 0)];
                const url = posterUrl(path);
                if (!url) {
                    posterImg.classList.add('d-none');
                    posterPlaceholder.classList.remove('d-none');
                } else {
                    posterImg.src = url;
                    posterImg.classList.remove('d-none');
                    posterPlaceholder.classList.add('d-none');
                }
            }

            function findSelectedMovieIdByTitle() {
                const val = (titleInput.value || '').trim();
                const opt = Array.from(list.options).find(o => o.value === val);
                return opt ? (opt.dataset.id || "0") : "0";
            }

            function updateUIForMovie(movieId) {
                 const id = Number(movieId || 0);
                 const dur = movieDurations[id];
                 durationText.textContent = (dur > 0) ? `Тривалість: ${dur} хв` : "Тривалість: —";
                 setPoster(id);

                 const start = new Date(startInput.value);
                 const end = new Date(endInput.value);
                 if (dur > 0 && !isNaN(start) && !isNaN(end)) {
                     const diffMins = (end - start) / 60000;
                     if (diffMins < dur) {
                         warn.classList.remove('d-none');
                         warn.textContent = `Увага: час сеансу (${Math.round(diffMins)} хв) менший за фільм (${dur} хв).`;
                     } else {
                         warn.classList.add('d-none');
                     }
                 } else {
                     warn.classList.add('d-none');
                 }
            }

            titleInput.addEventListener('input', () => {
                const newId = findSelectedMovieIdByTitle();
                movieIdHidden.value = newId;
                updateUIForMovie(newId);
            });

            startInput.addEventListener('change', () => updateUIForMovie(movieIdHidden.value));
            endInput.addEventListener('change', () => updateUIForMovie(movieIdHidden.value));

            updateUIForMovie(movieIdHidden.value);
            loadPricingMetaAndRender(currentHallId);

        })();
    </script>
}