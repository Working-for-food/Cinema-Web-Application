@using Infrastructure.Entities
@model Web.ViewModels.Admin.Sessions.SessionEditVm

@{
    ViewData["Title"] = "Редагувати сеанс";

    var movieTitleFromPost = Context.Request.HasFormContentType && Context.Request.Form.ContainsKey("movieTitle")
        ? Context.Request.Form["movieTitle"].ToString()
        : "";

    var selectedMovieText = Model.Movies.FirstOrDefault(x => x.Value == Model.MovieId.ToString())?.Text ?? "";

    var movieTitleValue = !string.IsNullOrWhiteSpace(movieTitleFromPost)
        ? movieTitleFromPost
        : selectedMovieText;

    string FormatDt(DateTime? dt) => dt.HasValue ? dt.Value.ToString("yyyy-MM-ddTHH:mm") : "";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
            <h1 class="section-title mb-1">Редагувати сеанс</h1>
            <a class="btn btn-secondary shadow-sm br-8 px-3" asp-action="Index">
                <i class="fa-solid fa-arrow-left me-2"></i>НАЗАД
            </a>
        </div>

        @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 br-12">@ok</div>
        }
        @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-12">@err</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger border-0 small br-8 shadow-none mb-4"></div>
        }

        <form asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post"
              novalidate
              id="editForm"
              asp-antiforgery="true">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="MovieId" id="movieIdHidden" />
            <input type="hidden" asp-for="CinemaId" />
            <input type="hidden" asp-for="HallId" />

            <div class="row g-4 align-items-stretch">

                <div class="col-12 col-lg-8 d-flex">
                    <div class="card shadow-sm border-0 br-12 overflow-hidden flex-grow-1">
                        <div class="card-body p-4 p-lg-5">

                            <h5 class="fw-bold text-muted text-uppercase small mb-4 letter-spacing-1">
                                <i class="fa-solid fa-location-dot me-2 text-primary"></i> Локація та час
                            </h5>

                            <div class="row g-4 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Кінотеатр</label>
                                    <select class="form-select border-2 br-8 shadow-none bg-light"
                                            asp-for="CinemaId"
                                            asp-items="Model.Cinemas"
                                            id="cinemaSelect"
                                            disabled>
                                        <option value="0">— Оберіть кінотеатр —</option>
                                    </select>
                                    <div class="form-text x-small text-muted">
                                        <i class="fa-solid fa-lock me-1"></i>Локацію не можна змінити під час редагування
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Зал</label>
                                    <select class="form-select border-2 br-8 shadow-none bg-light"
                                            asp-for="HallId"
                                            asp-items="Model.Halls"
                                            id="hallSelect"
                                            disabled>
                                        <option value="0">— Оберіть зал —</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Початок</label>
                                    <input class="form-control border-2 br-8 shadow-none"
                                           asp-for="StartTime"
                                           id="StartTime"
                                           type="datetime-local"
                                           step="60"
                                           value="@FormatDt(Model.StartTime)" />
                                    <span class="text-danger small" asp-validation-for="StartTime"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Кінець</label>
                                    <input class="form-control border-2 br-8 shadow-none"
                                           asp-for="EndTime"
                                           id="EndTime"
                                           type="datetime-local"
                                           step="60"
                                           value="@FormatDt(Model.EndTime)" />

                                    <div class="d-flex justify-content-between mt-2">
                                        <span class="form-text x-small fw-bold text-primary" id="movieDurationText">ТРИВАЛІСТЬ: —</span>
                                        <span class="text-danger d-none fw-semibold x-small" id="shortDurationWarn"></span>
                                    </div>

                                    <span class="text-danger small" asp-validation-for="EndTime"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-4 d-flex">
                    <div class="card shadow-sm border-0 br-12 overflow-hidden flex-grow-1">
                        <div class="card-body p-4 p-lg-5">

                            <h5 class="fw-bold text-muted text-uppercase small mb-4 letter-spacing-1">
                                <i class="fa-solid fa-clapperboard me-2 text-primary"></i> Вибір фільму
                            </h5>

                            <div class="d-flex gap-3 align-items-start">

                                <div class="flex-shrink-0 d-none d-md-block">
                                    <div class="shadow-sm border br-8 overflow-hidden bg-light" style="width:100px; height:150px;">
                                        <img id="posterImg" class="d-none w-100 h-100 object-fit-cover" src="" alt="Постер" loading="lazy" />
                                        <div id="posterPlaceholder" class="h-100 w-100 d-flex align-items-center justify-content-center text-muted opacity-50 small text-center px-2">
                                            <i class="fa-solid fa-image fa-2x"></i>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex-grow-1" style="min-width:0;">
                                    <div class="mb-4">
                                        <label class="form-label small fw-bold text-muted text-uppercase">Назва фільму</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-2 border-end-0 br-left-8 text-muted">
                                                <i class="fa-solid fa-magnifying-glass"></i>
                                            </span>
                                            <input class="form-control border-2 border-start-0 br-right-8 shadow-none"
                                                   list="movieList"
                                                   id="movieTitleInput"
                                                   name="movieTitle"
                                                   placeholder="Почніть вводити назву..."
                                                   autocomplete="off"
                                                   value="@movieTitleValue" />
                                        </div>

                                        <datalist id="movieList">
                                            @foreach (var m in Model.Movies)
                                            {
                                                <option value="@m.Text" data-id="@m.Value"></option>
                                            }
                                        </datalist>

                                        <span class="text-danger small" asp-validation-for="MovieId"></span>
                                    </div>

                                    <div>
                                        <label class="form-label small fw-bold text-muted text-uppercase">Формат показу</label>
                                        <select class="form-select border-2 br-8 shadow-none"
                                                asp-for="PresentationType"
                                                asp-items="Model.PresentationTypes"></select>
                                        <span class="text-danger small" asp-validation-for="PresentationType"></span>
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="card-footer bg-white border-top-0 p-4 p-lg-5 pt-0">
                            <button class="btn btn-maroon w-100 py-3 fw-bold shadow-sm" type="submit">
                                <i class="fa-solid fa-floppy-disk me-2"></i> ЗБЕРЕГТИ ЗМІНИ
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const movieDurations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, int>)(ViewBag.MovieDurations ?? new Dictionary<int, int>())));
            const moviePosters = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Dictionary<int, string>)(ViewBag.MoviePosters ?? new Dictionary<int, string>())));

            const els = {
                titleInput: document.getElementById('movieTitleInput'),
                movieIdHidden: document.getElementById('movieIdHidden'),
                movieList: document.getElementById('movieList'),
                startInput: document.getElementById('StartTime'),
                endInput: document.getElementById('EndTime'),
                durationText: document.getElementById('movieDurationText'),
                warn: document.getElementById('shortDurationWarn'),
                posterImg: document.getElementById('posterImg'),
                posterPlaceholder: document.getElementById('posterPlaceholder')
            };

            function posterUrl(path) {
                if (!path) return '';
                const p = String(path);
                if (p.startsWith('http')) return p;
                return `https://image.tmdb.org/t/p/w154${p.startsWith('/') ? p : '/' + p}`;
            }

            function updateUIForMovie() {
                const val = (els.titleInput?.value || '').trim();
                let id = 0;

                if (els.movieList) {
                    const opt = Array.from(els.movieList.options).find(o => o.value === val);
                    id = Number(opt ? opt.dataset.id : 0);
                }

                if (els.movieIdHidden) els.movieIdHidden.value = String(id);

                const path = moviePosters[id];
                if (path && els.posterImg && els.posterPlaceholder) {
                    els.posterImg.src = posterUrl(path);
                    els.posterImg.classList.remove('d-none');
                    els.posterPlaceholder.classList.add('d-none');
                } else if (els.posterImg && els.posterPlaceholder) {
                    els.posterImg.classList.add('d-none');
                    els.posterPlaceholder.classList.remove('d-none');
                }

                const dur = Number(movieDurations[id] || 0);
                if (els.durationText) els.durationText.textContent = dur > 0 ? `ТРИВАЛІСТЬ: ${dur} хв` : 'ТРИВАЛІСТЬ: —';

                const startVal = els.startInput?.value;
                const endVal = els.endInput?.value;

                if (dur > 0 && startVal && endVal && els.warn) {
                    const start = new Date(startVal);
                    const end = new Date(endVal);

                    if (!isNaN(start) && !isNaN(end)) {
                        const diffMins = (end - start) / 60000;
                        if (diffMins < dur) {
                            els.warn.classList.remove('d-none');
                            els.warn.textContent = `Час (${Math.round(diffMins)} хв) менший за фільм (${dur} хв)`;
                        } else {
                            els.warn.classList.add('d-none');
                            els.warn.textContent = '';
                        }
                    } else {
                        els.warn.classList.add('d-none');
                        els.warn.textContent = '';
                    }
                } else if (els.warn) {
                    els.warn.classList.add('d-none');
                    els.warn.textContent = '';
                }
            }

            els.titleInput?.addEventListener('input', updateUIForMovie);
            els.startInput?.addEventListener('change', updateUIForMovie);
            els.endInput?.addEventListener('change', updateUIForMovie);

            updateUIForMovie();
        })();
    </script>
}
