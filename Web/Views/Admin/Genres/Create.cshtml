@model Web.ViewModels.Admin.Genres.GenreEditVm

@{
    ViewData["Title"] = "Створення жанру";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title">Створити жанр</h1>

        <div class="card shadow-sm col-lg-6 mx-auto">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa-solid fa-plus me-2"></i>
                    Створення жанру
                </h5>
            </div>

            <div class="card-body p-4">
                <form asp-area="Admin"
                      asp-controller="Genres"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label text-muted">
                            <i class="fa-solid fa-tags me-1"></i>
                            Назва жанру
                        </label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Введіть назву жанру" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-area="Admin"
                           asp-controller="Genres"
                           asp-action="Index"
                           class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            Назад
                        </a>

                        <button type="submit" class="btn btn-maroon">
                            <i class="fa-solid fa-floppy-disk me-1"></i>
                            Створити жанр
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
