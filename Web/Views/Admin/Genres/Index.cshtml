@model List<Infrastructure.Entities.Genre>

@{
    ViewData["Title"] = "Жанри";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">ЖАНРИ</h1>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success mb-3">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger mb-3">@err</div>
        }

        <div class="col-12 mb-3">
            <div class="d-flex justify-content-lg-end">
                <a asp-controller="Genres" asp-action="Create" class="btn btn-maroon">
                    <i class="fa-solid fa-plus me-1"></i>
                    ДОДАТИ НОВИЙ ЖАНР
                </a>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="card shadow-sm col-lg-8 mx-auto">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-circle-info me-2"></i>
                        Немає результатів
                    </h5>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="mb-0">Жанри не знайдено.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var g in Model)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-body p-4">

                        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">

                            <!-- Назва жанру -->
                            <div>
                                <div class="text-muted small mb-1">
                                    <i class="fa-solid fa-tags me-1"></i>
                                    Назва жанру
                                </div>
                                <div class="fw-semibold fs-4">
                                    @g.Name
                                </div>
                            </div>

                            <!-- Кнопки -->
                            <div class="d-flex gap-2 flex-wrap justify-content-md-end">

                                <a asp-controller="Genres"
                                   asp-action="Details"
                                   asp-route-id="@g.Id"
                                   class="btn btn-maroon">
                                    <i class="fa-solid fa-circle-info me-1"></i>
                                    ДЕТАЛІ
                                </a>

                                <a asp-controller="Genres"
                                   asp-action="Edit"
                                   asp-route-id="@g.Id"
                                   class="btn btn-secondary">
                                    <i class="fa-solid fa-pen-to-square me-1"></i>
                                    РЕДАГУВАТИ
                                </a>

                                <a asp-controller="Genres"
                                   asp-action="Delete"
                                   asp-route-id="@g.Id"
                                   class="btn btn-maroon">
                                    <i class="fa-solid fa-trash me-1"></i>
                                    ВИДАЛИТИ
                                </a>

                            </div>

                        </div>

                    </div>
                </div>
            }
        }

    </div>
</section>
