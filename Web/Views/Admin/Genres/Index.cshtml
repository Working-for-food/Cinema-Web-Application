@model List<Infrastructure.Entities.Genre>

@{
    ViewData["Title"] = "Жанри";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="section-title mb-0">Жанри</h1>
            <div class="d-flex gap-2">
                <a asp-controller="Genres" asp-action="Create" class="btn btn-maroon">
                    <i class="fa-solid fa-plus me-1"></i>
                    ДОДАТИ НОВИЙ ЖАНР
                </a>
            </div>
        </div>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success border-0 shadow-sm mb-3">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-3">@err</div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 bg-white rounded-3 shadow-sm">
                <i class="fa-solid fa-tags fa-3x text-light mb-3"></i>
                <p class="text-muted">Жанри не знайдено.</p>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 col-12 admin-table-card overflow-hidden">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table admin-table align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-muted small fw-bold text-uppercase">Назва жанру</th>
                                    <th class="text-end pe-4 text-muted small fw-bold text-uppercase" style="width: 200px;">Дії</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="genre-dot me-2"></div>
                                                <span class="fw-bold text-dark">@g.Name</span>
                                            </div>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a asp-controller="Genres" asp-action="Details" asp-route-id="@g.Id" 
                                                   class="btn btn-sm btn-light border" title="Деталі">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                                <a asp-controller="Genres" asp-action="Edit" asp-route-id="@g.Id" 
                                                   class="btn btn-sm btn-light border text-primary" title="Редагувати">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </a>
                                                <a asp-controller="Genres" asp-action="Delete" asp-route-id="@g.Id" 
                                                   class="btn btn-sm btn-light border text-danger" title="Видалити">
                                                    <i class="fa-solid fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</section>