@model Web.ViewModels.Admin.Genres.GenreEditVm

@{
    ViewData["Title"] = "Редагування жанру";
}

<section class="py-5 gray-bg">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="section-title h2 fw-bold text-dark text-uppercase">Редагування жанру</h1>
            <p class="text-muted small text-uppercase fw-semibold">Змініть назву категорії нижче</p>
        </div>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 br-12">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-12">@err</div>
        }

        <div class="card shadow-sm border-0 col-lg-6 mx-auto br-12 overflow-hidden">
            
            <div class="card-body p-4 p-lg-5">
                <form asp-area="Admin" asp-controller="Genres" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small br-8 shadow-none mb-4"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label small fw-bold text-muted text-uppercase">
                            <i class="fa-solid fa-tags me-1"></i> Назва жанру
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-2 border-end-0 br-left-8 text-muted">
                                <i class="fa-solid fa-tag"></i>
                            </span>
                            <input asp-for="Name" class="form-control form-control-lg shadow-none border-2 br-right-8" 
                                   placeholder="Напр. Комедія..." />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                        <a asp-area="Admin" asp-controller="Genres" asp-action="Index" 
                           class="btn btn-link text-muted text-decoration-none fw-bold small p-0">
                            <i class="fa-solid fa-arrow-left me-1"></i> НАЗАД ДО СПИСКУ
                        </a>
                        
                        <button type="submit" class="btn btn-maroon px-5 py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-floppy-disk me-2"></i> ЗБЕРЕГТИ ЗМІНИ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}