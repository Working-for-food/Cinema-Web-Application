@model Infrastructure.Entities.Genre

@{
    ViewData["Title"] = "Видалення жанру";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title">Видалити жанр</h1>

        <div class="card shadow-sm col-lg-6 mx-auto">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    Підтвердження видалення
                </h5>
            </div>

            <div class="card-body p-4">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger mb-3">
                        @TempData["Error"]
                    </div>
                }

                <div class="alert alert-warning mb-4">
                    Ви впевнені, що хочете видалити цей жанр?
                    <strong>Цю дію неможливо скасувати.</strong>
                </div>

                <div class="mb-4">
                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-tags me-1"></i>
                            Назва жанру
                        </label>
                        <div class="fw-semibold fs-5">@Model.Name</div>
                    </div>
                </div>

                <form asp-controller="Genres"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Genres"
                           asp-action="Index"
                           class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            Скасувати
                        </a>

                        <button type="submit" class="btn btn-maroon">
                            <i class="fa-solid fa-trash me-1"></i>
                            Видалити жанр
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</section>

