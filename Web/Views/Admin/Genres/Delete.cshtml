@model Infrastructure.Entities.Genre

@{
    ViewData["Title"] = "Видалення жанру";
}

<section class="py-5 gray-bg">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="section-title h2 fw-bold text-dark text-uppercase">Видалити жанр</h1>
            <p class="text-muted small text-uppercase fw-semibold text-danger">Цю дію неможливо буде скасувати</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-12">
                <i class="fa-solid fa-circle-xmark me-2"></i> @TempData["Error"]
            </div>
        }

        <div class="card shadow-sm border-0 col-lg-6 mx-auto br-12 overflow-hidden">
            
            <div class="card-body p-4 p-lg-5">

                <div class="alert alert-warning border-0 shadow-none br-12 mb-5 p-4 d-flex align-items-center text-start">
                    <div class="me-4 text-warning">
                        <i class="fa-solid fa-triangle-exclamation fa-3x"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">Ви впевнені?</h5>
                        <p class="mb-0 opacity-75">Ви збираєтеся видалити жанр <strong>"@Model.Name"</strong>. Всі фільми втратять цей зв'язок.</p>
                    </div>
                </div>

                <div class="info-item border-0 bg-light-soft p-4 br-12 text-center mb-4">
                    <span class="info-item-label small fw-bold text-muted text-uppercase mb-2 d-block">
                        <i class="fa-solid fa-tags me-1 text-primary"></i> Назва жанру
                    </span>
                    <span class="info-item-value fw-bold text-dark fs-4">@Model.Name</span>
                </div>

                <form asp-controller="Genres" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                        <a asp-controller="Genres" asp-action="Index" 
                           class="btn btn-link text-muted text-decoration-none fw-bold small p-0">
                            <i class="fa-solid fa-arrow-left me-1"></i> СКАСУВАТИ
                        </a>

                        <button type="submit" class="btn btn-maroon px-5 py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-trash-can me-2"></i> ПІДТВЕРДИТИ ВИДАЛЕННЯ
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>