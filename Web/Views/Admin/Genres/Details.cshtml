@model Infrastructure.Entities.Genre

@{
    ViewData["Title"] = "Деталі жанру";
}

<section class="py-5 gray-bg">
    <div class="container">

        <div class="card shadow-sm border-0 col-lg-6 mx-auto br-12 overflow-hidden">
            
            <div class="card-body p-4 p-lg-5">

                <div class="text-center mb-5">
                    <div class="genre-icon-circle mx-auto mb-4">
                        <i class="fa-solid fa-tags fa-2x"></i>
                    </div>
                    <div class="header-subtitle text-uppercase fw-bold mb-1">Інформація про жанр</div>
                    <h2 class="header-title display-6">@Model.Name</h2>
                </div>

                <div class="panel bg-light-soft border-0 shadow-none mb-4" style="background: var(--surface-2);">
                    <div class="info-item border-0">
                        <span class="info-item-label">
                            <i class="fa-solid fa-hashtag me-2"></i>Системний ID
                        </span>
                        <span class="info-item-value text-muted">#@Model.Id</span>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3 mt-5 pt-4 border-top">
                    <a asp-area="Admin"
                       asp-controller="Genres"
                       asp-action="Index"
                       class="btn btn-secondary px-5 py-2 fw-bold text-uppercase">
                        <i class="fa-solid fa-arrow-left me-2"></i> Назад
                    </a>

                    <a asp-area="Admin"
                       asp-controller="Genres"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-maroon px-5 py-2 fw-bold text-uppercase shadow-sm">
                        <i class="fa-solid fa-pen-to-square me-2"></i> Редагувати
                    </a>
                </div>

            </div>
        </div>

    </div>
</section>