@model Infrastructure.Entities.Genre

@{
    ViewData["Title"] = "Деталі жанру";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">Деталі жанру</h1>

        <div class="card shadow-sm col-lg-6 mx-auto">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Інформація про жанр
                </h5>
            </div>

            <div class="card-body p-4">

                <div class="mb-4">

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-tags me-1"></i>
                            Назва жанру
                        </label>
                        <div class="fw-semibold fs-5">@Model.Name</div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-area="Admin"
                       asp-controller="Genres"
                       asp-action="Index"
                       class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Назад
                    </a>

                    <a asp-area="Admin"
                       asp-controller="Genres"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-maroon">
                        <i class="fa-solid fa-pen-to-square me-1"></i>
                        Редагувати жанр
                    </a>
                </div>

            </div>
        </div>

    </div>
</section>

