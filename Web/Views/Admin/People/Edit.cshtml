@model Web.ViewModels.Admin.People.PersonEditVm

@{
    ViewData["Title"] = "Редагування актора чи режисера";
}

<section class="py-5 gray-bg">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="section-title h2 fw-bold text-dark text-uppercase">Редагувати актора чи режисера</h1>
            <p class="text-muted small text-uppercase fw-semibold">Оновіть персональні дані актора чи режисера</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 br-12">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-12">@TempData["Error"]</div>
        }

        <div class="card shadow-sm border-0 col-lg-10 mx-auto br-12 overflow-hidden">
            <div class="card-body p-4 p-lg-5">
                <form method="post" asp-route-id="@Model.Id" asp-antiforgery="true">
                    <input type="hidden" asp-for="Id" />
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small br-8 shadow-none mb-4"></div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <label asp-for="FirstName" class="form-label small fw-bold text-muted text-uppercase">Імʼя</label>
                            <input asp-for="FirstName" class="form-control shadow-none border-2 br-8" placeholder="Введіть ім'я..." />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MiddleName" class="form-label small fw-bold text-muted text-uppercase">По батькові</label>
                            <input asp-for="MiddleName" class="form-control shadow-none border-2 br-8" placeholder="Якщо є..." />
                            <span asp-validation-for="MiddleName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="LastName" class="form-label small fw-bold text-muted text-uppercase">Прізвище</label>
                            <input asp-for="LastName" class="form-control shadow-none border-2 br-8" placeholder="Введіть прізвище..." />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <label asp-for="BirthDate" class="form-label small fw-bold text-muted text-uppercase">
                                <i class="fa-solid fa-calendar-day me-1"></i> Дата народження
                            </label>
                            <input asp-for="BirthDate" type="date" class="form-control shadow-none border-2 br-8" />
                            <span asp-validation-for="BirthDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CountryCode" class="form-label small fw-bold text-muted text-uppercase">
                                <i class="fa-solid fa-earth-americas me-1"></i> Країна
                            </label>
                            <select asp-for="CountryCode" asp-items="Model.CountryList" class="form-select shadow-none border-2 br-8">
                                <option value="">— не обрано —</option>
                            </select>
                            <span asp-validation-for="CountryCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PhotoUrl" class="form-label small fw-bold text-muted text-uppercase">
                                <i class="fa-solid fa-link me-1"></i> Посилання на фото
                            </label>
                            <input asp-for="PhotoUrl" class="form-control shadow-none border-2 br-8" placeholder="URL зображення..." />
                            <span asp-validation-for="PhotoUrl" class="text-danger small"></span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                    {
                        <div class="mb-4 text-center">
                            <div class="person-avatar shadow-sm border-2 mx-auto" style="width: 120px; height: 120px;">
                                <img src="@Model.PhotoUrl" alt="Preview" />
                            </div>
                            <div class="text-muted small mt-2">Поточне фото</div>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                        <a class="btn btn-link text-muted text-decoration-none fw-bold small p-0" asp-action="Index">
                            <i class="fa-solid fa-arrow-left me-1"></i> НАЗАД ДО СПИСКУ
                        </a>

                        <button type="submit" class="btn btn-maroon px-5 py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-floppy-disk me-2"></i> ЗБЕРЕГТИ ЗМІНИ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
