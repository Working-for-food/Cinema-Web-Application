@model Web.ViewModels.Admin.People.PersonEditVm

@{
    ViewData["Title"] = "Редагування користувача";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">Редагувати користувача</h1>

        <div class="card shadow-sm rounded">
            <div class="card-header bg-maroon text-white">
                <h5 class="mb-0">
                    <i class="fas fa-user-edit me-2"></i>Дані користувача
                </h5>
            </div>

            <div class="card-body">
                <form method="post" asp-route-id="@Model.Id" asp-antiforgery="true">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="FirstName" class="form-label">Імʼя</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="MiddleName" class="form-label">По батькові</label>
                            <input asp-for="MiddleName" class="form-control" />
                            <span asp-validation-for="MiddleName" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="LastName" class="form-label">Прізвище</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="BirthDate" class="form-label">Дата народження</label>
                            <input asp-for="BirthDate" type="date" class="form-control" />
                            <span asp-validation-for="BirthDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="CountryCode" class="form-label">Країна</label>
                            <select asp-for="CountryCode" asp-items="Model.CountryList" class="form-select">
                                <option value="">— не обрано —</option>
                            </select>
                            <span asp-validation-for="CountryCode" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="PhotoUrl" class="form-label">Посилання на фото</label>
                            <input asp-for="PhotoUrl" class="form-control" />
                            <span asp-validation-for="PhotoUrl" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <a class="btn btn-secondary" asp-action="Index">
                            <i class="fas fa-arrow-left me-2"></i>Назад
                        </a>

                        <button type="submit" class="btn btn-maroon">
                            <i class="fas fa-check me-2"></i>Зберегти зміни
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
