@model IReadOnlyList<Infrastructure.Entities.Person>

@{
    var pages = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var search = (string?)ViewBag.Search;
}

<div class="container mt-4">
    <h2>People</h2>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <form method="get" class="d-flex gap-2">
            <input class="form-control" name="search" value="@search" placeholder="Search..." />
            <button class="btn btn-primary">Search</button>
        </form>
        <a class="btn btn-success" asp-action="Create">Add person</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Country</th>
                <th>BirthDate</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@(p.FullName ?? (p.FirstName + " " + p.LastName))</td>
                <td>@(p.Country?.Name ?? "-")</td>
                <td>@(p.BirthDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                    <form class="d-inline" asp-action="Delete" asp-route-id="@p.Id" method="post"
                          onsubmit="return confirm('Delete this person?');">
                        <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(pages == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(pages-1)" asp-route-search="@search">Prev</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @pages / @totalPages</span></li>
            <li class="page-item @(pages >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(pages+1)" asp-route-search="@search">Next</a>
            </li>
        </ul>
    </nav>
</div>
