@model IReadOnlyList<Infrastructure.Entities.Person>

@{
    ViewData["Title"] = "Користувачі";

    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var search = (string?)ViewBag.Search;
}

<section class="sessions-section py-4 pb-6 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">Користувачі</h1>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-3">@TempData["Error"]</div>
        }

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
            <form method="get" class="d-flex gap-2 align-items-end">
                <div>
                    <label class="form-label">Пошук</label>
                    <input class="form-control"
                           name="search"
                           value="@search"
                           placeholder="Імʼя або прізвище" />
                </div>

                <div>
                    <label class="form-label invisible">.</label>
                    <button type="submit" class="btn btn-secondary w-100">
                        <i class="fas fa-search me-1"></i>ЗНАЙТИ
                    </button>
                </div>
            </form>

            <a class="btn btn-maroon mb-1" asp-action="Create">
                <i class="fas fa-plus me-2"></i>Додати користувача
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div class="card shadow-sm col-lg-8 mx-auto">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-circle-info me-2"></i>
                        Немає результатів
                    </h5>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="mb-0">Користувачів не знайдено.</p>
                </div>
            </div>
        }
        else
        {
            <!-- Таблична шапка -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-maroon text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-users me-2"></i>Список користувачів
                    </h5>
                </div>

                <div class="card-body py-3">
                    <div class="row align-items-center g-3 fw-semibold text-uppercase text-muted">

                        <!-- Фото -->
                        <div class="col-auto" style="width:72px;">
                            Фото
                        </div>

                        <!-- ПІБ -->
                        <div class="col">
                            ПІБ
                        </div>

                        <!-- Країна -->
                        <div class="col-auto" style="width:220px;">
                            Країна
                        </div>

                        <!-- Дата -->
                        <div class="col-auto" style="width:170px;">
                            Дата народження
                        </div>

                        <!-- Дії -->
                        <div class="col-auto text-end" style="width:220px;">
                            Дії
                        </div>

                    </div>
                </div>
            </div>

            <!-- Рядки як картки -->
            <div class="d-flex flex-column gap-3">
                @foreach (var p in Model)
                {
                    <div class="card shadow-sm">
                        <div class="card-body p-3 p-md-4">

                            <!-- "табличний рядок" всередині картки -->
                            <div class="row align-items-center g-3">

                                <!-- Фото -->
                                <div class="col-auto" style="width:72px;">
                                    <div class="person-avatar">
                                        @if (!string.IsNullOrWhiteSpace(p.PhotoUrl))
                                        {
                                            <img src="@p.PhotoUrl"
                                                 alt="Фото"
                                                 loading="lazy"
                                                 onerror="this.style.display='none'; this.parentElement.classList.add('no-photo');" />
                                        }
                                        else
                                        {
                                            <span class="person-avatar__placeholder">
                                                <i class="fas fa-user"></i>
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- ПІБ -->
                                <div class="col">
                                    <div class="fw-semibold">
                                        @(p.FullName ?? $"{p.FirstName} {p.LastName}")
                                    </div>
                                </div>

                                <!-- Країна -->
                                <div class="col-auto" style="width:220px;">
                                    @(p.Country?.Name ?? "—")
                                </div>

                                <!-- Дата -->
                                <div class="col-auto" style="width:170px;">
                                    @(p.BirthDate?.ToString("dd.MM.yyyy") ?? "—")
                                </div>

                                <!-- Дії -->
                                <div class="col-auto text-end" style="width:220px;">
                                    <div class="d-flex justify-content-end gap-2 flex-wrap">
                                        <a asp-action="Edit"
                                           asp-route-id="@p.Id"
                                           class="btn btn-secondary">
                                            <i class="fa-solid fa-pen-to-square me-1"></i>
                                            РЕДАГУВАТИ
                                        </a>

                                        <form method="post"
                                              asp-action="Delete"
                                              asp-route-id="@p.Id"
                                              class="d-inline"
                                              onsubmit="return confirm('Видалити цю персону?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-maroon">
                                                <i class="fa-solid fa-trash me-1"></i>
                                                ВИДАЛИТИ
                                            </button>
                                        </form>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                }
            </div>
        }

        @if (totalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-search="@search">
                            ← Назад
                        </a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">Сторінка @currentPage з @totalPages</span>
                    </li>

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-search="@search">
                            Далі →
                        </a>
                    </li>
                </ul>
            </nav>
        }

    </div>
</section>
