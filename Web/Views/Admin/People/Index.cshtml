@model IReadOnlyList<Infrastructure.Entities.Person>

@{
    ViewData["Title"] = "Користувачі";

    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var search = (string?)ViewBag.Search;
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-4">Користувачі</h1>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-3">@TempData["Error"]</div>
        }

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
            <form method="get" class="d-flex gap-2 align-items-end">
                <div>
                    <label class="form-label">Пошук</label>
                    <input class="form-control"
                           name="search"
                           value="@search"
                           placeholder="Імʼя або прізвище" />
                </div>

                <div>
                    <label class="form-label invisible">.</label>
                    <button type="submit" class="btn btn-secondary w-100">
                        <i class="fas fa-search me-1"></i>ЗНАЙТИ
                    </button>
                </div>
            </form>

            <a class="btn btn-maroon" asp-action="Create">
                <i class="fas fa-plus me-2"></i>Додати користувача
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div class="card shadow-sm col-lg-8 mx-auto">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-circle-info me-2"></i>
                        Немає результатів
                    </h5>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="mb-0">Користувачів не знайдено.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm mb-3 admin-table-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table admin-table mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th style="width:84px;">Фото</th>
                                    <th>ПІБ</th>
                                    <th style="width:220px;">Країна</th>
                                    <th style="width:180px;">Дата народження</th>
                                    <th class="text-end" style="width:250px;">Дії</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var p in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="person-avatar">
                                                @if (!string.IsNullOrWhiteSpace(p.PhotoUrl))
                                                {
                                                    <img src="@p.PhotoUrl"
                                                         alt="Фото"
                                                         loading="lazy"
                                                         onerror="this.style.display='none'; this.parentElement.classList.add('no-photo');" />
                                                }
                                                else
                                                {
                                                    <span class="person-avatar__placeholder">
                                                        <i class="fas fa-user"></i>
                                                    </span>
                                                }
                                            </div>
                                        </td>

                                        <td class="fw-semibold">
                                            @(p.FullName ?? $"{p.FirstName} {p.LastName}")
                                        </td>

                                        <td>
                                            @(p.Country?.Name ?? "—")
                                        </td>

                                        <td>
                                            @(p.BirthDate?.ToString("dd.MM.yyyy") ?? "—")
                                        </td>

                                        <td class="text-end">
                                            <a asp-action="Edit"
                                               asp-route-id="@p.Id"
                                               class="btn btn-sm btn-secondary me-1"
                                               title="Редагувати">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>

                                            <form method="post"
                                                  asp-action="Delete"
                                                  asp-route-id="@p.Id"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Видалити цього користувача?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        title="Видалити">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                </div>
            </div>
        }

        @if (totalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-search="@search">
                            Prev
                        </a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">Сторінка @currentPage з @totalPages</span>
                    </li>

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-search="@search">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        }

    </div>
</section>
