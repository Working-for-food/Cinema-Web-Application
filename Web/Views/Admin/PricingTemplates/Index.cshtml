@using Application.DTOs.Pricing
@using Web.ViewModels.Admin.PricingTemplates
@model PricingTemplatesIndexVm

@{
    ViewData["Title"] = "Шаблони цін";

    var isHallDisabled = !Model.CinemaId.HasValue;
    var hallPlaceholder = Model.CinemaId.HasValue ? "— Оберіть зал —" : "— Спершу оберіть кінотеатр —";

    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
            <h1 class="section-title mb-0">Шаблони цін</h1>

            <a class="btn btn-maroon"
               asp-action="Create"
               asp-route-cinemaId="@Model.CinemaId"
               asp-route-hallId="@Model.HallId"
               asp-route-returnUrl="@returnUrl">
                <i class="fa-solid fa-plus me-1"></i>
                СТВОРИТИ ШАБЛОН
            </a>
        </div>

        @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 br-12">@ok</div>
        }
        @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-12">@err</div>
        }

        <div class="d-none" id="afToken">
            @Html.AntiForgeryToken()
        </div>

        <div class="card shadow-sm border-0 mb-4 br-12">
            <div class="card-body p-4">
                <form method="get" asp-action="Index" id="filtersForm" class="row g-3 align-items-end">

                    <div class="col-12 col-lg-4">
                        <label class="form-label small fw-bold text-muted text-uppercase">
                            <i class="fa-solid fa-film me-1"></i> Кінотеатр
                        </label>
                        <select class="form-select shadow-none"
                                asp-for="CinemaId"
                                asp-items="Model.Cinemas"
                                id="cinemaSelect">
                            <option value="">Усі кінотеатри</option>
                        </select>
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label small fw-bold text-muted text-uppercase">
                            <i class="fa-solid fa-couch me-1"></i> Зал
                        </label>
                        <select class="form-select shadow-none"
                                asp-for="HallId"
                                asp-items="Model.Halls"
                                id="hallSelect"
                                disabled="@isHallDisabled"
                                aria-disabled="@isHallDisabled">
                            <option value="">@hallPlaceholder</option>
                        </select>
                    </div>

                    <div class="col-12 col-lg-4 text-lg-end">
                        <button type="submit" class="btn btn-maroon px-4">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> ПОКАЗАТИ
                        </button>
                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fa-solid fa-rotate-left me-1"></i> СКИНУТИ
                        </a>
                    </div>

                    @if (!Model.HallId.HasValue)
                    {
                        <div class="col-12">
                            <div class="text-muted small mt-1">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                Оберіть кінотеатр, а потім зал, щоб побачити шаблони.
                            </div>
                        </div>
                    }
                </form>
            </div>
        </div>

        @if (Model.Templates == null || !Model.Templates.Any())
        {
            <div class="empty-state mx-auto" style="max-width: 680px;">
                <div class="empty-icon"><i class="fa-solid fa-tags"></i></div>

                <h5 class="empty-title">
                    @if (Model.HallId.HasValue)
                    {
                        <span>У цьому залі ще немає шаблонів цін</span>
                    }
                    else
                    {
                        <span>Оберіть зал зі списку вище</span>
                    }
                </h5>

                <p class="empty-sub mb-3">
                    @if (Model.HallId.HasValue)
                    {
                        <span>Створіть перший шаблон і використовуйте його для швидкого заповнення цін.</span>
                    }
                    else
                    {
                        <span>Фільтри зверху допоможуть звузити список.</span>
                    }
                </p>

                @if (Model.HallId.HasValue)
                {
                    <a class="btn btn-maroon px-4 py-2 fw-bold text-uppercase"
                       asp-action="Create"
                       asp-route-cinemaId="@Model.CinemaId"
                       asp-route-hallId="@Model.HallId"
                       asp-route-returnUrl="@returnUrl">
                        <i class="fa-solid fa-plus me-2"></i>Створити шаблон
                    </a>
                }
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 col-12 admin-table-card overflow-hidden">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table admin-table align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 text-muted small fw-bold text-uppercase">Назва</th>
                                    <th class="text-muted small fw-bold text-uppercase" style="width: 160px;">Статус</th>
                                    <th class="text-muted small fw-bold text-uppercase" style="width: 140px;">Активувати</th>
                                    <th class="text-end pe-4 text-muted small fw-bold text-uppercase" style="width: 220px;">Дії</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.Templates)
                                {
                                    var isActive = item.IsActive;

                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-bold text-dark">@item.Name</span>
                                        </td>

                                        <td>
                                            <span class="badge rounded-pill fw-normal
                                                        @(isActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-muted border")">
                                                @(isActive ? "Активний" : "Неактивний")
                                            </span>
                                        </td>

                                        <td>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input toggle-status-btn"
                                                       type="checkbox"
                                                       role="switch"
                                                       style="cursor:pointer;"
                                                       data-id="@item.Id"
                                                       @(isActive ? "checked" : "")>
                                            </div>
                                        </td>

                                        <td class="pe-4 text-end">
                                            <div class="d-flex justify-content-end gap-1">

                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   asp-route-returnUrl="@returnUrl"
                                                   class="btn btn-sm btn-light border text-primary"
                                                   title="Редагувати">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </a>

                                                <form asp-action="Delete"
                                                      asp-route-id="@item.Id"
                                                      asp-route-returnUrl="@returnUrl"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Видалити шаблон «@item.Name»?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-light border text-danger"
                                                            title="Видалити">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const form = document.getElementById('filtersForm');
            const cinemaSelect = document.getElementById('cinemaSelect');
            const hallSelect = document.getElementById('hallSelect');

            if (cinemaSelect && form) {
                cinemaSelect.addEventListener('change', () => {
                    if (hallSelect) hallSelect.value = '';
                    form.submit();
                });
            }
            if (hallSelect && form) {
                hallSelect.addEventListener('change', () => form.submit());
            }

            const tokenInput = document.querySelector('#afToken input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const toggles = document.querySelectorAll('.toggle-status-btn');
            const url = '@Url.Action("ToggleStatus", "PricingTemplates", new { Area = "Admin" })';

            toggles.forEach(toggle => {
                toggle.addEventListener('change', async function () {
                    const id = this.dataset.id;
                    const originalState = !this.checked;

                    const row = this.closest('.list-group-item');
                    const badge = row ? row.querySelector('.js-status-badge') : null;

                    this.disabled = true;
                    this.style.opacity = '0.6';

                    try {
                        const response = await fetch(url + '?id=' + encodeURIComponent(id), {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            }
                        });

                        if (!response.ok) throw new Error('Server error');

                        if (badge) {
                            if (this.checked) {
                                badge.textContent = 'Активний';
                                badge.className = 'badge br-8 px-3 py-2 js-status-badge bg-success-subtle text-success border border-success-subtle';
                            } else {
                                badge.textContent = 'Неактивний';
                                badge.className = 'badge br-8 px-3 py-2 js-status-badge bg-light text-muted border';
                            }
                        }
                    } catch (error) {
                        console.error(error);
                        alert('Не вдалося змінити статус.');
                        this.checked = originalState;
                    } finally {
                        this.disabled = false;
                        this.style.opacity = '1';
                    }
                });
            });
        });
    </script>
}
