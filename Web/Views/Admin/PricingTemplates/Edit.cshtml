@using Infrastructure.Entities
@using Web.ViewModels.Admin.PricingTemplates
@using System.Text.Json
@model PricingTemplateEditVm

@{
    ViewData["Title"] = "Редагування шаблону";

    var returnUrl = ViewBag.ReturnUrl as string;
    var hasLocalReturn = !string.IsNullOrWhiteSpace(returnUrl) && Url.IsLocalUrl(returnUrl);
    var backHref = hasLocalReturn ? returnUrl! : Url.Action("Index", new { cinemaId = Model.CinemaId, hallId = Model.HallId })!;

    var jsonRowPrices = JsonSerializer.Serialize(Model.RowPrices ?? new List<Application.DTOs.Pricing.RowPriceDto>());
    var jsonCategoryMultipliers = JsonSerializer.Serialize(Model.CategoryMultipliers ?? new List<Application.DTOs.Pricing.CategoryMultiplierDto>());
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Редагування шаблону</h1>
    <a class="btn btn-outline-secondary btn-sm" href="@backHref">Назад</a>
</div>

@if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger mb-3" role="alert">@err</div>
}

<form asp-action="Edit"
      asp-route-id="@Model.Id"
      asp-route-returnUrl="@returnUrl"
      method="post"
      id="editForm">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="returnUrl" value="@returnUrl" />

    <input type="hidden" asp-for="CinemaId" />
    <input type="hidden" asp-for="HallId" />

    <div class="row">
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label fw-bold" asp-for="Name">Назва шаблону</label>
                        <input asp-for="Name" class="form-control" placeholder="Напр: Стандарт (Вечір)" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Кінотеатр</label>
                        <select asp-for="CinemaId"
                                asp-items="Model.Cinemas"
                                class="form-select bg-light"
                                disabled>
                            <option value="">— Кінотеатр —</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Зал</label>
                        <select asp-for="HallId"
                                asp-items="Model.Halls"
                                class="form-select bg-light"
                                id="hallSelect"
                                disabled>
                            <option value="">— Зал —</option>
                        </select>
                        <div class="form-text text-muted">
                            <i class="bi bi-lock-fill"></i> Зал не можна змінити після створення.
                        </div>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActive">
                        <label class="form-check-label" for="isActive">Активний шаблон</label>
                    </div>

                </div>

                <div class="card-footer bg-white border-top-0">
                    <button type="submit" class="btn btn-primary w-100">Зберегти зміни</button>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-primary border-opacity-25">
                <div class="card-header bg-primary bg-opacity-10">
                    <h5 class="card-title mb-0 text-primary fs-6 fw-bold">Налаштування цін</h5>
                </div>

                <div class="card-body">
                    <div class="alert alert-info py-2 px-3 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Ціна квитка = <strong>База ряду</strong> × <strong>Множник категорії</strong>
                    </div>

                    <div class="row">
                        <div class="col-md-6 border-end">
                            <label class="form-label fw-bold small">Базові ціни</label>

                            <div id="rowPricesUi" class="bg-white border rounded p-3 bg-light" style="min-height: 200px;">
                                <div class="text-center text-muted small mt-4">Завантаження даних...</div>
                            </div>
                            <div id="hiddenRowPrices"></div>

                            <span class="text-danger small" asp-validation-for="RowPrices"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Множники (категорія)</label>

                            <div id="catMultipliersWrap" class="bg-white border rounded overflow-hidden p-3 bg-light" style="min-height: 200px;">
                                <div class="text-center text-muted small mt-4">Завантаження даних...</div>
                            </div>

                            <span class="text-danger small" asp-validation-for="CategoryMultipliers"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-3 border-warning border-opacity-25" style="background-color:#fff9e6;">
                <div class="card-header bg-warning bg-opacity-10">
                    <h5 class="card-title mb-0 text-warning-emphasis fs-6 fw-bold">
                        <i class="bi bi-eye me-1"></i>Превʼю цін у залі
                    </h5>
                </div>
                <div class="card-body">
                    <div id="seatPreviewWrap" class="bg-white border rounded p-3 bg-light">
                        <div class="text-center text-muted small mt-4">Завантаження даних...</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const metaUrl = '@Url.Action("PricingMeta", "Sessions", new { Area = "Admin" })';

            const existingRowPrices = @Html.Raw(jsonRowPrices);
            const existingCatMultipliers = @Html.Raw(jsonCategoryMultipliers);

            const CAT = {
                Standard: @((int)SeatCategory.Standard),
                Vip: @((int)SeatCategory.Vip),
                Accessible: @((int)SeatCategory.Accessible)
            };

            const currentHallId = Number('@Model.HallId');

            const rowUi = document.getElementById('rowPricesUi');
            const hiddenContainer = document.getElementById('hiddenRowPrices');
            const catWrap = document.getElementById('catMultipliersWrap');
            const seatPreviewWrap = document.getElementById('seatPreviewWrap');

            let allRows = [];
            const pricesMap = new Map();
            let currentBasePrice = 100;

            const catMap = new Map();
            if (Array.isArray(existingCatMultipliers)) {
                existingCatMultipliers.forEach(x => {
                    const cid = Number(x.Category ?? x.category);
                    const mult = Number(x.Multiplier ?? x.multiplier);
                    if (Number.isFinite(cid) && Number.isFinite(mult)) catMap.set(cid, mult);
                });
            }

            let hallMeta = null;

            function seatUiClass(catId) {
                if (catId === CAT.Vip) return 'seat-bg-vip';
                if (catId === CAT.Accessible) return 'seat-bg-acc';
                return 'seat-bg-std';
            }

            function calcFinal(row, catId) {
                const base = pricesMap.has(row) ? Number(pricesMap.get(row)) : Number(currentBasePrice);
                const mult = catMap.has(catId) ? Number(catMap.get(catId)) : 1;
                return Math.round(base * mult);
            }

            function renderSeatPreviewFromMeta(meta) {
                if (!seatPreviewWrap) return;

                const seats = Array.isArray(meta?.seats) ? meta.seats : [];
                const maxSeats = Number(meta?.maxSeats || 0);

                if (!seats.length || maxSeats <= 0) {
                    seatPreviewWrap.innerHTML = '<div class="text-muted small text-center py-3">Немає місць у залі</div>';
                    return;
                }

                const byRow = new Map();
                seats.forEach(s => {
                    const r = Number(s.row);
                    const n = Number(s.number);
                    const c = Number(s.category);
                    if (!byRow.has(r)) byRow.set(r, new Map());
                    byRow.get(r).set(n, { row: r, number: n, category: c });
                });

                const rows = Array.isArray(meta?.rows) && meta.rows.length
                    ? meta.rows.map(Number)
                    : Array.from(byRow.keys()).sort((a, b) => a - b);

                let gridHtml = '';
                rows.forEach(row => {
                    const seatsInRow = byRow.get(row) || new Map();

                    gridHtml += `<div class="row-label">${row}</div>`;

                    for (let s = 1; s <= maxSeats; s++) {
                        const seat = seatsInRow.get(s);
                        if (!seat) {
                            gridHtml += `<div class="seat seat-empty"></div>`;
                            continue;
                        }

                        const catId = Number(seat.category);
                        const price = calcFinal(row, catId);

                        gridHtml += `
                            <div class="seat ${seatUiClass(catId)} js-seat-item"
                                 data-row="${row}"
                                 data-cat="${catId}"
                                 data-seat="${s}"
                                 title="Ряд ${row}, місце ${s} — ${price} грн">
                                <div class="seat-text">
                                    <div class="seat-no">${s}</div>
                                    <div class="seat-price js-seat-price">${price}</div>
                                </div>
                            </div>
                        `;
                    }
                });

                seatPreviewWrap.innerHTML = `
                    <div class="cinema-map-wrap">
                        <div class="cinema-map">
                            <div class="cinema-screen">
                                <div class="cinema-screen-arc"></div>
                                <div class="cinema-screen-title">ЕКРАН</div>
                            </div>

                            <div class="cinema-grid" style="--cols:${maxSeats};">
                                ${gridHtml}
                            </div>
                        </div>
                    </div>
                `;
            }

            function recalcVisualMap() {
                if (!seatPreviewWrap) return;

                seatPreviewWrap.querySelectorAll('.js-seat-item').forEach(el => {
                    const row = Number(el.dataset.row);
                    const cat = Number(el.dataset.cat);
                    const seatNo = el.dataset.seat || '';

                    const final = calcFinal(row, cat);

                    const priceEl = el.querySelector('.js-seat-price');
                    if (priceEl && priceEl.textContent !== String(final)) {
                        priceEl.style.opacity = '0.5';
                        priceEl.textContent = String(final);
                        setTimeout(() => priceEl.style.opacity = '1', 150);
                    }

                    el.title = `Ряд ${row}, місце ${seatNo} — ${final} грн`;
                });
            }

            function updateHiddenInputsOnly() {
                if (!hiddenContainer) return;

                hiddenContainer.innerHTML = '';
                allRows.forEach((r, index) => {
                    const price = pricesMap.has(r) ? Number(pricesMap.get(r)) : Number(currentBasePrice);

                    const inputRow = document.createElement('input');
                    inputRow.type = 'hidden';
                    inputRow.name = `RowPrices[${index}].Row`;
                    inputRow.value = String(r);

                    const inputPrice = document.createElement('input');
                    inputPrice.type = 'hidden';
                    inputPrice.name = `RowPrices[${index}].BasePrice`;
                    inputPrice.value = String(price);

                    hiddenContainer.appendChild(inputRow);
                    hiddenContainer.appendChild(inputPrice);
                });

                recalcVisualMap();
            }

            function renderRowUi() {
                if (!rowUi) return;

                let html = `
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-dark" for="basePriceInput">Загальна ціна</label>
                        <div class="input-group">
                            <span class="input-group-text">₴</span>
                            <input type="number" id="basePriceInput" class="form-control fw-bold" value="${currentBasePrice}" min="0" />
                        </div>
                    </div>

                    <hr class="text-muted opacity-25 my-3">

                    <div class="mb-2">
                        <label class="form-label fw-bold small text-dark mb-2">Винятки</label>
                        <div id="exceptionsContainer" class="d-flex flex-column gap-2 mb-3">
                `;

                if (pricesMap.size === 0) {
                    html += `<div class="text-muted small fst-italic ms-1 py-2" id="noExMsg">Винятків немає. Всі ряди коштують ${currentBasePrice} грн.</div>`;
                } else {
                    const sortedRows = Array.from(pricesMap.keys()).sort((a, b) => a - b);
                    sortedRows.forEach(row => {
                        const price = Number(pricesMap.get(row));
                        html += `
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-secondary fw-normal" style="min-width: 60px;">Ряд ${row}</span>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">₴</span>
                                    <input type="number" class="form-control text-end js-ex-price" data-row="${row}" value="${price}" min="0" />
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger js-remove-ex" data-row="${row}" title="Видалити виняток">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        `;
                    });
                }

                html += `
                        </div>
                    </div>

                    <div class="bg-light p-2 rounded border border-light">
                        <label class="form-label small text-muted mb-1">Додати новий виняток:</label>
                        <div class="d-flex gap-2">
                            <select id="exceptionRowSelect" class="form-select form-select-sm">
                                <option value="">-- Оберіть ряд --</option>
                `;

                allRows.forEach(r => {
                    if (!pricesMap.has(r)) html += `<option value="${r}">Ряд ${r}</option>`;
                });

                html += `
                            </select>
                            <button type="button" id="addExceptionBtn" class="btn btn-sm btn-secondary text-nowrap px-3">
                                <i class="bi bi-plus-lg me-1"></i> Додати
                            </button>
                        </div>
                    </div>
                `;

                rowUi.innerHTML = html;

                updateHiddenInputsOnly();
                attachRowEvents();
            }

            function attachRowEvents() {
                document.getElementById('basePriceInput')?.addEventListener('input', function () {
                    const val = Number(this.value);
                    if (Number.isFinite(val) && val >= 0) {
                        currentBasePrice = val;
                        updateHiddenInputsOnly();
                        const msg = document.getElementById('noExMsg');
                        if (msg) msg.textContent = `Винятків немає. Всі ряди коштують ${currentBasePrice} грн.`;
                    }
                });

                document.getElementById('addExceptionBtn')?.addEventListener('click', function () {
                    const select = document.getElementById('exceptionRowSelect');
                    const row = Number(select?.value || 0);
                    if (row > 0) {
                        pricesMap.set(row, currentBasePrice);
                        renderRowUi();
                    }
                });

                document.querySelectorAll('.js-remove-ex').forEach(btn => {
                    btn.addEventListener('click', function () {
                        const row = Number(this.dataset.row || 0);
                        if (row > 0) {
                            pricesMap.delete(row);
                            renderRowUi();
                        }
                    });
                });

                document.querySelectorAll('.js-ex-price').forEach(input => {
                    input.addEventListener('input', function () {
                        const row = Number(this.dataset.row || 0);
                        const val = Number(this.value);
                        if (row > 0 && Number.isFinite(val) && val >= 0) {
                            pricesMap.set(row, val);
                            updateHiddenInputsOnly();
                        }
                    });
                });
            }

            function initRowData(rows) {
                allRows = Array.isArray(rows) ? rows.map(Number) : [];
                pricesMap.clear();

                if (Array.isArray(existingRowPrices) && existingRowPrices.length > 0 && allRows.length > 0) {
                    const counts = {};
                    existingRowPrices.forEach(p => {
                        const price = Number(p.BasePrice);
                        counts[price] = (counts[price] || 0) + 1;
                    });

                    const sorted = Object.keys(counts).sort((a, b) => counts[b] - counts[a]);
                    const modePrice = Number(sorted[0] ?? 100);
                    currentBasePrice = Number.isFinite(modePrice) ? modePrice : 100;

                    existingRowPrices.forEach(p => {
                        const row = Number(p.Row);
                        const price = Number(p.BasePrice);
                        if (allRows.includes(row) && price !== currentBasePrice) {
                            pricesMap.set(row, price);
                        }
                    });
                } else {
                    currentBasePrice = 100;
                }

                renderRowUi();
            }

            function renderCats(apiCategories) {
                if (!catWrap) return;

                if (!Array.isArray(apiCategories) || apiCategories.length === 0) {
                    catWrap.innerHTML = '<div class="text-muted small text-center py-3">Дані відсутні</div>';
                    return;
                }

                catWrap.innerHTML = `
                    <table class="table table-sm table-borderless align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="ps-3 small">Категорія</th>
                                <th class="text-end pe-3 small">Множник</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${apiCategories.map((c, i) => {
                                const id = Number(c.id);
                                const title = String(c.title ?? id);
                                const val = catMap.has(id) ? Number(catMap.get(id)) : 1;
                                if (!catMap.has(id)) catMap.set(id, val);

                                return `
                                    <tr>
                                        <td class="ps-3 small fw-bold text-muted text-truncate" style="max-width: 220px;" title="${title}">${title}</td>
                                        <td class="text-end pe-2 py-1">
                                            <input type="hidden" name="CategoryMultipliers[${i}].Category" value="${id}" />
                                            <input class="form-control form-control-sm text-end js-cat-mult"
                                                   style="width:80px; display:inline;"
                                                   type="number" step="0.1" min="0.1"
                                                   data-cat="${id}"
                                                   name="CategoryMultipliers[${i}].Multiplier"
                                                   value="${val}" />
                                        </td>
                                    </tr>
                                `;
                            }).join('')}
                        </tbody>
                    </table>
                `;
            }

            catWrap?.addEventListener('input', (e) => {
                const t = e.target;
                if (!(t instanceof HTMLInputElement)) return;
                if (!t.classList.contains('js-cat-mult')) return;

                const cid = Number(t.dataset.cat);
                const mult = Number(t.value);

                if (Number.isFinite(cid) && Number.isFinite(mult)) {
                    catMap.set(cid, mult);
                    recalcVisualMap();
                }
            });

            async function loadMeta(hallId) {
                if (!hallId) return;

                try {
                    const res = await fetch(metaUrl + '?hallId=' + encodeURIComponent(hallId));
                    if (!res.ok) throw new Error();

                    const data = await res.json();
                    hallMeta = data;

                    initRowData(data.rows);
                    renderCats(data.categories);

                    renderSeatPreviewFromMeta(data);
                    recalcVisualMap();

                } catch (e) {
                    console.error(e);
                    if (rowUi) rowUi.innerHTML = '<div class="text-danger small text-center mt-4">Помилка завантаження даних</div>';
                    if (catWrap) catWrap.innerHTML = '<div class="text-danger small text-center mt-4">Помилка завантаження даних</div>';
                    if (seatPreviewWrap) seatPreviewWrap.innerHTML = '<div class="text-danger small text-center mt-4">Помилка завантаження даних</div>';
                    hallMeta = null;
                }
            }

            if (Number.isFinite(currentHallId) && currentHallId > 0) {
                loadMeta(currentHallId);
            }
        })();
    </script>
}
