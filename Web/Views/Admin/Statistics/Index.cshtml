@using Infrastructure.Entities
@using System.Globalization
@model Web.ViewModels.Admin.Statistics.BookingStatisticsIndexVm

@{
    var qs = Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : "";
    string ExportAllUrl() => (Url.Action("ExportAll", "Statistics") ?? "#") + qs;
    string ExportSliceUrl(string slice) => (Url.Action("Export", "Statistics", new { slice }) ?? "#") + qs;

    ViewData["Title"] = "Статистика";
    var ua = new CultureInfo("uk-UA");

    string Money(decimal v) => v.ToString("N2", ua);
    string Pct(decimal v) => v.ToString("N2", ua) + "%";

    string Pt(PresentationType p) => p switch
    {
        PresentationType.TwoD => "2D",
        PresentationType.ThreeD => "3D",
        PresentationType.Imax => "IMAX",
        _ => p.ToString()
    };

    string Cat(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "Standard",
        SeatCategory.Vip => "VIP",
        SeatCategory.Accessible => "Accessible",
        _ => c.ToString()
    };
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <div class="card-modern mb-4 overflow-hidden">
            <div class="card-header-modern">
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <span class="icon-badge">
                            <i class="fa-solid fa-chart-line"></i>
                        </span>
                        <div>
                            <h1 class="page-title mb-1">Статистика бронювань</h1>
                            <div class="header-subtitle">
                                Фільтруй по сеансах/бронюваннях і дивись зрізи по кінотеатрах, залах, фільмах та категоріях місць.
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-maroon" type="submit" form="filtersForm">
                            <i class="fa-solid fa-filter me-1"></i> Показати
                        </button>
                        <a class="btn btn-soft" asp-action="Index">
                            <i class="fa-solid fa-rotate-left me-1"></i> Скинути
                        </a>
                    </div>
                </div>

               
            </div>

            <div class="card-body p-4 p-md-4">
                <form method="get" asp-action="Index" class="row g-3 align-items-end" id="filtersForm">

                    <div class="col-12 col-lg-6">
                        <div class="panel h-100">
                            <div class="panel-head mb-3">
                                <div>
                                    <div class="panel-title">
                                        <i class="fa-solid fa-calendar-days me-1"></i>
                                        Діапазон по даті <span class="text-accent">сеансу</span>
                                    </div>
                                    <div class="panel-hint">Фільтр по StartTime</div>
                                </div>
                            </div>

                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label">Від</label>
                                    <input class="form-control"
                                           asp-for="SessionFrom"
                                           type="datetime-local"
                                           step="60" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">До</label>
                                    <input class="form-control"
                                           asp-for="SessionTo"
                                           type="datetime-local"
                                           step="60" />
                                </div>
                            </div>

                            <div class="form-check form-switch mt-3 d-flex align-items-center gap-2">
                                <input class="form-check-input toggle-status-btn"
                                       asp-for="IncludeFinishedSessions" />
                                <label class="form-check-label m-0"
                                       asp-for="IncludeFinishedSessions">Включати завершені сеанси</label>
                            </div>

                            <div class="form-check form-switch mt-2 d-flex align-items-center gap-2">
                                <input class="form-check-input toggle-status-btn"
                                       asp-for="IncludeCancelledSessions" />
                                <label class="form-check-label m-0"
                                       asp-for="IncludeCancelledSessions">Включати скасовані сеанси</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="panel h-100">
                            <div class="panel-head mb-3">
                                <div>
                                    <div class="panel-title">
                                        <i class="fa-solid fa-receipt me-1"></i>
                                        Діапазон по даті <span class="text-accent">бронювання</span>
                                    </div>
                                    <div class="panel-hint">Фільтр по BookedAt</div>
                                </div>
                            </div>

                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label">Від</label>
                                    <input class="form-control"
                                           asp-for="BookingFrom"
                                           type="datetime-local"
                                           step="60" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">До</label>
                                    <input class="form-control"
                                           asp-for="BookingTo"
                                           type="datetime-local"
                                           step="60" />
                                </div>
                            </div>

                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" asp-for="IncludeDeletedBookingsInPeriod" />
                                <label class="form-check-label" asp-for="IncludeDeletedBookingsInPeriod">
                                    Додавати скасовані бронювання до “дохід за період”
                                </label>
                            </div>

                            <div class="form-text">Скасовані бронювання показуються окремо.</div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label">
                            <i class="fa-solid fa-building me-1"></i>Кінотеатр
                        </label>
                        <select class="form-select"
                                asp-for="CinemaId"
                                asp-items="Model.Cinemas"
                                id="cinemaSelect">
                            <option value="0">— Усі кінотеатри —</option>
                        </select>
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label">
                            <i class="fa-solid fa-chair me-1"></i>Зал
                        </label>
                        <select class="form-select"
                                asp-for="HallId"
                                asp-items="Model.Halls"
                                id="hallSelect"
                                disabled="@(Model.CinemaId <= 0)">
                            <option value="0">@(Model.CinemaId > 0 ? "— Усі зали —" : "— Спершу оберіть кінотеатр —")</option>
                        </select>
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label">
                            <i class="fa-solid fa-hashtag me-1"></i>ID сеансу
                        </label>
                        <input class="form-control"
                               asp-for="SessionId"
                               type="number"
                               min="1"
                               placeholder="Напр. 12" />
                    </div>

                    <div class="col-12 col-lg-6">
                        <label class="form-label">
                            <i class="fa-solid fa-film me-1"></i>Фільм
                        </label>

                        <input class="form-control"
                               list="movieList"
                               id="movieTitleInput"
                               asp-for="MovieTitle"
                               placeholder="Почніть вводити назву..."
                               autocomplete="off" />

                        <datalist id="movieList">
                            @foreach (var m in Model.Movies)
                            {
                                <option value="@m.Text" data-id="@m.Value"></option>
                            }
                        </datalist>

                        <input type="hidden" asp-for="MovieId" id="movieIdHidden" />
                    </div>

                    <div class="col-12 col-lg-6">
                        <label class="form-label">
                            <i class="fa-solid fa-ticket me-1"></i>Тип показу
                        </label>

                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var p in Enum.GetValues<PresentationType>())
                            {
                                var checkedNow = Model.PresentationTypes.Contains(p);
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="PresentationTypes"
                                           value="@p"
                                           id="pt_@p"
                                           @(checkedNow ? "checked" : null) />
                                    <label class="form-check-label" for="pt_@p">@Pt(p)</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">
                            <i class="fa-solid fa-layer-group me-1"></i>Категорії місць
                        </label>

                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var c in Enum.GetValues<SeatCategory>())
                            {
                                var checkedNow = Model.SeatCategories.Contains(c);
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SeatCategories"
                                           value="@c"
                                           id="sc_@c"
                                           @(checkedNow ? "checked" : null) />
                                    <label class="form-check-label" for="sc_@c">@Cat(c)</label>
                                </div>
                            }
                        </div>

                        <div class="form-text">За замовчуванням обрані всі категорії</div>
                    </div>

                    <div class="col-12 d-flex gap-2 flex-wrap">
                        <button class="btn btn-maroon px-4" type="submit">
                            <i class="fa-solid fa-chart-line me-1"></i> ПОКАЗАТИ
                        </button>

                        <a class="btn btn-soft px-4" asp-action="Index">
                            <i class="fa-solid fa-rotate-left me-1"></i> СКИНУТИ
                        </a>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.Result is not null)
        {
            var s = Model.Result.Summary;

            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-3">
                    <div class="card-modern h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start justify-content-between">
                                <div>
                                    <div class="text-muted small fw-bold text-uppercase">Сеансів у вибірці</div>
                                    <div class="fs-4 fw-bold">@s.SessionsCount</div>
                                    <div class="small text-muted">Активні: @s.ActiveSessionsCount • Завершені: @s.FinishedSessionsCount • Скасовані: @s.CancelledSessionsCount</div>
                                </div>
                                <span class="icon-badge"><i class="fa-solid fa-clapperboard"></i></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-3">
                    <div class="card-modern h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start justify-content-between">
                                <div>
                                    <div class="text-muted small fw-bold text-uppercase">Заповненість (зараз)</div>
                                    <div class="fs-4 fw-bold">@Pct(s.OccupancyNowPercent)</div>
                                    <div class="small text-muted">Місць: @s.TotalSeats • Заброньовано: @s.BookedSeatsNow • Вільно: @s.FreeSeatsNow</div>
                                </div>
                                <span class="icon-badge"><i class="fa-solid fa-chair"></i></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-3">
                    <div class="card-modern h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start justify-content-between">
                                <div>
                                    <div class="text-muted small fw-bold text-uppercase">Дохід (зараз)</div>
                                    <div class="fs-4 fw-bold">@Money(s.RevenueNow) грн</div>
                                    <div class="small text-muted">Потенціал: @Money(s.PotentialRevenue) • Ще можна: @Money(s.RemainingPotentialRevenue)</div>
                                </div>
                                <span class="icon-badge"><i class="fa-solid fa-coins"></i></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-3">
                    <div class="card-modern h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start justify-content-between">
                                <div>
                                    <div class="text-muted small fw-bold text-uppercase">Продажі за період (BookedAt)</div>
                                    <div class="fs-4 fw-bold">@Money(s.RevenuePeriod) грн</div>
                                    <div class="small text-muted">Бронювань: @s.BookingsCountPeriod • Місць: @s.SeatsSoldPeriod</div>
                                    <div class="small text-muted">Скасовано: @s.CancelledBookingsCountPeriod • @Money(s.CancelledRevenuePeriod) грн</div>
                                </div>
                                <span class="icon-badge"><i class="fa-solid fa-receipt"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-modern mb-4 overflow-hidden">
                <div class="card-header-modern">
                    <div class="card-header-modern position-relative">
                        <div class="d-flex align-items-center gap-2">
                            <span class="icon-badge"><i class="fa-solid fa-table"></i></span>
                            <div>
                                <div class="header-title mb-0">Зрізи</div>
                                <div class="header-subtitle">Перемикай вкладки, щоб швидко порівняти показники.</div>
                            </div>
                        </div>

                        <a class="btn btn-success position-absolute"
                           style="top: 12px; right: 12px;"
                           href="@ExportAllUrl()">
                            <i class="fa-solid fa-file-excel me-1"></i> Експорт (все)
                        </a>
                    </div>

                    <div class="mt-3">
                        <ul class="nav nav-pills flex-wrap gap-2" id="statsTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="cinemas-tab" data-bs-toggle="pill" data-bs-target="#cinemas" type="button" role="tab">Кінотеатри</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="halls-tab" data-bs-toggle="pill" data-bs-target="#halls" type="button" role="tab">Зали</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="movies-tab" data-bs-toggle="pill" data-bs-target="#movies" type="button" role="tab">Фільми (top)</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="sessions-tab" data-bs-toggle="pill" data-bs-target="#sessions" type="button" role="tab">Сеанси (top)</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="types-tab" data-bs-toggle="pill" data-bs-target="#types" type="button" role="tab">Типи показу</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="cats-tab" data-bs-toggle="pill" data-bs-target="#cats" type="button" role="tab">Категорії місць</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="days1-tab" data-bs-toggle="pill" data-bs-target="#days1" type="button" role="tab">По днях (StartTime)</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="days2-tab" data-bs-toggle="pill" data-bs-target="#days2" type="button" role="tab">По днях (BookedAt)</button>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="tab-content" id="statsTabsContent">

                        @{
                            Func<int, object> EmptyRow = (cols) => new object();
                        }

                        <div class="tab-pane fade show active p-3 p-md-4" id="cinemas" role="tabpanel" aria-labelledby="cinemas-tab">
                            <div class="admin-table-card">
                                <div class="d-flex justify-content-end mb-2">
                                    <a class="btn btn-success btn-sm" href="@ExportSliceUrl("cinemas")">
                                        <i class="fa-solid fa-file-excel me-1"></i> Excel
                                    </a>
                                </div>
                                <div class="table-responsive">
                                    <table class="admin-table align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th class="ps-4">Кінотеатр</th>
                                                <th class="text-end">Сеансів</th>
                                                <th class="text-end">Місць</th>
                                                <th class="text-end">Забр. зараз</th>
                                                <th class="text-end">Заповненість</th>
                                                <th class="text-end">Дохід зараз</th>
                                                <th class="text-end">Потенціал</th>
                                                <th class="text-end pe-4">Продажі за період</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in Model.Result!.ByCinemas)
                                            {
                                                <tr>
                                                    <td class="ps-4 fw-bold">@r.CinemaName</td>
                                                    <td class="text-end">@r.SessionsCount</td>
                                                    <td class="text-end">@r.TotalSeats</td>
                                                    <td class="text-end fw-bold">@r.BookedSeatsNow</td>
                                                    <td class="text-end">@r.OccupancyNowPercent.ToString("N2", ua)%</td>
                                                    <td class="text-end">@Money(r.RevenueNow) грн</td>
                                                    <td class="text-end">@Money(r.PotentialRevenue) грн</td>
                                                    <td class="text-end pe-4">
                                                        <div class="fw-semibold">@Money(r.RevenuePeriod) грн</div>
                                                        <div class="small text-muted">броней: @r.BookingsCountPeriod • місць: @r.SeatsSoldPeriod</div>
                                                    </td>
                                                </tr>
                                            }
                                            @if (!Model.Result!.ByCinemas.Any())
                                            {
                                                <tr>
                                                    <td class="ps-4 py-3 text-muted" colspan="8">Немає даних за обраними фільтрами.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade p-3 p-md-4" id="halls" role="tabpanel" aria-labelledby="halls-tab">
                            <div class="admin-table-card">
                                <div class="d-flex justify-content-end mb-2">
                                    <a class="btn btn-success btn-sm" href="@ExportSliceUrl("halls")">
                                        <i class="fa-solid fa-file-excel me-1"></i> Excel
                                    </a>
                                </div>
                                <div class="table-responsive">
                                    <table class="admin-table align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th class="ps-4">Кінотеатр</th>
                                                <th>Зал</th>
                                                <th class="text-end">Сеансів</th>
                                                <th class="text-end">Місць</th>
                                                <th class="text-end">Забр. зараз</th>
                                                <th class="text-end">Заповненість</th>
                                                <th class="text-end">Дохід зараз</th>
                                                <th class="text-end pe-4">Продажі за період</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in Model.Result!.ByHalls)
                                            {
                                                <tr>
                                                    <td class="ps-4">@r.CinemaName</td>
                                                    <td class="fw-bold">@r.HallName</td>
                                                    <td class="text-end">@r.SessionsCount</td>
                                                    <td class="text-end">@r.TotalSeats</td>
                                                    <td class="text-end fw-bold">@r.BookedSeatsNow</td>
                                                    <td class="text-end">@r.OccupancyNowPercent.ToString("N2", ua)%</td>
                                                    <td class="text-end">@Money(r.RevenueNow) грн</td>
                                                    <td class="text-end pe-4">
                                                        <div class="fw-semibold">@Money(r.RevenuePeriod) грн</div>
                                                        <div class="small text-muted">броней: @r.BookingsCountPeriod • місць: @r.SeatsSoldPeriod</div>
                                                    </td>
                                                </tr>
                                            }
                                            @if (!Model.Result!.ByHalls.Any())
                                            {
                                                <tr>
                                                    <td class="ps-4 py-3 text-muted" colspan="8">Немає даних за обраними фільтрами.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade p-3 p-md-4" id="movies" role="tabpanel" aria-labelledby="movies-tab">
                            <div class="admin-table-card">
                                <div class="d-flex justify-content-end mb-2">
                                    <a class="btn btn-success btn-sm" href="@ExportSliceUrl("movies")">
                                        <i class="fa-solid fa-file-excel me-1"></i> Excel
                                    </a>
                                </div>
                                <div class="table-responsive">
                                    <table class="admin-table align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th class="ps-4">Фільм</th>
                                                <th class="text-end">Сеансів</th>
                                                <th class="text-end">Місць</th>
                                                <th class="text-end">Забр. зараз</th>
                                                <th class="text-end">Заповненість</th>
                                                <th class="text-end">Дохід зараз</th>
                                                <th class="text-end">Потенціал</th>
                                                <th class="text-end pe-4">Продажі за період</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in Model.Result!.ByMovies)
                                            {
                                                <tr>
                                                    <td class="ps-4 fw-bold">@r.MovieTitle</td>
                                                    <td class="text-end">@r.SessionsCount</td>
                                                    <td class="text-end">@r.TotalSeats</td>
                                                    <td class="text-end fw-bold">@r.BookedSeatsNow</td>
                                                    <td class="text-end">@r.OccupancyNowPercent.ToString("N2", ua)%</td>
                                                    <td class="text-end">@Money(r.RevenueNow) грн</td>
                                                    <td class="text-end">@Money(r.PotentialRevenue) грн</td>
                                                    <td class="text-end pe-4">
                                                        <div class="fw-semibold">@Money(r.RevenuePeriod) грн</div>
                                                        <div class="small text-muted">броней: @r.BookingsCountPeriod • місць: @r.SeatsSoldPeriod</div>
                                                    </td>
                                                </tr>
                                            }
                                            @if (!Model.Result!.ByMovies.Any())
                                            {
                                                <tr>
                                                    <td class="ps-4 py-3 text-muted" colspan="8">Немає даних за обраними фільтрами.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade p-3 p-md-4" id="sessions" role="tabpanel" aria-labelledby="sessions-tab">
                            <div class="admin-table-card">
                                <div class="d-flex justify-content-end mb-2">
                                    <a class="btn btn-success btn-sm" href="@ExportSliceUrl("sessions")">
                                        <i class="fa-solid fa-file-excel me-1"></i> Excel
                                    </a>
                                </div>
                                <div class="table-responsive">
                                    <table class="admin-table align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th class="ps-4">ID</th>
                                                <th>Старт</th>
                                                <th>Фільм</th>
                                                <th>Кінотеатр</th>
                                                <th>Зал</th>
                                                <th>Тип</th>
                                                <th class="text-end">Місць</th>
                                                <th class="text-end">Забр.</th>
