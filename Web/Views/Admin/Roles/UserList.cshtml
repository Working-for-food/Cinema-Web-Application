@using Web.ViewModels.Roles
@model IEnumerable<UserWithRolesVm>
@{
    ViewData["Title"] = "Список користувачів";
}

<div class="container mt-4">
    <h2>Список користувачів</h2>
    <a asp-action="Index" class="btn btn-secondary mb-3">Назад до ролей</a>

    <table class="table table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Email</th>
                <th>Ролі</th>
                <th class="text-end">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>
                        @if (user.Roles.Any())
                        {
                            @string.Join(", ", user.Roles)
                        }
                        else
                        {
                            <span class="text-muted">Немає ролей</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-userId="@user.UserId">
                            <i class="fas fa-user-cog"></i> Права доступу
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>