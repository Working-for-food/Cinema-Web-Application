@using Web.ViewModels.Roles
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model IEnumerable<UserWithRolesVm>
@{
    ViewData["Title"] = "Список користувачів";
    string superAdminEmail = Configuration["SuperAdmin:Email"];
}

<section class="py-5 gray-bg">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
            <div>
                <h1 class="section-title mb-1 text-uppercase">Керування користувачами</h1>
                <p class="text-muted small text-uppercase fw-bold opacity-75 mt-3">Список зареєстрованих осіб та їх рівні доступу</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary px-4 py-2 fw-bold text-uppercase">
                    <i class="fa-solid fa-arrow-left me-2"></i>СПИСОК РОЛЕЙ
                </a>
            </div>
        </div>

        <div class="card shadow-sm border-0 br-12 overflow-hidden bg-white">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table admin-table mb-0 align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">Користувач</th>
                                <th>Контакти</th>
                                <th>Рівень доступу</th>
                                <th class="text-end pe-4">Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                bool isSuperAdmin = user.Email == superAdminEmail;

                                <tr class="@(isSuperAdmin ? "bg-light-soft" : "")">

                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-badge @(isSuperAdmin ? "bg-warning text-white" : "bg-light text-primary") me-3" style="width: 40px; height: 40px;">
                                                <i class="fa-solid @(isSuperAdmin ? "fa-crown" : "fa-user")"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@user.Username.ToUpper()</span>
                                                @if (isSuperAdmin)
                                                {
                                                    <span class="text-warning x-small fw-bold text-uppercase">Головний адміністратор</span>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="small text-muted fw-semibold">
                                            <i class="fa-solid fa-envelope me-1 opacity-50"></i> @user.Email
                                        </div>
                                    </td>

                                    <td>
                                        @if (user.Roles != null && user.Roles.Any())
                                        {
                                            var isAdmin = user.Roles.Any(r => r.Equals("admin", StringComparison.OrdinalIgnoreCase));

                                            if (isAdmin)
                                            {
                                                <span class="badge bg-danger px-3 py-2 text-uppercase br-6 shadow-none" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                                    <i class="fa-solid fa-user-shield me-1"></i> ADMIN
                                                </span>
                                            }
                                            else
                                            {
                                                var roleName = user.Roles.FirstOrDefault() ?? "User";
                                                <span class="badge bg-dark px-3 py-2 text-uppercase br-6 shadow-none" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                                    <i class="fa-solid fa-user me-1"></i> @roleName
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small opacity-50"><em>Без прав</em></span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        @if (isSuperAdmin)
                                        {
                                            <span class="badge bg-light text-muted border px-3 py-2 br-8">
                                                <i class="fa-solid fa-lock me-1"></i> ЗАХИЩЕНО
                                            </span>
                                        }
                                        else
                                        {
                                            <a class="btn btn-maroon-light btn-sm px-3 br-8 fw-bold" asp-action="Edit" asp-route-userId="@user.UserId">
                                                <i class="fa-solid fa-user-gear me-1"></i> НАЛАШТУВАТИ
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>