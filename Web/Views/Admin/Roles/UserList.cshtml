@using Web.ViewModels.Roles
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model IEnumerable<UserWithRolesVm>
@{
    ViewData["Title"] = "Список користувачів";
    string superAdminEmail = Configuration["SuperAdmin:Email"];
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users"></i> Список користувачів</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Назад до списку ролей
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Логін</th>
                        <th>Email</th>
                        <th>Рівень доступу</th>
                        <th class="text-end pe-4">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        bool isSuperAdmin = user.Email == superAdminEmail;

                        <tr class="@(isSuperAdmin ? "table-warning" : "")">
                            <td class="ps-4 fw-bold">
                                @user.Username
                                @if (isSuperAdmin)
                                {
                                    <i class="fas fa-crown text-warning ms-1" title="Super Admin"></i>
                                }
                            </td>

                            <td>@user.Email</td>

                            <td>
                                @if (user.Roles.Any())
                                {
                                    if (user.Roles.Contains("admin"))
                                    {
                                        <span class="badge bg-danger rounded-pill px-3">
                                            <i class="fas fa-user-shield"></i> Адміністратор
                                        </span>
                                    }
                                    else
                                    {
                                        foreach (var role in user.Roles)
                                        {
                                            <span class="badge bg-secondary rounded-pill me-1">@role</span>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small"><em>Немає ролей</em></span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (isSuperAdmin)
                                {
                                    <span class="text-muted small"><i class="fas fa-lock"></i> Захищено</span>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-userId="@user.UserId">
                                        <i class="fas fa-user-cog"></i> Налаштувати
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>