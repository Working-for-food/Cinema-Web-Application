@model IEnumerable<Infrastructure.Entities.ApplicationUser>
@{
    ViewData["Title"] = "Список користувачів";
}

<div class="container mt-4">
    <h2>Список користувачів</h2>
    <a asp-action="Index" class="btn btn-secondary mb-3">Назад до ролей</a>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Email</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-userId="@user.Id">
                            Права доступу
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>