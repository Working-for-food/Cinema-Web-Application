@model Web.ViewModels.Admin.MovieEditVm

@{
    ViewData["Title"] = "Редагувати фільм";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">Редагувати фільм</h1>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success mb-3">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger mb-3">@err</div>
        }

        <div class="card shadow-sm col-lg-8 mx-auto">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa-solid fa-pen-to-square me-2"></i>
                    Редагування інформації про фільм
                </h5>
            </div>

            <div class="card-body p-4">
                <form asp-controller="Movies"
                      asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post"
                      asp-antiforgery="true">

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label text-muted">
                            <i class="fa-solid fa-clapperboard me-1"></i>
                            Назва
                        </label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label text-muted">
                            <i class="fa-solid fa-align-left me-1"></i>
                            Опис
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label asp-for="OriginalName" class="form-label text-muted">
                                <i class="fa-solid fa-pen-nib me-1"></i>
                                Оригінальна назва
                            </label>
                            <input asp-for="OriginalName" class="form-control" />
                            <span asp-validation-for="OriginalName" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Language" class="form-label text-muted">
                                <i class="fa-solid fa-language me-1"></i>
                                Мова (ISO)
                            </label>
                            <input asp-for="Language" class="form-control" placeholder="en" />
                            <span asp-validation-for="Language" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 mt-3">
                        <label asp-for="TrailerUrl" class="form-label text-muted">
                            <i class="fa-solid fa-link me-1"></i>
                            Посилання на трейлер
                        </label>
                        <input asp-for="TrailerUrl" type="url" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="TrailerUrl" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="PosterPath" class="form-label text-muted">
                                <i class="fa-solid fa-image me-1"></i>
                                Шлях до постера
                            </label>
                            <input asp-for="PosterPath" class="form-control" />
                            <span asp-validation-for="PosterPath" class="text-danger"></span>
                            <div class="form-text">TMDB: /abc.jpg або повний URL.</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="BackdropPath" class="form-label text-muted">
                                <i class="fa-solid fa-panorama me-1"></i>
                                Шлях до фону (Backdrop)
                            </label>
                            <input asp-for="BackdropPath" class="form-control" />
                            <span asp-validation-for="BackdropPath" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-3 mt-0">
                        <div class="col-12 col-md-6">
                            <label asp-for="ReleaseDate" class="form-label text-muted">
                                <i class="fa-solid fa-calendar-days me-1"></i>
                                Дата виходу
                            </label>
                            <input asp-for="ReleaseDate" type="date" class="form-control" />
                            <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Duration" class="form-label text-muted">
                                <i class="fa-solid fa-clock me-1"></i>
                                Тривалість (хв)
                            </label>
                            <input asp-for="Duration" type="number" class="form-control" />
                            <span asp-validation-for="Duration" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4 mt-3">
                        <label asp-for="SelectedDirectorIds" class="form-label text-muted">
                            <i class="fa-solid fa-video me-1"></i>
                            Режисери
                        </label>
                        <select asp-for="SelectedDirectorIds"
                                asp-items="Model.DirectorMultiList"
                                class="form-select js-people-select"
                                multiple></select>
                        <span asp-validation-for="SelectedDirectorIds" class="text-danger"></span>
                        <div class="form-text">Введіть 3+ літери для пошуку. Можна обрати кількох.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SelectedCountryCodes" class="form-label text-muted">
                            <i class="fa-solid fa-globe me-1"></i>
                            Країни (MovieCountries)
                        </label>
                        <select asp-for="SelectedCountryCodes"
                                asp-items="Model.CountryMultiList"
                                class="form-select"
                                multiple
                                size="6"></select>
                        <span asp-validation-for="SelectedCountryCodes" class="text-danger"></span>
                        <div class="form-text">Ctrl/Command для множинного вибору.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SelectedActorIds" class="form-label text-muted">
                            <i class="fa-solid fa-user-group me-1"></i>
                            Актори
                        </label>
                        <select asp-for="SelectedActorIds"
                                asp-items="Model.ActorList"
                                class="form-select js-people-select"
                                multiple></select>
                        <span asp-validation-for="SelectedActorIds" class="text-danger"></span>
                        <div class="form-text">Введіть 3+ літери для пошуку. Можна обрати кількох.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SelectedGenreIds" class="form-label text-muted">
                            <i class="fa-solid fa-tags me-1"></i>
                            Жанри
                        </label>
                        <select asp-for="SelectedGenreIds"
                                asp-items="Model.GenreList"
                                class="form-select"
                                multiple
                                size="5"></select>
                        <div class="form-text">Утримуйте Ctrl (Windows) або Command (Mac) для множинного вибору.</div>
                        <span asp-validation-for="SelectedGenreIds" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            Назад
                        </a>

                        <button type="submit" class="btn btn-maroon">
                            <i class="fa-solid fa-floppy-disk me-1"></i>
                            Зберегти зміни
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        .select2-container {
            width: 100% !important;
        }

            .select2-container .select2-selection--multiple {
                min-height: 38px;
                padding: .25rem .5rem;
            }

        .select2-container--default .select2-selection--multiple {
            border: 1px solid #ced4da;
            border-radius: .375rem;
        }

            .select2-container--default .select2-selection--multiple .select2-selection__choice {
                margin-top: .25rem;
            }
    </style>

    <script>
        $(function () {
            $('.js-people-select').select2({
                width: '100%',
                minimumInputLength: 3,
                ajax: {
                    url: '/admin/movies/people/search',
                    dataType: 'json',
                    delay: 300,
                    data: function (params) {
                        return {
                            term: params.term,
                            page: params.page || 1
                        };
                    },
                    cache: true
                },
                placeholder: 'Введіть 3+ літери...',
                closeOnSelect: false
            });
        });
    </script>
}
