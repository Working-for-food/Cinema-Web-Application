@model Web.ViewModels.Admin.MovieEditVm

@{
    ViewData["Title"] = "Редагування фільму";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-4">РЕДАГУВАННЯ ФІЛЬМУ</h1>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success mb-3">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger mb-3">@err</div>
        }

        <div class="card shadow-sm col-lg-8 mx-auto">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa-solid fa-pen-to-square me-2"></i>
                    Редагування інформації про фільм
                </h5>
            </div>

            <div class="card-body p-4">
                <form asp-controller="Movies"
                      asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post"
                      asp-antiforgery="true">

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label text-muted">
                            <i class="fa-solid fa-clapperboard me-1"></i>
                            Назва
                        </label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label text-muted">
                            <i class="fa-solid fa-align-left me-1"></i>
                            Опис
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="ReleaseDate" class="form-label text-muted">
                                <i class="fa-solid fa-calendar-days me-1"></i>
                                Дата виходу
                            </label>
                            <input asp-for="ReleaseDate" type="date" class="form-control" />
                            <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="Duration" class="form-label text-muted">
                                <i class="fa-solid fa-clock me-1"></i>
                                Тривалість (хв)
                            </label>
                            <input asp-for="Duration" type="number" class="form-control" />
                            <span asp-validation-for="Duration" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProductionCountryCode" class="form-label text-muted">
                            <i class="fa-solid fa-flag me-1"></i>
                            Країна виробництва
                        </label>
                        <select asp-for="ProductionCountryCode" asp-items="Model.CountryList" class="form-select">
                            <option value="">-- none --</option>
                        </select>
                        <span asp-validation-for="ProductionCountryCode" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DirectorId" class="form-label text-muted">
                            <i class="fa-solid fa-video me-1"></i>
                            Режисер
                        </label>
                        <select asp-for="DirectorId" asp-items="Model.DirectorList" class="form-select">
                            <option value="">-- none --</option>
                        </select>
                        <span asp-validation-for="DirectorId" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SelectedCountryCodes" class="form-label text-muted">
                            <i class="fa-solid fa-globe me-1"></i>
                            Країни (MovieCountries)
                        </label>
                        <select asp-for="SelectedCountryCodes"
                                asp-items="Model.CountryMultiList"
                                class="form-control"
                                multiple
                                size="6"></select>
                        <span asp-validation-for="SelectedCountryCodes" class="text-danger"></span>
                        <div class="form-text">Ctrl/Command для множинного вибору.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SelectedActorIds" class="form-label text-muted">
                            <i class="fa-solid fa-user-group me-1"></i>
                            Актори
                        </label>
                        <select asp-for="SelectedActorIds"
                                asp-items="Model.ActorList"
                                class="form-control"
                                multiple
                                size="6"></select>
                        <span asp-validation-for="SelectedActorIds" class="text-danger"></span>
                        <div class="form-text">Ctrl/Command для множинного вибору.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SelectedGenreIds" class="form-label text-muted">
                            <i class="fa-solid fa-tags me-1"></i>
                            Жанри
                        </label>
                        <select asp-for="SelectedGenreIds"
                                asp-items="Model.GenreList"
                                class="form-control"
                                multiple
                                size="5"></select>
                        <span asp-validation-for="SelectedGenreIds" class="text-danger"></span>
                        <div class="form-text">Утримуйте Ctrl для множинного вибору.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            Назад
                        </a>

                        <button type="submit" class="btn btn-maroon">
                            <i class="fa-solid fa-save me-1"></i>
                            Зберегти зміни
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

