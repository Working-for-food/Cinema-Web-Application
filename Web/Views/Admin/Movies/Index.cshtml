@using Web.Helpers
@model Web.ViewModels.Admin.MovieIndexVm

@{
    ViewData["Title"] = "Фільми";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="section-title mb-0">Фільми</h1>
            <div class="d-flex gap-2">
                <a asp-action="AddFromTmdb" class="btn btn-outline-maroon">
                    <i class="fa-solid fa-cloud-arrow-down me-1"></i>
                    ІМПОРТУВАТИ (TMDB)
                </a>
                <a asp-action="Create" class="btn btn-maroon">
                    <i class="fa-solid fa-plus me-1"></i>
                    ДОДАТИ НОВИЙ ФІЛЬМ
                </a>
            </div>
        </div>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success border-0 shadow-sm mb-3">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-3">@err</div>
        }

        <div class="card shadow-sm border-0 col-12 mb-4">
            <div class="card-body p-4">
                <form method="get" asp-action="Index" class="row g-3 align-items-end">
                    <div class="col-12 col-lg-6">
                        <label class="form-label text-muted small fw-bold text-uppercase">Пошук</label>
                        <div class="input-group border rounded-2">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                            <input name="search" value="@Model.SearchTerm" class="form-control border-0 ps-0" placeholder="Пошук за назвою..." />
                        </div>
                    </div>

                    <div class="col-12 col-lg-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Сортування</label>
                        <select name="sortBy" class="form-select border rounded-2">
                            <option value="">За замовчуванням</option>
                            <option value="title" selected="@(Model.SortBy == "title")">Назва (А-Я)</option>
                            <option value="title_desc" selected="@(Model.SortBy == "title_desc")">Назва (Я-А)</option>
                            <option value="date_asc" selected="@(Model.SortBy == "date_asc")">Дата релізу (↑)</option>
                            <option value="date_desc" selected="@(Model.SortBy == "date_desc")">Дата релізу (↓)</option>
                        </select>
                    </div>

                    <div class="col-12 col-lg-3 text-lg-end">
                        <button type="submit" class="btn btn-maroon px-4">ЗАСТОСУВАТИ</button>
                        <a asp-action="Index" class="btn btn-secondary px-4">СКИНУТИ</a>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.Movies == null || !Model.Movies.Any())
        {
            <div class="text-center py-5 bg-white rounded-3 shadow-sm">
                <i class="fa-solid fa-film fa-3x text-light mb-3"></i>
                <p class="text-muted">Фільми не знайдено.</p>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 col-12 admin-table-card overflow-hidden">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table admin-table align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4" style="width: 100px;">Постер</th>
                                    <th>
                                        <a asp-action="Index" class="text-decoration-none text-muted small fw-bold text-uppercase"
                                           asp-route-sortBy="@(Model.SortBy == "title_desc" ? "title" : "title_desc")"
                                           asp-route-search="@Model.SearchTerm" asp-route-page="@Model.Page">
                                            Назва @(Model.SortBy == "title_desc" ? "▼" : "▲")
                                        </a>
                                    </th>
                                    <th style="width: 160px;">
                                        <a asp-action="Index" class="text-decoration-none text-muted small fw-bold text-uppercase"
                                           asp-route-sortBy="@(Model.SortBy == "date_desc" ? "date_asc" : "date_desc")"
                                           asp-route-search="@Model.SearchTerm" asp-route-page="@Model.Page">
                                            Дата релізу
                                        </a>
                                    </th>
                                    <th class="text-muted small fw-bold text-uppercase" style="width: 140px;">Тривалість</th>
                                    <th class="text-muted small fw-bold text-uppercase">Жанри</th>
                                    <th class="text-muted small fw-bold text-uppercase" style="width: 100px;">Сеанси</th>
                                    <th class="text-end pe-4 text-muted small fw-bold text-uppercase" style="width: 200px;">Дії</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var movie in Model.Movies)
                                {
                                    var posterUrl = TmdbImage.Build(movie.PosterPath, "w92");
                                    <tr>
                                        <td class="ps-4">
                                            <div class="rounded-2 shadow-sm overflow-hidden" style="width: 60px; height: 90px; background: #f0f0f0;">
                                                @if (!string.IsNullOrWhiteSpace(posterUrl))
                                                {
                                                    <img src="@posterUrl" alt="Poster" class="w-100 h-100 object-fit-cover" />
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center justify-content-center h-100 text-muted small text-center p-1">No poster</div>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-dark">@movie.Title</span>
                                        </td>
                                        <td class="text-muted">@(movie.ReleaseDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                                        <td class="text-muted small">@(movie.Duration.HasValue ? $"{movie.Duration} хв" : "-")</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(movie.GenreNames))
                                            {
                                                <span class="badge bg-light text-primary border border-primary-subtle rounded-pill fw-normal">@movie.GenreNames</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@(movie.SessionsCount > 0 ? movie.SessionsCount : "0")</span>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-sm btn-light border" title="Деталі">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-sm btn-light border text-primary" title="Редагувати">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </a>
                                                @if (movie.SessionsCount > 0)
                                                {
                                                    <button type="button" class="btn btn-sm btn-light border text-danger opacity-50" disabled title="Має сеанси">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <form asp-action="Delete" asp-route-id="@movie.Id" method="post" class="d-inline" onsubmit="return confirm('Видалити?');">
                                                        <button type="submit" class="btn btn-sm btn-light border text-danger" title="Видалити">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <nav class="mt-4">
                <ul class="pagination pagination-sm justify-content-center border-0">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link border-0 shadow-sm mx-1 rounded-2" asp-action="Index" 
                           asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link border-0 bg-transparent text-dark fw-bold">@Model.Page / @Model.TotalPages</span>
                    </li>
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link border-0 shadow-sm mx-1 rounded-2" asp-action="Index" 
                           asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</section>