@{
    ViewData["Title"] = "Імпорт з TMDB";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-4">ІМПОРТ З TMDB</h1>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-3">@TempData["Error"]</div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div></div>

            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>
                НАЗАД
            </a>
        </div>

        <div class="card shadow-sm rounded">
            <div class="card-header bg-maroon text-white">
                <h5 class="mb-0">
                    <i class="fa-solid fa-cloud-arrow-down me-2"></i>
                    Пошук фільму в TMDB
                </h5>
            </div>

            <div class="card-body p-4">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-lg-8">
                        <label class="form-label text-muted" for="q">
                            <i class="fa-solid fa-magnifying-glass me-1"></i>
                            Назва
                        </label>
                        <input id="q"
                               class="form-control"
                               placeholder="Напр. Interstellar" />
                    </div>

                    <div class="col-12 col-lg-4">
                        <div class="d-flex gap-2 justify-content-lg-end">
                            <button id="btnSearch"
                                    class="btn btn-maroon flex-grow-1 flex-lg-grow-0"
                                    type="button">
                                <i class="fa-solid fa-magnifying-glass me-1"></i>
                                ПОШУК
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mt-4" id="results"></div>
            </div>
        </div>

        <!-- антифорджері токен в окремій формі, щоб JS міг його взяти -->
        <form id="af" method="post">
            @Html.AntiForgeryToken()
        </form>

    </div>
</section>

@section Scripts {
    <script>
        const btn = document.getElementById("btnSearch");
        const q = document.getElementById("q");
        const results = document.getElementById("results");

        // TODO: якщо ти перенесла методи в MoviesController, то зміни маршрути тут:
        // const SEARCH_URL = "/admin/movies/tmdb/search";
        // const IMPORT_URL = "/admin/movies/tmdb/import";
        const SEARCH_URL = "/admin/movies/tmdb/search";
        const IMPORT_URL = "/admin/movies/tmdb/import";

        btn.addEventListener("click", runSearch);
        q.addEventListener("keydown", (e) => {
            if (e.key === "Enter") { e.preventDefault(); runSearch(); }
        });

        async function runSearch() {
            const query = (q.value || "").trim();
            if (!query) return;

            results.innerHTML = `<div class="text-muted">Loading...</div>`;

            const r = await fetch(`${SEARCH_URL}?query=${encodeURIComponent(query)}`);
            if (!r.ok) {
                results.innerHTML = `<div class="alert alert-danger mb-0">Search failed</div>`;
                return;
            }

            const items = await r.json();
            if (!items.length) {
                results.innerHTML = `<div class="alert alert-secondary mb-0">Немає результатів</div>`;
                return;
            }

            results.innerHTML = `
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:96px">Постер</th>
                                <th>Назва</th>
                                <th style="width:160px">Дата виходу</th>
                                <th class="text-end" style="width:140px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            ${items.map(x => `
                                <tr>
                                    <td>
                                        ${x.posterPath
                                            ? `<img class="img-thumbnail" style="width:72px" src="https://image.tmdb.org/t/p/w92${x.posterPath}" alt="Poster" />`
                                            : `<span class="text-muted">—</span>`
                                        }
                                    </td>
                                    <td>${escapeHtml(x.title ?? "")}</td>
                                    <td>${escapeHtml(x.releaseDate ?? "")}</td>
                                    <td class="text-end" style="white-space:nowrap">
                                        <form method="post" action="${IMPORT_URL}">
                                            <input name="tmdbId" type="hidden" value="${x.tmdbId}" />
                                            <input name="__RequestVerificationToken" type="hidden" value="${getAntiforgeryToken()}" />
                                            <button class="btn btn-sm btn-success" type="submit">
                                                <i class="bi bi-download"></i> Import
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            `).join("")}
                        </tbody>
                    </table>
                </div>
            `;
        }

        function getAntiforgeryToken() {
            return document.querySelector('#af input[name="__RequestVerificationToken"]')?.value ?? "";
        }
        function escapeHtml(s) {
            return String(s)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }
    </script>
}
