@{
    ViewData["Title"] = "Імпорт з TMDB";
}

<section class="py-5 gray-bg">
    <div class="container-fluid px-lg-5">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="section-title mb-0">ІМПОРТ З TMDB</h1>
            <a asp-action="Index" class="btn btn-outline-modern">
                <i class="fa-solid fa-arrow-left me-2"></i>НАЗАД ДО СПИСКУ
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 br-8">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-8">@TempData["Error"]</div>
        }

        <div class="card shadow-sm border-0 br-12 overflow-hidden">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fs-6 fw-bold text-dark text-uppercase">
                    <i class="fa-solid fa-cloud-arrow-down me-2 text-primary"></i>
                    Пошук фільму в глобальній базі
                </h5>
            </div>

            <div class="card-body p-4 p-lg-5">
                <div class="row g-3 align-items-end justify-content-center">
                    <div class="col-12 col-lg-7">
                        <label class="form-label small fw-bold text-muted text-uppercase" for="q">Назва фільму</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-2 border-end-0 br-left-8 text-muted">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input id="q" class="form-control border-2 border-start-0 br-right-8 shadow-none" 
                                   placeholder="Напр. Interstellar або Початок..." />
                        </div>
                    </div>

                    <div class="col-12 col-lg-2">
                        <button id="btnSearch" class="btn btn-dark w-100 fw-bold br-8 py-2" type="button">
                            ПОШУК
                        </button>
                    </div>
                </div>

                <div class="mt-5" id="results">
                    <div class="text-center py-5 text-muted opacity-50">
                        <i class="fa-solid fa-film fa-3x mb-3"></i>
                        <p>Введіть назву фільму для пошуку</p>
                    </div>
                </div>
            </div>
        </div>

        <form id="af" method="post">
            @Html.AntiForgeryToken()
        </form>

    </div>
</section>

@section Scripts {
    <script>
        const btn = document.getElementById("btnSearch");
        const q = document.getElementById("q");
        const results = document.getElementById("results");

        const SEARCH_URL = "/admin/movies/tmdb/search";
        const IMPORT_URL = "/admin/movies/tmdb/import";

        btn.addEventListener("click", runSearch);
        q.addEventListener("keydown", (e) => {
            if (e.key === "Enter") { e.preventDefault(); runSearch(); }
        });

        async function runSearch() {
            const query = (q.value || "").trim();
            if (!query) return;

            results.innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="mt-2 text-muted">Шукаємо у всесвіті TMDB...</div>
                </div>`;

            try {
                const r = await fetch(`${SEARCH_URL}?query=${encodeURIComponent(query)}`);
                if (!r.ok) throw new Error();

                const items = await r.json();
                if (!items.length) {
                    results.innerHTML = `
                        <div class="alert alert-light border text-center py-4 br-8">
                            <i class="fa-solid fa-face-frown mb-2 d-block fa-2x"></i>
                            Нічого не знайдено за запитом "<strong>${escapeHtml(query)}</strong>"
                        </div>`;
                    return;
                }

                results.innerHTML = `
                    <div class="table-responsive br-8 border overflow-hidden shadow-sm">
                        <table class="table tmdb-table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width:100px">Постер</th>
                                    <th>Назва фільму</th>
                                    <th style="width:180px">Дата виходу</th>
                                    <th class="text-end" style="width:140px">Дія</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white">
                                ${items.map(x => `
                                    <tr>
                                        <td class="ps-3">
                                            ${x.posterPath
                                                ? `<img class="poster-preview" src="https://image.tmdb.org/t/p/w92${x.posterPath}" alt="Poster" />`
                                                : `<div class="poster-preview bg-light d-flex align-items-center justify-content-center text-muted small">N/A</div>`
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">${escapeHtml(x.title ?? "")}</div>
                                        </td>
                                        <td class="text-muted small">${escapeHtml(x.releaseDate ?? "—")}</td>
                                        <td class="text-end pe-3">
                                            <form method="post" action="${IMPORT_URL}">
                                                <input name="tmdbId" type="hidden" value="${x.tmdbId}" />
                                                <input name="__RequestVerificationToken" type="hidden" value="${getAntiforgeryToken()}" />
                                                <button class="btn btn-sm btn-primary-modern px-3" type="submit">
                                                    <i class="fa-solid fa-download me-1"></i> Імпорт
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                `).join("")}
                            </tbody>
                        </table>
                    </div>
                `;
            } catch (e) {
                results.innerHTML = `<div class="alert alert-danger br-8">Помилка під час пошуку. Спробуйте пізніше.</div>`;
            }
        }

        function getAntiforgeryToken() {
            return document.querySelector('#af input[name="__RequestVerificationToken"]')?.value ?? "";
        }
        function escapeHtml(s) {
            return String(s).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;");
        }
    </script>
}