@using Web.Helpers
@model Web.ViewModels.Admin.MovieDetailsVm

@{
    ViewData["Title"] = "Деталі фільму";

    var genres = Model.Movie.MovieGenres?
        .Select(mg => mg.Genre?.Name)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .ToList() ?? new();

    var countries = Model.Movie.MovieCountries?
        .Select(x => x.Country?.Name ?? x.CountryCode)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList() ?? new();

    var actors = Model.Movie.MovieActors?
        .OrderBy(x => x.CustOrder)
        .Select(x => x.Actor?.FullName ?? x.ActorId.ToString())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList() ?? new();

    var directors = Model.Movie.MovieDirectors?
        .OrderBy(x => x.BillingOrder)
        .Select(x => x.Director?.FullName ?? x.DirectorId.ToString())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList() ?? new();

    var posterUrl = TmdbImage.Build(Model.Movie.PosterPath, "w342");
    var backdropUrl = TmdbImage.Build(Model.Movie.BackdropPath, "w1280");
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">Деталі фільму</h1>

        <div class="card shadow-sm col-lg-10 col-xl-9 mx-auto overflow-hidden">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Інформація про фільм
                </h5>
            </div>

            @if (!string.IsNullOrWhiteSpace(backdropUrl))
            {
                <img src="@backdropUrl"
                     alt="Backdrop"
                     class="w-100"
                     style="max-height:320px;object-fit:cover" />
            }

            <div class="card-body p-4">

                <div class="row g-4 align-items-start">
                    <div class="col-12 col-md-4 col-lg-3">
                        @if (!string.IsNullOrWhiteSpace(posterUrl))
                        {
                            <img src="@posterUrl" alt="Poster" class="img-fluid rounded shadow-sm" />
                        }
                        else
                        {
                            <div class="bg-light border rounded d-flex align-items-center justify-content-center"
                                 style="height:420px">
                                <span class="text-muted">Немає постера</span>
                            </div>
                        }
                    </div>

                    <div class="col-12 col-md-8 col-lg-9">

                        <div class="mb-3">
                            <label class="form-label text-muted">
                                <i class="fa-solid fa-clapperboard me-1"></i>
                                Назва
                            </label>
                            <div class="fw-semibold fs-4">@Model.Movie.Title</div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted">
                                    <i class="fa-solid fa-calendar-days me-1"></i>
                                    Дата виходу
                                </label>
                                <div class="fw-semibold">
                                    @(Model.Movie.ReleaseDate?.ToString("dd.MM.yyyy") ?? "-")
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted">
                                    <i class="fa-solid fa-clock me-1"></i>
                                    Тривалість
                                </label>
                                <div class="fw-semibold">
                                    @(Model.Movie.Duration.HasValue ? $"{Model.Movie.Duration} хв" : "-")
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label text-muted">
                                <i class="fa-solid fa-star me-1"></i>
                                Рейтинги
                            </label>
                            <div class="fw-semibold">
                                IMDb @Model.ImdbRating | Rotten Tomatoes @Model.RottenTomatoes | Metacritic @Model.Metacritic
                            </div>
                            <div class="text-muted" style="font-size:0.9rem;">
                                IMDb — оцінка глядачів · Rotten Tomatoes — критики · Metacritic — експерти
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-3">
                            <label class="form-label text-muted">
                                <i class="fa-solid fa-video me-1"></i>
                                Режисери
                            </label>
                            <div class="fw-semibold">
                                @(directors.Count == 0 ? "-" : string.Join(", ", directors))
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted">
                                <i class="fa-solid fa-tags me-1"></i>
                                Жанри
                            </label>
                            <div class="fw-semibold">
                                @if (genres.Count == 0)
                                {
                                    <span class="text-muted">-</span>
                                }
                                else
                                {
                                    foreach (var g in genres)
                                    {
                                        <span class="badge bg-info text-dark me-1 mb-1">@g</span>
                                    }
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted">
                                <i class="fa-solid fa-globe me-1"></i>
                                Країни
                            </label>
                            <div class="fw-semibold">
                                @(countries.Count == 0 ? "-" : string.Join(", ", countries))
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted">
                                <i class="fa-solid fa-user-group me-1"></i>
                                Актори
                            </label>
                            <div class="fw-semibold">
                                @(actors.Count == 0 ? "-" : string.Join(", ", actors))
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted">
                                <i class="fa-solid fa-ticket me-1"></i>
                                Сеанси
                            </label>
                            <div class="fw-semibold">
                                @(Model.Movie.Sessions?.Count ?? 0)
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted">
                                <i class="fa-solid fa-pen-nib me-1"></i>
                                Оригінальна назва
                            </label>
                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.Movie.OriginalName) ? "-" : Model.Movie.OriginalName)
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted">
                                    <i class="fa-solid fa-language me-1"></i>
                                    Мова
                                </label>
                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.Movie.Language) ? "-" : Model.Movie.Language)
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted">
                                    <i class="fa-solid fa-link me-1"></i>
                                    Трейлер
                                </label>
                                <div class="fw-semibold">
                                    @if (string.IsNullOrWhiteSpace(Model.Movie.TrailerUrl))
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else
                                    {
                                        <a href="@Model.Movie.TrailerUrl" target="_blank" rel="noopener">
                                            Відкрити трейлер
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mt-0">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted">
                                    <i class="fa-solid fa-image me-1"></i>
                                    PosterPath
                                </label>
                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.Movie.PosterPath) ? "-" : Model.Movie.PosterPath)
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted">
                                    <i class="fa-solid fa-panorama me-1"></i>
                                    BackdropPath
                                </label>
                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.Movie.BackdropPath) ? "-" : Model.Movie.BackdropPath)
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label text-muted">
                                <i class="fa-solid fa-align-left me-1"></i>
                                Опис
                            </label>
                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.Movie.Description) ? "-" : Model.Movie.Description)
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fa-solid fa-arrow-left me-1"></i>
                                Назад
                            </a>

                            <a asp-action="Edit" asp-route-id="@Model.Movie.Id" class="btn btn-maroon">
                                <i class="fa-solid fa-pen-to-square me-1"></i>
                                Редагувати
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</section>
