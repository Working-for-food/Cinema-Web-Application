@model Infrastructure.Entities.Movie

@{
    ViewData["Title"] = "Деталі фільму";

    var genres = Model.MovieGenres?
        .Select(mg => mg.Genre?.Name)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .ToList() ?? new();

    var countries = Model.MovieCountries?
        .Select(x => x.Country?.Name ?? x.CountryCode)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList() ?? new();

    var actors = Model.MovieActors?
        .OrderBy(x => x.CustOrder)
        .Select(x => x.Actor?.FullName ?? x.ActorId.ToString())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList() ?? new();

    var directors = Model.MovieDirectors?
        .OrderBy(x => x.BillingOrder)
        .Select(x => x.Director?.FullName ?? x.DirectorId.ToString())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList() ?? new();
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">ДЕТАЛІ ФІЛЬМУ</h1>

        <div class="card shadow-sm col-lg-8 mx-auto">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Інформація про фільм
                </h5>
            </div>

            <div class="card-body p-4">
                <div class="mb-4">

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-clapperboard me-1"></i>
                            Назва
                        </label>
                        <div class="fw-semibold fs-5">@Model.Title</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-calendar-days me-1"></i>
                            Дата виходу
                        </label>
                        <div class="fw-semibold fs-5">
                            @(Model.ReleaseDate?.ToString("dd.MM.yyyy") ?? "-")
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-clock me-1"></i>
                            Тривалість
                        </label>
                        <div class="fw-semibold fs-5">
                            @(Model.Duration.HasValue ? $"{Model.Duration} хв" : "-")
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-video me-1"></i>
                            Режисери
                        </label>
                        <div class="fw-semibold">
                            @(directors.Count == 0 ? "-" : string.Join(", ", directors))
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-tags me-1"></i>
                            Жанри
                        </label>
                        <div class="fw-semibold">
                            @if (genres.Count == 0)
                            {
                                <span class="text-muted">-</span>
                            }
                            else
                            {
                                foreach (var g in genres)
                                {
                                    <span class="badge bg-info text-dark me-1 mb-1">@g</span>
                                }
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-globe me-1"></i>
                            Країни
                        </label>
                        <div class="fw-semibold">
                            @(countries.Count == 0 ? "-" : string.Join(", ", countries))
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-user-group me-1"></i>
                            Актори
                        </label>
                        <div class="fw-semibold">
                            @(actors.Count == 0 ? "-" : string.Join(", ", actors))
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-ticket me-1"></i>
                            Сеанси
                        </label>
                        <div class="fw-semibold fs-5">
                            @(Model.Sessions?.Count ?? 0)
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-pen-nib me-1"></i>
                            Оригінальна назва
                        </label>
                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.OriginalName) ? "-" : Model.OriginalName)
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-language me-1"></i>
                            Мова
                        </label>
                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.Language) ? "-" : Model.Language)
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-link me-1"></i>
                            Трейлер
                        </label>
                        <div class="fw-semibold">
                            @if (string.IsNullOrWhiteSpace(Model.TrailerUrl))
                            {
                                <span class="text-muted">-</span>
                            }
                            else
                            {
                                <a href="@Model.TrailerUrl" target="_blank" rel="noopener">
                                    Відкрити трейлер
                                </a>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-image me-1"></i>
                            Шлях до постера
                        </label>
                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.PosterPath) ? "-" : Model.PosterPath)
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-panorama me-1"></i>
                            Шлях до фону
                        </label>
                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.BackdropPath) ? "-" : Model.BackdropPath)
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label text-muted">
                            <i class="fa-solid fa-align-left me-1"></i>
                            Опис
                        </label>
                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Назад
                    </a>

                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-maroon">
                        <i class="fa-solid fa-pen-to-square me-1"></i>
                        Редагувати
                    </a>
                </div>

            </div>
        </div>

    </div>
</section>

