@using Web.Helpers
@model Infrastructure.Entities.Movie

@{
    ViewData["Title"] = "Деталі фільму";

    var genres = Model.MovieGenres?.Select(mg => mg.Genre?.Name).Where(n => !string.IsNullOrWhiteSpace(n)).ToList() ?? new();
    var countries = Model.MovieCountries?.Select(x => x.Country?.Name ?? x.CountryCode).Where(x => !string.IsNullOrWhiteSpace(x)).ToList() ?? new();
    var actors = Model.MovieActors?.OrderBy(x => x.CustOrder).Select(x => x.Actor?.FullName ?? x.ActorId.ToString()).Where(x => !string.IsNullOrWhiteSpace(x)).ToList() ?? new();
    var directors = Model.MovieDirectors?.OrderBy(x => x.BillingOrder).Select(x => x.Director?.FullName ?? x.DirectorId.ToString()).Where(x => !string.IsNullOrWhiteSpace(x)).ToList() ?? new();

    var posterUrl = TmdbImage.Build(Model.PosterPath, "w342");
    var backdropUrl = TmdbImage.Build(Model.BackdropPath, "w1280");
}

<section class="py-5 gray-bg">
    <div class="container">
        <div class="card shadow-sm border-0 mx-auto overflow-hidden br-16" style="max-width: 1100px;">
            
            <div class="position-relative">
                @if (!string.IsNullOrWhiteSpace(backdropUrl))
                {
                    <div class="backdrop-container">
                        <img src="@backdropUrl" alt="Backdrop" class="w-100 backdrop-img" />
                        <div class="backdrop-overlay"></div>
                    </div>
                }
                else
                {
                    <div class="bg-dark" style="height: 200px;"></div>
                }
                
                <div class="position-absolute bottom-0 start-0 p-4 p-md-5 w-100">
                    <div class="d-flex align-items-end gap-4 flex-wrap flex-md-nowrap">
                        <div class="detail-poster shadow-lg d-none d-md-block">
                            @if (!string.IsNullOrWhiteSpace(posterUrl))
                            {
                                <img src="@posterUrl" alt="Poster" class="img-fluid rounded" />
                            }
                            else
                            {
                                <div class="no-poster-placeholder">Немає постера</div>
                            }
                        </div>
                        
                        <div class="text-white pb-2">
                            <h1 class="display-5 fw-bold mb-1">@Model.Title</h1>
                            <p class="opacity-75 fs-5 mb-0">@Model.OriginalName</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="row g-5">
                    <div class="col-lg-4 order-2 order-lg-1">
                        <div class="info-group mb-4">
                            <label class="info-label">ЖАНРИ</label>
                            <div class="mt-2">
                                @foreach (var g in genres)
                                {
                                    <span class="badge-modern">@g</span>
                                }
                            </div>
                        </div>

                        <div class="info-list mt-4">
                            <div class="info-item">
                                <span class="info-item-label"><i class="fa-solid fa-calendar me-2"></i>Реліз:</span>
                                <span class="info-item-value">@(Model.ReleaseDate?.ToString("dd MMMM yyyy") ?? "-")</span>
                            </div>
                            <div class="info-item">
                                <span class="info-item-label"><i class="fa-solid fa-clock me-2"></i>Тривалість:</span>
                                <span class="info-item-value">@(Model.Duration.HasValue ? $"{Model.Duration} хв" : "-")</span>
                            </div>
                            <div class="info-item">
                                <span class="info-item-label"><i class="fa-solid fa-globe me-2"></i>Країна:</span>
                                <span class="info-item-value">@(string.Join(", ", countries))</span>
                            </div>
                            <div class="info-item">
                                <span class="info-item-label"><i class="fa-solid fa-ticket me-2"></i>Сеанси:</span>
                                <span class="info-item-value">@(Model.Sessions?.Count ?? 0)</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.TrailerUrl))
                        {
                            <a href="@Model.TrailerUrl" target="_blank" class="btn btn-outline-dark w-100 mt-4 br-8">
                                <i class="fa-brands fa-youtube me-2"></i>ДИВИТИСЬ ТРЕЙЛЕР
                            </a>
                        }
                    </div>

                    <div class="col-lg-8 order-1 order-lg-2">
                        <div class="mb-5">
                            <h4 class="fw-bold mb-3">Сюжет</h4>
                            <p class="text-secondary lh-lg fs-5">
                                @(string.IsNullOrWhiteSpace(Model.Description) ? "Опис відсутній." : Model.Description)
                            </p>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <h6 class="fw-bold text-muted small text-uppercase mb-3">Режисери</h6>
                                <p class="fw-semibold">@(directors.Count == 0 ? "-" : string.Join(", ", directors))</p>
                            </div>
                            <div class="col-12">
                                <h6 class="fw-bold text-muted small text-uppercase mb-3">У головних ролях</h6>
                                <p class="fw-semibold lh-base">@(actors.Count == 0 ? "-" : string.Join(", ", actors))</p>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-secondary px-4 br-8">
                                <i class="fa-solid fa-arrow-left me-2"></i>Назад
                            </a>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-maroon px-4 br-8">
                                <i class="fa-solid fa-pen-to-square me-2"></i>Редагувати
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>