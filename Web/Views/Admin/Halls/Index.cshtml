@model Web.ViewModels.Admin.Halls.HallsIndexVm

@{
    ViewData["Title"] = "Зали";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
            <h1 class="section-title mb-0">ЗАЛИ</h1>
            <div class="d-flex gap-2">
                <a asp-controller="Cinemas" asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>НАЗАД
                </a>
                <a asp-action="Create" asp-route-cinemaId="@Model.CinemaId" class="btn btn-maroon">
                    <i class="fas fa-plus me-1"></i>СТВОРИТИ ЗАЛ
                </a>
            </div>
        </div>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 br-12">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-12">@err</div>
        }

        <div class="card shadow-sm border-0 col-12 mb-4 br-12">
            <div class="card-body p-4">
                <form method="get" asp-action="Index" class="row g-3 align-items-end">
                    <div class="col-12 col-md-6 col-lg-4">
                        <label asp-for="CinemaId" class="form-label small fw-bold text-muted text-uppercase">Кінотеатр</label>
                        <select asp-for="CinemaId" asp-items="Model.Cinemas" class="form-select shadow-none" onchange="this.form.submit()">
                            <option value="">Усі кінотеатри</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-lg-8 text-md-end text-muted small opacity-75">
                        <i class="fa-solid fa-circle-info me-1"></i> Оберіть кінотеатр для швидкої фільтрації
                    </div>
                </form>
            </div>
        </div>

        @if (Model.Halls == null || !Model.Halls.Any())
        {
            <div class="empty-state mx-auto" style="max-width: 600px;">
                <div class="empty-icon">
                    <i class="fa-solid fa-chair"></i>
                </div>
                <h5 class="empty-title">Залів не знайдено</h5>
                <p class="empty-sub">Спробуйте обрати інший кінотеатр або додайте новий зал.</p>
            </div>
        }
        else
        {
            <div class="admin-table-card col-12 overflow-hidden">
                <div class="table-responsive">
                    <table class="table admin-table mb-0 align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">Кінотеатр</th>
                                <th>Назва залу</th>
                                <th style="width:220px;">Кількість місць</th>
                                <th class="text-end pe-4" style="width:240px;">Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.Halls)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark text-uppercase small">@h.CinemaName</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold fs-5">@h.HallName</div>
                                    </td>
                                    <td>
                                        <span class="pill pill-genre">
                                            <i class="fa-solid fa-users-viewfinder me-1"></i> @h.SeatsCount
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            <a asp-action="Seats" asp-route-id="@h.HallId" 
                                               class="btn btn-sm btn-light border text-primary" title="Конфігурація місць">
                                                <i class="fas fa-chair me-1"></i> МІСЦЯ
                                            </a>

                                            <a asp-action="Edit" asp-route-id="@h.HallId" 
                                               class="btn btn-sm btn-light border" title="Редагувати">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>

                                            <form method="post" asp-action="Delete" asp-route-id="@h.HallId" 
                                                  asp-route-cinemaId="@Model.CinemaId" class="d-inline"
                                                  onsubmit="return confirm('Видалити цей зал?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-light border text-danger" title="Видалити">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>