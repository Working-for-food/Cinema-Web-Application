@model Web.ViewModels.Admin.Halls.HallsIndexVm

@{
    ViewData["Title"] = "Зали";
}

<section class="sessions-section py-4 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">Зали</h1>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success mb-3">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger mb-3">@err</div>
        }

        <div class="row align-items-end mb-4">
            <div class="col-12 col-md-6">
                <form method="get" asp-action="Index" class="filter-group">
                    <label asp-for="CinemaId" class="form-label">Кінотеатр</label>
                    <select asp-for="CinemaId"
                            asp-items="Model.Cinemas"
                            class="form-select"
                            onchange="this.form.submit()">
                        <option value="">Усі</option>
                    </select>

                    <noscript>
                        <button type="submit" class="btn btn-secondary mt-2">
                            Фільтрувати
                        </button>
                    </noscript>
                </form>
            </div>

            <div class="col-12 col-md-6 text-md-end mt-3 mt-md-0">
                <a asp-action="Create"
                   asp-route-cinemaId="@Model.CinemaId"
                   class="btn btn-maroon">
                    <i class="fas fa-plus me-1"></i>Створити зал
                </a>

                <a asp-controller="Cinemas"
                   asp-action="Index"
                   class="btn btn-secondary ms-2">
                    <i class="fas fa-arrow-left me-2"></i>Назад
                </a>
            </div>
        </div>

        @if (Model.Halls == null || !Model.Halls.Any())
        {
            <div class="card shadow-sm col-lg-8 mx-auto">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-circle-info me-2"></i>
                        Немає результатів
                    </h5>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="mb-0">Залів не знайдено.</p>
                </div>
            </div>
        }
        else
        {
            <!-- Table (універсальний стиль як Movies/Users) -->
            <div class="card shadow-sm mb-3 admin-table-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table admin-table mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Кінотеатр</th>
                                    <th>Зал</th>
                                    <th style="width:190px;">Кількість місць</th>
                                    <th class="text-end" style="width:220px;">Дії</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var h in Model.Halls)
                                {
                                    <tr>
                                        <td class="fw-semibold">@h.CinemaName</td>
                                        <td>@h.HallName</td>
                                        <td>@h.SeatsCount</td>

                                        <!-- КНОПКИ ЯК У MOVIES: маленькі, іконки -->
                                        <td class="text-end">
                                            <a asp-action="Edit"
                                               asp-route-id="@h.HallId"
                                               class="btn btn-sm btn-secondary me-1"
                                               title="Редагувати">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>

                                            <a asp-action="Seats"
                                               asp-route-id="@h.HallId"
                                               class="btn btn-sm btn-admin-seats me-1"
                                               title="Місця">
                                                <i class="fas fa-chair"></i>
                                            </a>


                                            <form method="post"
                                                  asp-action="Delete"
                                                  asp-route-id="@h.HallId"
                                                  asp-route-cinemaId="@Model.CinemaId"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Видалити цей зал?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        title="Видалити">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                </div>
            </div>
        }

    </div>
</section>
