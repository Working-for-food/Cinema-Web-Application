@using Application.DTOs
@using Infrastructure.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@model GenerateSeatsDto

@{
    ViewData["Title"] = $"Місця: {Model.HallName}";

    var error = ViewBag.SeatsError as string;

    string CatLabel(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "Звичайні",
        SeatCategory.Vip => "VIP",
        SeatCategory.Accessible => "Доступні",
        _ => c.ToString()
    };

    string BadgeClass(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "badge text-bg-light border",
        SeatCategory.Vip => "badge text-bg-warning",
        SeatCategory.Accessible => "badge text-bg-info",
        _ => "badge text-bg-secondary"
    };

    Func<SeatCategory, IEnumerable<SelectListItem>> categoryItemsFor = selected =>
    Enum.GetValues<SeatCategory>()
        .Select(c => new SelectListItem(
            text: CatLabel(c),
            value: ((int)c).ToString(),
            selected: c == selected))
        .ToList();

    var grouped = (Model.Seats ?? new List<SeatDto>())
        .GroupBy(s => s.RowNumber)
        .OrderBy(g => g.Key)
        .ToList();

    var maxSeats = grouped.Count == 0 ? 0 : grouped.Max(g => g.Count());

    var canEditCategories = string.IsNullOrWhiteSpace(Model.LockReason);

    var rowsForCategoryEdit = grouped
        .Select(g => new
        {
            RowNumber = g.Key,
            Category = g.First().Category,
            IsMixed = g.Select(x => x.Category).Distinct().Count() > 1
        })
        .ToList();
}

<section class="seats-page py-4 py-lg-5">
    <div class="container">

        <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">
            <div>
                <div class="text-muted small mb-1">Зал</div>
                <h1 class="page-title mb-0">
                    Місця: <span class="text-maroon">@Model.HallName</span>
                </h1>
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                <a asp-area="Admin" asp-controller="Halls" asp-action="Index" class="btn btn-soft">
                    <i class="fas fa-arrow-left me-2"></i>Назад до залів
                </a>

                @if (!string.IsNullOrWhiteSpace(Model.LockReason))
                {
                    <span class="pill pill-warning">
                        <i class="fas fa-lock me-2"></i>Редагування вимкнено
                    </span>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger d-flex align-items-start gap-2 mb-3" role="alert">
                <i class="fas fa-exclamation-triangle mt-1"></i>
                <div>@error</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.LockReason))
        {
            <div class="alert alert-warning d-flex align-items-start gap-2 mb-3" role="alert">
                <i class="fas fa-info-circle mt-1"></i>
                <div>
                    <div class="fw-semibold">Заблоковано</div>
                    <div class="small opacity-75">@Model.LockReason</div>
                </div>
            </div>
        }

        <div class="card card-modern shadow-sm">
            <div class="card-header card-header-modern">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-badge">
                        <i class="fas fa-chair"></i>
                    </div>
                    <div>
                        <div class="header-title">Керування місцями</div>
                        <div class="header-subtitle">Налаштування рядів, генерація, схема та категорії</div>
                    </div>
                </div>
            </div>

            <div class="card-body p-3 p-lg-4">

                @if (!Model.AlreadyGenerated)
                {
                    <div class="panel mb-4">
                        <div class="panel-head">
                            <div>
                                <div class="panel-title">
                                    <i class="fas fa-table me-2"></i>1) Налаштування рядів
                                </div>
                                <div class="panel-hint">Задай базову структуру, щоб швидко створити конфіг</div>
                            </div>
                        </div>

                        <form method="post" asp-area="Admin" asp-controller="Halls" asp-action="ConfigureSeats" class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="hallId" value="@Model.HallId" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Кількість рядів</label>
                                    <div class="input-group input-group-modern">
                                        <span class="input-group-text"><i class="fas fa-layer-group"></i></span>
                                        <input type="number" name="rows" min="1" value="@Model.Rows"
                                               class="form-control"
                                               @(Model.CanEditSeats ? "" : "disabled") />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Місць у ряду за замовчуванням</label>
                                    <div class="input-group input-group-modern">
                                        <span class="input-group-text"><i class="fas fa-grip-horizontal"></i></span>
                                        <input type="number" name="seatsPerRow" min="1" value="@Model.SeatsPerRow"
                                               class="form-control"
                                               @(Model.CanEditSeats ? "" : "disabled") />
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <button type="submit" class="btn btn-maroon btn-modern"
                                        @(Model.CanEditSeats ? "" : "disabled")>
                                    <i class="fas fa-cogs me-2"></i>Побудувати таблицю
                                </button>
                            </div>

                            @if (!Model.CanEditSeats)
                            {
                                <div class="alert alert-secondary mt-3 mb-0">
                                    Редагування місць вимкнено.
                                </div>
                            }
                        </form>
                    </div>

                    <div class="panel">
                        <div class="panel-head">
                            <div>
                                <div class="panel-title">
                                    <i class="fas fa-pen me-2"></i>2) Редагування місць у кожному ряду
                                </div>
                                <div class="panel-hint">Можеш змінити кількість місць і категорію в кожному ряді</div>
                            </div>
                        </div>

                        @if (!Model.CanEditSeats)
                        {
                            <div class="alert alert-secondary mt-3 mb-0">
                                Редагування місць вимкнено.
                            </div>
                        }
                        else
                        {
                            <form method="post" asp-area="Admin" asp-controller="Halls" asp-action="GenerateSeats" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="hallId" value="@Model.HallId" />

                                <div class="table-responsive">
                                    <table class="table table-modern align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th class="col-row">Ряд</th>
                                                <th class="col-seats">Кількість місць</th>
                                                <th style="min-width: 260px;">Категорія ряду</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.RowConfigs.Count; i++)
                                            {
                                                <tr>
                                                    <td class="fw-semibold">
                                                        #@Model.RowConfigs[i].RowNumber
                                                        <input type="hidden" name="rowConfigs[@i].RowNumber" value="@Model.RowConfigs[i].RowNumber" />
                                                    </td>
                                                    <td>
                                                        <input type="number"
                                                               name="rowConfigs[@i].SeatsCount"
                                                               min="1"
                                                               value="@Model.RowConfigs[i].SeatsCount"
                                                               class="form-control form-control-sm" />
                                                    </td>
                                                    <td>
                                                        <select class="form-select form-select-sm"
                                                                name="rowConfigs[@i].Category"
                                                                asp-items="categoryItemsFor(Model.RowConfigs[i].Category)">
                                                        </select>
                                                        <div class="form-text">
                                                            Впливає лише на категорію місць у залі.
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-end mt-3">
                                    <button type="submit" class="btn btn-maroon btn-modern">
                                        <i class="fas fa-check me-2"></i>Згенерувати місця
                                    </button>
                                </div>
                            </form>
                        }
                    </div>
                }
                else
                {
                    <div class="panel mb-4">
                        <div class="panel-head">
                            <div>
                                <div class="panel-title">
                                    <i class="fas fa-check-circle me-2"></i>Місця вже згенеровані
                                </div>
                                <div class="panel-hint">За потреби можна створити заново (видалить поточні місця)</div>
                            </div>
                        </div>

                        <form method="post"
                              asp-area="Admin" asp-controller="Halls" asp-action="GenerateSeats"
                              class="mt-3"
                              onsubmit="return confirmRegenerate();">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="hallId" value="@Model.HallId" />

                            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="allowRegenerate"
                                           name="allowRegenerate"
                                           value="true"
                                           @(string.IsNullOrWhiteSpace(Model.LockReason) ? "" : "disabled") />
                                    <label class="form-check-label" for="allowRegenerate">
                                        Створити місця заново (видалить поточні записи місць)
                                    </label>
                                </div>

                                <button type="submit" class="btn btn-danger btn-modern"
                                        @(string.IsNullOrWhiteSpace(Model.LockReason) ? "" : "disabled")>
                                    <i class="fas fa-trash-alt me-2"></i>Створити заново
                                </button>
                            </div>
                        </form>
                    </div>

                    @if (grouped.Count == 0)
                    {
                        <div class="empty-state">
                            <div class="empty-icon"><i class="fas fa-chair"></i></div>
                            <div class="empty-title">Місця відсутні</div>
                            <div class="empty-sub">Спробуй створити місця заново або перевір конфіг рядів.</div>
                        </div>
                    }
                    else
                    {
                        @if (canEditCategories)
                        {
                            <div class="panel mb-4">
                                <div class="panel-head">
                                    <div>
                                        <div class="panel-title">
                                            <i class="fas fa-tags me-2"></i>Категорії по рядах
                                        </div>
                                        <div class="panel-hint">
                                            Спочатку вистав категорії по рядах, а потім нижче можна змінювати окремі місця
                                        </div>
                                    </div>
                                </div>

                                <form method="post" asp-area="Admin" asp-controller="Halls" asp-action="UpdateRowCategories" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="hallId" value="@Model.HallId" />

                                    <div class="table-responsive">
                                        <table class="table table-modern align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th class="col-row">Ряд</th>
                                                    <th style="min-width: 320px;">Категорія</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < rowsForCategoryEdit.Count; i++)
                                                {
                                                    <tr>
                                                        <td class="fw-semibold">
                                                            #@rowsForCategoryEdit[i].RowNumber
                                                            <input type="hidden" name="rows[@i].RowNumber" value="@rowsForCategoryEdit[i].RowNumber" />
                                                        </td>
                                                        <td>
                                                            <select class="form-select form-select-sm"
                                                                    name="rows[@i].Category"
                                                                    asp-items="categoryItemsFor(rowsForCategoryEdit[i].Category)">
                                                            </select>
                                                        </td>
                                                        <td class="text-end">
                                                            @if (rowsForCategoryEdit[i].IsMixed)
                                                            {
                                                                <span class="text-warning small">
                                                                    <i class="fas fa-exclamation-triangle me-1"></i>Змішано
                                                                </span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="d-flex justify-content-end mt-3">
                                        <button type="submit" class="btn btn-maroon btn-modern">
                                            <i class="fas fa-save me-2"></i>Зберегти категорії рядів
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }

                        <div class="panel">
                            <div class="panel-head">
                                <div>
                                    <div class="panel-title">
                                        <i class="fas fa-th me-2"></i>Схема залу
                                    </div>
                                    <div class="panel-hint">Категорії місць + (якщо можна) редагування кліком</div>
                                </div>
                            </div>

                            <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
                                <span class="@BadgeClass(SeatCategory.Standard)">S</span>
                                <small class="text-muted me-3">@CatLabel(SeatCategory.Standard)</small>

                                <span class="@BadgeClass(SeatCategory.Vip)">VIP</span>
                                <small class="text-muted me-3">@CatLabel(SeatCategory.Vip)</small>

                                <span class="@BadgeClass(SeatCategory.Accessible)">♿</span>
                                <small class="text-muted">@CatLabel(SeatCategory.Accessible)</small>
                            </div>

                            @if (canEditCategories)
                            {
                                <div class="alert alert-info py-2 mt-3">
                                    Можеш клацати по місцях у сітці — категорія буде змінюватися циклічно.
                                    Потім натисни <strong>Зберегти зміни</strong>.
                                </div>
                            }

                            <div class="screen mt-3">
                                <div class="screen-label">ЕКРАН</div>
                            </div>

                            <form method="post"
                                  asp-area="Admin" asp-controller="Halls" asp-action="UpdateSeatCategories"
                                  class="mt-3"
                                  onsubmit="return buildSeatCategoryChanges();">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="hallId" value="@Model.HallId" />
                                <div id="seatChanges"></div>

                                <div class="table-responsive">
                                    <table class="table table-modern table-seats align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th class="col-row">Ряд</th>
                                                @for (int i = 1; i <= maxSeats; i++)
                                                {
                                                    <th class="text-center seat-col">@i</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in grouped)
                                            {
                                                var seatsInRow = row.OrderBy(x => x.SeatNumber).ToList();

                                                <tr>
                                                    <td class="fw-semibold">#@row.Key</td>

                                                    @for (int s = 1; s <= maxSeats; s++)
                                                    {
                                                        var seat = seatsInRow.FirstOrDefault(x => x.SeatNumber == s);

                                                        <td class="text-center">
                                                            @if (seat != null)
                                                            {
                                                                @if (canEditCategories)
                                                                {
                                                                    <button type="button"
                                                                            class="@BadgeClass(seat.Category) seat-toggle seat-badge"
                                                                            data-seat-id="@seat.Id"
                                                                            data-orig-cat="@((int)seat.Category)"
                                                                            data-cat="@((int)seat.Category)"
                                                                            title="@CatLabel(seat.Category)">
                                                                        @s
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <span class="@BadgeClass(seat.Category) seat-badge" title="@CatLabel(seat.Category)">@s</span>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="seat-empty">–</span>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                @if (canEditCategories)
                                {
                                    <div class="d-flex justify-content-end mt-3">
                                        <button type="submit" class="btn btn-maroon btn-modern">
                                            <i class="fas fa-save me-2"></i>Зберегти зміни
                                        </button>
                                    </div>
                                }
                            </form>
                        </div>
                    }
                }

            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script>
        function confirmRegenerate() {
            const allow = document.querySelector('#allowRegenerate');
            if (allow && allow.checked) {
                return confirm("Створення заново видалить існуючі місця. Продовжити?");
            }
            alert("Щоб створити місця заново, спочатку поставте галочку.");
            return false;
        }

        (function initSeatCategoryToggles() {
            const buttons = document.querySelectorAll('.seat-toggle');
            if (!buttons || buttons.length === 0) return;

            const cycle = [0, 1, 2];

            function nextCat(v) {
                const idx = cycle.indexOf(parseInt(v, 10));
                return cycle[(idx + 1) % cycle.length];
            }

            function applyVisual(btn, cat) {
                btn.classList.remove('text-bg-light', 'border', 'text-bg-warning', 'text-bg-info', 'text-bg-secondary');

                if (cat === 0) {
                    btn.classList.add('text-bg-light', 'border');
                    btn.title = 'Звичайні';
                } else if (cat === 1) {
                    btn.classList.add('text-bg-warning');
                    btn.title = 'VIP';
                } else if (cat === 2) {
                    btn.classList.add('text-bg-info');
                    btn.title = 'Доступні';
                } else {
                    btn.classList.add('text-bg-secondary');
                    btn.title = 'Невідомо';
                }

                btn.dataset.cat = cat.toString();
            }

            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const next = nextCat(btn.dataset.cat);
                    applyVisual(btn, next);
                });
            });
        })();

        function buildSeatCategoryChanges() {
            const container = document.getElementById('seatChanges');
            if (!container) return true;
            container.innerHTML = '';

            const changed = Array.from(document.querySelectorAll('.seat-toggle'))
                .filter(b => b.dataset.cat !== b.dataset.origCat)
                .map(b => ({ id: b.dataset.seatId, cat: b.dataset.cat }));

            if (changed.length === 0) {
                alert('Змін не знайдено. Спочатку змініть категорію хоча б одного місця.');
                return false;
            }

            for (let i = 0; i < changed.length; i++) {
                const seatId = changed[i].id;
                const cat = changed[i].cat;

                const inp1 = document.createElement('input');
                inp1.type = 'hidden';
                inp1.name = `changes[${i}].SeatId`;
                inp1.value = seatId;
                container.appendChild(inp1);

                const inp2 = document.createElement('input');
                inp2.type = 'hidden';
                inp2.name = `changes[${i}].Category`;
                inp2.value = cat;
                container.appendChild(inp2);
            }

            return true;
        }
    </script>
}
