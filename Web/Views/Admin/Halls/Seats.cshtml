@using Application.DTOs
@using Infrastructure.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@model GenerateSeatsDto

@{
    ViewData["Title"] = $"Місця: {Model.HallName}";
    var error = ViewBag.SeatsError as string;

    string CatLabel(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "Звичайні",
        SeatCategory.Vip => "VIP",
        SeatCategory.Accessible => "Інклюзивні",
        _ => c.ToString()
    };

    string SeatBgClass(SeatCategory c) => c switch
    {
        SeatCategory.Vip => "seat-bg-vip",
        SeatCategory.Accessible => "seat-bg-acc",
        _ => "seat-bg-std"
    };

    Func<SeatCategory, IEnumerable<SelectListItem>> categoryItemsFor = selected =>
        Enum.GetValues<SeatCategory>()
            .Select(c => new SelectListItem(CatLabel(c), ((int)c).ToString(), c == selected))
            .ToList();

    var grouped = (Model.Seats ?? new List<SeatDto>())
        .GroupBy(s => s.RowNumber)
        .OrderBy(g => g.Key)
        .ToList();

    var maxSeats = grouped.Count == 0 ? 0 : grouped.Max(g => g.Max(x => x.SeatNumber));
    var canEditCategories = string.IsNullOrWhiteSpace(Model.LockReason);
}

<section class="py-5 gray-bg">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
            <div>
                <h1 class="section-title mb-1">Місця: @Model.HallName</h1>
            </div>
            <div class="d-flex gap-2">
                <a asp-area="Admin" asp-controller="Halls" asp-action="Index" class="btn btn-secondary px-4">
                    <i class="fa-solid fa-arrow-left me-2"></i>НАЗАД ДО ЗАЛІВ
                </a>

                @if (Model.AlreadyGenerated && string.IsNullOrWhiteSpace(Model.LockReason))
                {
                    <form method="post"
                          asp-action="GenerateSeats"
                          class="d-inline"
                          onsubmit="return confirm('Увага! Всі існуючі місця та квитки будуть видалені. Продовжити?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="hallId" value="@Model.HallId" />
                        <input type="hidden" name="allowRegenerate" value="true" />
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fa-solid fa-trash-can me-2"></i>ВИДАЛИТИ ТА СТВОРИТИ ЗАНОВО
                        </button>
                    </form>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 br-12 d-flex align-items-center">
                <i class="fa-solid fa-circle-exclamation me-3 fa-lg"></i>
                <div>@error</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.LockReason))
        {
            <div class="alert alert-warning border-0 shadow-sm mb-5 br-12 d-flex align-items-center">
                <i class="fa-solid fa-lock me-3 fa-lg text-warning"></i>
                <div>
                    <div class="fw-bold text-uppercase small">Редагування обмежене</div>
                    <div class="small opacity-75">@Model.LockReason</div>
                </div>
            </div>
        }

        @if (!Model.AlreadyGenerated)
        {
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card shadow-sm border-0 br-12 h-100">
                        <div class="card-body p-4 p-lg-5">
                            <h5 class="fw-bold text-dark text-uppercase small mb-4">
                                <i class="fa-solid fa-sliders me-2 text-primary"></i> 1. Налаштування рядів
                            </h5>

                            <form method="post" asp-action="ConfigureSeats">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="hallId" value="@Model.HallId" />

                                <div class="mb-4">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Кількість рядів</label>
                                    <input type="number"
                                           name="rows"
                                           min="1"
                                           value="@Model.Rows"
                                           class="form-control border-2 br-8 shadow-none"
                                           @(Model.CanEditSeats ? "" : "disabled") />
                                </div>

                                <div class="mb-4">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Місць у ряду (за замовчуванням)</label>
                                    <input type="number"
                                           name="seatsPerRow"
                                           min="1"
                                           value="@Model.SeatsPerRow"
                                           class="form-control border-2 br-8 shadow-none"
                                           @(Model.CanEditSeats ? "" : "disabled") />
                                </div>

                                <button type="submit" class="btn btn-dark w-100 py-2 fw-bold" @(Model.CanEditSeats ? "" : "disabled")>
                                    <i class="fa-solid fa-table me-2"></i>ПОБУДУВАТИ ТАБЛИЦЮ
                                </button>
                            </form>

                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card shadow-sm border-0 br-12 h-100">
                        <div class="card-body p-4 p-lg-5">
                            <h5 class="fw-bold text-dark text-uppercase small mb-4">
                                <i class="fa-solid fa-pen-to-square me-2 text-primary"></i> 2. Деталізація та запуск
                            </h5>

                            <form method="post" asp-action="GenerateSeats">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="hallId" value="@Model.HallId" />

                                <div class="admin-table-card border-0 mb-4 shadow-none">
                                    <div class="table-responsive">
                                        <table class="table admin-table mb-0 align-middle">
                                            <thead>
                                                <tr>
                                                    <th>Ряд</th>
                                                    <th>Кількість місць</th>
                                                    <th>Категорія</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < Model.RowConfigs.Count; i++)
                                                {
                                                    <tr>
                                                        <td class="fw-bold text-primary">
                                                            #@Model.RowConfigs[i].RowNumber
                                                            <input type="hidden"
                                                                   name="rowConfigs[@i].RowNumber"
                                                                   value="@Model.RowConfigs[i].RowNumber" />
                                                        </td>
                                                        <td>
                                                            <input type="number"
                                                                   name="rowConfigs[@i].SeatsCount"
                                                                   min="1"
                                                                   value="@Model.RowConfigs[i].SeatsCount"
                                                                   class="form-control form-control-sm border-2 br-4 w-75" />
                                                        </td>
                                                        <td>
                                                            <select class="form-select form-select-sm border-2 br-4"
                                                                    name="rowConfigs[@i].Category"
                                                                    asp-items="categoryItemsFor(Model.RowConfigs[i].Category)">
                                                            </select>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="text-end">
                                    <button type="submit" class="btn btn-maroon px-5 py-2 fw-bold shadow-sm">
                                        <i class="fa-solid fa-bolt me-2"></i>ЗГЕНЕРУВАТИ ПЛАН ЗАЛУ
                                    </button>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-3">

                    @if (canEditCategories)
                    {
                        <div class="card shadow-sm border-0 br-12 mb-4">
                            <div class="card-body p-4">
                                <h5 class="fw-bold text-dark text-uppercase small mb-4">
                                    <i class="fa-solid fa-tags me-2 text-primary"></i>Категорії рядів
                                </h5>

                                <form method="post" asp-action="UpdateRowCategories">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="hallId" value="@Model.HallId" />

                                    <div class="row-list-scroll pe-2" style="max-height: 400px; overflow-y: auto;">
                                        @for (int i = 0; i < grouped.Count; i++)
                                        {
                                            var rowNum = grouped[i].Key;
                                            var isMixed = grouped[i].Select(x => x.Category).Distinct().Count() > 1;

                                            <div class="mb-3 p-2 bg-light-soft br-8 border">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="small fw-bold">Ряд #@rowNum</span>
                                                    @if (isMixed)
                                                    {
                                                        <i class="fa-solid fa-circle-nodes text-warning" title="Змішані категорії"></i>
                                                    }
                                                </div>

                                                <input type="hidden" name="rows[@i].RowNumber" value="@rowNum" />
                                                <select class="form-select form-select-sm border-0 shadow-none"
                                                        name="rows[@i].Category"
                                                        asp-items="categoryItemsFor(grouped[i].First().Category)">
                                                </select>
                                            </div>
                                        }
                                    </div>

                                    <button type="submit" class="btn btn-dark w-100 mt-3 py-2 fw-bold small">
                                        <i class="fa-solid fa-floppy-disk me-2"></i>ОНОВИТИ РЯДИ
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                    <div class="panel p-4 bg-white shadow-sm br-12">
                        <h6 class="fw-bold text-muted text-uppercase small mb-3">Легенда</h6>
                        <div class="d-flex flex-column gap-2 small fw-bold">
                            <div class="d-flex align-items-center"><span class="d-inline-block br-4 seat-bg-std me-2" style="width:12px;height:12px;"></span>   Звичайні</div>
                            <div class="d-flex align-items-center"><span class="d-inline-block br-4 seat-bg-vip me-2" style="width:12px;height:12px;"></span>   VIP</div>
                            <div class="d-flex align-items-center"><span class="d-inline-block br-4 seat-bg-acc me-2" style="width:12px;height:12px;"></span>   Інклюзивні</div>
                        </div>
                    </div>

                </div>

                <div class="col-lg-9">
                    <div class="card shadow-sm border-0 br-12 overflow-hidden">
                        <div class="card-body p-4 p-md-5">
                            <div class="text-center mb-5">
                                <div class="header-subtitle text-uppercase fw-bold mb-1 opacity-50">Конфігурація</div>
                                <h3 class="fw-bold text-dark mb-0 text-uppercase">Інтерактивна схема</h3>
                            </div>

                            <form method="post"
                                  asp-action="UpdateSeatCategories"
                                  onsubmit="return buildSeatCategoryChanges();">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="hallId" value="@Model.HallId" />
                                <div id="seatChanges"></div>

                                <div class="cinema-map-wrap">
                                    <div class="cinema-map">
                                        <div class="cinema-screen">
                                            <div class="cinema-screen-arc"></div>
                                            <div class="cinema-screen-title">ЕКРАН</div>
                                        </div>

                                        <div class="cinema-grid" style="--cols:@maxSeats;">
                                            @foreach (var row in grouped)
                                            {
                                                var seatsInRow = row.OrderBy(x => x.SeatNumber).ToList();

                                                <div class="row-label">@row.Key</div>

                                                @for (int s = 1; s <= maxSeats; s++)
                                                {
                                                    var seat = seatsInRow.FirstOrDefault(x => x.SeatNumber == s);

                                                    if (seat == null)
                                                    {
                                                        <div class="seat seat-empty"></div>
                                                    }
                                                    else
                                                    {
                                                        var cls = SeatBgClass(seat.Category);

                                                        if (canEditCategories)
                                                        {
                                                            <button type="button"
                                                                    class="seat seat-toggle @cls"
                                                                    data-seat-id="@seat.Id"
                                                                    data-orig-cat="@((int)seat.Category)"
                                                                    data-cat="@((int)seat.Category)"
                                                                    title="Ряд @row.Key, місце @s (@CatLabel(seat.Category))">
                                                                <div class="seat-text">
                                                                    <div class="seat-no">@s</div>
                                                                </div>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <div class="seat @cls"
                                                                 title="Ряд @row.Key, місце @s (@CatLabel(seat.Category))">
                                                                <div class="seat-text">
                                                                    <div class="seat-no">@s</div>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>

                                @if (canEditCategories)
                                {
                                    <div class="d-flex justify-content-between align-items-center mt-4">
                                        <div class="text-muted small">
                                            <i class="fa-solid fa-circle-info me-1"></i>Натискайте на місця для зміни категорій
                                        </div>
                                        <button type="submit" class="btn btn-maroon px-5 py-2 fw-bold shadow-sm">
                                            <i class="fa-solid fa-floppy-disk me-2"></i>ЗБЕРЕГТИ ЗМІНИ СХЕМИ
                                        </button>
                                    </div>
                                }
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const buttons = document.querySelectorAll('.seat-toggle');
            if (!buttons.length) return;
            
            const cycle = [0, 1, 2];
            
            function nextCat(v) {
                const num = parseInt(v ?? '0', 10);
                const idx = cycle.indexOf(num);
                return cycle[(idx + 1) % cycle.length];
            }
            
            function applyVisual(btn, cat) {
                btn.classList.remove('seat-bg-std', 'seat-bg-vip', 'seat-bg-acc');
                
                if (cat === 0) { btn.classList.add('seat-bg-std'); }
                else if (cat === 1) { btn.classList.add('seat-bg-vip'); }
                else { btn.classList.add('seat-bg-acc'); }

                btn.dataset.cat = String(cat);
            }

            buttons.forEach(btn => {
                btn.addEventListener('pointerdown', (e) => {
                    e.preventDefault();    
                    e.stopPropagation();

                    const current = btn.dataset.cat ?? btn.dataset.origCat ?? '0';
                    const next = nextCat(current);
                    applyVisual(btn, next);
            
                    btn.blur();            
                }, { passive: false });
              });
            });
            
            function buildSeatCategoryChanges() {
            const container = document.getElementById('seatChanges');
            if (!container) return true;
            container.innerHTML = '';

            const changed = Array.from(document.querySelectorAll('.seat-toggle'))
            .filter(b => (b.dataset.cat ?? b.dataset.origCat) !== b.dataset.origCat)
            .map(b => ({ id: b.dataset.seatId, cat: b.dataset.cat }));

            if (changed.length === 0) {
                alert('Змін не знайдено. Спочатку змініть категорію хоча б одного місця.');
                return false;
            }
            
            for (let i = 0; i < changed.length; i++) {
                const inp1 = document.createElement('input');
                inp1.type = 'hidden';
                inp1.name = `changes[${i}].SeatId`;
                inp1.value = changed[i].id;
                container.appendChild(inp1);
                
                const inp2 = document.createElement('input');
                inp2.type = 'hidden';
                inp2.name = `changes[${i}].Category`;
                inp2.value = changed[i].cat;
                container.appendChild(inp2);
            }
            
            return true;
        }
    </script>
}

