@using Application.DTOs
@using Infrastructure.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@model GenerateSeatsDto

@{
    ViewData["Title"] = $"Місця: {Model.HallName}";

    var error = ViewBag.SeatsError as string;

    string CatLabel(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "Звичайні",
        SeatCategory.Vip => "VIP",
        SeatCategory.Accessible => "Доступні",
        _ => c.ToString()
    };

    // Використовуємо ті ж бейджі, що і в інших сторінках (марун + жовта тема)
    string BadgeClass(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "badge text-bg-light border text-dark",
        SeatCategory.Vip => "badge text-bg-warning text-dark",
        SeatCategory.Accessible => "badge text-bg-info text-dark",
        _ => "badge text-bg-secondary"
    };

    Func<SeatCategory, IEnumerable<SelectListItem>> categoryItemsFor = selected =>
        Enum.GetValues<SeatCategory>()
            .Select(c => new SelectListItem(
                text: CatLabel(c),
                value: ((int)c).ToString(),
                selected: c == selected))
            .ToList();

    var grouped = (Model.Seats ?? new List<SeatDto>())
        .GroupBy(s => s.RowNumber)
        .OrderBy(g => g.Key)
        .ToList();

    // якщо місця нерівні по рядах — беремо max
    var maxSeats = grouped.Count == 0 ? 0 : grouped.Max(g => g.Max(x => x.SeatNumber));

    var canEditCategories = string.IsNullOrWhiteSpace(Model.LockReason);

    var rowsForCategoryEdit = grouped
        .Select(g => new
        {
            RowNumber = g.Key,
            Category = g.First().Category,
            IsMixed = g.Select(x => x.Category).Distinct().Count() > 1
        })
        .ToList();
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">
            МІСЦЯ: @Model.HallName
        </h1>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger d-flex align-items-start gap-2 mb-3" role="alert">
                <i class="fa-solid fa-triangle-exclamation mt-1"></i>
                <div>@error</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.LockReason))
        {
            <div class="alert alert-warning d-flex align-items-start gap-2 mb-3" role="alert">
                <i class="fa-solid fa-lock mt-1"></i>
                <div>
                    <div class="fw-semibold">Редагування вимкнено</div>
                    <div class="small opacity-75">@Model.LockReason</div>
                </div>
            </div>
        }

        <!-- Верхня панель як в інших адмін-сторінках -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-maroon text-white">
                <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                    <div>
                        <h5 class="mb-1">
                            <i class="fa-solid fa-chair me-2"></i>
                            Керування місцями
                        </h5>
                        <div class="small opacity-75">
                            Налаштування рядів, генерація, схема та категорії
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap align-items-center justify-content-lg-end">
                        <a asp-area="Admin"
                           asp-controller="Halls"
                           asp-action="Index"
                           class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            НАЗАД ДО ЗАЛІВ
                        </a>

                        @if (!string.IsNullOrWhiteSpace(Model.LockReason))
                        {
                            <span class="badge text-bg-warning text-dark">
                                <i class="fa-solid fa-lock me-1"></i> РЕДАГУВАННЯ ВИМКНЕНО
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- жовтий фон як ти просила -->
            <div class="card-body p-3 p-md-4" style="background-color:#fff9e6;">
                <div class="text-muted">
                    Тут можна створити місця по рядах або змінювати категорії рядів/місць (якщо редагування дозволене).
                </div>
            </div>
        </div>

        @if (!Model.AlreadyGenerated)
        {
            <!-- 1) Налаштування рядів -->
            <div class="card shadow-sm mb-4" style="background-color:#fff9e6;">
                <div class="card-header bg-maroon text-white">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-table me-2"></i>
                        1) Налаштування рядів
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form method="post"
                          asp-area="Admin"
                          asp-controller="Halls"
                          asp-action="ConfigureSeats">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="hallId" value="@Model.HallId" />

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted">
                                    <i class="fa-solid fa-layer-group me-1"></i>
                                    Кількість рядів
                                </label>
                                <input type="number"
                                       name="rows"
                                       min="1"
                                       value="@Model.Rows"
                                       class="form-control"
                                       @(Model.CanEditSeats ? "" : "disabled") />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted">
                                    <i class="fa-solid fa-grip-lines me-1"></i>
                                    Місць у ряду за замовчуванням
                                </label>
                                <input type="number"
                                       name="seatsPerRow"
                                       min="1"
                                       value="@Model.SeatsPerRow"
                                       class="form-control"
                                       @(Model.CanEditSeats ? "" : "disabled") />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit"
                                    class="btn btn-maroon"
                                    @(Model.CanEditSeats ? "" : "disabled")>
                                <i class="fa-solid fa-gears me-1"></i>
                                ПОБУДУВАТИ ТАБЛИЦЮ
                            </button>
                        </div>

                        @if (!Model.CanEditSeats)
                        {
                            <div class="alert alert-secondary mt-3 mb-0">
                                Редагування місць вимкнено.
                            </div>
                        }
                    </form>
                </div>
            </div>

            <!-- 2) Редагування місць у кожному ряду -->
            <div class="card shadow-sm" style="background-color:#fff9e6;">
                <div class="card-header bg-maroon text-white">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-pen me-2"></i>
                        2) Редагування місць у кожному ряду
                    </h5>
                </div>

                <div class="card-body p-4">
                    @if (!Model.CanEditSeats)
                    {
                        <div class="alert alert-secondary mb-0">
                            Редагування місць вимкнено.
                        </div>
                    }
                    else
                    {
                        <form method="post"
                              asp-area="Admin"
                              asp-controller="Halls"
                              asp-action="GenerateSeats">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="hallId" value="@Model.HallId" />

                            <div class="table-responsive border rounded bg-white">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:120px;">Ряд</th>
                                            <th style="width:180px;">Кількість місць</th>
                                            <th>Категорія ряду</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.RowConfigs.Count; i++)
                                        {
                                            <tr>
                                                <td class="fw-semibold">
                                                    #@Model.RowConfigs[i].RowNumber
                                                    <input type="hidden"
                                                           name="rowConfigs[@i].RowNumber"
                                                           value="@Model.RowConfigs[i].RowNumber" />
                                                </td>
                                                <td>
                                                    <input type="number"
                                                           name="rowConfigs[@i].SeatsCount"
                                                           min="1"
                                                           value="@Model.RowConfigs[i].SeatsCount"
                                                           class="form-control form-control-sm" />
                                                </td>
                                                <td>
                                                    <select class="form-select form-select-sm"
                                                            name="rowConfigs[@i].Category"
                                                            asp-items="categoryItemsFor(Model.RowConfigs[i].Category)">
                                                    </select>
                                                    <div class="form-text">
                                                        Впливає лише на категорію місць у залі.
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <button type="submit" class="btn btn-maroon">
                                    <i class="fa-solid fa-check me-1"></i>
                                    ЗГЕНЕРУВАТИ МІСЦЯ
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Місця вже згенеровані -->
            <div class="card shadow-sm mb-4" style="background-color:#fff9e6;">
                <div class="card-header bg-maroon text-white">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-circle-check me-2"></i>
                        Місця вже згенеровані
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form method="post"
                          asp-area="Admin" asp-controller="Halls" asp-action="GenerateSeats"
                          onsubmit="return confirmRegenerate();">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="hallId" value="@Model.HallId" />

                        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="allowRegenerate"
                                       name="allowRegenerate"
                                       value="true"
                                       @(string.IsNullOrWhiteSpace(Model.LockReason) ? "" : "disabled") />
                                <label class="form-check-label" for="allowRegenerate">
                                    Створити місця заново (видалить поточні записи місць)
                                </label>
                            </div>

                            <button type="submit"
                                    class="btn btn-danger"
                                    @(string.IsNullOrWhiteSpace(Model.LockReason) ? "" : "disabled")>
                                <i class="fa-solid fa-trash-can me-1"></i>
                                СТВОРИТИ ЗАНОВО
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            @if (grouped.Count == 0)
            {
                <div class="card shadow-sm" style="background-color:#fff9e6;">
                    <div class="card-body p-4 text-center">
                        <div class="display-6 mb-2"><i class="fa-solid fa-chair"></i></div>
                        <div class="fw-semibold">Місця відсутні</div>
                        <div class="text-muted">Спробуй створити місця заново або перевір конфіг рядів.</div>
                    </div>
                </div>
            }
            else
            {
                @if (canEditCategories)
                {
                    <!-- Категорії по рядах -->
                    <div class="card shadow-sm mb-4" style="background-color:#fff9e6;">
                        <div class="card-header bg-maroon text-white">
                            <h5 class="mb-0">
                                <i class="fa-solid fa-tags me-2"></i>
                                Категорії по рядах
                            </h5>
                        </div>

                        <div class="card-body p-4">
                            <form method="post"
                                  asp-area="Admin"
                                  asp-controller="Halls"
                                  asp-action="UpdateRowCategories">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="hallId" value="@Model.HallId" />

                                <div class="table-responsive border rounded bg-white">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width:120px;">Ряд</th>
                                                <th>Категорія</th>
                                                <th style="width:180px;" class="text-end"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < rowsForCategoryEdit.Count; i++)
                                            {
                                                <tr>
                                                    <td class="fw-semibold">
                                                        #@rowsForCategoryEdit[i].RowNumber
                                                        <input type="hidden" name="rows[@i].RowNumber" value="@rowsForCategoryEdit[i].RowNumber" />
                                                    </td>
                                                    <td>
                                                        <select class="form-select form-select-sm"
                                                                name="rows[@i].Category"
                                                                asp-items="categoryItemsFor(rowsForCategoryEdit[i].Category)">
                                                        </select>
                                                    </td>
                                                    <td class="text-end">
                                                        @if (rowsForCategoryEdit[i].IsMixed)
                                                        {
                                                            <span class="text-warning small">
                                                                <i class="fa-solid fa-triangle-exclamation me-1"></i>Змішано
                                                            </span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-end mt-3">
                                    <button type="submit" class="btn btn-maroon">
                                        <i class="fa-solid fa-floppy-disk me-1"></i>
                                        ЗБЕРЕГТИ КАТЕГОРІЇ РЯДІВ
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }

                <!-- Схема залу -->
                <div class="card shadow-sm" style="background-color:#fff9e6;">
                    <div class="card-header bg-maroon text-white">
                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                            <h5 class="mb-0">
                                <i class="fa-solid fa-border-all me-2"></i>
                                Схема залу
                            </h5>

                            <div class="d-flex flex-wrap gap-3 small align-items-center">
                                <span class="d-flex align-items-center">
                                    <span class="@BadgeClass(SeatCategory.Standard) me-2" style="width:12px; height:12px; display:inline-block; padding:0; border-radius:50%;"></span>
                                    <span class="text-white-50">@CatLabel(SeatCategory.Standard)</span>
                                </span>
                                <span class="d-flex align-items-center">
                                    <span class="@BadgeClass(SeatCategory.Vip) me-2" style="width:12px; height:12px; display:inline-block; padding:0; border-radius:50%;"></span>
                                    <span class="text-white-50">@CatLabel(SeatCategory.Vip)</span>
                                </span>
                                <span class="d-flex align-items-center">
                                    <span class="@BadgeClass(SeatCategory.Accessible) me-2" style="width:12px; height:12px; display:inline-block; padding:0; border-radius:50%;"></span>
                                    <span class="text-white-50">@CatLabel(SeatCategory.Accessible)</span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4 bg-light overflow-auto">

                        @if (canEditCategories)
                        {
                            <div class="alert alert-info py-2">
                                Можеш клацати по місцях у сітці — категорія буде змінюватися циклічно.
                                Потім натисни <strong>Зберегти зміни</strong>.
                            </div>
                        }

                        <div class="mb-4 mx-auto text-center" style="max-width:520px;">
                            <div class="border-top border-4 border-secondary opacity-25 mb-2"></div>
                            <small class="text-uppercase text-muted fw-semibold">Екран</small>
                        </div>

                        <form method="post"
                              asp-area="Admin" asp-controller="Halls" asp-action="UpdateSeatCategories"
                              onsubmit="return buildSeatCategoryChanges();">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="hallId" value="@Model.HallId" />
                            <div id="seatChanges"></div>

                            <div class="table-responsive">
                                <table class="table table-borderless w-auto text-center"
                                       style="border-spacing:4px; border-collapse:separate;">
                                    <thead>
                                        <tr>
                                            <th class="text-muted fw-normal small">Ряд</th>
                                            @for (int i = 1; i <= maxSeats; i++)
                                            {
                                                <th class="text-muted fw-normal small" style="width:50px;">@i</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in grouped)
                                        {
                                            var seatsInRow = row.OrderBy(x => x.SeatNumber).ToList();

                                            <tr>
                                                <td class="fw-semibold text-secondary align-middle">#@row.Key</td>

                                                @for (int s = 1; s <= maxSeats; s++)
                                                {
                                                    var seat = seatsInRow.FirstOrDefault(x => x.SeatNumber == s);

                                                    <td>
                                                        @if (seat != null)
                                                        {
                                                            if (canEditCategories)
                                                            {
                                                                <button type="button"
                                                                        class="@BadgeClass(seat.Category)"
                                                                        style="width:50px; height:40px; border-radius:10px;"
                                                                        data-seat-id="@seat.Id"
                                                                        data-orig-cat="@((int)seat.Category)"
                                                                        data-cat="@((int)seat.Category)"
                                                                        title="@CatLabel(seat.Category)">
                                                                    <span class="fw-bold text-dark">@s</span>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <span class="@BadgeClass(seat.Category)"
                                                                      style="display:inline-flex; width:50px; height:40px; align-items:center; justify-content:center; border-radius:10px;"
                                                                      title="@CatLabel(seat.Category)">
                                                                    <span class="fw-bold text-dark">@s</span>
                                                                </span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div style="width:50px; height:40px;"></div>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (canEditCategories)
                            {
                                <div class="d-flex justify-content-end mt-3">
                                    <button type="submit" class="btn btn-maroon">
                                        <i class="fa-solid fa-floppy-disk me-1"></i>
                                        ЗБЕРЕГТИ ЗМІНИ
                                    </button>
                                </div>
                            }
                        </form>

                    </div>
                </div>
            }
        }

    </div>
</section>

@section Scripts {
    <script>
        function confirmRegenerate() {
            const allow = document.querySelector('#allowRegenerate');
            if (allow && allow.checked) {
                return confirm("Створення заново видалить існуючі місця. Продовжити?");
            }
            alert("Щоб створити місця заново, спочатку поставте галочку.");
            return false;
        }

        (function initSeatCategoryToggles() {
            const buttons = document.querySelectorAll('.seat-toggle');
            if (!buttons || buttons.length === 0) return;

            const cycle = [0, 1, 2];

            function nextCat(v) {
                const idx = cycle.indexOf(parseInt(v, 10));
                return cycle[(idx + 1) % cycle.length];
            }

            function applyVisual(btn, cat) {
                btn.classList.remove('text-bg-light', 'border', 'text-bg-warning', 'text-bg-info', 'text-bg-secondary');

                if (cat === 0) {
                    btn.classList.add('text-bg-light', 'border');
                    btn.title = 'Звичайні';
                } else if (cat === 1) {
                    btn.classList.add('text-bg-warning');
                    btn.title = 'VIP';
                } else if (cat === 2) {
                    btn.classList.add('text-bg-info');
                    btn.title = 'Доступні';
                } else {
                    btn.classList.add('text-bg-secondary');
                    btn.title = 'Невідомо';
                }

                btn.dataset.cat = cat.toString();
            }

            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const next = nextCat(btn.dataset.cat);
                    applyVisual(btn, next);
                });
            });
        })();

        function buildSeatCategoryChanges() {
            const container = document.getElementById('seatChanges');
            if (!container) return true;
            container.innerHTML = '';

            const changed = Array.from(document.querySelectorAll('.seat-toggle'))
                .filter(b => b.dataset.cat !== b.dataset.origCat)
                .map(b => ({ id: b.dataset.seatId, cat: b.dataset.cat }));

            if (changed.length === 0) {
                alert('Змін не знайдено. Спочатку змініть категорію хоча б одного місця.');
                return false;
            }

            for (let i = 0; i < changed.length; i++) {
                const seatId = changed[i].id;
                const cat = changed[i].cat;

                const inp1 = document.createElement('input');
                inp1.type = 'hidden';
                inp1.name = `changes[${i}].SeatId`;
                inp1.value = seatId;
                container.appendChild(inp1);

                const inp2 = document.createElement('input');
                inp2.type = 'hidden';
                inp2.name = `changes[${i}].Category`;
                inp2.value = cat;
                container.appendChild(inp2);
            }

            return true;
        }
    </script>
}
