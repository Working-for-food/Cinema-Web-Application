@using Application.DTOs
@using Infrastructure.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@model GenerateSeatsDto

@{
    ViewData["Title"] = $"Місця: {Model.HallName}";

    var error = ViewBag.SeatsError as string;

    string CatLabel(SeatCategory c) => c switch
    {
        SeatCategory.Standard => "Звичайні",
        SeatCategory.Vip => "VIP",
        SeatCategory.Accessible => "Інклюзивні",
        _ => c.ToString()
    };

    string SeatBgClass(SeatCategory c) => c switch
    {
        SeatCategory.Vip => "seat-bg-vip",
        SeatCategory.Accessible => "seat-bg-acc",
        _ => "seat-bg-std"
    };

    Func<SeatCategory, IEnumerable<SelectListItem>> categoryItemsFor = selected =>
        Enum.GetValues<SeatCategory>()
            .Select(c => new SelectListItem(
                text: CatLabel(c),
                value: ((int)c).ToString(),
                selected: c == selected))
            .ToList();

    var grouped = (Model.Seats ?? new List<SeatDto>())
        .GroupBy(s => s.RowNumber)
        .OrderBy(g => g.Key)
        .ToList();

    var maxSeats = grouped.Count == 0 ? 0 : grouped.Max(g => g.Max(x => x.SeatNumber));

    var canEditCategories = string.IsNullOrWhiteSpace(Model.LockReason);

    var rowsForCategoryEdit = grouped
        .Select(g => new
        {
            RowNumber = g.Key,
            Category = g.First().Category,
            IsMixed = g.Select(x => x.Category).Distinct().Count() > 1
        })
        .ToList();

    var regenerateDisabled = !string.IsNullOrWhiteSpace(Model.LockReason);
    var regenerateDisabledText = !string.IsNullOrWhiteSpace(Model.LockReason)
        ? Model.LockReason
        : "Наразі неможливо створити місця заново.";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">
            МІСЦЯ: @Model.HallName
        </h1>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger d-flex align-items-start gap-2 mb-3" role="alert">
                <i class="fa-solid fa-triangle-exclamation mt-1"></i>
                <div>@error</div>
            </div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-maroon text-white">
                <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                    <div>
                        <h5 class="mb-1">
                            <i class="fa-solid fa-chair me-2"></i>
                            Керування місцями
                        </h5>
                        <div class="small opacity-75">
                            Налаштування рядів, генерація, схема та категорії
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body p-3 p-md-4" style="background-color:#fff9e6;">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">

                    <div class="text-muted">
                        Тут можна створити місця по рядах або змінювати категорії (якщо редагування дозволене).
                    </div>

                    <div class="d-flex gap-2 flex-wrap justify-content-lg-end">

                        <a asp-area="Admin"
                           asp-controller="Halls"
                           asp-action="Index"
                           class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            НАЗАД ДО ЗАЛІВ
                        </a>

                        @if (Model.AlreadyGenerated)
                        {
                            <form method="post"
                                  asp-area="Admin"
                                  asp-controller="Halls"
                                  asp-action="GenerateSeats"
                                  class="d-inline"
                                  onsubmit="return confirmRegenerate();">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="hallId" value="@Model.HallId" />
                                <input type="hidden" name="allowRegenerate" value="true" />

                                <button type="submit"
                                        class="btn btn-danger"
                                        @(regenerateDisabled ? "disabled" : "")>
                                    <i class="fa-solid fa-trash-can me-1"></i>
                                    СТВОРИТИ ЗАНОВО
                                </button>
                            </form>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.LockReason))
                {
                    <div class="alert alert-warning d-flex align-items-start gap-2 mt-3 mb-0" role="alert">
                        <i class="fa-solid fa-lock mt-1"></i>

                        <div>
                            <div class="fw-semibold">Обмеження</div>

                            <div class="small opacity-75">
                                <div>
                                    <strong>Редагування:</strong> вимкнено — @Model.LockReason
                                </div>

                                @if (Model.AlreadyGenerated)
                                {
                                    <div class="mt-1">
                                        <strong>Створити заново:</strong> вимкнено — @regenerateDisabledText
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (!Model.AlreadyGenerated)
        {
            <div class="card shadow-sm mb-4" style="background-color:#fff9e6;">
                <div class="card-header bg-maroon text-white">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-table me-2"></i>
                        1) Налаштування рядів
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form method="post"
                          asp-area="Admin"
                          asp-controller="Halls"
                          asp-action="ConfigureSeats">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="hallId" value="@Model.HallId" />

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted">
                                    <i class="fa-solid fa-layer-group me-1"></i>
                                    Кількість рядів
                                </label>
                                <input type="number"
                                       name="rows"
                                       min="1"
                                       value="@Model.Rows"
                                       class="form-control"
                                       @(Model.CanEditSeats ? "" : "disabled") />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted">
                                    <i class="fa-solid fa-grip-lines me-1"></i>
                                    Місць у ряду за замовчуванням
                                </label>
                                <input type="number"
                                       name="seatsPerRow"
                                       min="1"
                                       value="@Model.SeatsPerRow"
                                       class="form-control"
                                       @(Model.CanEditSeats ? "" : "disabled") />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit"
                                    class="btn btn-maroon"
                                    @(Model.CanEditSeats ? "" : "disabled")>
                                <i class="fa-solid fa-gears me-1"></i>
                                ПОБУДУВАТИ ТАБЛИЦЮ
                            </button>
                        </div>

                        @if (!Model.CanEditSeats)
                        {
                            <div class="alert alert-secondary mt-3 mb-0">
                                Редагування місць вимкнено.
                            </div>
                        }
                    </form>
                </div>
            </div>

            <div class="card shadow-sm" style="background-color:#fff9e6;">
                <div class="card-header bg-maroon text-white">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-pen me-2"></i>
                        2) Редагування місць у кожному ряду
                    </h5>
                </div>

                <div class="card-body p-4">
                    @if (!Model.CanEditSeats)
                    {
                        <div class="alert alert-secondary mb-0">
                            Редагування місць вимкнено.
                        </div>
                    }
                    else
                    {
                        <form method="post"
                              asp-area="Admin"
                              asp-controller="Halls"
                              asp-action="GenerateSeats">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="hallId" value="@Model.HallId" />

                            <div class="table-responsive border rounded bg-white">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:120px;">Ряд</th>
                                            <th style="width:180px;">Кількість місць</th>
                                            <th>Категорія ряду</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.RowConfigs.Count; i++)
                                        {
                                            <tr>
                                                <td class="fw-semibold">
                                                    #@Model.RowConfigs[i].RowNumber
                                                    <input type="hidden"
                                                           name="rowConfigs[@i].RowNumber"
                                                           value="@Model.RowConfigs[i].RowNumber" />
                                                </td>
                                                <td>
                                                    <input type="number"
                                                           name="rowConfigs[@i].SeatsCount"
                                                           min="1"
                                                           value="@Model.RowConfigs[i].SeatsCount"
                                                           class="form-control form-control-sm" />
                                                </td>
                                                <td>
                                                    <select class="form-select form-select-sm"
                                                            name="rowConfigs[@i].Category"
                                                            asp-items="categoryItemsFor(Model.RowConfigs[i].Category)">
                                                    </select>
                                                    <div class="form-text">
                                                        Впливає лише на категорію місць у залі.
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <button type="submit" class="btn btn-maroon">
                                    <i class="fa-solid fa-check me-1"></i>
                                    ЗГЕНЕРУВАТИ МІСЦЯ
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        }
        else
        {
            @if (grouped.Count == 0)
            {
                <div class="card shadow-sm" style="background-color:#fff9e6;">
                    <div class="card-body p-4 text-center">
                        <div class="display-6 mb-2"><i class="fa-solid fa-chair"></i></div>
                        <div class="fw-semibold">Місця відсутні</div>
                        <div class="text-muted">Спробуй створити місця заново або перевір конфіг рядів.</div>
                    </div>
                </div>
            }
            else
            {
                @if (canEditCategories)
                {
                    <div class="card shadow-sm mb-4" style="background-color:#fff9e6;">
                        <div class="card-header bg-maroon text-white">
                            <h5 class="mb-0">
                                <i class="fa-solid fa-tags me-2"></i>
                                Категорії по рядах
                            </h5>
                        </div>

                        <div class="card-body p-4">
                            <form method="post"
                                  asp-area="Admin"
                                  asp-controller="Halls"
                                  asp-action="UpdateRowCategories">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="hallId" value="@Model.HallId" />

                                <div class="table-responsive border rounded bg-white">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width:120px;">Ряд</th>
                                                <th>Категорія</th>
                                                <th style="width:180px;" class="text-end"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < rowsForCategoryEdit.Count; i++)
                                            {
                                                <tr>
                                                    <td class="fw-semibold">
                                                        #@rowsForCategoryEdit[i].RowNumber
                                                        <input type="hidden" name="rows[@i].RowNumber" value="@rowsForCategoryEdit[i].RowNumber" />
                                                    </td>
                                                    <td>
                                                        <select class="form-select form-select-sm"
                                                                name="rows[@i].Category"
                                                                asp-items="categoryItemsFor(rowsForCategoryEdit[i].Category)">
                                                        </select>
                                                    </td>
                                                    <td class="text-end">
                                                        @if (rowsForCategoryEdit[i].IsMixed)
                                                        {
                                                            <span class="text-warning small">
                                                                <i class="fa-solid fa-triangle-exclamation me-1"></i>Змішано
                                                            </span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-end mt-3">
                                    <button type="submit" class="btn btn-maroon">
                                        <i class="fa-solid fa-floppy-disk me-1"></i>
                                        ЗБЕРЕГТИ КАТЕГОРІЇ РЯДІВ
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }

                <div class="card shadow-sm" style="background-color:#fff9e6;">
                    <div class="card-header bg-maroon text-white">
                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                            <h5 class="mb-0">
                                <i class="fa-solid fa-border-all me-2"></i>
                                Схема залу
                            </h5>

                            <div class="d-flex flex-wrap gap-3 small align-items-center">
                                <span class="d-flex align-items-center">
                                    <span class="legend-dot legend-std me-2"></span>
                                    <span class="text-white-50">@CatLabel(SeatCategory.Standard)</span>
                                </span>
                                <span class="d-flex align-items-center">
                                    <span class="legend-dot legend-vip me-2"></span>
                                    <span class="text-white-50">@CatLabel(SeatCategory.Vip)</span>
                                </span>
                                <span class="d-flex align-items-center">
                                    <span class="legend-dot legend-acc me-2"></span>
                                    <span class="text-white-50">@CatLabel(SeatCategory.Accessible)</span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">

                        @if (canEditCategories)
                        {
                            <div class="alert alert-info py-2">
                                Клацай по місцях — категорія змінюється циклічно. Потім натисни <strong>Зберегти зміни</strong>.
                            </div>
                        }

                        <form method="post"
                              asp-area="Admin" asp-controller="Halls" asp-action="UpdateSeatCategories"
                              onsubmit="return buildSeatCategoryChanges();">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="hallId" value="@Model.HallId" />
                            <div id="seatChanges"></div>

                            <div class="cinema-map-wrap">
                                <div class="cinema-map">

                                    <div class="cinema-screen">
                                        <div class="cinema-screen-arc"></div>
                                        <div class="cinema-screen-title">ЕКРАН</div>
                                    </div>

                                    <div class="cinema-grid" style="--cols:@maxSeats;">
                                        @foreach (var row in grouped)
                                        {
                                            var seatsInRow = row.OrderBy(x => x.SeatNumber).ToList();

                                            <div class="row-label">@row.Key</div>

                                            @for (int s = 1; s <= maxSeats; s++)
                                            {
                                                var seat = seatsInRow.FirstOrDefault(x => x.SeatNumber == s);

                                                if (seat != null)
                                                {
                                                    var cls = SeatBgClass(seat.Category);

                                                    if (canEditCategories)
                                                    {
                                                        <button type="button"
                                                                class="seat seat-toggle @cls"
                                                                data-seat-id="@seat.Id"
                                                                data-orig-cat="@((int)seat.Category)"
                                                                data-cat="@((int)seat.Category)"
                                                                title="@CatLabel(seat.Category)">
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <div class="seat @cls" title="@CatLabel(seat.Category)"></div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="seat seat-empty"></div>
                                                }
                                            }
                                        }
                                    </div>

                                </div>
                            </div>

                            @if (canEditCategories)
                            {
                                <div class="d-flex justify-content-end mt-3">
                                    <button type="submit" class="btn btn-maroon">
                                        <i class="fa-solid fa-floppy-disk me-1"></i>
                                        ЗБЕРЕГТИ ЗМІНИ
                                    </button>
                                </div>
                            }
                        </form>

                    </div>
                </div>
            }
        }

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function confirmRegenerate() {
            return confirm("Створення заново видалить існуючі місця. Продовжити?");
        }

        (function initSeatCategoryToggles() {
            const buttons = document.querySelectorAll('.seat-toggle');
            if (!buttons || buttons.length === 0) return;

            const cycle = [0, 1, 2];

            function nextCat(v) {
                const idx = cycle.indexOf(parseInt(v, 10));
                return cycle[(idx + 1) % cycle.length];
            }

            function applyVisual(btn, cat) {
                btn.classList.remove('seat-bg-std', 'seat-bg-vip', 'seat-bg-acc');

                if (cat === 0) {
                    btn.classList.add('seat-bg-std');
                    btn.title = 'Звичайні';
                } else if (cat === 1) {
                    btn.classList.add('seat-bg-vip');
                    btn.title = 'VIP';
                } else if (cat === 2) {
                    btn.classList.add('seat-bg-acc');
                    btn.title = 'Інклюзивні';
                }

                btn.dataset.cat = cat.toString();
            }

            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const next = nextCat(btn.dataset.cat);
                    applyVisual(btn, next);
                });
            });
        })();

        function buildSeatCategoryChanges() {
            const container = document.getElementById('seatChanges');
            if (!container) return true;
            container.innerHTML = '';

            const changed = Array.from(document.querySelectorAll('.seat-toggle'))
                .filter(b => b.dataset.cat !== b.dataset.origCat)
                .map(b => ({ id: b.dataset.seatId, cat: b.dataset.cat }));

            if (changed.length === 0) {
                alert('Змін не знайдено. Спочатку змініть категорію хоча б одного місця.');
                return false;
            }

            for (let i = 0; i < changed.length; i++) {
                const seatId = changed[i].id;
                const cat = changed[i].cat;

                const inp1 = document.createElement('input');
                inp1.type = 'hidden';
                inp1.name = `changes[${i}].SeatId`;
                inp1.value = seatId;
                container.appendChild(inp1);

                const inp2 = document.createElement('input');
                inp2.type = 'hidden';
                inp2.name = `changes[${i}].Category`;
                inp2.value = cat;
                container.appendChild(inp2);
            }

            return true;
        }
    </script>
}

