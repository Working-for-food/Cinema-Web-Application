@model Web.ViewModels.Admin.Halls.HallEditVm

@{
    var isCreate = Model.Id == null;
    ViewData["Title"] = isCreate ? "Створення залу" : "Редагування залу";
}

<section class="py-5 gray-bg">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="section-title h2 fw-bold text-dark text-uppercase">
                @(isCreate ? "Створення залу" : "Редагування залу")
            </h1>
            <p class="text-muted small text-uppercase fw-semibold">
                @(isCreate ? "Вкажіть параметри для нового залу" : "Змініть назву або приналежність залу")
            </p>
        </div>

        <div class="card shadow-sm border-0 col-lg-8 mx-auto br-12 overflow-hidden">
            
            <div class="card-body p-4 p-lg-5">
                <form asp-area="Admin"
                      asp-controller="Halls"
                      asp-action="@(isCreate ? "Create" : "Edit")"
                      method="post">

                    @Html.AntiForgeryToken()

                    @if (!isCreate)
                    {
                        <input type="hidden" asp-for="Id" />
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small br-8 shadow-none mb-4"></div>

                    <div class="mb-4">
                        <label asp-for="CinemaId" class="form-label small fw-bold text-muted text-uppercase">
                            <i class="fa-solid fa-film me-1"></i> Кінотеатр
                        </label>

                        <select asp-for="CinemaId"
                                asp-items="Model.Cinemas"
                                class="form-select border-2 br-8 shadow-none">
                            <option value="">Оберіть кінотеатр</option>
                        </select>

                        <span asp-validation-for="CinemaId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label small fw-bold text-muted text-uppercase">
                            <i class="fa-solid fa-chair me-1"></i> Назва залу
                        </label>

                        <input asp-for="Name"
                               class="form-control form-control-lg border-2 br-8 shadow-none"
                               placeholder="Наприклад: Зал №1 / IMAX / VIP"
                               autocomplete="off" />

                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                        <a asp-area="Admin"
                           asp-controller="Halls"
                           asp-action="Index"
                           asp-route-cinemaId="@Model.CinemaId"
                           class="btn btn-link text-muted text-decoration-none fw-bold small p-0">
                            <i class="fa-solid fa-arrow-left me-1"></i> НАЗАД ДО СПИСКУ
                        </a>

                        <button type="submit" class="btn btn-maroon px-5 py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-floppy-disk me-2"></i> 
                            @(isCreate ? "СТВОРИТИ ЗАЛ" : "ЗБЕРЕГТИ ЗМІНИ")
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}