@model Web.ViewModels.Admin.Halls.HallEditVm

@{
    var isCreate = Model.Id == null;
    ViewData["Title"] = isCreate ? "Створення залу" : "Редагування залу";
}

<section class="py-5 gray-bg">
    <div class="container-fluid">

        <h1 class="section-title text-center mb-5">@(isCreate ? "Створити зал" : "Редагувати зал")</h1>

        <div class="card shadow-sm col-lg-8 mx-auto">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa-solid @(isCreate ? "fa-plus" : "fa-pen-to-square") me-2"></i>
                    @(isCreate ? "Реєстрація залу" : "Редагування залу")
                </h5>
            </div>

            <div class="card-body p-4">
                <form asp-area="Admin"
                      asp-controller="Halls"
                      asp-action="@(isCreate ? "Create" : "Edit")"
                      method="post">

                    @Html.AntiForgeryToken()

                    @if (!isCreate)
                    {
                        <input type="hidden" asp-for="Id" />
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CinemaId" class="form-label text-muted">
                            <i class="fa-solid fa-film me-1"></i>
                            Кінотеатр
                        </label>

                        <select asp-for="CinemaId"
                                asp-items="Model.Cinemas"
                                class="form-select">
                            <option value="">Оберіть кінотеатр</option>
                        </select>

                        <span asp-validation-for="CinemaId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label text-muted">
                            <i class="fa-solid fa-chair me-1"></i>
                            Назва залу
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Наприклад: Зал №1 / IMAX / VIP"
                               autocomplete="off" />

                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-area="Admin"
                           asp-controller="Halls"
                           asp-action="Index"
                           asp-route-cinemaId="@Model.CinemaId"
                           class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            Назад
                        </a>

                        <button type="submit" class="btn btn-maroon">
                            <i class="fa-solid fa-floppy-disk me-1"></i>
                            @(isCreate ? "Створити зал" : "Зберегти зміни")
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
