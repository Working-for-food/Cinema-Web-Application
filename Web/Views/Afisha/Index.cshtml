@model Web.ViewModels.Afisha.AfishaIndexVm

<link rel="stylesheet" href="~/css/afisha.css" />

<div class="afisha-page">
    <h1 class="afisha-title">Афіша</h1>

    <!-- Tabs -->
    <div class="afisha-tabs" role="tablist" aria-label="Афіша вкладки">
        <button type="button"
                class="afisha-tab-btn is-active"
                role="tab"
                aria-selected="true"
                aria-controls="tab-now"
                id="tabBtnNow"
                data-tab="now">
            У ПРОКАТІ
        </button>

        <button type="button"
                class="afisha-tab-btn"
                role="tab"
                aria-selected="false"
                aria-controls="tab-soon"
                id="tabBtnSoon"
                data-tab="soon">
            СКОРО БУДЕ
        </button>
    </div>

    <!-- Tab: Now showing -->
    <section id="tab-now" class="afisha-tab-panel is-active" role="tabpanel" aria-labelledby="tabBtnNow">
        <div class="afisha-carousel" data-carousel="now">
            <button type="button" class="afisha-car-btn prev" aria-label="Попередній слайд">‹</button>

            <div class="afisha-car-stage">
                <div class="afisha-car-track">
                    @for (var i = 0; i < (Model.NowShowing?.Count ?? 0); i++)
                    {
                        var m = Model.NowShowing[i];

                        <a asp-route="MovieDetails"
                           asp-route-id="@m.Id"
                           class="afisha-car-item movie-card-link"
                           data-index="@i">

                            <div class="movie-poster-wrap">
                                @if (!string.IsNullOrWhiteSpace(m.AgeLabel))
                                {
                                    <div class="badge badge-age">@m.AgeLabel</div>
                                }
                                @if (m.Year is not null)
                                {
                                    <div class="badge badge-year">@m.Year</div>
                                }

                                <img class="afisha-poster"
                                     src="@m.PosterUrl"
                                     alt="@m.Title" />
                            </div>

                            <div class="movie-name">@m.Title</div>
                            <div class="btn-details">Показати деталі</div>
                        </a>
                    }
                </div>
            </div>

            <button type="button" class="afisha-car-btn next" aria-label="Наступний слайд">›</button>
        </div>
    </section>

    <!-- Tab: Coming soon -->
    <section id="tab-soon" class="afisha-tab-panel" role="tabpanel" aria-labelledby="tabBtnSoon">
        <div class="afisha-carousel" data-carousel="soon">
            <button type="button" class="afisha-car-btn prev" aria-label="Попередній слайд">‹</button>

            <div class="afisha-car-stage">
                <div class="afisha-car-track">
                    @for (var i = 0; i < (Model.ComingSoon?.Count ?? 0); i++)
                    {
                        var m = Model.ComingSoon[i];

                        <a asp-route="MovieDetails"
                           asp-route-id="@m.Id"
                           class="afisha-car-item movie-card-link movie-card-soon"
                           data-index="@i">

                            <div class="movie-poster-wrap">
                                <div class="soon-badge">СКОРО</div>

                                @if (!string.IsNullOrWhiteSpace(m.AgeLabel))
                                {
                                    <div class="badge badge-age">@m.AgeLabel</div>
                                }
                                @if (m.Year is not null)
                                {
                                    <div class="badge badge-year">@m.Year</div>
                                }

                                <img class="afisha-poster"
                                     src="@m.PosterUrl"
                                     alt="@m.Title" />
                            </div>

                            <div class="movie-name">@m.Title</div>
                            <div class="btn-details">Показати деталі</div>
                        </a>
                    }
                </div>
            </div>

            <button type="button" class="afisha-car-btn next" aria-label="Наступний слайд">›</button>
        </div>
    </section>
</div>

<script src="~/js/afisha-carousel.js"></script>
