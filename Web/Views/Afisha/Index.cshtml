@model Web.ViewModels.Afisha.AfishaIndexVm

<link rel="stylesheet" href="~/css/afisha.css" />

<div class="afisha-page">
    <h1 class="afisha-title">Афіша</h1>

    <section class="afisha-section">
        <h2 class="afisha-section-title">ЗАРАЗ У ПРОКАТІ</h2>

        <div class="afisha-row">
            @foreach (var m in Model.NowShowing)
            {
                <a asp-route="MovieDetails"
                   asp-route-id="@m.Id"
                   class="movie-card movie-card-link">

                    <div class="movie-poster-wrap">
                        @if (!string.IsNullOrWhiteSpace(m.AgeLabel))
                        {
                            <div class="badge badge-age">@m.AgeLabel</div>
                        }
                        @if (m.Year is not null)
                        {
                            <div class="badge badge-year">@m.Year</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(m.PosterUrl) &&
                       (m.PosterUrl.StartsWith("http://") || m.PosterUrl.StartsWith("https://")))
                        {
                            <img class="afisha-poster" src="@m.PosterUrl" alt="" />
                        }
                        else
                        {
                            <div class="afisha-poster afisha-poster-placeholder"></div>
                        }
                    </div>

                    <div class="movie-name">@m.Title</div>

                    <div class="btn-details">Показати деталі</div>
                </a>
            }
        </div>
    </section>

    <section class="afisha-section">
        <h2 class="afisha-section-title">СКОРО У ПРОКАТІ</h2>

        <div class="afisha-row">
            @foreach (var m in Model.ComingSoon)
            {
                <a asp-route="MovieDetails"
                   asp-route-id="@m.Id"
                   class="movie-card movie-card-soon movie-card-link">

                    <div class="movie-poster-wrap">
                        <div class="soon-badge">СКОРО</div>

                        @if (!string.IsNullOrWhiteSpace(m.AgeLabel))
                        {
                            <div class="badge badge-age">@m.AgeLabel</div>
                        }
                        @if (m.Year is not null)
                        {
                            <div class="badge badge-year">@m.Year</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(m.PosterUrl) &&
                       (m.PosterUrl.StartsWith("http://") || m.PosterUrl.StartsWith("https://")))
                        {
                            <img class="afisha-poster" src="@m.PosterUrl" alt="" />
                        }
                        else
                        {
                            <div class="afisha-poster afisha-poster-placeholder"></div>
                        }
                    </div>

                    <div class="movie-name">@m.Title</div>

                    <div class="btn-details">Показати деталі</div>
                </a>
            }
        </div>
    </section>
</div>
